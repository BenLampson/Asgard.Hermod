    <ProjectReference Include="..\..\src\Asgard.Hermod.ObjectStorage.UI\Asgard.Hermod.ObjectStorage.UI.csproj" />
    <ProjectReference Include="..\..\src\Asgard.Hermod.Persistence.Sqlite\Asgard.Hermod.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Asgard.Hermod.Providers.AliyunOss\Asgard.Hermod.Providers.AliyunOss.csproj" />
    <ProjectReference Include="..\..\src\Asgard.Hermod.Security.Windows\Asgard.Hermod.Security.Windows.csproj" />
    <ProjectReference Include="..\..\src\Asgard.Hermod\Asgard.Hermod.csproj" />
  </ItemGroup>
</Project>
