            {
              "type": "text",
              "id": "KZp2z",
              "name": "断线与关闭规则内容",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "SSH 断线后保留快照，本地搜索、复制、导出和已附快照分析可继续；远端读取停用，异常紧凑显示在标题栏。容器消失或被重建不重定向旧文档。关闭日志不影响 SSH；日志来源关闭后 Agent 保留历史，停用定位与新上下文读取。",
              "lineHeight": 1.75,
              "fontFamily": "$uiFont",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
