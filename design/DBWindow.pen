                                  "width": 314,
                                  "content": "SELECT DATE(created_at) AS day,\n  COUNT(*) AS orders,\n  SUM(total) AS revenue\nFROM hermod_dev.orders\nWHERE status = 'paid'\n  AND created_at >=\n    CURRENT_DATE - INTERVAL 6 DAY\nGROUP BY day ORDER BY day DESC;",
