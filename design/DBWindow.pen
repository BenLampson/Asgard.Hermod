    {
      "type": "frame",
      "id": "PgkGo",
      "x": 5160,
      "y": 5700,
      "name": "16 · PostgreSQL & MySQL · 四项规则对照验收",
      "context": "唯一候选直接固定展示并使用，不构成替用户在多个候选中猜测；多个候选才要求选择。任何移除仍须用户确认。\n统一规则：只有一个可用数据库或执行目标时直接使用并固定展示；多个时才选择或主动全选。Session 固定当前实例，至少保留一个数据库。任何移除先说明对象和影响，用户确认后才执行；唯一替代目标也不得跳过移除确认。",
      "metadata": {
        "type": "shared-session-rule-audit",
        "engines": [
          "postgresql",
          "mysql"
        ],
        "instanceBound": true,
        "minDatabases": 1,
        "confirmEveryRemoval": true,
        "selectionPolicy": "unique-direct-multiple-explicit",
        "automaticRemoval": false,
        "requiresExplicitRemovalConfirmation": true
      },
