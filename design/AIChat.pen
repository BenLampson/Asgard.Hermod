                      "fontFamily": "$ui",
                      "fontSize": 17,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "oKgBC",
                      "name": "04  执行与取消 body",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "数据库默认手动；自动只读只授权受限只读查询。修改操作进入待确认卡，不得折叠到看不见；审阅时显示当前 Session、执行目标和完整语句。等待确认期间保持同一忙状态。停止不撤销已完成操作；结果未知时先检查，禁止盲目重试。",
                      "lineHeight": 1.65,
                      "fontFamily": "$ui",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "D2cNtX",
                  "name": "05  恢复与键盘",
                  "width": "fill_container",
