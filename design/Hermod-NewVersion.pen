            },
            {
              "type": "text",
              "id": "iuOSk",
              "name": "01 / 密度与文字 正文",
              "fill": "$body",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "输入高度 36；按钮 32；紧凑控件 28，仅用于工具栏和表格筛选。圆角 6；常用图标 16；间距 4 / 8 / 12 / 16；标签、控件、说明之间保留 6。正文与输入以 13 为主，辅助说明至少 12，页面标题 14–16。代码、协议数值使用 JetBrains Mono。固定高度输入框不以换行容纳长内容。",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ypEtI",
          "name": "02 / 交互与可访问性",
          "width": "fill_container",
          "stroke": "$line",
          "strokeWidth": {
            "top": 1
          },
          "layout": "vertical",
          "gap": 8,
          "padding": [
            16,
            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "s2OHX",
              "name": "02 / 交互与可访问性 标题",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "02 / 交互与可访问性",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "m3A5J",
              "name": "02 / 交互与可访问性 正文",
              "fill": "$body",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "默认、悬停、聚焦、错误、禁用和只读状态必须可区分。焦点描边 2；错误同时提供图标、颜色和就地说明。只读内容允许复制；禁用控件不响应操作。图标按钮提供提示和可访问名称；长名称截断时保留完整提示，焦点不持续打开工具提示。",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "lUbIL",
          "name": "03 / 键盘与选择",
          "width": "fill_container",
          "stroke": "$line",
