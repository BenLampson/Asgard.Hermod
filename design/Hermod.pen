        {
          "type": "frame",
          "id": "eAmiH",
          "name": "识别及显示规则",
          "width": "fill_container",
          "fill": "$app-bg",
          "cornerRadius": 6,
          "layout": "vertical",
          "gap": 8,
          "padding": 16,
          "children": [
            {
              "type": "text",
              "id": "aWixi",
              "name": "默认识别规则",
              "fill": "$ink",
              "content": "默认规则",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "otZRS",
              "name": "默认识别规则内容",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "扩展名忽略大小写，复合后缀优先匹配（如 .tar.gz）；无后缀时使用 Content-Type 补充识别。\n列表使用 18px 图标，详情使用 24px 图标；颜色辅助识别，图形本身也能区分类型。文件夹保持独立的文件夹图标。",
              "lineHeight": 1.65,
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
