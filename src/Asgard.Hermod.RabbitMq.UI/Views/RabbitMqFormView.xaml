<UserControl x:Class="Asgard.Hermod.RabbitMq.UI.Views.RabbitMqFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/RabbitMqDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <DataTemplate x:Key="TextField">
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" MaxLength="8192" AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
            <DataTemplate x:Key="SecretField">
                <c:SecretInput Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
            <DataTemplate x:Key="BoolField">
                <CheckBox IsChecked="{Binding Checked}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
            <DataTemplate x:Key="ChoiceField">
                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Value}" AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
            <DataTemplate x:Key="MultilineField">
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Height="180" MaxLength="1400000" FontFamily="{DynamicResource MonoFont}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Label}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Border Padding="12" Margin="0,0,0,16" CornerRadius="5" Background="{DynamicResource AppBackgroundBrush}">
                <TextBlock Text="{Binding TargetLabel}" ToolTip="{Binding Target}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
            </Border>
            <ItemsControl ItemsSource="{Binding InputFields}" IsEnabled="{Binding IsEditable}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:FormField Label="{Binding Label}" IsRequired="{Binding Required}" Margin="0,0,0,16">
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextField}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="secret">
                                                <Setter Property="ContentTemplate" Value="{StaticResource SecretField}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="boolean">
                                                <Setter Property="ContentTemplate" Value="{StaticResource BoolField}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="choice">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ChoiceField}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="multiline">
                                                <Setter Property="ContentTemplate" Value="{StaticResource MultilineField}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </c:FormField>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding BooleanFields}" IsEnabled="{Binding IsEditable}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:FormField Label="{Binding Label}" Margin="0,0,12,8">
                            <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Value}" Height="36" AutomationProperties.Name="{Binding Label}" />
                        </c:FormField>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{Binding HasArguments, Converter={StaticResource Visible}}" IsEnabled="{Binding IsEditable}" Margin="0,0,0,16">
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc RabbitMqAddArgument}" Command="{Binding AddArgumentCommand}" />
                    <TextBlock Text="{Binding ArgumentsLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
                <Grid Background="{DynamicResource RabbitMqSoftBrush}" Height="36" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc RabbitMqKey}" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc RabbitMqType}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc RabbitMqValue}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Arguments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Loc RabbitMqKey}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Type}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Loc RabbitMqType}" />
                                <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.Name="{loc:Loc RabbitMqValue}" />
                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveArgumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="0" ToolTip="{loc:Loc RabbitMqRemoveArgument}" AutomationProperties.Name="{loc:Loc RabbitMqRemoveArgument}">
                                    <c:IconView Kind="x" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Border Padding="12" Margin="0,0,0,16" CornerRadius="4" Background="{DynamicResource WarningWeakBrush}">
                <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
            <c:FormField Label="{Binding ConfirmationLabel}" IsRequired="True" Visibility="{Binding IsConfirmation, Converter={StaticResource Visible}}">
                <TextBox Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{Binding ConfirmationLabel}" />
            </c:FormField>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
