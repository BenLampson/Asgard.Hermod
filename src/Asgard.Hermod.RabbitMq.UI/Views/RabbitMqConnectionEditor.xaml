<UserControl x:Class="Asgard.Hermod.RabbitMq.UI.Views.RabbitMqConnectionEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <StackPanel>
        <c:FormField Label="{loc:Loc InstanceName}" IsRequired="True" Error="{Binding Wizard.NameError}" Margin="0,0,0,16">
            <TextBox x:Name="NameInput" Text="{Binding Wizard.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" AutomationProperties.Name="{loc:Loc InstanceName}" />
        </c:FormField>
        <c:SegmentedSelector ItemsSource="{Binding Panes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Pane, Mode=TwoWay}" Margin="0,0,0,18" AutomationProperties.Name="{loc:Loc RabbitMqConnectionDetails}" />
        <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <c:InstanceConfigurationFieldEditor Margin="0,0,0,14" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{loc:Loc RabbitMqPlaintextWarning}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding IsPlaintext, Converter={StaticResource Visible}}" />
    </StackPanel>
</UserControl>
