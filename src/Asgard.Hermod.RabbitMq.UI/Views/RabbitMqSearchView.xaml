<UserControl x:Class="Asgard.Hermod.RabbitMq.UI.Views.RabbitMqSearchView" x:Name="SearchRoot" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
    <Border Background="{DynamicResource RabbitMqBackgroundBrush}" BorderBrush="{DynamicResource RabbitMqLineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:IconView Kind="search" Width="14" Height="14" Foreground="{DynamicResource RabbitMqMutedBrush}" />
            <TextBox Grid.Column="1" x:Name="Input" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource SearchTextBox}" Margin="8,0,0,0" FontSize="12" AutomationProperties.Name="{loc:Loc RabbitMqSearch}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Grid.Column="1" Text="{Binding Placeholder, ElementName=SearchRoot}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource RabbitMqMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
