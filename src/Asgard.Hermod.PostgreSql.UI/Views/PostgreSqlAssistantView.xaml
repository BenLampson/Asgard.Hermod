<UserControl x:Class="Asgard.Hermod.PostgreSql.UI.Views.PostgreSqlAssistantView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI">
 <controls:AgentPanel x:Name="ChatPanel" IsSourceClosed="{Binding IsSourceClosed}" Archive="{Binding Archive}" QuickPrompts="{Binding QuickPrompts}" WelcomeDescription="{loc:Loc ChatDbWelcome}" Messages="{Binding Messages}" Prompt="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxPromptLength="8000"
  Placeholder="{loc:Loc PostgreSqlAssistantPrompt}" SendCommand="{Binding SendCommand}" CancelCommand="{Binding CancelCommand}"
  ClearCommand="{Binding ClearCommand}" HideCommand="{Binding HideCommand}" IsBusy="{Binding IsBusy}" Error="{Binding Error}" Status="{Binding Status}">
  <controls:AgentPanel.ContextContent>
   <StackPanel>
    <TextBlock Text="{Binding ContextLabel}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
    <WrapPanel Margin="0,7,0,0">
     <CheckBox Content="{loc:Loc PostgreSqlAssistantIncludeSql}" IsChecked="{Binding IncludeSql}" Margin="0,0,12,7" />
     <CheckBox Content="{loc:Loc PostgreSqlAssistantIncludeResults}" IsChecked="{Binding IncludeResults}" IsEnabled="{Binding CanShareResults}" ToolTip="{loc:Loc DatabaseSessionResultScopeHint}" Margin="0,0,0,7" />
    </WrapPanel>
    <TextBlock Text="{loc:Loc PostgreSqlAssistantPrivacy}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
   </StackPanel>
  </controls:AgentPanel.ContextContent>
  <controls:AgentPanel.MessageTemplate><DataTemplate>
   <controls:AgentMessageView Role="{Binding Role}" Body="{Binding Content}" TimestampLabel="{Binding TimestampLabel}" IsUser="{Binding IsUser}" IsTool="{Binding IsTool}" Status="{Binding Status}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" IsAwaitingApproval="{Binding IsAwaitingApproval}" IsError="{Binding IsError}" ModelIdentity="{Binding ModelIdentity}" Elapsed="{Binding Elapsed}" RecoveryPrompt="{Binding RecoveryPrompt}" RestoreDraftCommand="{Binding DataContext.RestoreDraftCommand, RelativeSource={RelativeSource AncestorType=controls:AgentPanel}}">
    <controls:AgentMessageView.ActionsContent>
     <ItemsControl ItemsSource="{Binding SqlBlocks}"><ItemsControl.ItemTemplate><DataTemplate>
      <controls:AgentCodeSuggestion Code="{Binding Sql}" Caption="{loc:Loc PostgreSqlAssistantSuggestion}"
       InsertText="{loc:Loc PostgreSqlAssistantInsert}" ExecuteText="{loc:Loc PostgreSqlAssistantExecute}" CommandParameter="{Binding}"
       InsertCommand="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=controls:AgentPanel}}"
       ExecuteCommand="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=controls:AgentPanel}}" />
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </controls:AgentMessageView.ActionsContent>
   </controls:AgentMessageView>
  </DataTemplate></controls:AgentPanel.MessageTemplate>
  <controls:AgentPanel.ComposerOptions><controls:SegmentedSelector ItemsSource="{Binding ExecutionModes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ExecutionMode, Mode=TwoWay}" IsEnabled="{Binding CanChangeExecutionMode}" MaxWidth="200" HorizontalAlignment="Left" ToolTip="{loc:Loc SqlAgentModeHint}" AutomationProperties.Name="{loc:Loc SqlAgentExecutionMode}" /></controls:AgentPanel.ComposerOptions>
 </controls:AgentPanel>
</UserControl>
