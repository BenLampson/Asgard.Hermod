<UserControl x:Class="Asgard.Hermod.PostgreSql.UI.Views.PostgreSqlTabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 PreviewKeyDown="OnKeyDown" SizeChanged="OnObjectSizeChanged">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/WorkspaceSelectionStyles.xaml" /><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="HistoryItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <!-- 按设计字体的自然字距排版；普通元数据名称不套用 SQL 等宽字体。 -->
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /></Style>
  <Style x:Key="StructureHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceResultGridHeader}"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="12,0" /><Setter Property="Height" Value="36" /></Style>
  <Style x:Key="StructureValue" TargetType="TextBlock"><Setter Property="Margin" Value="12,0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /><Setter Property="ToolTip" Value="{Binding Detail}" /></Style>
  <Style x:Key="StructureName" TargetType="TextBlock" BasedOn="{StaticResource StructureValue}"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /><Setter Property="FontSize" Value="13" /><Setter Property="ToolTip" Value="{Binding Name}" /></Style>
   </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
 <Grid x:Name="ObjectContent" Margin="0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsQuery}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel>
   <controls:DatabaseObjectHeader x:Name="ObjectContext" />
   <Border Height="34" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,0"><controls:SectionSelector x:Name="ObjectSectionSelector" BorderThickness="0" Height="34" ItemContainerStyle="{StaticResource DatabaseObjectSectionTab}" ItemsSource="{Binding ObjectSections}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ObjectSection, Mode=TwoWay}" /></Border>
   <Grid x:Name="ObjectToolbar" Height="52" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Button x:Name="ShowFilter" Command="{Binding ShowFilterCommand}" Margin="0,0,10,0" VerticalAlignment="Center"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DatabaseObjectButton}"><Setter Property="Visibility" Value="{Binding ShowTableControls, Converter={StaticResource Visible}}" /><Style.Triggers><DataTrigger Binding="{Binding IsFilterOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="list-filter" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" /><TextBlock Text="{loc:Loc DatabaseObjectFilter}" /></StackPanel></Button>
    <Button x:Name="RefreshTable" Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource DatabaseObjectButton}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><controls:IconView Kind="refresh-cw" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding ObjectRefreshLabel}" /></StackPanel></Button>
    <Button x:Name="ExportPage" Grid.Column="3" Click="OnExportObject" IsEnabled="{Binding CanExportObject}" Style="{StaticResource DatabaseObjectButton}" VerticalAlignment="Center" Visibility="{Binding IsDataObjectSection, Converter={StaticResource Visible}}" ToolTip="{loc:Loc DatabaseObjectExportHint}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="download" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="{loc:Loc DatabaseObjectExportPage}" /></StackPanel></Button>
    <Button x:Name="CopyObjectName" Grid.Column="3" Click="OnCopyObjectName" VerticalAlignment="Center"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DatabaseObjectButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsDataObjectSection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="copy" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="{Binding ObjectCopyNameLabel}" /></StackPanel></Button>
   </Grid>
   <Grid x:Name="FilterToolbar" Margin="20,0,20,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowTableControls}" Value="True" /><Condition Binding="{Binding IsFilterOpen}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid><TextBox x:Name="FilterInput" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" Height="32" MinHeight="32" FontFamily="{DynamicResource MonoFont}" FontSize="12" ToolTip="{loc:Loc PostgreSqlWhereHint}" AutomationProperties.Name="{loc:Loc PostgreSqlWhereCondition}" />
     <TextBlock Text="{loc:Loc PostgreSqlWhereCondition}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilterText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button Grid.Column="1" Content="{loc:Loc PostgreSqlApplyFilter}" Command="{Binding ApplyFilterCommand}" Margin="8,0" ToolTip="{loc:Loc PostgreSqlWhereHint}" />
    <Button Grid.Column="2" Content="{loc:Loc PostgreSqlRemoveFilter}" Command="{Binding ClearFilterCommand}" />
   </Grid>
  </StackPanel>
  <Border x:Name="InlineError" Grid.Row="1" Background="{DynamicResource DangerWeakBrush}" Padding="12,9" Margin="0,0,0,10" CornerRadius="5">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="{Binding HasError, Converter={StaticResource Visible}}" /><Style.Triggers><DataTrigger Binding="{Binding (controls:WorkspaceConnectionScope.State).HasError, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
   <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
  </Border>
  <Grid Grid.Row="2">
   <Grid x:Name="DataPanel" Margin="20,0" SizeChanged="OnDataSizeChanged"><Grid.RowDefinitions><RowDefinition x:Name="EditorRow" Height="210" /><RowDefinition x:Name="EditorSplitterRow" Height="6" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource LineSoftBrush}" ShowsPreview="True" Visibility="{Binding IsQuery, Converter={StaticResource Visible}}" />
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

     <ContentControl x:Name="GridHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
     <TextBlock Grid.Row="1" Text="{loc:Loc PostgreSqlNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Expander Grid.Row="3" Header="{loc:Loc PostgreSqlMessages}" Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" Margin="0,8,0,0"><TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="100" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" /></Expander>
   </Grid>
   <Grid x:Name="StructurePanel" Margin="20,0" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,8,0,16"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsDefinitionSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
     <controls:SegmentedSelector x:Name="StructureSections" ItemsSource="{Binding MetadataSections}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding StructureSection, Mode=TwoWay}" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc PostgreSqlStructure}" />
    </ScrollViewer>
    <controls:DatabaseColumnReader Grid.Row="1" x:Name="ColumnReader" Rows="{Binding ColumnRows}" Visibility="{Binding IsColumnsSection, Converter={StaticResource Visible}}" />
    <DataGrid Grid.Row="1" x:Name="StructureGrid" ItemsSource="{Binding StructureRows}" ColumnHeaderStyle="{StaticResource StructureHeader}" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="40" ColumnHeaderHeight="36" GridLinesVisibility="Horizontal" CanUserResizeRows="False" SelectionUnit="FullRow" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{loc:Loc PostgreSqlStructure}">
     <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource WorkspaceResultGrid}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsDefinitionSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsColumnsSection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DataGrid.Style>
     <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc PostgreSqlObjectName}" Binding="{Binding Name}" Width="240" MinWidth="160" ElementStyle="{StaticResource StructureName}" /><DataGridTextColumn Header="{loc:Loc PostgreSqlObjectDetails}" Binding="{Binding Detail}" Width="*" MinWidth="240" ElementStyle="{StaticResource StructureValue}" /></DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="1" Text="{loc:Loc PostgreSqlNoStructureItems}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding IsEmptyStructure, Converter={StaticResource Visible}}" />
    <controls:CodeEditor Grid.Row="1" x:Name="DefinitionEditor" Text="{Binding Definition, Mode=OneWay}" IsReadOnly="True" Visibility="{Binding IsDefinitionSelected, Converter={StaticResource Visible}}" AutomationProperties.Name="{loc:Loc PostgreSqlObjectDefinition}" />
   </Grid>
  </Grid>
  <!-- 分页和草稿操作始终共用一行；窄窗口只截断状态文字，不挤压操作按钮。 -->
  <Grid Grid.Row="3" x:Name="DataActions" Margin="20,0" Height="40" AutomationProperties.HelpText="{Binding EditHint}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="-20,0,-20,0" IsHitTestVisible="False" />
   <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="FooterStatus" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" ToolTip="{Binding Status}">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{Binding EditHint}" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsQuery}" Value="False"><Setter Property="Text" Value="{Binding ObjectFooterText}" /></DataTrigger><DataTrigger Binding="{Binding HasDataDraft}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <Border Grid.Column="1" Background="Transparent" ToolTip="{Binding EditHint}" Visibility="{Binding HasDataRows, Converter={StaticResource Visible}}" AutomationProperties.HelpText="{Binding EditHint}"><controls:IconView Kind="info" AutomationProperties.Name="{Binding EditHint}" ToolTip="{Binding EditHint}" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Border>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding ShowTableControls, Converter={StaticResource Visible}}">
     <TextBlock x:Name="RowsPerPageLabel" Text="{loc:Loc PostgreSqlRowsPerPage}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
     <ComboBox x:Name="PageSizeSelector" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=OneWay}" SelectionChanged="OnPageSizeChanged" Width="80" Height="32" MinHeight="32" AutomationProperties.Name="{loc:Loc PostgreSqlRowsPerPage}" ToolTip="{Binding PageSize, StringFormat={loc:Loc PostgreSqlRowsPerPageHint}}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" x:Name="PageButtons">
     <Button x:Name="PreviousPage" Command="{Binding PreviousCommand}" Style="{StaticResource DatabaseObjectIconButton}" ToolTip="{loc:Loc PostgreSqlPrevious}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc PostgreSqlPrevious}" Margin="0,0,6,0"><controls:IconView Kind="chevron-left" Width="16" Height="16" /></Button>
     <Button x:Name="NextPage" Command="{Binding NextCommand}" Style="{StaticResource DatabaseObjectIconButton}" ToolTip="{loc:Loc PostgreSqlNext}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc PostgreSqlNext}"><controls:IconView Kind="chevron-right" Width="16" Height="16" /></Button>
     <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="12,0" VerticalAlignment="Center" Visibility="{Binding CanEditRows, Converter={StaticResource Visible}}" />
    </StackPanel>
    <StackPanel x:Name="EditActions" Orientation="Horizontal" Visibility="{Binding CanEditRows, Converter={StaticResource Visible}}">
    <Button x:Name="RevertChanges" Command="{Binding RevertCommand}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DatabaseObjectButton}"><Style.Triggers><DataTrigger Binding="{Binding OutcomeUnknown}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="undo-2" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="{loc:Loc DatabaseObjectUndoChanges}" /></StackPanel></Button>
    <Button x:Name="SaveChanges" Command="{Binding SaveChangesCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DatabaseObjectPrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding OutcomeUnknown}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="check" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="{loc:Loc DatabaseObjectSaveChanges}" /></StackPanel></Button>
    <Button x:Name="VerifyRows" Content="{loc:Loc PostgreSqlVerifyRows}" Command="{Binding VerifyCommand}" Margin="8,0,0,0" Visibility="{Binding OutcomeUnknown, Converter={StaticResource Visible}}" />
    </StackPanel>
   </StackPanel>
  </Grid>
  <Grid x:Name="StructureActions" Grid.Row="3" Height="40" Margin="20,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ObjectFooterText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Command="{Binding ShowDefinitionCommand}" VerticalAlignment="Center"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DatabaseObjectButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDefinitionSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="file-code" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="{loc:Loc DatabaseObjectViewDdl}" /></StackPanel></Button></Grid>

 </Grid>
 <controls:DatabaseSqlWorkspace x:Name="SqlWorkspace" SupportsActualAnalysis="False" Visibility="{Binding IsQuery, Converter={StaticResource Visible}}" RunRequested="OnRun" RunAllRequested="OnRunAll" ExplainRequested="OnExplain" TargetChanged="OnSqlTargetChanged" CopyRequested="OnCopySqlOutput" ExportRequested="OnExportSqlOutput" />
 </Grid>
</UserControl>
