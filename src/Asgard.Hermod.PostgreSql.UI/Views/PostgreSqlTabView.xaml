<UserControl x:Class="Asgard.Hermod.PostgreSql.UI.Views.PostgreSqlTabView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 PreviewKeyDown="OnKeyDown">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/WorkspaceSelectionStyles.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="HistoryItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <!-- 按设计字体的自然字距排版；普通元数据名称不套用 SQL 等宽字体。 -->
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /></Style>
  <Style x:Key="StructureHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceResultGridHeader}"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="12,0" /><Setter Property="Height" Value="36" /></Style>
  <Style x:Key="StructureValue" TargetType="TextBlock"><Setter Property="Margin" Value="12,0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /><Setter Property="ToolTip" Value="{Binding Detail}" /></Style>
  <Style x:Key="StructureName" TargetType="TextBlock" BasedOn="{StaticResource StructureValue}"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /><Setter Property="FontSize" Value="13" /><Setter Property="ToolTip" Value="{Binding Name}" /></Style>
   </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel>
   <Grid x:Name="ObjectContext" Margin="0,0,0,14" ToolTip="{Binding Header}" AutomationProperties.Name="{Binding Header}">
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsQuery}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <controls:IconView Grid.RowSpan="2" Kind="{Binding Icon}" Width="23" Height="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <Grid Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <TextBlock Text="{loc:Loc PostgreSqlDatabaseSchema}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
     <TextBlock Grid.Column="1" Text="{Binding DatabaseContext}" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
   </Grid>
   <WrapPanel x:Name="QueryToolbar" Visibility="{Binding IsQuery, Converter={StaticResource Visible}}" Margin="0,0,0,4">
    <StackPanel Orientation="Horizontal" Margin="0,0,12,6"><TextBlock Text="{loc:Loc PostgreSqlExecutionDatabase}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
     <Grid Width="180">     <ComboBox x:Name="DatabaseSelector" Width="180" Height="32" MinHeight="32" Visibility="{Binding HasMultipleDatabases, Converter={StaticResource Visible}}" ItemsSource="{Binding Databases}" SelectedItem="{Binding Database, Mode=OneWay}" IsEditable="False" Text="{Binding Database, Mode=OneWay}" SelectionChanged="OnDatabaseChanged" PreviewKeyDown="OnDatabaseKeyDown" AutomationProperties.Name="{loc:Loc PostgreSqlExecutionDatabase}" /><TextBlock Text="{loc:Loc DatabaseSessionChooseTarget}" Margin="10,0,28,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Database}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <TextBlock Text="{Binding Database}" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="{Binding HasSingleDatabase, Converter={StaticResource Visible}}" />
    </StackPanel>
    <Button x:Name="RunCurrent" Content="{loc:Loc PostgreSqlRunCurrentButton}" IsEnabled="{Binding CanRun}" Style="{StaticResource PrimaryButton}" Click="OnRun" ToolTip="{loc:Loc PostgreSqlRunCurrentHint}" AutomationProperties.Name="{loc:Loc PostgreSqlRunCurrentHint}" Margin="0,0,8,6" />
    <Button x:Name="RunAll" Content="{loc:Loc PostgreSqlRunAllButton}" IsEnabled="{Binding CanRun}" Click="OnRunAll" ToolTip="{loc:Loc PostgreSqlRunAllHint}" AutomationProperties.Name="{loc:Loc PostgreSqlRunAllHint}" Margin="0,0,8,6" />
    <Button x:Name="ExplainQuery" Content="{loc:Loc PostgreSqlExplain}" IsEnabled="{Binding CanRun}" Click="OnExplain" ToolTip="{loc:Loc PostgreSqlExplainHint}" AutomationProperties.Name="{loc:Loc PostgreSqlExplainHint}" Margin="0,0,8,6" />
    <Button Content="{loc:Loc PostgreSqlCancelQuery}" Command="{Binding CancelCommand}" Margin="0,0,8,6" />
    <Button Content="{loc:Loc PostgreSqlSaveQuery}" Command="{Binding SaveDocumentCommand}" Margin="0,0,0,6" />
   </WrapPanel>
   <Grid x:Name="ObjectToolbar" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="ShowFilter" Content="{loc:Loc PostgreSqlShowFilter}" Command="{Binding ShowFilterCommand}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="{Binding ShowTableControls, Converter={StaticResource Visible}}" /><Style.Triggers><DataTrigger Binding="{Binding IsFilterOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button x:Name="RefreshTable" Content="{loc:Loc PostgreSqlRefresh}" Command="{Binding RefreshCommand}" />
    </StackPanel>
    <controls:SectionSelector BorderThickness="0" ItemContainerStyle="{StaticResource WorkspaceSectionItem}" ItemsSource="{Binding Sections}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Section, Mode=TwoWay}" />
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsQuery}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsMetadataOnly}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
   </Grid>
   <Grid x:Name="FilterToolbar" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowTableControls}" Value="True" /><Condition Binding="{Binding IsFilterOpen}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
    <Grid><TextBox x:Name="FilterInput" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" Height="32" MinHeight="32" FontFamily="{DynamicResource MonoFont}" FontSize="12" ToolTip="{loc:Loc PostgreSqlWhereHint}" AutomationProperties.Name="{loc:Loc PostgreSqlWhereCondition}" />
     <TextBlock Text="{loc:Loc PostgreSqlWhereCondition}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="11,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding FilterText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button Grid.Column="1" Content="{loc:Loc PostgreSqlApplyFilter}" Command="{Binding ApplyFilterCommand}" Margin="8,0" ToolTip="{loc:Loc PostgreSqlWhereHint}" />
    <Button Grid.Column="2" Content="{loc:Loc PostgreSqlRemoveFilter}" Command="{Binding ClearFilterCommand}" />
   </Grid>
  </StackPanel>
  <Border x:Name="InlineError" Grid.Row="1" Background="{DynamicResource DangerWeakBrush}" Padding="12,9" Margin="0,0,0,10" CornerRadius="5">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="{Binding HasError, Converter={StaticResource Visible}}" /><Style.Triggers><DataTrigger Binding="{Binding (controls:WorkspaceConnectionScope.State).HasError, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
   <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
  </Border>
  <Grid Grid.Row="2">
   <Grid x:Name="DataPanel" SizeChanged="OnDataSizeChanged"><Grid.RowDefinitions><RowDefinition x:Name="EditorRow" Height="210" /><RowDefinition x:Name="EditorSplitterRow" Height="6" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <controls:CodeEditor x:Name="SqlEditor" Text="{Binding Sql, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CompletionProvider="{Binding}" IsReadOnly="False" MinHeight="80" MaxLength="10485760" Visibility="{Binding IsQuery, Converter={StaticResource Visible}}" AutomationProperties.Name="{loc:Loc PostgreSqlSqlEditor}" AutomationProperties.HelpText="{loc:Loc PostgreSqlCompletionHint}" ToolTip="{loc:Loc PostgreSqlCompletionHint}" />
    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource LineSoftBrush}" ShowsPreview="True" Visibility="{Binding IsQuery, Converter={StaticResource Visible}}" />
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedResult.Summary}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><controls:SectionSelector BorderThickness="0" ItemContainerStyle="{StaticResource WorkspaceSectionItem}" ItemsSource="{Binding Results}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" Visibility="{Binding IsQuery, Converter={StaticResource Visible}}" /></DockPanel>
     <ContentControl x:Name="GridHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
     <TextBlock Grid.Row="1" Text="{loc:Loc PostgreSqlNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasResult}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Expander Grid.Row="3" Header="{loc:Loc PostgreSqlMessages}" Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" Margin="0,8,0,0"><TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="100" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" /></Expander>
    <Expander Grid.Row="4" IsExpanded="{Binding IsHistoryOpen, Mode=TwoWay}" Header="{loc:Loc PostgreSqlExecutionTrace}" Visibility="{Binding IsQuery, Converter={StaticResource Visible}}" Margin="0,6,0,0" ToolTip="{loc:Loc PostgreSqlExecutionTraceHint}">
     <Grid Height="180" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
      <ListBox ItemContainerStyle="{StaticResource HistoryItem}" ItemsSource="{Binding ExecutionTraces}" SelectedItem="{Binding SelectedTrace, Mode=TwoWay}" DisplayMemberPath="Summary" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc PostgreSqlExecutionTrace}" />
      <Grid Grid.Column="1" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
       <controls:CodeEditor Text="{Binding SelectedTrace.Sql, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{loc:Loc PostgreSqlTraceSql}" />
       <controls:CodeEditor Grid.Row="1" Text="{Binding SelectedTrace.Detail, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0" AutomationProperties.Name="{loc:Loc PostgreSqlTraceDetails}" />
      </Grid>
     </Grid>
    </Expander>
   </Grid>
   <Grid x:Name="StructurePanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,12">
     <controls:SegmentedSelector x:Name="StructureSections" ItemsSource="{Binding StructureSections}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding StructureSection, Mode=TwoWay}" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc PostgreSqlStructure}" />
    </ScrollViewer>
    <DataGrid Grid.Row="1" x:Name="StructureGrid" ItemsSource="{Binding StructureRows}" ColumnHeaderStyle="{StaticResource StructureHeader}" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="40" ColumnHeaderHeight="36" GridLinesVisibility="Horizontal" CanUserResizeRows="False" SelectionUnit="FullRow" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{loc:Loc PostgreSqlStructure}">
     <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource WorkspaceResultGrid}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsDefinitionSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DataGrid.Style>
     <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc PostgreSqlObjectName}" Binding="{Binding Name}" Width="240" MinWidth="160" ElementStyle="{StaticResource StructureName}" /><DataGridTextColumn Header="{loc:Loc PostgreSqlObjectDetails}" Binding="{Binding Detail}" Width="*" MinWidth="240" ElementStyle="{StaticResource StructureValue}" /></DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="1" Text="{loc:Loc PostgreSqlNoStructureItems}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding IsEmptyStructure, Converter={StaticResource Visible}}" />
    <controls:CodeEditor Grid.Row="1" x:Name="DefinitionEditor" Text="{Binding Definition, Mode=OneWay}" IsReadOnly="True" Visibility="{Binding IsDefinitionSelected, Converter={StaticResource Visible}}" AutomationProperties.Name="{loc:Loc PostgreSqlObjectDefinition}" />
   </Grid>
  </Grid>
  <!-- 分页和草稿操作始终共用一行；窄窗口只截断状态文字，不挤压操作按钮。 -->
  <Grid Grid.Row="3" x:Name="DataActions" Margin="0,12,0,0" MinHeight="32" AutomationProperties.HelpText="{Binding EditHint}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Grid VerticalAlignment="Center" Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="FooterStatus" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{Binding EditHint}" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsQuery}" Value="False"><Setter Property="Text" Value="{Binding Status}" /></DataTrigger><DataTrigger Binding="{Binding HasDataDraft}" Value="True"><Setter Property="Text" Value="{Binding DraftSummary}" /><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <Border Grid.Column="1" Background="Transparent" ToolTip="{Binding EditHint}" Visibility="{Binding HasDataRows, Converter={StaticResource Visible}}" AutomationProperties.HelpText="{Binding EditHint}"><controls:IconView Kind="info" AutomationProperties.Name="{Binding EditHint}" ToolTip="{Binding EditHint}" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Border>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding ShowTableControls, Converter={StaticResource Visible}}">
     <TextBlock Text="{loc:Loc PostgreSqlRowsPerPage}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
     <ComboBox x:Name="PageSizeSelector" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=OneWay}" SelectionChanged="OnPageSizeChanged" Width="80" Height="32" MinHeight="32" AutomationProperties.Name="{loc:Loc PostgreSqlRowsPerPage}" ToolTip="{Binding PageSize, StringFormat={loc:Loc PostgreSqlRowsPerPageHint}}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" x:Name="PageButtons">
     <Button x:Name="PreviousPage" Command="{Binding PreviousCommand}" Width="32" Padding="0" ToolTip="{loc:Loc PostgreSqlPrevious}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc PostgreSqlPrevious}" Margin="0,0,6,0"><controls:IconView Kind="arrow-left" Width="16" Height="16" /></Button>
     <Button x:Name="NextPage" Command="{Binding NextCommand}" Width="32" Padding="0" ToolTip="{loc:Loc PostgreSqlNext}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc PostgreSqlNext}"><controls:IconView Kind="arrow-right" Width="16" Height="16" /></Button>
     <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="12,0" VerticalAlignment="Center" Visibility="{Binding CanEditRows, Converter={StaticResource Visible}}" />
    </StackPanel>
    <StackPanel x:Name="EditActions" Orientation="Horizontal" Visibility="{Binding CanEditRows, Converter={StaticResource Visible}}">
    <Button x:Name="RevertChanges" Content="{loc:Loc PostgreSqlRevertChanges}" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
    <Button x:Name="SaveChanges" Content="{loc:Loc PostgreSqlSaveChanges}" Command="{Binding SaveChangesCommand}" Style="{StaticResource PrimaryButton}" />
    <Button x:Name="VerifyRows" Content="{loc:Loc PostgreSqlVerifyRows}" Command="{Binding VerifyCommand}" Margin="8,0,0,0" Visibility="{Binding OutcomeUnknown, Converter={StaticResource Visible}}" />
    </StackPanel>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
