<controls:HermodDialog x:Class="Asgard.Hermod.Redis.UI.Views.RedisEditDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 xmlns:views="clr-namespace:Asgard.Hermod.Redis.UI.Views" Title="{loc:Loc RedisEditValue}" Width="780" Height="700" MinWidth="560" MinHeight="520" ResizeMode="CanResize" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
 <controls:HermodDialog.FooterContent><controls:DialogActionBar><StackPanel Orientation="Horizontal">
  <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" IsCancel="True" Margin="0,0,10,0" />
  <Button x:Name="SaveButton" Content="{loc:Loc RedisSaveValue}" Style="{StaticResource PrimaryButton}" Click="OnSave" IsEnabled="{Binding CanSave}" />
 </StackPanel></controls:DialogActionBar></controls:HermodDialog.FooterContent>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <TextBlock Text="{Binding FullName}" FontFamily="{DynamicResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}" Margin="0,0,0,10" />
  <views:RedisKeyContentView Grid.Row="1" x:Name="Editor" IsEditorHost="True" />
 </Grid>
</controls:HermodDialog>
