<UserControl x:Class="Asgard.Hermod.Redis.UI.Views.RedisConnectionEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" Focusable="True">
 <StackPanel>
  <controls:FormField Label="{loc:Loc InstanceName}" IsRequired="True" Error="{Binding Wizard.NameError}" Margin="0,0,0,16">
   <TextBox x:Name="NameInput" Text="{Binding Wizard.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" AutomationProperties.Name="{loc:Loc InstanceName}" />
  </controls:FormField>
  <controls:SegmentedSelector ItemsSource="{Binding Panes}" DisplayMemberPath="Name" SelectedValuePath="Id"
   SelectedValue="{Binding Pane, Mode=TwoWay}" Margin="0,0,0,18" AutomationProperties.Name="{loc:Loc RedisConnectionInformation}" />
  <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate>
   <controls:InstanceConfigurationFieldEditor Margin="0,0,0,14" />
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
