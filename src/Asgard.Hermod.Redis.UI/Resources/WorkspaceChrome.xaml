<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 只收敛 Redis 内部导航；保持全局主题语义色与其他模块模板不变。 -->
 <Style x:Key="RedisChoiceItem" TargetType="ListBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Padding" Value="12,0" />
  <Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0,2,4,2" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Choice" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource LineSoftBrush}" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="RedisSectionItem" TargetType="ListBoxItem" BasedOn="{StaticResource RedisChoiceItem}">
  <Setter Property="FontSize" Value="12" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Choice" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
     <ContentPresenter.Resources><Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
     </Style></ContentPresenter.Resources>
    </ContentPresenter>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource LineSoftBrush}" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource LineSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
