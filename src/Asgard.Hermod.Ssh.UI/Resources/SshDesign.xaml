<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
 <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SshBackgroundColor}" />
 <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource SshBackgroundColor}" />
 <SolidColorBrush x:Key="SshRailBrush" Color="{DynamicResource SshSoftColor}" />
 <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource SshLineColor}" />
 <SolidColorBrush x:Key="LineSoftBrush" Color="{DynamicResource SshLineColor}" />
 <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource SshInkColor}" />
 <SolidColorBrush x:Key="TextBodyBrush" Color="{DynamicResource SshInkColor}" />
 <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource SshMutedColor}" />
 <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SshAccentColor}" />
 <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource SshAccentColor}" />
 <SolidColorBrush x:Key="AccentWeakBrush" Color="{DynamicResource SshSelectedColor}" />
 <SolidColorBrush x:Key="WorkspaceCaptionBrush" Color="{DynamicResource SshCaptionColor}" />
 <SolidColorBrush x:Key="WorkspaceLineBrush" Color="{DynamicResource SshLineColor}" />
 <SolidColorBrush x:Key="WorkspaceInkBrush" Color="{DynamicResource SshInkColor}" />
 <SolidColorBrush x:Key="WorkspaceMutedBrush" Color="{DynamicResource SshMutedColor}" />
 <Style x:Key="SshLogButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Padding" Value="8,0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource ButtonContentText}" /></ContentPresenter.Resources></ContentPresenter></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="SshConsoleTab" TargetType="ListBoxItem"><Setter Property="Width" Value="160" /><Setter Property="Height" Value="38" /><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource TabKeyboardFocusVisual}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="12,0"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="SshRailButton" TargetType="RadioButton"><Setter Property="Height" Value="54" /><Setter Property="Width" Value="44" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource TabKeyboardFocusVisual}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Rail" Background="Transparent" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
