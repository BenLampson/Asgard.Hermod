<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshDockerResourcesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:charts="clr-namespace:Asgard.Hermod.Ssh.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,8">
  <TextBlock Text="{Binding SectionError}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{loc:Loc SshMonitorCpu}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding ContainerCpu}" FontSize="20" FontWeight="SemiBold" Margin="0,6" /><TextBlock Text="{loc:Loc DockerCpuHint}" Style="{StaticResource MonitorHint}" TextWrapping="Wrap" /><charts:SshMonitorChart Height="100" Margin="0,10,0,0" Points="{Binding ContainerCpuPoints}" Maximum="{Binding ContainerCpuMaximum}" AutomationProperties.Name="{loc:Loc DockerCpuTrend}" /></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc DockerMemory}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding ContainerMemory}" FontSize="16" FontWeight="SemiBold" Margin="0,6" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc DockerMemoryTrend}" Style="{StaticResource MonitorHint}" /><charts:SshMonitorChart Height="100" Margin="0,10,0,0" Points="{Binding ContainerMemoryPoints}" PrimaryBrush="{DynamicResource SuccessBrush}" AutomationProperties.Name="{loc:Loc DockerMemoryTrend}" /></StackPanel>
  </Grid>
  <UniformGrid Columns="3" Margin="0,12"><StackPanel><TextBlock Text="{loc:Loc DockerNetwork}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding SelectedContainer.NetworkRate}" FontSize="11" Margin="0,5" TextWrapping="Wrap" /></StackPanel><StackPanel><TextBlock Text="{loc:Loc DockerBlockIo}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding SelectedContainer.DiskRate}" FontSize="11" Margin="0,5" TextWrapping="Wrap" /></StackPanel><StackPanel><TextBlock Text="{loc:Loc DockerPids}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding SelectedContainer.Processes}" FontSize="11" Margin="0,5" /></StackPanel></UniformGrid>
  <DockPanel><Button DockPanel.Dock="Right" Command="{Binding RefreshDetailsCommand}" Content="{loc:Loc SshFilesRefresh}" Style="{StaticResource MonitorActionButton}" /><TextBlock Text="{Binding DetailUpdated}" Style="{StaticResource MonitorHint}" VerticalAlignment="Center" /></DockPanel>
 </StackPanel></ScrollViewer>
</UserControl>
