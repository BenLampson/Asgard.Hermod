<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshTransfersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /></ResourceDictionary></UserControl.Resources>
 <DockPanel Background="{DynamicResource SurfaceBrush}"><Border DockPanel.Dock="Bottom" Padding="16" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"><TextBlock Text="{loc:Loc SshTransferOwnership}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="18" LineStackingStrategy="BlockLineHeight" /></Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Transfers}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="16,14"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource DatabaseToolbarButton}" Content="{loc:Loc SshAgentStop}" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" /><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" /></DockPanel><DockPanel Margin="0,10,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding Direction}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /></DockPanel><ProgressBar Height="4" Margin="0,10,0,0" IsIndeterminate="True" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" /><TextBlock Text="{Binding Progress}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</UserControl>
