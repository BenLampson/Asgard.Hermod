<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshLogCaption" x:Name="CaptionRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 xmlns:views="clr-namespace:Asgard.Hermod.Ssh.UI.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /></ResourceDictionary></UserControl.Resources>
 <Border Height="48" Background="{DynamicResource WorkspaceCaptionBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,0,8,0">
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Click="OnAgent" Height="28" MinHeight="28" FontSize="12" Padding="8,0" Style="{StaticResource SshLogButton}" FontWeight="Normal" Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" ToolTip="{loc:Loc SshLogAiToggle}" AutomationProperties.Name="{loc:Loc SshLogAiToggle}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="sparkles" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseSessionAgent}" /></StackPanel>
     <Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc ChatLogAttachSnapshot}" Click="OnAttachSnapshot" /><MenuItem Header="{loc:Loc ChatLogAttachSelection}" Click="OnAttachSelection" /></ContextMenu></Button.ContextMenu>
    </Button>
    <Button Click="OnMinimize" Style="{StaticResource SshLogButton}" Padding="0" Foreground="{DynamicResource TextMutedBrush}" Width="32" Height="28" MinHeight="28" ToolTip="{loc:Loc Minimize}" AutomationProperties.Name="{loc:Loc Minimize}"><controls:IconView Kind="minus" Width="14" Height="14" /></Button>
    <Button Click="OnMaximize" Style="{StaticResource SshLogButton}" Padding="0" Foreground="{DynamicResource TextMutedBrush}" Width="32" Height="28" MinHeight="28" ToolTip="{loc:Loc Maximize}" AutomationProperties.Name="{loc:Loc Maximize}"><controls:IconView Kind="square" Width="14" Height="14" /></Button>
    <Button Click="OnClose" Style="{StaticResource SshLogButton}" Padding="0" Foreground="{DynamicResource TextMutedBrush}" Width="32" Height="28" MinHeight="28" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="14" Height="14" /></Button>
   </StackPanel>
   <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <controls:IconView Kind="file-text" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding Container.Name}" ToolTip="{Binding Container.Name}" FontSize="14" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    <TextBlock Grid.Column="2" Text="{loc:Loc SshMonitorLogs}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0" />
    <Button x:Name="SourceDetailsButton" Grid.Column="3" Click="OnSourceDetails" Height="28" MinHeight="28" FontSize="12" FontWeight="Normal" Padding="8,0" MaxWidth="300" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Style="{StaticResource SshLogButton}" ToolTip="{loc:Loc SshLogSourceDetails}" AutomationProperties.Name="{loc:Loc SshLogSourceDetails}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:IconView Kind="chevron-down" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></Grid></Button>
    <Popup x:Name="SourcePopup" PlacementTarget="{Binding ElementName=SourceDetailsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><views:SshLogSourceDetailsView DataContext="{Binding DataContext, ElementName=CaptionRoot}" /></Popup>
    <StackPanel x:Name="ReadAlert" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Height="28" Margin="10,0" Visibility="{Binding HasAlert, Converter={StaticResource Visible}}"><controls:IconView Kind="circle-alert" Width="14" Height="14" Foreground="{DynamicResource LogWarningBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding AlertText}" ToolTip="{Binding Status}" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource LogWarningBrush}" VerticalAlignment="Center" /><Button Command="{Binding RefreshCommand}" Visibility="{Binding CanRetry, Converter={StaticResource Visible}}" Height="28" MinHeight="28" FontSize="12" FontWeight="Normal" Padding="8,0" Style="{StaticResource SshLogButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{loc:Loc Retry}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="rotate-cw" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc Retry}" /></StackPanel></Button></StackPanel>
   </Grid>
  </DockPanel>
 </Border>
</UserControl>
