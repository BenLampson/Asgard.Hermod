<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshKubernetesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="20,16" MinHeight="640" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="180" /></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Button DockPanel.Dock="Right" Click="OnClose" Style="{StaticResource IconButton}" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="16" Height="16" /></Button>
   <StackPanel><TextBlock Text="{loc:Loc KubeTitle}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding Host}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" /><TextBlock Text="{Binding EnvironmentSummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <StackPanel Width="220" Margin="0,0,12,8"><TextBlock Text="{loc:Loc KubeContext}" Margin="0,0,0,6" /><ComboBox x:Name="ContextPicker" ItemsSource="{Binding Contexts}" SelectedItem="{Binding Context, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc KubeContext}" /></StackPanel>
   <StackPanel Width="180" Margin="0,0,12,8"><TextBlock Text="{loc:Loc KubeNamespace}" Margin="0,0,0,6" /><ComboBox x:Name="NamespacePicker" ItemsSource="{Binding Namespaces}" IsEditable="True" Text="{Binding Namespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc KubeNamespace}" /></StackPanel>
   <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="{loc:Loc KubeResource}" Margin="0,0,0,6" /><ComboBox x:Name="ResourcePicker" ItemsSource="{Binding ResourceChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Resource, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc KubeResource}" /></StackPanel>
   <Button Content="{loc:Loc KubeDetect}" Command="{Binding DetectCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8" />
   <Button Content="{loc:Loc SshFilesRefresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8" />
   <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,10"><ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource MonitorVisible}}" /><TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel>
  <Grid Grid.Row="3" MinHeight="90">
   <DataGrid x:Name="ResourceTable" Style="{StaticResource MonitorGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc KubeResource}">
    <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc Name}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc KubeNamespace}" Binding="{Binding Namespace}" Width="*" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc KubeStatus}" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource MonitorCellText}" /></DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="{loc:Loc KubeEmpty}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasNoItems, Converter={StaticResource MonitorVisible}}" />
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,12,0,10">
   <WrapPanel><Button Content="{loc:Loc KubeDescribe}" Command="{Binding ActionCommand}" CommandParameter="describe" Margin="0,0,8,8" /><Button Content="{loc:Loc DockerLogs}" Command="{Binding ActionCommand}" CommandParameter="logs" Margin="0,0,8,8" /><Button Content="{loc:Loc KubeRollout}" Command="{Binding ActionCommand}" CommandParameter="rollout" Margin="0,0,8,8" /><Button Content="{loc:Loc KubeRestart}" Command="{Binding ActionCommand}" CommandParameter="restart" Margin="0,0,8,8" /><Button Content="{loc:Loc SshMonitorCopyLogs}" Click="OnCopyOutput" Margin="0,0,8,8" /></WrapPanel>
   <TextBlock Text="{Binding ResultTarget}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="{Binding ExecutedCommand}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="11" />
  </StackPanel>
  <TextBox x:Name="ResultOutput" Grid.Row="5" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" FontSize="12" AutomationProperties.Name="{loc:Loc KubeOutput}" />
 </Grid></ScrollViewer>
</UserControl>
