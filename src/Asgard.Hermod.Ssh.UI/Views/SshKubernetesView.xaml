<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshKubernetesView" x:Name="KubeRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}" SizeChanged="OnViewportChanged" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="440" Height="{Binding ActualHeight, ElementName=KubeRoot}"><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="34" /><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="16,0"><DockPanel>
   <Button DockPanel.Dock="Right" Click="OnClose" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshCollapseToolbox}" AutomationProperties.Name="{loc:Loc SshCollapseToolbox}"><controls:IconView Kind="panel-left-close" Width="16" Height="16" /></Button>
   <TextBlock Text="{loc:Loc KubeWorkspaceTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
  </DockPanel></Border>
  <Border Grid.Row="1" Padding="16,6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SshRailBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
   <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Loc SshInitializeEnvironment}" Command="{Binding DetectCommand}" Style="{StaticResource MonitorActionButton}" /><TextBlock Text="{Binding EnvironmentSummary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnvironmentSummary}" VerticalAlignment="Center" /></DockPanel>
   <TextBlock Text="{Binding Status}" FontSize="10" Visibility="{Binding IsBusy, Converter={StaticResource MonitorVisible}}" AutomationProperties.LiveSetting="Polite" /><ProgressBar IsIndeterminate="True" Height="3" Margin="0,5,0,0" Visibility="{Binding IsBusy, Converter={StaticResource MonitorVisible}}" />
   <TextBlock Visibility="{Binding HasError, Converter={StaticResource MonitorVisible}}" Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <TextBlock Visibility="{Binding HasNamespaceWarning, Converter={StaticResource MonitorVisible}}" Text="{Binding NamespaceWarning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel></Border>
  <Expander x:Name="ScopeFilters" Grid.Row="2" IsExpanded="True" Header="{loc:Loc KubeScope}" Margin="16,4"><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{loc:Loc KubeContext}" FontSize="11" Margin="0,0,0,4" /><ComboBox x:Name="ContextPicker" ItemsSource="{Binding Contexts}" SelectedItem="{Binding Context, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc KubeContext}" /></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc KubeNamespace}" FontSize="11" Margin="0,0,0,4" /><ComboBox x:Name="NamespacePicker" ItemsSource="{Binding Namespaces}" IsEditable="True" Text="{Binding Namespace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc KubeNamespace}" /></StackPanel>
  </Grid></Expander>
  <ListBox x:Name="ResourcePicker" Grid.Row="3" ItemsSource="{Binding ResourceChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Resource, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineSoftBrush}" Background="{DynamicResource SurfaceBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc KubeResource}"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tab" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
  <DockPanel Grid.Row="4" Margin="16,3"><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshFilesRefresh}" AutomationProperties.Name="{loc:Loc SshFilesRefresh}"><controls:IconView Kind="refresh-cw" Width="14" Height="14" /></Button><Button DockPanel.Dock="Right" Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource MonitorActionButton}" Visibility="{Binding IsBusy, Converter={StaticResource MonitorVisible}}" /><Grid><TextBox x:Name="ResourceSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc KubeSearchResources}" AutomationProperties.Name="{loc:Loc KubeSearchResources}" Padding="8,3" /><TextBlock Text="{loc:Loc KubeSearchResources}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="9,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <Grid Grid.Row="5"><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="72" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="3*" MinHeight="48" /></Grid.RowDefinitions>
   <Grid><DataGrid x:Name="ResourceTable" Style="{StaticResource MonitorGrid}" ItemsSource="{Binding ItemView}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" RowHeight="42" AutomationProperties.Name="{loc:Loc KubeResource}">
    <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc Name}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc KubeReadyColumn}" Binding="{Binding Ready}" Width="60" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc KubeRestartsColumn}" Binding="{Binding Restarts}" Width="76" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc KubeNamespace}" Binding="{Binding Namespace}" Width="*" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorState}" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource MonitorCellText}" /></DataGrid.Columns>
   </DataGrid><TextBlock Text="{loc:Loc KubeEmpty}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding HasNoItems, Converter={StaticResource MonitorVisible}}" /></Grid>
   <WrapPanel Grid.Row="1" Margin="16,4"><Button Content="{loc:Loc KubeDescribe}" Command="{Binding ActionCommand}" CommandParameter="describe" Style="{StaticResource MonitorActionButton}" Margin="0,0,6,2" /><Button Content="{loc:Loc DockerLogs}" Command="{Binding ActionCommand}" CommandParameter="logs" Style="{StaticResource MonitorActionButton}" Margin="0,0,6,2" /><Button Visibility="{Binding IsDeploymentResource, Converter={StaticResource MonitorVisible}}" Content="{loc:Loc KubeRollout}" Command="{Binding ActionCommand}" CommandParameter="rollout" Style="{StaticResource MonitorActionButton}" Margin="0,0,6,2" /><Button Visibility="{Binding IsDeploymentResource, Converter={StaticResource MonitorVisible}}" Content="{loc:Loc KubeRestart}" Command="{Binding ActionCommand}" CommandParameter="restart" Style="{StaticResource MonitorActionButton}" /></WrapPanel>
   <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="16" ShowsPreview="True" Background="{DynamicResource LineSoftBrush}" AutomationProperties.Name="{loc:Loc SshResourceDetailsResize}" />
   <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="16,5"><StackPanel x:Name="OutputTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4"><RadioButton Content="{loc:Loc ManagementLogsTab}" IsChecked="{Binding IsLogOutput, Mode=OneWay}" Command="{Binding ActionCommand}" CommandParameter="logs" Style="{StaticResource ManagementTab}" /><RadioButton Content="{loc:Loc DockerDetails}" IsChecked="{Binding IsDetailsOutput, Mode=OneWay}" Command="{Binding ActionCommand}" CommandParameter="describe" Style="{StaticResource ManagementTab}" /><RadioButton Content="{loc:Loc KubeEventsTab}" IsChecked="{Binding IsEventsOutput, Mode=OneWay}" Command="{Binding ActionCommand}" CommandParameter="events" Style="{StaticResource ManagementTab}" /></StackPanel><DockPanel x:Name="OutputSearchTools" DockPanel.Dock="Bottom" Margin="0,4,0,0"><CheckBox x:Name="WrapOutput" DockPanel.Dock="Right" Content="{loc:Loc SshLogWrapToggle}" ToolTip="{loc:Loc SshLogWrap}" AutomationProperties.Name="{loc:Loc SshLogWrap}" VerticalAlignment="Center" Margin="8,0,0,0" /><TextBox x:Name="OutputSearch" MinHeight="28" Padding="8,3" TextChanged="OnOutputSearchChanged" ToolTip="{loc:Loc SshLogSearchHint}" AutomationProperties.Name="{loc:Loc SshLogSearchPlaceholder}" /></DockPanel><Button DockPanel.Dock="Right" Click="OnCopyOutput" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshMonitorCopyLogs}" AutomationProperties.Name="{loc:Loc SshMonitorCopyLogs}"><controls:IconView Kind="copy" Width="14" Height="14" /></Button><TextBlock Text="{Binding ResultTarget}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultTarget}" VerticalAlignment="Center" /></DockPanel>
    <TextBox x:Name="ResultOutput" Grid.Row="1" TextChanged="OnOutputSearchChanged" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" FontSize="11" BorderThickness="0" Padding="16,8" Background="{DynamicResource SshRailBrush}" AutomationProperties.Name="{loc:Loc KubeOutput}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="TextWrapping" Value="NoWrap" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=WrapOutput}" Value="True"><Setter Property="TextWrapping" Value="Wrap" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
    <StackPanel x:Name="AdvancedOutput" Grid.Row="2" Margin="16,2"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" /><Expander Header="{loc:Loc DockerAdvancedDetails}"><TextBox Text="{Binding ExecutedCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="10" /></Expander></StackPanel>
   </Grid>
  </Grid>
 </Grid></ScrollViewer>
</UserControl>
