<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshAssistantView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" PreviewKeyDown="OnPromptKeyDown">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
 <Border Background="{DynamicResource SurfaceBrush}" Padding="16">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12">
    <Button DockPanel.Dock="Right" Click="OnClose" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshAgentHide}" AutomationProperties.Name="{loc:Loc SshAgentHide}"><controls:IconView Kind="x" Width="15" Height="15" /></Button>
    <Button DockPanel.Dock="Right" Command="{Binding ClearCommand}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshAgentNewConversation}" AutomationProperties.Name="{loc:Loc SshAgentNewConversation}"><controls:IconView Kind="plus" Width="15" Height="15" /></Button>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:IconView Kind="sparkles" Foreground="{DynamicResource AccentBrush}" Width="17" Height="17" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc SshAgentTitle}" FontSize="14" FontWeight="SemiBold" /></StackPanel>
   </DockPanel>
   <StackPanel Grid.Row="1" Margin="0,0,0,14">
    <TextBlock Text="{Binding ContextLabel}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
    <Button Content="{loc:Loc SshAgentAttachSelection}" Click="OnAttachSelection" HorizontalAlignment="Left" Margin="0,8,0,4" />
    <CheckBox Content="{loc:Loc SshAgentIncludeSelection}" IsChecked="{Binding IncludeOutput}" />
   </StackPanel>
   <ScrollViewer x:Name="ConversationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource AppBackgroundBrush}" Padding="12" CornerRadius="6" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8" />
      <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" />
      <ItemsControl ItemsSource="{Binding Commands}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10,0,0">
       <TextBox Text="{Binding Command, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc SshAgentSuggestion}" />
       <WrapPanel Margin="0,8,0,0"><Button Content="{loc:Loc SshAgentInsert}" Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,4" /><Button Content="{loc:Loc SshAgentExecute}" Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,0,4" /></WrapPanel>
      </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Margin="0,8,0,8"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{loc:Loc SshAgentThinking}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
   <StackPanel Grid.Row="4"><TextBox x:Name="PromptEditor" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" MinHeight="80" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="16000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc SshAgentPrompt}" />
    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="{loc:Loc SshAgentSend}" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" /><Button DockPanel.Dock="Right" Content="{loc:Loc SshAgentStop}" Command="{Binding CancelCommand}" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc SshAgentSendHint}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></DockPanel>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
