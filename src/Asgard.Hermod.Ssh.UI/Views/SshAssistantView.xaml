<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshAssistantView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" PreviewKeyDown="OnPromptKeyDown">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
 <Border Background="{DynamicResource SurfaceBrush}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,0">
    <DockPanel x:Name="AgentHeader">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Command="{Binding ClearCommand}" Style="{StaticResource StandardButton}" Width="32" Height="32" Padding="0" ToolTip="{loc:Loc SshAgentNewConversation}" AutomationProperties.Name="{loc:Loc SshAgentNewConversation}" Margin="0,0,8,0"><controls:IconView Kind="plus" Width="15" Height="15" /></Button>
      <Button Click="OnClose" Style="{StaticResource StandardButton}" Width="32" Height="32" Padding="0" ToolTip="{loc:Loc SshAgentHide}" AutomationProperties.Name="{loc:Loc SshAgentHide}"><controls:IconView Kind="x" Width="15" Height="15" /></Button>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:IconView Kind="sparkles" Foreground="{DynamicResource AccentBrush}" Width="17" Height="17" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc SshAgentTitle}" FontSize="14" FontWeight="SemiBold" /></StackPanel>
    </DockPanel>
   </Border>
   <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
    <StackPanel>
     <TextBlock Text="{Binding ContextLabel}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
     <WrapPanel Margin="0,7,0,0"><Button Content="{loc:Loc SshAgentAttachSelection}" Click="OnAttachSelection" Margin="0,0,8,7" /><CheckBox IsChecked="{Binding IncludeOutput}" Margin="0,0,0,7" VerticalAlignment="Center" ToolTip="{loc:Loc SshAgentIncludeSelection}"><TextBlock Text="{loc:Loc SshAgentIncludeSelectionShort}" TextWrapping="Wrap" /></CheckBox></WrapPanel>
     <TextBlock Text="{loc:Loc SshAgentAutomationHint}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>
   </Border>
   <ScrollViewer x:Name="ConversationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,0">
    <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border CornerRadius="6" Margin="0,0,0,16"><Border.Style><Style TargetType="Border">
      <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
      <Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /><Setter Property="Padding" Value="12" /></DataTrigger>
       <DataTrigger Binding="{Binding IsTool}" Value="True"><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12" /></DataTrigger></Style.Triggers>
     </Style></Border.Style><StackPanel>
      <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8" />
      <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" MinHeight="0" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="13" MaxHeight="260" VerticalScrollBarVisibility="Auto" />
      <TextBlock Text="{Binding Status}" Visibility="{Binding IsTool, Converter={StaticResource Visible}}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite" />
      <ItemsControl ItemsSource="{Binding Commands}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6"><StackPanel>
        <TextBlock Text="{loc:Loc SshAgentSuggestion}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />
        <TextBox Text="{Binding Command, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" FontSize="12" IsReadOnly="True" MinHeight="0" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc SshAgentSuggestion}" />
        <WrapPanel Margin="0,12,0,0"><Button Content="{loc:Loc SshAgentInsert}" Command="{Binding DataContext.InsertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,4" /><Button Content="{loc:Loc SshAgentExecute}" Command="{Binding DataContext.ExecuteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,0,4" /></WrapPanel>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <StackPanel Grid.Row="3" Margin="18,8,18,8"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding Status}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel>
   <StackPanel Grid.Row="4" Margin="14,0,14,14">
    <Border x:Name="Composer" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
     <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid MinHeight="48">
       <TextBox x:Name="PromptEditor" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="16000" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="{loc:Loc SshAgentPrompt}" />
       <TextBlock Text="{loc:Loc SshAgentPrompt}" IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Prompt}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,8,0,0">
       <Button x:Name="SendAction" DockPanel.Dock="Right" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" ToolTip="{loc:Loc SshAgentSend}" AutomationProperties.Name="{loc:Loc SshAgentSend}" Width="34" Height="32" Padding="0"><controls:IconView Kind="arrow-right" Width="15" Height="15" RenderTransformOrigin="0.5,0.5"><controls:IconView.RenderTransform><RotateTransform Angle="-90" /></controls:IconView.RenderTransform></controls:IconView></Button>
       <Button DockPanel.Dock="Right" Content="{loc:Loc SshAgentStop}" Command="{Binding CancelCommand}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:IconView Kind="sparkles" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{loc:Loc SshAgentTitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
      </DockPanel>
     </Grid>
    </Border>
    <TextBlock Text="{loc:Loc SshAgentSendHint}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" />
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
