<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorDockerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:charts="clr-namespace:Asgard.Hermod.Ssh.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" SizeChanged="OnViewportChanged" Background="{DynamicResource SurfaceBrush}">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*" /><ColumnDefinition x:Name="DetailsColumn" Width="0" /></Grid.ColumnDefinitions>
  <Grid x:Name="ContainerList"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
   <DockPanel><TextBlock x:Name="DockerEnvironmentLabel" DockPanel.Dock="Right" Text="{Binding DockerEnvironmentSummary}" Style="{StaticResource MonitorHint}" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="400" /><UniformGrid Columns="4" MinHeight="68"><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorContainerCount}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding ContainerCount}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorRunning}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding RunningContainers}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource SuccessBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorStopped}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding StoppedContainers}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorUnhealthy}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding UnhealthyContainers}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource WarningBrush}" /></StackPanel></UniformGrid></DockPanel>
   <DockPanel x:Name="ContainerFilters" Grid.Row="1" Margin="0,4,0,8"><Button DockPanel.Dock="Right" Click="OnColumns" Content="{loc:Loc DockerColumns}" Style="{StaticResource MonitorActionButton}" Margin="10,0,0,0" /><ComboBox DockPanel.Dock="Right" Width="120" SelectedValuePath="Tag" SelectedValue="{Binding ContainerState, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc SshMonitorState}">
    <ComboBoxItem Tag="" Content="{loc:Loc SshMonitorAllStates}" /><ComboBoxItem Tag="running" Content="{loc:Loc SshMonitorRunning}" /><ComboBoxItem Tag="exited" Content="{loc:Loc SshMonitorExited}" />
   </ComboBox><Grid x:Name="ContainerSearch" Width="320" HorizontalAlignment="Left"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SshMonitorContainerSearch}" ToolTip="{loc:Loc SshMonitorContainerSearch}" Padding="28,4,8,4" /><controls:IconView Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" /><TextBlock Text="{loc:Loc SshMonitorContainerSearch}" Foreground="{DynamicResource TextMutedBrush}" Margin="29,0,8,0" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
   <DataGrid x:Name="ContainerGrid" Grid.Row="2" ItemsSource="{Binding ContainerView}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" Style="{StaticResource MonitorGrid}" RowHeight="54" AutomationProperties.Name="{loc:Loc SshMonitorDocker}">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="{loc:Loc DockerContainerImage}" SortMemberPath="Name" Width="2*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,0"><TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Image}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Image}" Margin="0,5,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{loc:Loc DockerStateHealth}" SortMemberPath="State" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8,0"><controls:StatusBadge Text="{Binding Status}" Tone="{Binding Tone}" ShowIndicator="False" HorizontalAlignment="Left" /><controls:StatusBadge Text="{Binding Health}" Tone="{Binding HealthTone}" ShowIndicator="False" HorizontalAlignment="Left" FontSize="10" Margin="0,2,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{loc:Loc SshMonitorCpu}" SortMemberPath="CpuPercent" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,0"><TextBlock Text="{Binding Cpu}" FontFamily="{DynamicResource MonoFont}" FontSize="11" /><ProgressBar Value="{Binding CpuBar, Mode=OneWay}" Style="{StaticResource MonitorBar}" Margin="0,7,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{loc:Loc DockerMemory}" SortMemberPath="MemoryBytes" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,0"><TextBlock Text="{Binding Memory}" FontFamily="{DynamicResource MonoFont}" FontSize="11" /><ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Style="{StaticResource MonitorBar}" Foreground="{DynamicResource SuccessBrush}" Margin="0,7,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{loc:Loc DockerNetwork}" Binding="{Binding NetworkRate}" SortMemberPath="ReceivedPerSecond" Width="190" ElementStyle="{StaticResource MonitorCellText}" />
     <DataGridTextColumn Header="{loc:Loc DockerBlockIo}" Binding="{Binding DiskRate}" SortMemberPath="ReadPerSecond" Width="190" ElementStyle="{StaticResource MonitorCellText}" />
     <DataGridTextColumn Header="{loc:Loc DockerPids}" Binding="{Binding Processes}" SortMemberPath="Resources.Processes" Width="75" ElementStyle="{StaticResource MonitorCellText}" />
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="3" Padding="0,8,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshMonitorLimit}" Visibility="{Binding ReachedLimit, Converter={StaticResource MonitorVisible}}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding ResultCount}" Style="{StaticResource MonitorHint}" /></DockPanel></Border>
  </Grid>
  <Border x:Name="ContainerDetailsDrawer" Grid.Column="1" Visibility="{Binding IsContainerPaneOpen, Converter={StaticResource MonitorVisible}}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="4" Margin="16,0,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel Margin="12,0"><Button DockPanel.Dock="Right" Command="{Binding CloseContainerDetailsCommand}" ToolTip="{Binding ContainerPaneCloseLabel}" AutomationProperties.Name="{Binding ContainerPaneCloseLabel}" Style="{StaticResource IconButton}"><controls:IconView Kind="x" Width="14" Height="14" /></Button><TextBlock Text="{Binding ContainerPaneTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContainerPaneTitle}" /></DockPanel>
    <ScrollViewer Grid.Row="1" Visibility="{Binding IsContainerDetailsOpen, Converter={StaticResource MonitorVisible}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="ContainerDetails" Margin="16,8,16,16">
      <TextBlock Text="{loc:Loc SshMonitorContainerName}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Name}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorContainerId}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Id}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="11" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorImage}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Image}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorState}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Status}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorHealth}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Health}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorPorts}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Ports}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="11" Margin="0,4,0,0" />
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Border>
  <Border x:Name="ContainerActionBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,5" MinHeight="40" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4" AutomationProperties.Name="{loc:Loc SshMonitorContainerActions}">
   <Grid x:Name="ActionBarLayout"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid x:Name="ContainerIdentity" VerticalAlignment="Center" Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <controls:IconView Kind="container" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" /><TextBlock Grid.Column="1" Text="{Binding SelectedContainerName}" FontSize="11" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedContainerName}" VerticalAlignment="Center" Margin="12,0" />
     <TextBlock Grid.Column="2" Text="{Binding SelectedContainerSummary}" Style="{StaticResource MonitorLabel}" ToolTip="{Binding SelectedContainer.Id}" VerticalAlignment="Center" />
    </Grid>
    <WrapPanel x:Name="ContainerActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="ViewContainerLogs" Command="{Binding ReadLogsCommand}" ToolTip="{loc:Loc SshLogOpenWindow}" AutomationProperties.Name="{loc:Loc SshMonitorViewLogs}" Style="{StaticResource CompactButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="file-text" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc SshMonitorViewLogs}" /></StackPanel></Button>
     <Button x:Name="ViewContainerDetails" Command="{Binding ViewContainerDetailsCommand}" AutomationProperties.Name="{loc:Loc SshMonitorViewDetails}" Style="{StaticResource CompactButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="info" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc SshMonitorViewDetails}" /></StackPanel></Button>
     <Button Command="{Binding StartContainerCommand}" Content="{loc:Loc DockerStart}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
     <Button Command="{Binding RestartContainerCommand}" Content="{loc:Loc DockerRestartShort}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
     <Button Command="{Binding StopContainerCommand}" Content="{loc:Loc DockerStopShort}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" />
     <Button Command="{Binding OpenDockerCommandsCommand}" Content="{loc:Loc DockerLibrary}" Style="{StaticResource CompactButton}" />
    </WrapPanel>
   </Grid>
  </Border>
  <Grid x:Name="ContainerTrendPanel" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Height="190"><Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <DockPanel Grid.ColumnSpan="3"><TextBlock DockPanel.Dock="Right" Text="{loc:Loc DockerRateHint}" Style="{StaticResource MonitorHint}" ToolTip="{loc:Loc DockerRateHint}" /><TextBlock Text="{Binding ContainerTrendTitle}" FontSize="12" FontWeight="SemiBold" /></DockPanel>
   <Border Grid.Row="1" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Loc DockerCpuHint}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding ContainerCpu}" Foreground="{DynamicResource AccentBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="14" FontWeight="SemiBold" /></DockPanel><charts:SshMonitorChart Grid.Row="1" Points="{Binding ContainerCpuPoints}" Maximum="{Binding ContainerCpuMaximum}" AutomationProperties.Name="{loc:Loc DockerCpuTrend}" /></Grid></Border>
   <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8"><Grid><Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="{Binding ContainerMemory}" Foreground="{DynamicResource SuccessBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="14" FontWeight="SemiBold" /><charts:SshMonitorChart Grid.Row="1" Points="{Binding ContainerMemoryPoints}" PrimaryBrush="{DynamicResource SuccessBrush}" AutomationProperties.Name="{loc:Loc DockerMemoryTrend}" /></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
