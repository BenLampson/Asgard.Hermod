<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorDockerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" SizeChanged="OnViewportChanged">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*" /><ColumnDefinition x:Name="LogsColumn" Width="0" /></Grid.ColumnDefinitions>
  <Grid x:Name="ContainerList"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
   <UniformGrid Columns="4" MinHeight="80"><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorContainerCount}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding ContainerCount}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorRunning}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding RunningContainers}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource SuccessBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorStopped}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding StoppedContainers}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorUnhealthy}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding UnhealthyContainers}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource WarningBrush}" /></StackPanel></UniformGrid>
   <DockPanel x:Name="ContainerFilters" Grid.Row="1" Margin="0,4,0,8"><ComboBox DockPanel.Dock="Right" Width="140" SelectedValuePath="Tag" SelectedValue="{Binding ContainerState, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc SshMonitorState}">
    <ComboBoxItem Tag="" Content="{loc:Loc SshMonitorAllStates}" /><ComboBoxItem Tag="running" Content="{loc:Loc SshMonitorRunning}" /><ComboBoxItem Tag="exited" Content="{loc:Loc SshMonitorExited}" />
   </ComboBox><Grid Width="320" HorizontalAlignment="Left"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SshMonitorContainerSearch}" ToolTip="{loc:Loc SshMonitorContainerSearch}" Padding="28,4,8,4" /><controls:IconView Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" /><TextBlock Text="{loc:Loc SshMonitorContainerSearch}" Foreground="{DynamicResource TextMutedBrush}" Margin="29,0,8,0" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
   <DataGrid x:Name="ContainerGrid" Grid.Row="2" ItemsSource="{Binding ContainerView}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" Style="{StaticResource MonitorGrid}" AutomationProperties.Name="{loc:Loc SshMonitorDocker}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{loc:Loc SshMonitorContainerName}" Binding="{Binding Name}" Width="1.1*" SortMemberPath="Name" ElementStyle="{StaticResource MonitorCellText}" />
     <DataGridTextColumn Header="{loc:Loc SshMonitorImage}" Binding="{Binding Image}" Width="1.3*" SortMemberPath="Image" ElementStyle="{StaticResource MonitorCellText}" />
     <DataGridTemplateColumn Header="{loc:Loc SshMonitorState}" SortMemberPath="State" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:StatusBadge Text="{Binding Status}" Tone="{Binding Tone}" ShowIndicator="False" HorizontalAlignment="Left" Margin="8,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{loc:Loc SshMonitorHealth}" SortMemberPath="Value.Health" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><controls:StatusBadge Text="{Binding Health}" Tone="{Binding HealthTone}" ShowIndicator="False" HorizontalAlignment="Left" Margin="8,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{loc:Loc SshMonitorPorts}" Binding="{Binding Ports}" Width="1.4*" SortMemberPath="Ports" ElementStyle="{StaticResource MonitorCellText}" />
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="3" Padding="0,8,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshMonitorLimit}" Visibility="{Binding ReachedLimit, Converter={StaticResource MonitorVisible}}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding ResultCount}" Style="{StaticResource MonitorHint}" /></DockPanel></Border>
  </Grid>
  <Border x:Name="LogDrawer" Grid.Column="1" Visibility="{Binding IsContainerPaneOpen, Converter={StaticResource MonitorVisible}}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="4" Margin="16,0,0,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel Margin="12,0"><Button DockPanel.Dock="Right" Command="{Binding CloseLogsCommand}" ToolTip="{Binding ContainerPaneCloseLabel}" AutomationProperties.Name="{Binding ContainerPaneCloseLabel}" Style="{StaticResource IconButton}"><controls:IconView Kind="x" Width="14" Height="14" /></Button><TextBlock Text="{Binding ContainerPaneTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContainerPaneTitle}" /></DockPanel>
    <Grid Grid.Row="1" Visibility="{Binding IsLogOpen, Converter={StaticResource MonitorVisible}}"><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel Margin="12,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="OnCopyLogs" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshMonitorCopyLogs}" AutomationProperties.Name="{loc:Loc SshMonitorCopyLogs}"><controls:IconView Kind="copy" Width="14" Height="14" /></Button><Button Command="{Binding ReadLogsCommand}" CommandParameter="{Binding SelectedContainer}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshFilesRefresh}" AutomationProperties.Name="{loc:Loc SshFilesRefresh}"><controls:IconView Kind="refresh-cw" Width="14" Height="14" /></Button></StackPanel><TextBlock Text="{loc:Loc SshMonitorLogScope}" Style="{StaticResource MonitorHint}" VerticalAlignment="Center" /></DockPanel>
     <TextBox x:Name="LogOutput" Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" FontSize="11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource TerminalSurfaceBrush}" Foreground="{DynamicResource TerminalTextBrush}" BorderThickness="0" Padding="12" AutomationProperties.Name="{loc:Loc SshMonitorLogs}" />
     <TextBlock Grid.Row="2" Text="{Binding LogStatus}" Style="{StaticResource MonitorHint}" TextWrapping="Wrap" Margin="12,8" AutomationProperties.LiveSetting="Polite" />
    </Grid>
    <ScrollViewer Grid.Row="1" Visibility="{Binding IsContainerDetailsOpen, Converter={StaticResource MonitorVisible}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="ContainerDetails" Margin="16,8,16,16">
      <TextBlock Text="{loc:Loc SshMonitorContainerName}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Name}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorContainerId}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Id}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="11" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorImage}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Image}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorState}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Status}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorHealth}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Health}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <TextBlock Text="{loc:Loc SshMonitorPorts}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding SelectedContainer.Ports}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="11" Margin="0,4,0,0" />
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Border>
  <Border x:Name="ContainerActionBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,5" MinHeight="40" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4" AutomationProperties.Name="{loc:Loc SshMonitorContainerActions}">
   <Grid x:Name="ActionBarLayout"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid x:Name="ContainerIdentity" VerticalAlignment="Center" Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <controls:IconView Kind="container" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" /><TextBlock Grid.Column="1" Text="{Binding SelectedContainerName}" FontSize="11" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedContainerName}" VerticalAlignment="Center" Margin="12,0" />
     <TextBlock Grid.Column="2" Text="{Binding SelectedContainerSummary}" Style="{StaticResource MonitorLabel}" ToolTip="{Binding SelectedContainer.Id}" VerticalAlignment="Center" />
    </Grid>
    <WrapPanel x:Name="ContainerActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="ViewContainerLogs" Command="{Binding ReadLogsCommand}" ToolTip="{loc:Loc SshMonitorLogScope}" AutomationProperties.Name="{loc:Loc SshMonitorViewLogs}" Style="{StaticResource CompactButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="file-text" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc SshMonitorViewLogs}" /></StackPanel></Button>
     <Button x:Name="ViewContainerDetails" Command="{Binding ViewContainerDetailsCommand}" AutomationProperties.Name="{loc:Loc SshMonitorViewDetails}" Style="{StaticResource CompactButton}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="info" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc SshMonitorViewDetails}" /></StackPanel></Button>
    </WrapPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
