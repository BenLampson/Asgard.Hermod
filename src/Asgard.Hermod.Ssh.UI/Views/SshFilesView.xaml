<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshFilesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
 <Grid Background="{DynamicResource SurfaceBrush}" Margin="16,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <DockPanel LastChildFill="True" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:Loc SshFilesUpload}" Command="{Binding UploadCommand}" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" /><Button Content="{loc:Loc SshFilesNewFolder}" Command="{Binding CreateDirectoryCommand}" Margin="8,0,0,0" /></StackPanel>
   <Button DockPanel.Dock="Left" Content="{loc:Loc SshFilesUp}" Command="{Binding ParentCommand}" Margin="0,0,8,0" /><Button DockPanel.Dock="Left" Content="{loc:Loc SshFilesRefresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
   <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SshFilesPath}" KeyDown="OnPathKeyDown" />
  </DockPanel>
  <StackPanel Grid.Row="1"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   <DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{loc:Loc SshFilesDownload}" Command="{Binding DownloadCommand}" Margin="8,0,0,0" /><Button Content="{loc:Loc SshFilesRename}" Command="{Binding RenameCommand}" Margin="8,0,0,0" /><Button Content="{loc:Loc SshFilesDelete}" Command="{Binding DeleteCommand}" Margin="8,0,0,0" /></StackPanel><TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" MaxWidth="280" HorizontalAlignment="Left" MinWidth="120" ToolTip="{loc:Loc SshFilesFilter}" AutomationProperties.Name="{loc:Loc SshFilesFilter}" /></DockPanel>
  </StackPanel>
  <DataGrid x:Name="FileList" Grid.Row="2" Style="{StaticResource WorkspaceDataGrid}" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MouseDoubleClick="OnOpenEntry" KeyDown="OnEntryKeyDown" HeadersVisibility="Column" RowHeight="38" AutomationProperties.Name="{loc:Loc SshFilesTitle}">
   <DataGrid.Columns><DataGridTemplateColumn Header="{loc:Loc SshFilesName}" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:IconView Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Kind" Value="file-code" /><Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Kind" Value="folder" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{loc:Loc SshFilesSize}" Binding="{Binding Length}" Width="100" /><DataGridTextColumn Header="{loc:Loc SshFilesPermissions}" Binding="{Binding Permissions}" Width="90" /><DataGridTextColumn Header="{loc:Loc SshFilesModified}" Binding="{Binding Modified}" Width="170" /></DataGrid.Columns>
  </DataGrid>
  <Expander Grid.Row="3" Header="{loc:Loc SshFilesTransfers}" IsExpanded="True" Margin="0,12,0,0"><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="{loc:Loc SshAgentStop}" Command="{Binding CancelCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
   <ItemsControl ItemsSource="{Binding Transfers}" MaxHeight="100"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" Margin="16,0,0,0" /><TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" Foreground="{DynamicResource TextMutedBrush}" Margin="16,0,0,0" /><TextBlock DockPanel.Dock="Left" Text="{Binding Direction}" Margin="0,0,12,0" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </DockPanel></Expander>
 </Grid>
</UserControl>
