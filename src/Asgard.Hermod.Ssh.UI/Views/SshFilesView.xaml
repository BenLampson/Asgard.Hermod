<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshFilesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="SshFileHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceColumnHeader}"><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="14,0" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="{DynamicResource SshRailBrush}" /></Style>
  <Style x:Key="SshFileCell" TargetType="DataGridCell" BasedOn="{StaticResource WorkspaceGridCell}"><Setter Property="Padding" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SshFileRow" TargetType="DataGridRow" BasedOn="{StaticResource WorkspaceGridRow}"><Setter Property="MinHeight" Value="32" /><Setter Property="Height" Value="32" /></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}"><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
  <DockPanel Margin="14,0"><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" Width="20" Height="28" Padding="0" ToolTip="{loc:Loc SshFilesRefresh}" AutomationProperties.Name="{loc:Loc SshFilesRefresh}"><controls:IconView Kind="refresh-cw" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Button><controls:IconView DockPanel.Dock="Left" Kind="folder" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource MonoFont}" FontSize="11" MinHeight="24" Height="24" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Loc SshFilesPath}" KeyDown="OnPathKeyDown" /></DockPanel>
  <Border Grid.Row="1" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="8,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Button Command="{Binding ParentCommand}" Style="{StaticResource DatabaseToolbarButton}" Width="28" Height="28" Padding="0" ToolTip="{loc:Loc SshFilesUp}" AutomationProperties.Name="{loc:Loc SshFilesUp}"><controls:IconView Kind="arrow-up" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Button>
   <Button Command="{Binding UploadCommand}" Style="{StaticResource DatabaseToolbarButton}" Width="28" Height="28" Padding="0" ToolTip="{loc:Loc SshFilesUpload}" AutomationProperties.Name="{loc:Loc SshFilesUpload}"><controls:IconView Kind="upload" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Button>
   <Button Command="{Binding DownloadCommand}" Style="{StaticResource DatabaseToolbarButton}" Width="28" Height="28" Padding="0" ToolTip="{loc:Loc SshFilesDownload}" AutomationProperties.Name="{loc:Loc SshFilesDownload}"><controls:IconView Kind="download" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Button>
   <Button Command="{Binding CreateDirectoryCommand}" Style="{StaticResource DatabaseToolbarButton}" Width="28" Height="28" Padding="0" ToolTip="{loc:Loc SshFilesNewFolder}" AutomationProperties.Name="{loc:Loc SshFilesNewFolder}"><controls:IconView Kind="folder-plus" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Button>
   <Button Command="{Binding RenameCommand}" Style="{StaticResource DatabaseToolbarButton}" Width="28" Height="28" Padding="0" ToolTip="{loc:Loc SshFilesRename}" AutomationProperties.Name="{loc:Loc SshFilesRename}"><controls:IconView Kind="pencil" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Button>
   <Button Command="{Binding DeleteCommand}" Style="{StaticResource DatabaseToolbarButton}" Width="28" Height="28" Padding="0" ToolTip="{loc:Loc SshFilesDelete}" AutomationProperties.Name="{loc:Loc SshFilesDelete}"><controls:IconView Kind="trash-2" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" /></Button>

  </StackPanel></Border>
  <DataGrid x:Name="FileList" Grid.Row="2" Style="{StaticResource WorkspaceDataGrid}" ColumnHeaderStyle="{StaticResource SshFileHeader}" CellStyle="{StaticResource SshFileCell}" RowStyle="{StaticResource SshFileRow}" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MouseDoubleClick="OnOpenEntry" KeyDown="OnEntryKeyDown" HeadersVisibility="Column" RowHeight="32" ColumnHeaderHeight="30" FontFamily="{DynamicResource UiFont}" FontSize="12" BorderThickness="0" Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}" HorizontalGridLinesBrush="{DynamicResource LineSoftBrush}" GridLinesVisibility="None" AutomationProperties.Name="{loc:Loc SshFilesTitle}">
   <DataGrid.Columns><DataGridTemplateColumn Header="{loc:Loc SshFilesName}" Width="*" MinWidth="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="14,0,0,0"><controls:IconView Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Kind" Value="file-code" /><Style.Triggers><DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter Property="Kind" Value="folder" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{loc:Loc SshFilesSize}" Binding="{Binding Length}" Width="72" /></DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="3" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="14,0"><TextBlock Text="{Binding PanelStatus}" ToolTip="{Binding Error}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" /></Border>
 </Grid>
</UserControl>
