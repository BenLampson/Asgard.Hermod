<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshContainerLogView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="PlainLogText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}" TextElement.Foreground="{DynamicResource TextBodyBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border Padding="24,16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="file-text" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" /><TextBlock Text="{Binding Container.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="460" /></StackPanel><TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" Margin="0,8,0,0" /></StackPanel>
    <Button Grid.Column="1" Command="{Binding ToggleAiCommand}" Style="{StaticResource StandardButton}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc SshLogAiToggle}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="sparkles" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc SshLogAiTitle}" /></StackPanel></Button>
   </Grid>
  </Border>
  <controls:WorkspaceSplitView x:Name="LogSplit" Grid.Row="1" IsPaneOpen="{Binding IsAiOpen, Mode=TwoWay}" PaneWidth="400">
   <controls:WorkspaceSplitView.MainContent>
    <Grid Margin="20,16,20,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
      <TextBlock Text="{loc:Loc SshLogRange}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="TailRange" Width="130" SelectedValuePath="Tag" SelectedValue="{Binding TailLines, Mode=TwoWay}" Margin="0,0,12,0" AutomationProperties.Name="{loc:Loc SshLogRange}" IsEnabled="{Binding IsConnected}">
       <ComboBoxItem><ComboBoxItem.Tag><system:Int32>100</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail100}" /></ComboBoxItem>
       <ComboBoxItem><ComboBoxItem.Tag><system:Int32>500</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail500}" /></ComboBoxItem>
       <ComboBoxItem><ComboBoxItem.Tag><system:Int32>1000</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail1000}" /></ComboBoxItem>
      </ComboBox>
      <Button Command="{Binding RefreshCommand}" Content="{loc:Loc SshFilesRefresh}" Margin="0,0,8,0" />
      <Button Command="{Binding CancelCommand}" Content="{loc:Loc SshAgentStop}" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
      <Button Click="OnCopy" Content="{loc:Loc SshMonitorCopyLogs}" Margin="0,0,8,0" />
      <Button Click="OnExport" Content="{loc:Loc SshLogExport}" Margin="0,0,12,0" />
      <CheckBox Content="{loc:Loc SshLogWrap}" IsChecked="{Binding WrapLines}" VerticalAlignment="Center" />
     </WrapPanel>
     <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid>
       <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSearchChanged" AutomationProperties.Name="{loc:Loc SshSearchOutput}" ToolTip="{loc:Loc SshLogSearchHint}" Padding="30,0,10,0" />
       <controls:IconView Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
       <TextBlock Text="{loc:Loc SshSearchOutput}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="31,0,10,0" IsHitTestVisible="False" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
      <TextBlock x:Name="MatchCount" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
      <Button Grid.Column="2" Click="OnPrevious" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchPrevious}" AutomationProperties.Name="{loc:Loc SshSearchPrevious}"><controls:IconView Kind="chevron-up" Width="16" Height="16" /></Button>
      <Button Grid.Column="3" Click="OnNext" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchNext}" AutomationProperties.Name="{loc:Loc SshSearchNext}"><controls:IconView Kind="chevron-down" Width="16" Height="16" /></Button>
     </Grid>
     <Border Grid.Row="2" CornerRadius="6" Background="{DynamicResource TerminalSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16">
      <TextBox x:Name="LogOutput" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource TerminalTextBrush}" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SelectionChanged="OnLogSelectionChanged" TextChanged="OnLogTextChanged" AutomationProperties.Name="{loc:Loc SshMonitorLogs}">
       <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PlainLogText}"><Setter Property="TextWrapping" Value="NoWrap" /><Style.Triggers><DataTrigger Binding="{Binding WrapLines}" Value="True"><Setter Property="TextWrapping" Value="Wrap" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
      </TextBox>
     </Border>
    </Grid>
   </controls:WorkspaceSplitView.MainContent>
   <controls:WorkspaceSplitView.PaneContent>
    <Grid x:Name="AnalysisPane" DataContext="{Binding Assistant}" Margin="18,16,18,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Command="{Binding ClearCommand}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshAgentNewConversation}" AutomationProperties.Name="{loc:Loc SshAgentNewConversation}"><controls:IconView Kind="plus" Width="16" Height="16" /></Button><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:IconView Kind="sparkles" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc SshLogAiTitle}" FontSize="16" FontWeight="SemiBold" /></StackPanel></DockPanel>
     <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,14,0,12"><StackPanel>
      <TextBlock Text="{loc:Loc SshLogAiDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
      <CheckBox Content="{loc:Loc SshLogSelectionOnly}" IsChecked="{Binding UseSelection}" Margin="0,12,0,6" />
      <TextBlock Text="{Binding ContextLabel}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
      <Button Command="{Binding AnalyzeCommand}" Content="{loc:Loc SshLogAnalyze}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
     </StackPanel></Border>
     <ScrollViewer x:Name="AnalysisScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border CornerRadius="6" Padding="12" Margin="0,0,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
        <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Margin="0,0,0,8" />
        <controls:MarkdownView Source="{Binding Content}" IsMarkdownEnabled="{Binding IsAssistant}" />
        <TextBlock Text="{Binding Context}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
     <StackPanel Grid.Row="3" Margin="0,8"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{loc:Loc SshAgentThinking}" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
     <Border Grid.Row="4" Padding="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8"><StackPanel>
      <TextBlock Text="{loc:Loc SshLogAsk}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8" />
      <TextBox x:Name="AnalysisPrompt" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120" MaxLength="16000" VerticalScrollBarVisibility="Auto" Style="{StaticResource PlainLogText}" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="{loc:Loc SshLogAsk}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Command="{Binding CancelCommand}" Content="{loc:Loc SshAgentStop}" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" /><Button Command="{Binding SendCommand}" Content="{loc:Loc SshAgentSend}" Style="{StaticResource PrimaryButton}" /></StackPanel>
     </StackPanel></Border>
    </Grid>
   </controls:WorkspaceSplitView.PaneContent>
  </controls:WorkspaceSplitView>
  <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
 </Grid>
</UserControl>
