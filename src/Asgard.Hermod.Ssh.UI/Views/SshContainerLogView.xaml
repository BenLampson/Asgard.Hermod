<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshContainerLogView" x:Name="LogRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="LogButton" TargetType="Button" BasedOn="{StaticResource SshLogButton}"><Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /></Style>
  <Style x:Key="LogRangeCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinWidth" Value="120" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" CornerRadius="4" /></ControlTemplate></ToggleButton.Template></ToggleButton>
   <Grid Margin="8,0" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions><controls:IconView Kind="list-filter" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" /><ContentPresenter Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="0,0,6,0" /><controls:IconView Grid.Column="2" Kind="chevron-down" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" /></Grid>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="4"><ScrollViewer MaxHeight="220" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="24" /></Grid.RowDefinitions>
  <Border x:Name="LogToolbar" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="280" Height="28" Background="{DynamicResource LogSearchBackgroundBrush}" CornerRadius="4"><Grid>
      <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSearchChanged" Style="{StaticResource AgentTextBox}" FontSize="12" Height="28" MinHeight="28" Padding="28,0,55,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{loc:Loc SshSearchOutput}" ToolTip="{loc:Loc SshLogSearchHint}" />
      <controls:IconView Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
      <Grid IsHitTestVisible="False"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style><TextBlock Text="{loc:Loc SshLogSearchPlaceholder}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="30,0,55,0" VerticalAlignment="Center" /><TextBlock Text="{loc:Loc SshLogSearchShortcut}" FontSize="10" Foreground="{DynamicResource LogGutterBrush}" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
     </Grid></Border>
     <StackPanel x:Name="SearchResults" Orientation="Horizontal" Margin="6,0,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock x:Name="MatchCount" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
      <Button Click="OnPrevious" Style="{StaticResource LogButton}" ToolTip="{loc:Loc SshSearchPrevious}" AutomationProperties.Name="{loc:Loc SshSearchPrevious}"><controls:IconView Kind="chevron-up" Width="14" Height="14" /></Button>
      <Button Click="OnNext" Style="{StaticResource LogButton}" ToolTip="{loc:Loc SshSearchNext}" AutomationProperties.Name="{loc:Loc SshSearchNext}"><controls:IconView Kind="chevron-down" Width="14" Height="14" /></Button>
     </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <ComboBox x:Name="TailRange" Style="{StaticResource LogRangeCombo}" Margin="0,0,6,0" Height="28" MinHeight="28" FontSize="12" SelectedValuePath="Tag" SelectedValue="{Binding TailLines, Mode=TwoWay}" SelectionChanged="OnTailChanged" AutomationProperties.Name="{loc:Loc SshLogRange}" IsEnabled="{Binding CanChangeRange}">
      <ComboBoxItem><ComboBoxItem.Tag><system:Int32>100</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail100}" /></ComboBoxItem>
      <ComboBoxItem><ComboBoxItem.Tag><system:Int32>500</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail500}" /></ComboBoxItem>
      <ComboBoxItem><ComboBoxItem.Tag><system:Int32>1000</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail1000}" /></ComboBoxItem>
     </ComboBox>
     <Button x:Name="ReadAction" Command="{Binding ReadActionCommand}" Style="{StaticResource LogButton}" Margin="0,0,6,0" AutomationProperties.Name="{Binding ReadActionLabel}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="{Binding ReadActionIcon}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding ReadActionLabel}" /></StackPanel></Button>
     <Border Width="1" Height="16" Background="{DynamicResource LineBrush}" Margin="0,0,6,0" />
     <ToggleButton IsChecked="{Binding WrapLines}" Height="28" Padding="8,0" FontFamily="{DynamicResource UiFont}" FontSize="12" FontWeight="Normal" Margin="0,0,6,0" ToolTip="{loc:Loc SshLogWrap}" AutomationProperties.Name="{loc:Loc SshLogWrap}"><ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger></Style.Triggers></Style></ToggleButton.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="corner-down-left" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc SshLogWrapToggle}" /></StackPanel></ToggleButton>
     <Button Click="OnMore" Style="{StaticResource LogButton}" ToolTip="{loc:Loc MoreOptions}" AutomationProperties.Name="{loc:Loc MoreOptions}"><controls:IconView Kind="ellipsis" Width="14" Height="14" />
      <Button.ContextMenu><ContextMenu>
       <MenuItem Header="{loc:Loc CopySelection}" Click="OnCopySelection" />
       <MenuItem Header="{loc:Loc SshMonitorCopyLogs}" Click="OnCopy" />
       <MenuItem Header="{loc:Loc SshLogExport}" Click="OnExport" /><Separator />
       <MenuItem Header="{loc:Loc SshFontIncrease}" Click="OnFontIncrease" />
       <MenuItem Header="{loc:Loc SshFontDecrease}" Click="OnFontDecrease" />
      </ContextMenu></Button.ContextMenu>
     </Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Background="{DynamicResource LogBackgroundBrush}"><controls:CodeEditor x:Name="LogEditor" IsLogReader="True" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"><controls:CodeEditor.Style><Style TargetType="controls:CodeEditor"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsBodyEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></controls:CodeEditor.Style></controls:CodeEditor>
   <StackPanel x:Name="EmptyBody" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24" Visibility="{Binding IsBodyEmpty, Converter={StaticResource Visible}}"><controls:IconView Kind="file-text" Width="24" Height="24" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" /><TextBlock Text="{Binding BodyHeading}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /><TextBlock Text="{Binding BodyDetail}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19.8" Margin="0,8,0,0" /></StackPanel>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{loc:Loc ReadOnly}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock x:Name="EncodingStatus" Text="{Binding EncodingAndFont}" Margin="10,0,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel><TextBlock x:Name="SnapshotStatus" Text="{Binding SnapshotStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SnapshotStatus}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></DockPanel>
  </Border>
 </Grid>
</UserControl>
