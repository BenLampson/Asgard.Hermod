<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshContainerLogView" x:Name="LogRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="LogButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="12" /></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="24" /></Grid.RowDefinitions>
  <Border x:Name="LogToolbar" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0">
   <DockPanel>
    <Grid DockPanel.Dock="Right" Width="280" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSearchChanged" FontSize="12" Height="28" MinHeight="28" Padding="28,0,8,0" AutomationProperties.Name="{loc:Loc SshSearchOutput}" ToolTip="{loc:Loc SshLogSearchHint}" />
     <controls:IconView Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
     <TextBlock x:Name="MatchCount" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0" />
     <Button Grid.Column="2" Click="OnPrevious" Style="{StaticResource LogButton}" Padding="4,0" ToolTip="{loc:Loc SshSearchPrevious}" AutomationProperties.Name="{loc:Loc SshSearchPrevious}"><controls:IconView Kind="chevron-up" Width="12" Height="12" /></Button>
     <Button Grid.Column="3" Click="OnNext" Style="{StaticResource LogButton}" Padding="4,0" ToolTip="{loc:Loc SshSearchNext}" AutomationProperties.Name="{loc:Loc SshSearchNext}"><controls:IconView Kind="chevron-down" Width="12" Height="12" /></Button>
    </Grid>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <ComboBox x:Name="TailRange" Width="140" Height="28" MinHeight="28" FontSize="12" SelectedValuePath="Tag" SelectedValue="{Binding TailLines, Mode=TwoWay}" SelectionChanged="OnTailChanged" Margin="0,0,6,0" AutomationProperties.Name="{loc:Loc SshLogRange}" IsEnabled="{Binding CanChangeRange}">
      <ComboBoxItem><ComboBoxItem.Tag><system:Int32>100</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail100}" /></ComboBoxItem>
      <ComboBoxItem><ComboBoxItem.Tag><system:Int32>500</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail500}" /></ComboBoxItem>
      <ComboBoxItem><ComboBoxItem.Tag><system:Int32>1000</system:Int32></ComboBoxItem.Tag><TextBlock Text="{loc:Loc SshLogTail1000}" /></ComboBoxItem>
     </ComboBox>
     <Button Command="{Binding RefreshCommand}" Content="{loc:Loc SshFilesRefresh}" Style="{StaticResource LogButton}" Margin="0,0,6,0" />
     <Button Command="{Binding CancelCommand}" Content="{loc:Loc SshAgentStop}" Style="{StaticResource LogButton}" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
     <Border Width="1" Height="16" Background="{DynamicResource LineBrush}" Margin="0,0,6,0" />
     <CheckBox Content="{loc:Loc SshLogWrap}" IsChecked="{Binding WrapLines}" VerticalAlignment="Center" FontSize="12" Margin="8,0,12,0" />
     <Button Click="OnMore" Style="{StaticResource LogButton}" ToolTip="{loc:Loc MoreOptions}" AutomationProperties.Name="{loc:Loc MoreOptions}"><controls:IconView Kind="ellipsis" Width="14" Height="14" />
      <Button.ContextMenu><ContextMenu>
       <MenuItem Header="{loc:Loc CopySelection}" Click="OnCopySelection" />
       <MenuItem Header="{loc:Loc SshMonitorCopyLogs}" Click="OnCopy" />
       <MenuItem Header="{loc:Loc SshLogExport}" Click="OnExport" /><Separator />
       <MenuItem Header="{loc:Loc SshFontIncrease}" Click="OnFontIncrease" />
       <MenuItem Header="{loc:Loc SshFontDecrease}" Click="OnFontDecrease" />
      </ContextMenu></Button.ContextMenu>
     </Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <controls:CodeEditor x:Name="LogEditor" Grid.Row="1" IsLogReader="True" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" />
  <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Loc ReadOnly}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></DockPanel>
  </Border>
 </Grid>
</UserControl>
