<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:charts="clr-namespace:Asgard.Hermod.Ssh.UI.Controls">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <StackPanel x:Name="OverviewContent" Margin="24,16" MinWidth="840">
   <UniformGrid Columns="4" MinHeight="80" Margin="0,0,0,16">
    <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorCpu}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Cpu}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding ProcessorCount}" Style="{StaticResource MonitorHint}" /></StackPanel>
    <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorMemory}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Memory}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="{Binding MemoryHint}" Style="{StaticResource MonitorHint}" /></StackPanel>
    <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorRootDisk}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Disk}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{Binding DiskCapacity}" Style="{StaticResource MonitorHint}" /></StackPanel>
    <StackPanel><TextBlock Text="{loc:Loc SshMonitorAllInterfaces}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding AggregateSent, StringFormat={loc:Loc SshMonitorSentValue}}" FontFamily="{DynamicResource MonoFont}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,4" /><TextBlock Text="{Binding AggregateReceived, StringFormat={loc:Loc SshMonitorReceivedValue}}" FontFamily="{DynamicResource MonoFont}" FontSize="15" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="{loc:Loc SshMonitorExcludesLoopback}" Style="{StaticResource MonitorHint}" Margin="0,5,0,0" /></StackPanel>
   </UniformGrid>
   <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
    <UniformGrid Columns="3" Height="188">
     <DockPanel Margin="0,0,24,0"><TextBlock DockPanel.Dock="Top" Text="{loc:Loc SshMonitorCpuTrend}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" /><charts:SshMonitorChart Points="{Binding CpuPoints}" AutomationProperties.Name="{loc:Loc SshMonitorCpuTrend}" /></DockPanel>
     <DockPanel Margin="0,0,24,0"><TextBlock DockPanel.Dock="Top" Text="{loc:Loc SshMonitorMemoryTrend}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" /><charts:SshMonitorChart Points="{Binding MemoryPoints}" PrimaryBrush="{DynamicResource SuccessBrush}" AutomationProperties.Name="{loc:Loc SshMonitorMemoryTrend}" /></DockPanel>
     <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="{loc:Loc SshMonitorNetworkTrend}" FontWeight="SemiBold" FontSize="12" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{loc:Loc SshMonitorSentLegend}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="10,0,8,0" /><TextBlock Text="{loc:Loc SshMonitorReceivedLegend}" Foreground="{DynamicResource SuccessBrush}" FontSize="10" /></StackPanel></DockPanel><charts:SshMonitorChart Points="{Binding AggregateSentPoints}" SecondaryPoints="{Binding AggregateReceivedPoints}" Maximum="0" AutomationProperties.Name="{loc:Loc SshMonitorNetworkTrend}" /></DockPanel>
    </UniformGrid>
   </Border>
   <DockPanel Margin="0,14,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding System}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{loc:Loc SshMonitorRootDisk}" FontSize="12" FontWeight="SemiBold" /></DockPanel>
   <DataGrid x:Name="RootMountGrid" ItemsSource="{Binding RootMounts}" Style="{StaticResource MonitorGrid}" Height="74" AutomationProperties.Name="{loc:Loc SshMonitorRootDisk}">
    <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc SshMonitorMount}" Binding="{Binding Path}" Width="*" SortMemberPath="Path" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorDevice}" Binding="{Binding Device}" Width="1.4*" SortMemberPath="Device" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorFileSystem}" Binding="{Binding FileSystem}" Width="*" SortMemberPath="FileSystem" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorTotal}" Binding="{Binding Total}" Width="*" SortMemberPath="TotalBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorUsed}" Binding="{Binding Used}" Width="*" SortMemberPath="UsedBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorAvailable}" Binding="{Binding Available}" Width="*" SortMemberPath="AvailableBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTemplateColumn Header="{loc:Loc SshMonitorUsage}" SortMemberPath="UsedPercent" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><ProgressBar Style="{StaticResource MonitorBar}" Value="{Binding UsedPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock Grid.Column="1" Text="{Binding Percent}" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
   </DataGrid>
   <TextBlock Text="{loc:Loc SshMonitorRecent}" Style="{StaticResource MonitorHint}" Margin="0,7,0,0" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
