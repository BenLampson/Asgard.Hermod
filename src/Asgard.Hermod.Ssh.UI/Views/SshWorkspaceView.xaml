<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 xmlns:terminal="clr-namespace:Asgard.Hermod.WinTerminal;assembly=Asgard.Hermod.WinTerminal"
 Background="{DynamicResource SurfaceBrush}" SizeChanged="OnViewportSizeChanged">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
 <controls:WorkspacePageLayout x:Name="WorkspaceLayout" IsDetailsOpen="{Binding IsDetailsOpen}" IsOverlayOpen="{Binding Connection.IsOpen}">
  <controls:WorkspacePageLayout.Overlay><controls:WorkspaceConnectionOverlay CloseWorkspaceCommand="{Binding CloseWindowCommand}" State="{Binding Connection}" TargetName="{Binding Name}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}" /></controls:WorkspacePageLayout.Overlay>
  <controls:WorkspacePageLayout.Toolbar><controls:WorkspaceHeader State="{Binding Connection}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}">
   <controls:WorkspaceHeader.IdentityContent><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition x:Name="IdentityColumn" Width="*" /></Grid.ColumnDefinitions>
    <controls:IconView x:Name="ToolbarTypeIcon" Kind="terminal" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><controls:InstanceNameButton Instance="{Binding Instance}" FontSize="14" HorizontalAlignment="Stretch" /><TextBlock Text="{Binding RemoteIdentity}" ToolTip="{Binding RemoteIdentity}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
   </Grid></controls:WorkspaceHeader.IdentityContent>
   <controls:WorkspaceHeader.StatusContent><StackPanel Orientation="Horizontal"><controls:StatusBadge Style="{DynamicResource WorkspaceHeaderSecondaryStatus}" Text="{Binding Instance.EnvironmentLabel}" Tone="{Binding Instance.EnvironmentTone}" ShowIndicator="False" Margin="0,0,10,0" /><controls:StatusBadge x:Name="ConnectionBadge" Text="{Binding Status}" Tone="{Binding Tone}" ShowIndicator="False" /></StackPanel></controls:WorkspaceHeader.StatusContent>
   <controls:WorkspaceHeader.ActionsContent><StackPanel x:Name="ToolbarActions" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="OnToolbarActionsSizeChanged">
     <Button x:Name="SearchAction" Click="OnSearchClick" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchOutput}" AutomationProperties.Name="{loc:Loc SshSearchOutput}"><controls:IconView Kind="search" Width="15" Height="15" /></Button>
     <Button x:Name="CopyAction" Focusable="False" Click="OnCopyClick" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshCopySelection}" AutomationProperties.Name="{loc:Loc SshCopySelection}"><controls:IconView Kind="copy" Width="15" Height="15" /></Button>
     <Button x:Name="PasteAction" Click="OnPasteClick" IsEnabled="{Binding IsConnected}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshPaste}" AutomationProperties.Name="{loc:Loc SshPaste}"><controls:IconView Kind="clipboard" Width="15" Height="15" /></Button>
     <Button x:Name="EditAction" Command="{Binding EditConnectionCommand}" Style="{StaticResource StandardButton}" ToolTip="{loc:Loc SshEditConfiguration}" AutomationProperties.Name="{loc:Loc SshEditConfiguration}" Margin="6,0,0,0" Padding="8,0">
      <StackPanel Orientation="Horizontal"><controls:IconView Kind="settings-2" Width="15" Height="15" /><TextBlock Text="{loc:Loc SshEditConfiguration}" Margin="7,0,0,0" /></StackPanel>
     </Button>
     <controls:WorkspaceTools x:Name="SessionTools" VerticalAlignment="Center" Margin="6,0,0,0" />
     <Button x:Name="DetailsAction" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource StandardButton}" ToolTip="{loc:Loc SshConnectionDetails}" AutomationProperties.Name="{loc:Loc SshConnectionDetails}" Margin="6,0,0,0" Padding="8,0">
      <StackPanel Orientation="Horizontal"><controls:IconView Kind="panel-right" Width="15" Height="15" /><TextBlock x:Name="DetailsActionLabel" Text="{loc:Loc SshConnectionDetails}" Margin="7,0,0,0" /></StackPanel>
     </Button>
     <Button x:Name="MoreAction" Click="OnMoreClick" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshMore}" AutomationProperties.Name="{loc:Loc SshMore}"><controls:IconView Kind="ellipsis" Width="15" Height="15" /></Button>
    </StackPanel></controls:WorkspaceHeader.ActionsContent>
  </controls:WorkspaceHeader></controls:WorkspacePageLayout.Toolbar>
  <controls:WorkspacePageLayout.Notification>
   <StackPanel>
   <Border Visibility="{Binding HasSaveFeedback, Converter={StaticResource Visible}}" Background="{DynamicResource SuccessWeakBrush}" Padding="18,8">
    <TextBlock Text="{loc:Loc SshConfigurationSaved}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   </Border>
   </StackPanel>
  </controls:WorkspacePageLayout.Notification>
  <controls:WorkspacePageLayout.Details>
    <Border x:Name="DetailsPanel" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceBrush}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
      <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="14" Height="14" /></Button><TextBlock Text="{loc:Loc SshConnectionDetails}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
      <TextBlock Text="{loc:Loc SshHost}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
      <TextBlock Text="{Binding HostEndpoint}" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" Margin="0,5,0,16" />
      <TextBlock Text="{loc:Loc SshUser}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
      <TextBlock Text="{Binding UserName}" TextWrapping="Wrap" Margin="0,5,0,16" />
      <TextBlock Text="{loc:Loc SshConnectionMethod}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
      <TextBlock Text="{Binding RouteDescription}" TextWrapping="Wrap" Margin="0,5,0,20" />
      <ItemsControl ItemsSource="{Binding HostKeys}"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,0,0,18">
        <DockPanel><controls:IconView Kind="shield-check" Width="15" Height="15" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding Host}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" /></DockPanel>
        <TextBlock Text="{Binding Algorithm}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,5" />
        <TextBlock Text="{Binding Fingerprint}" FontSize="11" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" />
        <Button Content="{loc:Loc SshCopyFingerprint}" Click="OnCopyFingerprint" Tag="{Binding Fingerprint}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
    </Border>
  </controls:WorkspacePageLayout.Details>
  <controls:WorkspacePageLayout.StatusContent>
   <DockPanel LastChildFill="False">
    <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,14,0" />
    <TextBlock x:Name="FooterRoute" Text="{Binding RouteLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
    <TextBlock x:Name="FooterFocus" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11" Visibility="{Binding IsConnected, Converter={StaticResource Visible}}">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Loc SshTerminalUnfocused}" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TerminalView}" Value="True"><Setter Property="Text" Value="{loc:Loc SshTerminalFocused}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger></Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
    <TextBlock DockPanel.Dock="Right" Text="{Binding GridSize}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="10" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextMutedBrush}" />
    <TextBlock x:Name="FooterTerminalType" DockPanel.Dock="Right" Text="{loc:Loc SshTerminalType}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0" />
    <TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshEncoding}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,0,0" />
   </DockPanel>
  </controls:WorkspacePageLayout.StatusContent>
    <Grid x:Name="TerminalSurface" Background="{DynamicResource TerminalSurfaceBrush}" SizeChanged="OnTerminalSizeChanged">
     <Border BorderThickness="1" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TerminalView}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style></Border>
     <terminal:TerminalControl x:Name="TerminalView" Session="{Binding Session}" IsReadOnly="{Binding IsReadOnly}" Margin="20,18"
      FontFamily="{DynamicResource MonoFont}" FontSize="14" Background="{DynamicResource TerminalSurfaceBrush}" Foreground="{DynamicResource TerminalTextBrush}"
      AutomationProperties.Name="{loc:Loc SshTerminalLabel}" PreviewPaste="OnPreviewPaste" />
     <Border x:Name="SearchOverlay" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right" Width="484" Margin="14" Padding="8" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <DockPanel>
       <Button DockPanel.Dock="Right" Click="OnCloseSearch" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchClose}" AutomationProperties.Name="{loc:Loc SshSearchClose}"><controls:IconView Kind="x" Width="14" Height="14" /></Button>
       <Button DockPanel.Dock="Right" Click="OnNextMatch" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchNext}" AutomationProperties.Name="{loc:Loc SshSearchNext}"><controls:IconView Kind="chevron-down" Width="14" Height="14" /></Button>
       <Button DockPanel.Dock="Right" Click="OnPreviousMatch" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchPrevious}" AutomationProperties.Name="{loc:Loc SshSearchPrevious}"><controls:IconView Kind="chevron-up" Width="14" Height="14" /></Button>
       <TextBlock x:Name="MatchCount" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0" FontSize="11" />
       <TextBox x:Name="SearchInput" TextChanged="OnSearchChanged" AutomationProperties.Name="{loc:Loc SshSearchOutput}" />
      </DockPanel>
     </Border>
    </Grid>
 </controls:WorkspacePageLayout>
</UserControl>
