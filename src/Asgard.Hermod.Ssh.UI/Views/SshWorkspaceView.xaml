<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshWorkspaceView" x:Name="SshWorkspaceRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 xmlns:views="clr-namespace:Asgard.Hermod.Ssh.UI.Views"
 xmlns:terminal="clr-namespace:Asgard.Hermod.WinTerminal;assembly=Asgard.Hermod.WinTerminal"
 Background="{DynamicResource SurfaceBrush}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" SizeChanged="OnViewportSizeChanged">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /></ResourceDictionary></UserControl.Resources>
 <controls:WorkspacePageLayout x:Name="WorkspaceLayout" IsDetailsOpen="{Binding IsDetailsOpen}" IsOverlayOpen="{Binding Connection.IsOpen}">
  <controls:WorkspacePageLayout.Overlay><controls:WorkspaceConnectionOverlay CloseWorkspaceCommand="{Binding CloseWindowCommand}" State="{Binding Connection}" TargetName="{Binding Name}" RetryCommand="{Binding ReconnectCommand}" /></controls:WorkspacePageLayout.Overlay>
  <controls:WorkspacePageLayout.Toolbar><controls:WorkspaceHeader State="{Binding Connection}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}">
   <controls:WorkspaceHeader.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></controls:WorkspaceHeader.Resources>
   <controls:WorkspaceHeader.IdentityContent><controls:WorkspaceIdentity Instance="{Binding Instance}" Endpoint="{Binding RemoteIdentity}" Icon="terminal" /></controls:WorkspaceHeader.IdentityContent>
   <controls:WorkspaceHeader.StatusContent><controls:StatusBadge Style="{DynamicResource WorkspaceHeaderSecondaryStatus}" Text="{Binding Instance.EnvironmentLabel}" Tone="{Binding Instance.EnvironmentTone}" ShowIndicator="False" IsCaption="True" /></controls:WorkspaceHeader.StatusContent>
   <controls:WorkspaceHeader.ActionsContent><StackPanel x:Name="ToolbarActions" Orientation="Horizontal" VerticalAlignment="Center" SizeChanged="OnToolbarActionsSizeChanged">
    <Button x:Name="MonitorAction" Command="{Binding ToggleMonitorCommand}" ToolTip="{loc:Loc SshMonitorTitle}" AutomationProperties.Name="{loc:Loc SshMonitorTitle}" Margin="0,0,8,0" Height="28" MinHeight="28" FontSize="12" FontWeight="Normal" Padding="9,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMonitorOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="activity" Width="15" Height="15" /><TextBlock x:Name="MonitorActionLabel" Text="{loc:Loc SshInstanceMonitor}" Margin="7,0,0,0" /></StackPanel></Button>
    <Button x:Name="DockerAction" Command="{Binding ToggleDockerCommandsCommand}" ToolTip="{loc:Loc DockerLibrary}" AutomationProperties.Name="{loc:Loc DockerLibrary}" Style="{StaticResource StandardButton}" Height="28" MinHeight="28" FontSize="12" FontWeight="Normal" Padding="9,0" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="terminal" Width="15" Height="15" /><TextBlock x:Name="DockerActionLabel" Text="{loc:Loc DockerLibrary}" Margin="7,0,0,0" /></StackPanel></Button>
    <Button x:Name="AgentAction" Click="OnOpenAgent" IsEnabled="{Binding HasActiveConsole}" ToolTip="{loc:Loc SshAgentToggle}" AutomationProperties.Name="{loc:Loc SshAgentToggle}" Height="28" MinHeight="28" FontSize="12" FontWeight="Normal" Padding="9,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAgentOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="sparkles" Width="15" Height="15" /><TextBlock Text="{loc:Loc SshAgentTitle}" Margin="7,0,0,0" /></StackPanel></Button>
   </StackPanel></controls:WorkspaceHeader.ActionsContent>
  </controls:WorkspaceHeader></controls:WorkspacePageLayout.Toolbar>
  <controls:WorkspacePageLayout.Notification>
   <StackPanel>
   <Border Visibility="{Binding HasSaveFeedback, Converter={StaticResource Visible}}" Background="{DynamicResource SuccessWeakBrush}" Padding="18,8">
    <TextBlock Text="{loc:Loc SshConfigurationSaved}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   </Border>
   </StackPanel>
  </controls:WorkspacePageLayout.Notification>
  <controls:WorkspacePageLayout.Details>
    <Border x:Name="DetailsPanel" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceBrush}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
      <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="14" Height="14" /></Button><TextBlock Text="{loc:Loc SshConnectionDetails}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
      <TextBlock Text="{loc:Loc SshHost}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
      <TextBlock Text="{Binding HostEndpoint}" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" Margin="0,5,0,16" />
      <TextBlock Text="{loc:Loc SshUser}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
      <TextBlock Text="{Binding UserName}" TextWrapping="Wrap" Margin="0,5,0,16" />
      <TextBlock Text="{loc:Loc SshConnectionMethod}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
      <TextBlock Text="{Binding RouteDescription}" TextWrapping="Wrap" Margin="0,5,0,20" />
      <ItemsControl ItemsSource="{Binding HostKeys}"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,0,0,18">
        <DockPanel><controls:IconView Kind="shield-check" Width="15" Height="15" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding Host}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" /></DockPanel>
        <TextBlock Text="{Binding Algorithm}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,5" />
        <TextBlock Text="{Binding Fingerprint}" FontSize="11" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" />
        <Button Content="{loc:Loc SshCopyFingerprint}" Click="OnCopyFingerprint" Tag="{Binding Fingerprint}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
    </Border>
  </controls:WorkspacePageLayout.Details>
  <controls:WorkspacePageLayout.StatusContent>
   <DockPanel LastChildFill="False">
    <TextBlock Text="{Binding Elapsed}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,14,0" />
    <TextBlock x:Name="FooterRoute" Text="{Binding RouteLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
    <TextBlock x:Name="FooterFocus" Text="{Binding ActiveConsoleLabel}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
    <TextBlock DockPanel.Dock="Right" Text="{Binding GridSize}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="10" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextMutedBrush}" />
    <TextBlock x:Name="FooterTerminalType" DockPanel.Dock="Right" Text="{loc:Loc SshTerminalType}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0" />
    <TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshEncoding}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,0,0" />
   </DockPanel>
  </controls:WorkspacePageLayout.StatusContent>
  <controls:WorkspaceSplitView x:Name="AgentSplit" IsPaneOpen="False">
   <controls:WorkspaceSplitView.MainContent>
    <Grid x:Name="ToolboxGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition x:Name="ToolboxColumn" Width="0" /><ColumnDefinition x:Name="ToolboxDividerColumn" Width="0" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Border x:Name="ToolRail" Background="{DynamicResource SshRailBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,1,0" Padding="4,12,3,0"><StackPanel><TextBlock Text="{loc:Loc SshInstanceTools}" TextAlignment="Center" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
      <RadioButton Style="{StaticResource SshRailButton}" Command="{Binding ToggleToolboxCommand}" CommandParameter="files" IsChecked="{Binding IsFilesSection, Mode=OneWay}" ToolTip="{loc:Loc SshToolFiles}" AutomationProperties.Name="{loc:Loc SshToolFiles}"><StackPanel><controls:IconView Kind="folder" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" /><TextBlock Text="{loc:Loc SshToolFiles}" FontSize="10" Margin="0,7,0,0" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource SshRailButton}" Command="{Binding ToggleToolboxCommand}" CommandParameter="forward" IsChecked="{Binding IsForwardSection, Mode=OneWay}" ToolTip="{loc:Loc SshToolForward}" AutomationProperties.Name="{loc:Loc SshToolForward}"><StackPanel><controls:IconView Kind="network" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" /><TextBlock Text="{loc:Loc SshToolForward}" FontSize="10" Margin="0,7,0,0" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
      <RadioButton Style="{StaticResource SshRailButton}" Command="{Binding ToggleToolboxCommand}" CommandParameter="transfers" IsChecked="{Binding IsTransfersSection, Mode=OneWay}" ToolTip="{loc:Loc SshToolTransfers}" AutomationProperties.Name="{loc:Loc SshToolTransfers}"><StackPanel><controls:IconView Kind="arrow-down-up" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" /><TextBlock Text="{loc:Loc SshToolTransfers}" FontSize="10" Margin="0,7,0,0" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
     </StackPanel></Border>
     <Border Grid.Column="1" x:Name="ToolboxPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,1,0" Visibility="{Binding IsToolboxOpen, Converter={StaticResource Visible}}"><Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="14,0"><DockPanel><Button DockPanel.Dock="Right" Command="{Binding CollapseToolboxCommand}" Style="{StaticResource IconButton}" Width="20" Height="24" Padding="0" ToolTip="{loc:Loc SshCollapseToolbox}" AutomationProperties.Name="{loc:Loc SshCollapseToolbox}"><controls:IconView Kind="panel-left-close" Width="14" Height="14" /></Button><TextBlock Text="{Binding ToolboxTitle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></Border>
      <views:SshFilesView Grid.Row="1" DataContext="{Binding Files}" Visibility="{Binding DataContext.IsFilesSection, ElementName=SshWorkspaceRoot, Converter={StaticResource Visible}}" />
      <views:SshForwardsView Grid.Row="1" Visibility="{Binding IsForwardSection, Converter={StaticResource Visible}}" />
      <views:SshTransfersView Grid.Row="1" DataContext="{Binding Files}" Visibility="{Binding DataContext.IsTransfersSection, ElementName=SshWorkspaceRoot, Converter={StaticResource Visible}}" />
     </Grid></Border>
     <GridSplitter Grid.Column="2" x:Name="ToolboxSplitter" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource LineSoftBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" DragCompleted="OnToolboxResizeCompleted" Visibility="{Binding IsToolboxOpen, Converter={StaticResource Visible}}" AutomationProperties.Name="{loc:Loc WorkspacePaneResize}" />
     <Grid Grid.Column="3" x:Name="SshBodyGrid" SizeChanged="OnMonitorViewportChanged"><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition x:Name="MonitorRow" Height="0" /></Grid.RowDefinitions>
      <Border x:Name="ConsoleToolbar" Height="38" Padding="12,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1"><DockPanel>
       <controls:WorkspaceTools DockPanel.Dock="Right" x:Name="SessionTools" Label="{loc:Loc SshConsoleOptions}" Icon="sliders-horizontal" IsFlat="True" VerticalAlignment="Center" Margin="4,0,0,0" />
       <Button DockPanel.Dock="Right" Command="{Binding NewSessionCommand}" Style="{StaticResource DatabaseToolbarButton}" VerticalAlignment="Center" ToolTip="{loc:Loc SshConsoleNew}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="plus" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{loc:Loc SshConsoleNew}" /></StackPanel></Button>
       <TextBlock DockPanel.Dock="Right" Text="{Binding ConsoleActionStatus}" ToolTip="{Binding ConsoleActionStatus}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="11" Margin="8,0" />
       <controls:WorkspaceTabStrip x:Name="ConsoleTabs" Height="38" MinHeight="38" BorderThickness="0" ItemsSource="{Binding Consoles}" SelectedItem="{Binding ActiveConsole, Mode=TwoWay}" CloseCommand="{Binding CloseConsoleCommand}" ToolTipMemberPath="Name" ItemContainerStyle="{StaticResource SshConsoleTab}"><controls:WorkspaceTabStrip.Template><ControlTemplate TargetType="controls:WorkspaceTabStrip"><ScrollViewer x:Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False"><ItemsPresenter /></ScrollViewer></ControlTemplate></controls:WorkspaceTabStrip.Template><controls:WorkspaceTabStrip.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions><controls:IconView Kind="terminal" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><DockPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshConsoleEnded}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsEnded, Converter={StaticResource Visible}}" /><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></DockPanel><Button Grid.Column="4" Command="{Binding DataContext.CloseConsoleCommand, RelativeSource={RelativeSource AncestorType=controls:WorkspaceTabStrip}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Width="12" Height="12" Padding="0" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" /></Button></Grid></DataTemplate></controls:WorkspaceTabStrip.ItemTemplate></controls:WorkspaceTabStrip>
      </DockPanel></Border>
      <Grid Grid.Row="1" Background="{DynamicResource TerminalSurfaceBrush}">
<Grid x:Name="TerminalSurface" Visibility="{Binding IsTerminalSection, Converter={StaticResource Visible}}" Background="{DynamicResource TerminalSurfaceBrush}" SizeChanged="OnTerminalSizeChanged">
     <Border BorderThickness="1" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TerminalView}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style></Border>
     <terminal:TerminalControl x:Name="TerminalView" Session="{Binding Session}" IsReadOnly="{Binding IsReadOnly}" PreserveOutputOnResize="True" Margin="20,16"
      FontFamily="{DynamicResource MonoFont}" FontSize="13" LineHeight="22.1" Background="{DynamicResource TerminalSurfaceBrush}" Foreground="{DynamicResource TerminalTextBrush}"
      AutomationProperties.Name="{loc:Loc SshTerminalLabel}" PreviewPaste="OnPreviewPaste" />
     <Border x:Name="SearchOverlay" Visibility="{Binding ActiveConsole.IsSearchOpen, Converter={StaticResource Visible}}" VerticalAlignment="Top" HorizontalAlignment="Right" Width="484" Margin="14" Padding="8" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <DockPanel>
       <Button DockPanel.Dock="Right" Click="OnCloseSearch" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchClose}" AutomationProperties.Name="{loc:Loc SshSearchClose}"><controls:IconView Kind="x" Width="14" Height="14" /></Button>
       <Button DockPanel.Dock="Right" Click="OnNextMatch" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchNext}" AutomationProperties.Name="{loc:Loc SshSearchNext}"><controls:IconView Kind="chevron-down" Width="14" Height="14" /></Button>
       <Button DockPanel.Dock="Right" Click="OnPreviousMatch" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshSearchPrevious}" AutomationProperties.Name="{loc:Loc SshSearchPrevious}"><controls:IconView Kind="chevron-up" Width="14" Height="14" /></Button>
       <TextBlock x:Name="MatchCount" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0" FontSize="11" />
       <TextBox x:Name="SearchInput" Text="{Binding ActiveConsole.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSearchChanged" AutomationProperties.Name="{loc:Loc SshSearchOutput}" />
      </DockPanel>
     </Border>
    </Grid>
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasActiveConsole}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{loc:Loc SshNoConsole}" Foreground="{DynamicResource TerminalTextBrush}" FontSize="18" TextAlignment="Center" /><TextBlock Text="{loc:Loc SshNoConsoleHint}" Foreground="{DynamicResource TerminalTextBrush}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12" /><Button Content="{loc:Loc SshConsoleNew}" Command="{Binding NewSessionCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" /></StackPanel>
      </Grid>
      <GridSplitter x:Name="MonitorSplitter" Grid.Row="2" Visibility="{Binding IsMonitorOpen, Converter={StaticResource Visible}}" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="16" ShowsPreview="True" Background="{DynamicResource SshRailBrush}" AutomationProperties.Name="{loc:Loc WorkspacePaneResize}" DragCompleted="OnMonitorResizeCompleted"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0"><Border Width="36" Height="2" Background="{DynamicResource LineSoftBrush}" CornerRadius="1" /></Border></ControlTemplate></GridSplitter.Template></GridSplitter>
      <Border x:Name="MonitorDetails" Grid.Row="3" Visibility="{Binding IsMonitorOpen, Converter={StaticResource Visible}}"><views:SshMonitorView DataContext="{Binding Monitor}" CloseRequested="OnCloseMonitor" /></Border>
      <views:SshDockerCommandsView x:Name="DockerCommandsView" Grid.RowSpan="4" DataContext="{Binding DockerCommands}" Visibility="{Binding DataContext.IsDockerCommandsOpen, ElementName=SshWorkspaceRoot, Converter={StaticResource Visible}}" CloseRequested="OnCloseDockerCommands" MonitorRequested="OnDockerMonitorRequested" />
     </Grid>
     <StackPanel Visibility="Collapsed"><Button x:Name="SearchAction" /><Button x:Name="CopyAction" /><Button x:Name="PasteAction" /><Button x:Name="DetailsAction"><TextBlock x:Name="DetailsActionLabel" /></Button><Button x:Name="MoreAction" /></StackPanel>
    </Grid>
   </controls:WorkspaceSplitView.MainContent>
  </controls:WorkspaceSplitView>
 </controls:WorkspacePageLayout>
</UserControl>
