<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorDisksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:charts="clr-namespace:Asgard.Hermod.Ssh.UI.Controls">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="28" /></Grid.RowDefinitions>
  <UniformGrid Columns="4" MinHeight="80"><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorPersistentCount}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding PersistentCount}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{loc:Loc SshMonitorPersistentHint}" Style="{StaticResource MonitorHint}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorRootDisk}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Disk}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{Binding DiskCapacity}" Style="{StaticResource MonitorHint}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorPersistentAvailable}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding PersistentAvailable}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource SuccessBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorHighUsage}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding HighUsageCount}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource WarningBrush}" /><TextBlock Text="{loc:Loc SshMonitorHighUsageHint}" Style="{StaticResource MonitorHint}" /></StackPanel></UniformGrid>
  <DockPanel Grid.Row="1" Margin="0,4,0,8"><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshMonitorDiskSort}" Style="{StaticResource MonitorHint}" VerticalAlignment="Center" /><Grid Width="320" HorizontalAlignment="Left"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SshMonitorMountSearch}" ToolTip="{loc:Loc SshMonitorMountSearch}" Padding="28,4,8,4" /><controls:IconView Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" /><TextBlock Text="{loc:Loc SshMonitorMountSearch}" Foreground="{DynamicResource TextMutedBrush}" Margin="29,0,8,0" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <DataGrid x:Name="MountGrid" Grid.Row="2" ItemsSource="{Binding MountView}" SelectedItem="{Binding SelectedMount}" Style="{StaticResource MonitorGrid}" AutomationProperties.Name="{loc:Loc SshMonitorDisks}">
   <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc SshMonitorMount}" Binding="{Binding Path}" Width="1.2*" SortMemberPath="Path" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorDevice}" Binding="{Binding Device}" Width="1.5*" SortMemberPath="Device" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorFileSystem}" Binding="{Binding FileSystem}" Width="120" SortMemberPath="FileSystem" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorTotal}" Binding="{Binding Total}" Width="145" SortMemberPath="TotalBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorUsed}" Binding="{Binding Used}" Width="145" SortMemberPath="UsedBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorAvailable}" Binding="{Binding Available}" Width="145" SortMemberPath="AvailableBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTemplateColumn Header="{loc:Loc SshMonitorUsage}" SortMemberPath="UsedPercent" Width="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><ProgressBar Style="{StaticResource MonitorBar}" Value="{Binding UsedPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock Grid.Column="1" Text="{Binding Percent}" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3"><Border Visibility="{Binding ShowMountWarning, Converter={StaticResource MonitorVisible}}" Background="{DynamicResource WarningWeakBrush}" Padding="12,8" Margin="0,8,0,0"><TextBlock Text="{Binding MountWarning}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" /></Border><TextBlock Text="{loc:Loc SshMonitorMemoryFileSystemHint}" Style="{StaticResource MonitorHint}" Margin="0,10,0,0" /></StackPanel>
  <Border Grid.Row="4" Padding="0,8,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshMonitorLimit}" Visibility="{Binding ReachedLimit, Converter={StaticResource MonitorVisible}}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding ResultCount}" Style="{StaticResource MonitorHint}" /></DockPanel></Border>
 </Grid>
</UserControl>
