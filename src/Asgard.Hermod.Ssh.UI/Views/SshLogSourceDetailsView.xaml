<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshLogSourceDetailsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" Width="420">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/SshDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="DetailLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="Margin" Value="0,14,0,5" /></Style>
  <Style x:Key="DetailValue" TargetType="TextBox" BasedOn="{StaticResource AgentTextBox}"><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /><Setter Property="FontSize" Value="12" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
 </ResourceDictionary></UserControl.Resources>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
  <StackPanel><TextBlock Text="{loc:Loc SshLogSourceDetails}" FontSize="14" FontWeight="SemiBold" />
   <TextBlock Text="{loc:Loc SshHost}" Style="{StaticResource DetailLabel}" /><TextBox Text="{Binding Host, Mode=OneWay}" Style="{StaticResource DetailValue}" AutomationProperties.Name="{loc:Loc SshHost}" />
   <TextBlock Text="{loc:Loc SshLogContainerId}" Style="{StaticResource DetailLabel}" /><TextBox Text="{Binding Container.Id, Mode=OneWay}" Style="{StaticResource DetailValue}" AutomationProperties.Name="{loc:Loc SshLogContainerId}" />
   <TextBlock Text="{loc:Loc SshLogDocumentId}" Style="{StaticResource DetailLabel}" /><TextBox Text="{Binding Id, Mode=OneWay}" Style="{StaticResource DetailValue}" AutomationProperties.Name="{loc:Loc SshLogDocumentId}" />
   <TextBlock Text="{loc:Loc SshLogSnapshotLabel}" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding SnapshotTime}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding SnapshotStatus}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
  </StackPanel>
 </Border>
</UserControl>
