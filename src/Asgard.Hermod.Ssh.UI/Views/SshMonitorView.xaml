<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
 <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceBrush}" Padding="16,8">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Click="OnClose" Content="{loc:Loc Close}" Margin="8,0,0,0" /><Button DockPanel.Dock="Right" Content="{loc:Loc SshFilesRefresh}" Command="{Binding RefreshDetailsCommand}" Margin="8,0,0,0" />
    <controls:SectionSelector SelectedValue="{Binding Section, Mode=TwoWay}" SelectedValuePath="Tag" SelectionChanged="OnSectionChanged" AutomationProperties.Name="{loc:Loc SshMonitorTitle}">
     <ListBoxItem Tag="overview" Content="{loc:Loc SshMonitorOverview}" /><ListBoxItem Tag="processes" Content="{loc:Loc SshMonitorProcesses}" /><ListBoxItem Tag="docker" Content="{loc:Loc SshMonitorDocker}" /><ListBoxItem Tag="network" Content="{loc:Loc SshMonitorNetwork}" /><ListBoxItem Tag="disks" Content="{loc:Loc SshMonitorDisks}" />
    </controls:SectionSelector>
   </DockPanel>
   <Grid Grid.Row="1"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsOverview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding System}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
     <TextBlock Text="{Binding Cpu, StringFormat={loc:Loc SshMonitorCpuValue}}" Margin="0,10,0,6" /><ProgressBar Value="{Binding Snapshot.CpuPercent}" Maximum="100" Height="5" Foreground="{DynamicResource AccentBrush}" />
     <TextBlock Text="{Binding Memory, StringFormat={loc:Loc SshMonitorMemoryValue}}" Margin="0,12,0,0" /><TextBlock Text="{Binding Disk, StringFormat={loc:Loc SshMonitorDiskValue}}" Margin="0,8,0,0" /><TextBlock Text="{Binding Network}" Margin="0,8,0,0" FontSize="11" />
    </StackPanel>
    <TextBox Grid.Column="1" Text="{Binding Details, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12" AutomationProperties.Name="{loc:Loc SshMonitorTitle}" />
   </Grid>
   <ScrollViewer Grid.Row="1" Visibility="{Binding IsOverview, Converter={StaticResource Visible}}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <UniformGrid Columns="4" MinWidth="720">
     <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorCpu}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" /><TextBlock Text="{Binding Cpu}" FontFamily="{DynamicResource MonoFont}" FontSize="18" Margin="0,8,0,6" />
      <ItemsControl ItemsSource="{Binding History}" Height="64"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="6" Height="{Binding CpuHeight}" Fill="{DynamicResource AccentBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{loc:Loc SshMonitorRecent}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
     </StackPanel>
     <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorMemory}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" /><TextBlock Text="{Binding Memory}" FontFamily="{DynamicResource MonoFont}" FontSize="18" Margin="0,8,0,6" />
      <ItemsControl ItemsSource="{Binding History}" Height="64"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="6" Height="{Binding MemoryHeight}" Fill="{DynamicResource SuccessBrush}" Margin="0,0,2,0" VerticalAlignment="Bottom" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{loc:Loc SshMonitorRecent}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
     </StackPanel>
     <StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorDisks}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" /><TextBlock Text="{Binding Disk}" FontFamily="{DynamicResource MonoFont}" FontSize="18" Margin="0,8,0,14" /><TextBlock Text="{Binding System}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
     <StackPanel><TextBlock Text="{loc:Loc SshMonitorNetwork}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" /><TextBlock Text="{Binding Network}" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="14" Margin="0,8,0,14" /><TextBlock Text="{loc:Loc SshMonitorRefreshHint}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel>
    </UniformGrid>
   </ScrollViewer>
  </Grid>
 </Border>
</UserControl>
