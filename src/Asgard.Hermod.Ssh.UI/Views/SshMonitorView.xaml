<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:views="clr-namespace:Asgard.Hermod.Ssh.UI.Views"
 SizeChanged="OnViewportChanged">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Background="{DynamicResource SurfaceBrush}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="20,0">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="SamplingHint" Text="{loc:Loc SshMonitorRefreshHint}" Style="{StaticResource MonitorHint}" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Command="{Binding TogglePauseCommand}" ToolTip="{Binding PauseLabel}" AutomationProperties.Name="{Binding PauseLabel}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="pause" Width="14" Height="14" /><TextBlock x:Name="PauseLabel" Text="{Binding PauseLabel}" Margin="6,0,0,0" /></StackPanel></Button>
      <Button Command="{Binding RefreshDetailsCommand}" ToolTip="{loc:Loc SshFilesRefresh}" AutomationProperties.Name="{loc:Loc SshFilesRefresh}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="refresh-cw" Width="14" Height="14" /><TextBlock x:Name="RefreshLabel" Text="{loc:Loc SshFilesRefresh}" Margin="6,0,0,0" /></StackPanel></Button>
      <Button Click="OnClose" ToolTip="{loc:Loc SshMonitorCollapse}" AutomationProperties.Name="{loc:Loc SshMonitorCollapse}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="chevron-down" Width="14" Height="14" /><TextBlock x:Name="CollapseLabel" Text="{loc:Loc SshMonitorCollapse}" Margin="6,0,0,0" /></StackPanel></Button>
     </StackPanel>
     <StackPanel x:Name="MonitorHeading" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"><controls:IconView Kind="activity" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{loc:Loc SshMonitorTitle}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" /></StackPanel>
     <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
      <controls:SectionSelector x:Name="MonitorSections" SelectedValue="{Binding Section, Mode=TwoWay}" SelectedValuePath="Tag" AutomationProperties.Name="{loc:Loc SshMonitorTitle}">
       <ListBoxItem Tag="overview" Content="{loc:Loc SshMonitorOverview}" /><ListBoxItem Tag="processes" Content="{loc:Loc SshMonitorProcesses}" /><ListBoxItem Tag="docker" Content="{loc:Loc SshMonitorDocker}" /><ListBoxItem Tag="network" Content="{loc:Loc SshMonitorNetwork}" /><ListBoxItem Tag="disks" Content="{loc:Loc SshMonitorDisks}" />
      </controls:SectionSelector>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Border Grid.Row="1" Visibility="{Binding HasBanner, Converter={StaticResource MonitorVisible}}" Background="{DynamicResource WarningWeakBrush}" Padding="24,7">
    <TextBlock Text="{Binding BannerText}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   </Border>
   <Grid Grid.Row="2">
    <views:SshMonitorOverviewView Visibility="{Binding IsOverview, Converter={StaticResource MonitorVisible}}" />
    <views:SshMonitorProcessesView Visibility="{Binding IsProcesses, Converter={StaticResource MonitorVisible}}" />
    <views:SshMonitorDockerView Visibility="{Binding IsDocker, Converter={StaticResource MonitorVisible}}" />
    <views:SshMonitorNetworkView Visibility="{Binding IsNetwork, Converter={StaticResource MonitorVisible}}" />
    <views:SshMonitorDisksView Visibility="{Binding IsDisks, Converter={StaticResource MonitorVisible}}" />
    <Border Visibility="{Binding ShowLoading, Converter={StaticResource MonitorVisible}}" Background="{DynamicResource SurfaceBrush}" Padding="24">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="160" Height="3" /><TextBlock Text="{loc:Loc SshMonitorLoading}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" /></StackPanel>
    </Border>
    <Border x:Name="MonitorEmptyState" Visibility="{Binding ShowEmpty, Converter={StaticResource MonitorVisible}}" Background="{DynamicResource SurfaceBrush}" Padding="20">
     <Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="24,116,24,38" /><Style.Triggers><DataTrigger Binding="{Binding IsDocker}" Value="True"><Setter Property="Margin" Value="24,116,24,128" /></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600"><controls:IconView Kind="search" Width="28" Height="28" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,8" /><TextBlock Text="{Binding EmptyDescription}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Content="{loc:Loc SshFilesRefresh}" Command="{Binding RefreshDetailsCommand}" Margin="0,0,8,0" /><Button Content="{loc:Loc SshMonitorClearSearch}" Command="{Binding ClearSearchCommand}" /></StackPanel></StackPanel>
    </Border>
   </Grid>
   <Border Grid.Row="3" Background="{DynamicResource AppBackgroundBrush}" Padding="24,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshMonitorReadOnly}" Style="{StaticResource MonitorHint}" VerticalAlignment="Center" /><TextBlock Text="{Binding Updated}" Style="{StaticResource MonitorHint}" VerticalAlignment="Center" /></DockPanel></Border>
  </Grid>
 </Border>
</UserControl>
