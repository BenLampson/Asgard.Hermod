<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorNetworkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:charts="clr-namespace:Asgard.Hermod.Ssh.UI.Controls">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="40" /><RowDefinition Height="170" /><RowDefinition Height="*" /><RowDefinition Height="26" /></Grid.RowDefinitions>
  <UniformGrid Columns="4" MinHeight="80"><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorInterface}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding NetworkName}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{loc:Loc SshMonitorExcludesLoopback}" Style="{StaticResource MonitorHint}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorSent}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Sent}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{loc:Loc SshMonitorRateHint}" Style="{StaticResource MonitorHint}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorReceived}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Received}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="{loc:Loc SshMonitorRateHint}" Style="{StaticResource MonitorHint}" /></StackPanel><StackPanel><TextBlock Text="{loc:Loc SshMonitorInterfaceCount}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Networks.Count}" Style="{StaticResource MonitorValue}" /><TextBlock Text="{loc:Loc SshMonitorNetworkCountersHint}" Style="{StaticResource MonitorHint}" /></StackPanel></UniformGrid>
  <DockPanel Grid.Row="1" Margin="0,4,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{loc:Loc SshMonitorSentLegend}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,16,0" /><TextBlock Text="{loc:Loc SshMonitorReceivedLegend}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" /></StackPanel><ComboBox x:Name="InterfacePicker" ItemsSource="{Binding NetworkChoices}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding SelectedNetworkKey, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc SshMonitorInterface}" /></DockPanel>
  <charts:SshMonitorChart x:Name="TrafficChart" Grid.Row="2" Points="{Binding SentPoints}" SecondaryPoints="{Binding ReceivedPoints}" Maximum="0" AutomationProperties.Name="{loc:Loc SshMonitorNetworkTrend}" Margin="0,0,0,12" />
  <DataGrid x:Name="NetworkGrid" Grid.Row="3" ItemsSource="{Binding Networks}" Style="{StaticResource MonitorGrid}" AutomationProperties.Name="{loc:Loc SshMonitorNetwork}">
   <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc SshMonitorInterface}" Binding="{Binding Name}" Width="130" SortMemberPath="Name" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorState}" Binding="{Binding Status}" Width="110" SortMemberPath="Status" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorAddress}" Binding="{Binding Addresses}" Width="1.4*" SortMemberPath="Addresses" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorSent}" Binding="{Binding Sent}" Width="145" SortMemberPath="Value.SentPerSecond" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorReceived}" Binding="{Binding Received}" Width="145" SortMemberPath="Value.ReceivedPerSecond" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorTotalSent}" Binding="{Binding TotalSent}" Width="145" SortMemberPath="Value.SentBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorTotalReceived}" Binding="{Binding TotalReceived}" Width="145" SortMemberPath="Value.ReceivedBytes" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorMtu}" Binding="{Binding Mtu}" Width="80" SortMemberPath="Value.Mtu" ElementStyle="{StaticResource MonitorCellText}" /></DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="4" Text="{loc:Loc SshMonitorNetworkCountersHint}" Style="{StaticResource MonitorHint}" Margin="0,8,0,0" />
 </Grid>
</UserControl>
