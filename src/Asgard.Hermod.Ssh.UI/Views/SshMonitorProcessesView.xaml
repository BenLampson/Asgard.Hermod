<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshMonitorProcessesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:charts="clr-namespace:Asgard.Hermod.Ssh.UI.Controls">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
  <UniformGrid Columns="4" MinHeight="80"><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorProcessCount}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding ProcessCount}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{loc:Loc SshMonitorCurrentHost}" Style="{StaticResource MonitorHint}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorRunning}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding RunningProcesses}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource SuccessBrush}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorCpu}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Cpu}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding ProcessorCount}" Style="{StaticResource MonitorHint}" /></StackPanel><StackPanel Margin="0,0,20,0"><TextBlock Text="{loc:Loc SshMonitorMemory}" Style="{StaticResource MonitorLabel}" /><TextBlock Text="{Binding Memory}" Style="{StaticResource MonitorValue}" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{Binding MemoryHint}" Style="{StaticResource MonitorHint}" /></StackPanel></UniformGrid>
  <DockPanel Grid.Row="1" Margin="0,4,0,8"><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshMonitorProcessCpuHint}" Style="{StaticResource MonitorHint}" MaxWidth="460" VerticalAlignment="Center" TextAlignment="Right" ToolTip="{loc:Loc SshMonitorProcessCpuHint}" /><Grid Width="320" HorizontalAlignment="Left"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc SshMonitorProcessSearch}" ToolTip="{loc:Loc SshMonitorProcessSearch}" Padding="28,4,8,4" /><controls:IconView Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" /><TextBlock Text="{loc:Loc SshMonitorProcessSearch}" Foreground="{DynamicResource TextMutedBrush}" Margin="29,0,8,0" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <DataGrid x:Name="ProcessGrid" Grid.Row="2" ItemsSource="{Binding ProcessView}" Style="{StaticResource MonitorGrid}" AutomationProperties.Name="{loc:Loc SshMonitorProcesses}">
   <DataGrid.Columns><DataGridTextColumn Header="{loc:Loc SshMonitorPid}" Binding="{Binding Pid}" Width="80" SortMemberPath="Pid" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorProcessName}" Binding="{Binding Name}" Width="2*" SortMemberPath="Name" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorUser}" Binding="{Binding User}" Width="140" SortMemberPath="User" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc SshMonitorState}" Binding="{Binding Status}" Width="120" SortMemberPath="Status" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTemplateColumn Header="{loc:Loc SshMonitorCpu}" SortMemberPath="CpuPercent" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><ProgressBar Style="{StaticResource MonitorBar}" Value="{Binding CpuPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock Grid.Column="1" Text="{Binding Cpu}" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="{loc:Loc SshMonitorMemoryUsage}" SortMemberPath="MemoryPercent" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><ProgressBar Style="{StaticResource MonitorBar}" Value="{Binding MemoryPercent, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock Grid.Column="1" Text="{Binding Memory}" FontFamily="{DynamicResource MonoFont}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{loc:Loc SshMonitorResident}" Binding="{Binding Resident}" Width="150" SortMemberPath="ResidentBytes" ElementStyle="{StaticResource MonitorCellText}" /></DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="3" Padding="0,8,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Loc SshMonitorLimit}" Visibility="{Binding ReachedLimit, Converter={StaticResource MonitorVisible}}" Style="{StaticResource MonitorHint}" /><TextBlock Text="{Binding ResultCount}" Style="{StaticResource MonitorHint}" /></DockPanel></Border>
 </Grid>
</UserControl>
