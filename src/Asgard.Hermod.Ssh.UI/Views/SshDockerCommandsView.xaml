<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshDockerCommandsView" x:Name="DockerRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:views="clr-namespace:Asgard.Hermod.Ssh.UI.Views" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="DockerLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
  <Style x:Key="DockerField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,7" /></Style>
  <Style x:Key="DockerAction" TargetType="Button" BasedOn="{StaticResource MonitorActionButton}"><Setter Property="Height" Value="36" /><Setter Property="MinWidth" Value="90" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="DockerExpander" TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" /><Setter Property="Margin" Value="0,12,0,0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
   <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{DynamicResource SshRailBrush}" Foreground="{TemplateBinding Foreground}" BorderThickness="1" BorderBrush="{DynamicResource LineSoftBrush}" Padding="10,8"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" CornerRadius="4"><DockPanel><TextBlock x:Name="Arrow" Text="+" Margin="0,0,8,0" /><ContentPresenter /></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="−" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}" /></ToggleButton>
   <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,12,0,0" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="400" Height="{Binding ActualHeight, ElementName=DockerRoot}"><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="34" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border Padding="16,0" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1"><DockPanel><Button DockPanel.Dock="Right" Click="OnClose" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshCollapseToolbox}" AutomationProperties.Name="{loc:Loc SshCollapseToolbox}"><controls:IconView Kind="panel-left-close" Width="16" Height="16" /></Button><TextBlock Text="{loc:Loc SshToolDocker}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></Border>
  <Border Grid.Row="1" Padding="16,6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SshRailBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource MonitorActionButton}" Visibility="{Binding IsBusy, Converter={StaticResource MonitorVisible}}" /><Button DockPanel.Dock="Right" Command="{Binding DetectCommand}" Content="{loc:Loc SshInitializeEnvironment}" Style="{StaticResource MonitorActionButton}" /><TextBlock Text="{Binding EnvironmentSummary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnvironmentSummary}" VerticalAlignment="Center" /></DockPanel><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource MonitorVisible}}" /><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" /></StackPanel></Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0"><RadioButton Content="{loc:Loc DockerContainersTab}" IsChecked="{Binding IsContainerTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="containers" Style="{StaticResource ManagementTab}" /><RadioButton Content="{loc:Loc DockerImages}" IsChecked="{Binding IsImageTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="images" Style="{StaticResource ManagementTab}" /><RadioButton Content="{loc:Loc DockerComposeTab}" IsChecked="{Binding IsComposeTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="compose" Style="{StaticResource ManagementTab}" /></StackPanel>
  <Border Grid.Row="3" Background="{DynamicResource WarningWeakBrush}" Padding="16,6" Visibility="{Binding HasError, Converter={StaticResource MonitorVisible}}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
  <Grid x:Name="CommandColumns" Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="72" /><RowDefinition Height="8" /><RowDefinition Height="3*" MinHeight="64" /></Grid.RowDefinitions>
   <Grid x:Name="Catalog" Visibility="{Binding IsContainerTool, Converter={StaticResource MonitorVisible}}"><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="16,3"><ComboBox DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding ContainerState, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc SshMonitorState}"><ComboBoxItem Tag="" Content="{loc:Loc SshMonitorAllStates}" /><ComboBoxItem Tag="running" Content="{loc:Loc SshMonitorRunning}" /><ComboBoxItem Tag="exited" Content="{loc:Loc SshMonitorExited}" /></ComboBox><Grid><TextBox x:Name="ContainerSearch" Text="{Binding ContainerSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc DockerContainerSearch}" AutomationProperties.Name="{loc:Loc DockerContainerSearch}" Padding="10,4" /><TextBlock Text="{loc:Loc DockerContainerSearch}" Margin="11,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ContainerSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
    <Grid Grid.Row="1"><DataGrid x:Name="ContainerList" ItemsSource="{Binding ContainerView}" SelectedItem="{Binding SelectedContainer, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" Style="{StaticResource MonitorGrid}" RowHeight="44" AutomationProperties.Name="{loc:Loc DockerContainer}"><DataGrid.Columns>
     <DataGridTextColumn Header="{loc:Loc Name}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource MonitorCellText}" />
     <DataGridTemplateColumn Header="{loc:Loc DockerStateHealth}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Status}" FontSize="11" /><TextBlock Text="{Binding Health}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{loc:Loc SshMonitorCpu}" Binding="{Binding Cpu}" Width="60" ElementStyle="{StaticResource MonitorCellText}" /><DataGridTextColumn Header="{loc:Loc ManagementMemory}" Binding="{Binding Memory}" Width="*" ElementStyle="{StaticResource MonitorCellText}" />
    </DataGrid.Columns></DataGrid><TextBlock Text="{loc:Loc DockerNoContainers}" Style="{StaticResource MonitorHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoContainers, Converter={StaticResource MonitorVisible}}" IsHitTestVisible="False" /></Grid>
    <StackPanel Grid.Row="2" x:Name="ContainerPanel" Visibility="{Binding HasContainer, Converter={StaticResource MonitorVisible}}"><WrapPanel Margin="16,4" IsEnabled="{Binding CanEdit}"><Button x:Name="LogsAction" Content="{loc:Loc DockerLogs}" Command="{Binding ActionCommand}" CommandParameter="logs" Style="{StaticResource MonitorActionButton}" Margin="0,0,6,2" /><Button  Content="{loc:Loc DockerStart}" Command="{Binding ActionCommand}" CommandParameter="start" Style="{StaticResource MonitorActionButton}" Margin="0,0,6,2" /><Button x:Name="RestartAction" Content="{loc:Loc DockerRestartShort}" Command="{Binding ActionCommand}" CommandParameter="restart" Style="{StaticResource MonitorActionButton}" Margin="0,0,6,2" /><Button  Content="{loc:Loc DockerStopShort}" Command="{Binding ActionCommand}" CommandParameter="stop" Style="{StaticResource MonitorActionButton}" Margin="0,0,6,2" /></WrapPanel></StackPanel>
   </Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsOtherTool, Converter={StaticResource MonitorVisible}}"><StackPanel Margin="16,0,16,10">    <Expander x:Name="OtherResources" Header="{loc:Loc DockerOtherResources}" Style="{StaticResource DockerExpander}" IsExpanded="True"><StackPanel IsEnabled="{Binding CanEdit}">
     <TextBlock Text="{loc:Loc DockerOtherResourcesHint}" Style="{StaticResource MonitorHint}" Margin="0,0,0,12" />
     <ComboBox x:Name="OperationPicker" ItemsSource="{Binding VisibleOperations}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedOtherOperation}" MinHeight="34" AutomationProperties.Name="{loc:Loc DockerChooseAction}" />
     <StackPanel Visibility="{Binding NeedsImage, Converter={StaticResource MonitorVisible}}" Margin="0,12,0,0"><TextBlock Text="{loc:Loc DockerImageReference}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /></StackPanel>
     <StackPanel Visibility="{Binding NeedsCompose, Converter={StaticResource MonitorVisible}}" Margin="0,12,0,0"><TextBlock Text="{loc:Loc DockerProjectDirectory}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding ProjectDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /><TextBlock Text="{loc:Loc DockerProjectDirectoryHint}" Style="{StaticResource MonitorHint}" Margin="0,7,0,12" /><TextBlock Text="{loc:Loc DockerComposeFile}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding ComposeFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /><TextBlock Text="{loc:Loc DockerService}" Style="{StaticResource DockerLabel}" Margin="0,12,0,8" /><TextBox Text="{Binding Service, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /><TextBlock Text="{loc:Loc DockerServiceHint}" Style="{StaticResource MonitorHint}" Margin="0,7,0,0" /></StackPanel>
     <Button x:Name="ExecuteAction" Content="{Binding OperationTitle}" Command="{Binding ExecuteCommand}" Style="{StaticResource DockerAction}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding IsOtherOperation, Converter={StaticResource MonitorVisible}}" />
     <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel></Expander>
</StackPanel></ScrollViewer>
   <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" KeyboardIncrement="16" ShowsPreview="True" Background="{DynamicResource LineSoftBrush}" AutomationProperties.Name="{loc:Loc SshResourceDetailsResize}" />
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="16,0"><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedContainer.Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal"><RadioButton Content="{loc:Loc DockerResources}" IsChecked="{Binding IsResourceSection, Mode=OneWay}" Command="{Binding SelectDetailCommand}" CommandParameter="resources" Style="{StaticResource ManagementTab}" /><RadioButton Content="{loc:Loc DockerResult}" IsChecked="{Binding IsOutputSection, Mode=OneWay}" Command="{Binding SelectDetailCommand}" CommandParameter="output" Style="{StaticResource ManagementTab}" /><RadioButton Content="{loc:Loc DockerDetails}" IsChecked="{Binding IsDetailsSection, Mode=OneWay}" Command="{Binding SelectDetailCommand}" CommandParameter="details" Style="{StaticResource ManagementTab}" /></StackPanel></DockPanel>
    <views:SshDockerResourcesView Grid.Row="1" DataContext="{Binding ResourceMonitor, ElementName=DockerRoot}" Visibility="{Binding DataContext.IsResourceSection, ElementName=DockerRoot, Converter={StaticResource MonitorVisible}}" />
    <Border Grid.Row="1" Visibility="{Binding IsDetailsSection, Converter={StaticResource MonitorVisible}}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,8"><TextBlock Text="{Binding SelectedContainer.Name}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedContainer.Image}" TextWrapping="Wrap" Margin="0,6" /><TextBlock Text="{loc:Loc SshMonitorContainerId}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding SelectedContainer.Id, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="10" /><TextBlock Text="{loc:Loc DockerTargetPorts}" Margin="0,10,0,4" /><TextBlock Text="{Binding SelectedContainer.Ports}" TextWrapping="Wrap" /></StackPanel></ScrollViewer></Border>
    <Border x:Name="OutputPanel" Grid.Row="1" Visibility="{Binding IsOutputSection, Converter={StaticResource MonitorVisible}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <DockPanel Margin="16,3"><Button DockPanel.Dock="Right" Click="OnCopyOutput" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshMonitorCopyLogs}" AutomationProperties.Name="{loc:Loc SshMonitorCopyLogs}"><controls:IconView Kind="copy" Width="14" Height="14" /></Button><Button DockPanel.Dock="Right" Click="OnExportOutput" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshLogExport}" AutomationProperties.Name="{loc:Loc SshLogExport}"><controls:IconView Kind="download" Width="14" Height="14" /></Button><TextBox x:Name="OutputSearch" TextChanged="OnOutputSearchChanged" ToolTip="{loc:Loc DockerSearchOutput}" AutomationProperties.Name="{loc:Loc DockerSearchOutput}" MinHeight="28" Padding="8,3" /></DockPanel>
     <StackPanel Grid.Row="1" Margin="16,3"><TextBlock Text="{Binding ResultTarget}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultTarget}" /><TextBlock Text="{Binding ResultSummary}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
     <Grid Grid.Row="2"><TextBox x:Name="ResultOutput" Text="{Binding Output, Mode=OneWay}" TextChanged="OnOutputSearchChanged" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="16,8" Background="{DynamicResource SshRailBrush}" Foreground="{DynamicResource TextBodyBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" AutomationProperties.Name="{loc:Loc DockerResult}" /><TextBlock Text="{loc:Loc DockerResultEmpty}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="{Binding HasNoOutput, Converter={StaticResource MonitorVisible}}" /></Grid>
    </Grid></Border>
    <Border x:Name="EmptySelection" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="16" Visibility="{Binding HasNoContainer, Converter={StaticResource MonitorVisible}}"><StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Loc DockerSelectFirst}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc DockerSelectFirstHint}" Style="{StaticResource MonitorHint}" Margin="0,8,0,0" /></StackPanel></Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="200"><StackPanel Margin="16,0,16,5">     <Expander Header="{loc:Loc DockerLogOptions}" ><StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="{loc:Loc DockerTailLines}" Style="{StaticResource DockerLabel}" /><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding TailLines}" MinHeight="34" AutomationProperties.Name="{loc:Loc DockerTailLines}"><ComboBoxItem Content="{loc:Loc SshLogTail100}"><ComboBoxItem.Tag><system:Int32>100</system:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="{loc:Loc SshLogTail500}"><ComboBoxItem.Tag><system:Int32>500</system:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="{loc:Loc SshLogTail1000}"><ComboBoxItem.Tag><system:Int32>1000</system:Int32></ComboBoxItem.Tag></ComboBoxItem></ComboBox>
      <TextBlock Text="{loc:Loc DockerSince}" Style="{StaticResource DockerLabel}" Margin="0,12,0,8" /><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Since}" MinHeight="34"><ComboBoxItem Tag="" Content="{loc:Loc DockerSinceAll}" /><ComboBoxItem Tag="10m" Content="{loc:Loc DockerSince10Minutes}" /><ComboBoxItem Tag="1h" Content="{loc:Loc DockerSinceHour}" /><ComboBoxItem Tag="24h" Content="{loc:Loc DockerSinceDay}" /></ComboBox>
      <CheckBox IsChecked="{Binding Timestamps}" Content="{loc:Loc DockerTimestamps}" Margin="0,12,0,0" /><CheckBox IsChecked="{Binding Follow}" Content="{loc:Loc DockerFollow}" Margin="0,10,0,0" /><TextBlock Text="{loc:Loc DockerFollowHint}" Style="{StaticResource MonitorHint}" Margin="0,7,0,0" />
     </StackPanel></Expander>
    <Expander x:Name="CommandDetails" Header="{loc:Loc DockerAdvancedDetails}" ><StackPanel>
     <TextBlock Text="{loc:Loc DockerAdvancedHint}" Style="{StaticResource MonitorHint}" Margin="0,0,0,8" /><TextBox x:Name="CommandPreview" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource SshRailBrush}" Foreground="{DynamicResource TextBodyBrush}" FontFamily="{DynamicResource MonoFont}" Padding="10" MinHeight="50" />
     <TextBlock Text="{Binding Compatibility}" Style="{StaticResource MonitorHint}" Margin="0,8,0,0" /><WrapPanel Margin="0,10,0,0"><Button Content="{loc:Loc DockerCopyCommand}" Click="OnCopyCommand" Style="{StaticResource DockerAction}" /><Button Content="{loc:Loc DockerInsert}" Command="{Binding InsertCommand}" Style="{StaticResource DockerAction}" /></WrapPanel>
    </StackPanel></Expander>
</StackPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Grid></ScrollViewer>
</UserControl>
