<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshDockerCommandsView" x:Name="DockerRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
 SizeChanged="OnViewportChanged" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.Ssh.UI;component/Resources/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="DockerLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
  <Style x:Key="DockerField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,7" /></Style>
  <Style x:Key="DockerAction" TargetType="Button" BasedOn="{StaticResource MonitorActionButton}"><Setter Property="Height" Value="36" /><Setter Property="MinWidth" Value="90" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="DockerExpander" TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" /><Setter Property="Margin" Value="0,12,0,0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
   <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{DynamicResource SshRailBrush}" Foreground="{TemplateBinding Foreground}" BorderThickness="1" BorderBrush="{DynamicResource LineSoftBrush}" Padding="10,8"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" CornerRadius="4"><DockPanel><TextBlock x:Name="Arrow" Text="+" Margin="0,0,8,0" /><ContentPresenter /></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="−" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}" /></ToggleButton>
   <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,12,0,0" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border Padding="20,16"><DockPanel>
   <Button DockPanel.Dock="Right" Click="OnClose" Style="{StaticResource IconButton}" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="16" Height="16" /></Button>
   <StackPanel><TextBlock Text="{loc:Loc DockerLibrary}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc DockerLibraryHint}" Style="{StaticResource MonitorHint}" Margin="0,5,12,0" /></StackPanel>
  </DockPanel></Border>
  <Border Grid.Row="1" Background="{DynamicResource SshRailBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1" Padding="20,8"><DockPanel>
   <Button DockPanel.Dock="Right" Command="{Binding DetectCommand}" Content="{loc:Loc DockerRefreshResources}" Style="{StaticResource MonitorActionButton}" />
   <StackPanel><TextBlock Text="{Binding Host}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource MonitorHint}" Margin="0,4,12,0" /></StackPanel>
  </DockPanel></Border>
  <Border Grid.Row="2" Background="{DynamicResource WarningWeakBrush}" Padding="20,8" Visibility="{Binding HasError, Converter={StaticResource MonitorVisible}}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Border>
  <Grid x:Name="CommandColumns" Grid.Row="3" Margin="20,16"><Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Grid x:Name="Catalog" Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc DockerChooseContainer}" Style="{StaticResource DockerLabel}" />
    <Grid Grid.Row="1"><TextBox x:Name="ContainerSearch" Text="{Binding ContainerSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc DockerContainerSearch}" AutomationProperties.Name="{loc:Loc DockerContainerSearch}" Padding="10,7" /><TextBlock Text="{loc:Loc DockerContainerSearch}" Foreground="{DynamicResource TextMutedBrush}" Margin="11,0" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ContainerSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <Grid Grid.Row="2" Margin="0,10,0,0">
     <ListBox x:Name="ContainerList" ItemsSource="{Binding ContainerView}" SelectedItem="{Binding SelectedContainer}" IsEnabled="{Binding CanEdit}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" AutomationProperties.Name="{loc:Loc DockerContainer}">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderThickness="0"><ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" CanContentScroll="True"><ItemsPresenter /></ScrollViewer></Border></ControlTemplate></ListBox.Template>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Entry" Background="{DynamicResource SshRailBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Entry" Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter TargetName="Entry" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Entry" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Entry" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" /><TextBlock Text="{Binding Image}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Image}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="{loc:Loc DockerNoContainers}" Style="{StaticResource MonitorHint}" Margin="10,20" Visibility="{Binding HasNoContainers, Converter={StaticResource MonitorVisible}}" IsHitTestVisible="False" />
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding Status}" Style="{StaticResource MonitorHint}" AutomationProperties.LiveSetting="Polite" /><Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource MonitorVisible}}" Margin="0,8,0,0" /></StackPanel>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border x:Name="EmptySelection" Background="{DynamicResource SshRailBrush}" CornerRadius="6" Padding="24" Visibility="{Binding HasNoContainer, Converter={StaticResource MonitorVisible}}"><StackPanel><TextBlock Text="{loc:Loc DockerSelectFirst}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc DockerSelectFirstHint}" Style="{StaticResource MonitorHint}" Margin="0,10,0,0" /></StackPanel></Border>
    <StackPanel x:Name="ContainerPanel" Visibility="{Binding HasContainer, Converter={StaticResource MonitorVisible}}">
     <Border Background="{DynamicResource SshRailBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="16"><StackPanel>
      <TextBlock Text="{Binding SelectedContainer.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedContainer.Name}" />
      <WrapPanel Margin="0,8,0,0"><TextBlock Text="{Binding SelectedContainer.Status}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,16,0" /><TextBlock Text="{Binding SelectedContainer.Health}" Foreground="{DynamicResource TextMutedBrush}" /></WrapPanel>
      <TextBlock Text="{Binding SelectedContainer.Image}" Style="{StaticResource MonitorHint}" Margin="0,7,0,0" />
     </StackPanel></Border>
     <TextBlock Text="{loc:Loc DockerChooseAction}" Style="{StaticResource DockerLabel}" Margin="0,20,0,10" />
     <WrapPanel IsEnabled="{Binding CanEdit}">
      <Button x:Name="LogsAction" Content="{loc:Loc DockerLogs}" Command="{Binding ActionCommand}" CommandParameter="logs" Style="{StaticResource DockerAction}" />
      <Button Content="{loc:Loc DockerResources}" Click="OnMonitor" Style="{StaticResource DockerAction}" />
      <Button Content="{loc:Loc DockerDetails}" Command="{Binding ShowDetailsCommand}" Style="{StaticResource DockerAction}" />
      <Button Content="{loc:Loc DockerStart}" Command="{Binding ActionCommand}" CommandParameter="start" Style="{StaticResource DockerAction}" />
      <Button x:Name="RestartAction" Content="{loc:Loc DockerRestart}" Command="{Binding ActionCommand}" CommandParameter="restart" Style="{StaticResource DockerAction}" />
      <Button Content="{loc:Loc DockerStop}" Command="{Binding ActionCommand}" CommandParameter="stop" Style="{StaticResource DockerAction}" />
     </WrapPanel>
     <TextBlock Text="{loc:Loc DockerActionsHint}" Style="{StaticResource MonitorHint}" Margin="0,0,0,10" />
     <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding HasValidationError, Converter={StaticResource MonitorVisible}}" Margin="0,0,0,10" />
     <Border Background="{DynamicResource SshRailBrush}" Padding="14" CornerRadius="5" Margin="0,4,0,12" Visibility="{Binding ShowDetails, Converter={StaticResource MonitorVisible}}"><StackPanel>
      <TextBlock Text="{loc:Loc SshMonitorContainerId}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding SelectedContainer.Id, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,12" />
      <TextBlock Text="{loc:Loc DockerTargetPorts}" Style="{StaticResource DockerLabel}" /><TextBlock Text="{Binding SelectedContainer.Ports}" TextWrapping="Wrap" />
     </StackPanel></Border>
     <Expander Header="{loc:Loc DockerLogOptions}" Style="{StaticResource DockerExpander}"><StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="{loc:Loc DockerTailLines}" Style="{StaticResource DockerLabel}" /><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding TailLines}" MinHeight="34" AutomationProperties.Name="{loc:Loc DockerTailLines}"><ComboBoxItem Content="{loc:Loc SshLogTail100}"><ComboBoxItem.Tag><system:Int32>100</system:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="{loc:Loc SshLogTail500}"><ComboBoxItem.Tag><system:Int32>500</system:Int32></ComboBoxItem.Tag></ComboBoxItem><ComboBoxItem Content="{loc:Loc SshLogTail1000}"><ComboBoxItem.Tag><system:Int32>1000</system:Int32></ComboBoxItem.Tag></ComboBoxItem></ComboBox>
      <TextBlock Text="{loc:Loc DockerSince}" Style="{StaticResource DockerLabel}" Margin="0,12,0,8" /><ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Since}" MinHeight="34"><ComboBoxItem Tag="" Content="{loc:Loc DockerSinceAll}" /><ComboBoxItem Tag="10m" Content="{loc:Loc DockerSince10Minutes}" /><ComboBoxItem Tag="1h" Content="{loc:Loc DockerSinceHour}" /><ComboBoxItem Tag="24h" Content="{loc:Loc DockerSinceDay}" /></ComboBox>
      <CheckBox IsChecked="{Binding Timestamps}" Content="{loc:Loc DockerTimestamps}" Margin="0,12,0,0" /><CheckBox IsChecked="{Binding Follow}" Content="{loc:Loc DockerFollow}" Margin="0,10,0,0" /><TextBlock Text="{loc:Loc DockerFollowHint}" Style="{StaticResource MonitorHint}" Margin="0,7,0,0" />
     </StackPanel></Expander>
    </StackPanel>
    <Border x:Name="OutputPanel" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="5" Margin="0,16,0,0"><StackPanel>
     <Border Background="{DynamicResource SshRailBrush}" Padding="12,8"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBox x:Name="OutputSearch" Width="100" MinHeight="28" Padding="7,4" TextChanged="OnOutputSearchChanged" ToolTip="{loc:Loc DockerSearchOutput}" AutomationProperties.Name="{loc:Loc DockerSearchOutput}" Margin="0,0,8,0" /><Button Click="OnCopyOutput" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshMonitorCopyLogs}" AutomationProperties.Name="{loc:Loc SshMonitorCopyLogs}"><controls:IconView Kind="copy" Width="14" Height="14" /></Button><Button Click="OnExportOutput" Style="{StaticResource IconButton}" ToolTip="{loc:Loc SshLogExport}" AutomationProperties.Name="{loc:Loc SshLogExport}" Margin="6,0,0,0"><controls:IconView Kind="download" Width="14" Height="14" /></Button></StackPanel><TextBlock Text="{loc:Loc DockerResult}" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel></Border>
     <TextBlock Text="{Binding ResultTarget}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,10,12,0" /><TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="12,5,12,10" />
     <Grid><TextBox x:Name="ResultOutput" Text="{Binding Output, Mode=OneWay}" TextChanged="OnOutputSearchChanged" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Height="220" AutomationProperties.Name="{loc:Loc DockerResult}" />
      <TextBlock Text="{loc:Loc DockerResultEmpty}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="{Binding HasNoOutput, Converter={StaticResource MonitorVisible}}" />
     </Grid>
    </StackPanel></Border>
    <Expander x:Name="OtherResources" Header="{loc:Loc DockerOtherResources}" Style="{StaticResource DockerExpander}"><StackPanel IsEnabled="{Binding CanEdit}">
     <TextBlock Text="{loc:Loc DockerOtherResourcesHint}" Style="{StaticResource MonitorHint}" Margin="0,0,0,12" />
     <ComboBox x:Name="OperationPicker" ItemsSource="{Binding OtherOperations}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedOtherOperation}" MinHeight="34" AutomationProperties.Name="{loc:Loc DockerChooseAction}" />
     <StackPanel Visibility="{Binding NeedsImage, Converter={StaticResource MonitorVisible}}" Margin="0,12,0,0"><TextBlock Text="{loc:Loc DockerImageReference}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /></StackPanel>
     <StackPanel Visibility="{Binding NeedsCompose, Converter={StaticResource MonitorVisible}}" Margin="0,12,0,0"><TextBlock Text="{loc:Loc DockerProjectDirectory}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding ProjectDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /><TextBlock Text="{loc:Loc DockerProjectDirectoryHint}" Style="{StaticResource MonitorHint}" Margin="0,7,0,12" /><TextBlock Text="{loc:Loc DockerComposeFile}" Style="{StaticResource DockerLabel}" /><TextBox Text="{Binding ComposeFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /><TextBlock Text="{loc:Loc DockerService}" Style="{StaticResource DockerLabel}" Margin="0,12,0,8" /><TextBox Text="{Binding Service, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DockerField}" /><TextBlock Text="{loc:Loc DockerServiceHint}" Style="{StaticResource MonitorHint}" Margin="0,7,0,0" /></StackPanel>
     <Button x:Name="ExecuteAction" Content="{Binding OperationTitle}" Command="{Binding ExecuteCommand}" Style="{StaticResource DockerAction}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding IsOtherOperation, Converter={StaticResource MonitorVisible}}" />
     <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel></Expander>
    <Expander x:Name="CommandDetails" Header="{loc:Loc DockerAdvancedDetails}" Style="{StaticResource DockerExpander}"><StackPanel>
     <TextBlock Text="{loc:Loc DockerAdvancedHint}" Style="{StaticResource MonitorHint}" Margin="0,0,0,8" /><TextBox x:Name="CommandPreview" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource SshRailBrush}" Foreground="{DynamicResource TextBodyBrush}" FontFamily="{DynamicResource MonoFont}" Padding="10" MinHeight="50" />
     <TextBlock Text="{Binding Compatibility}" Style="{StaticResource MonitorHint}" Margin="0,8,0,0" /><WrapPanel Margin="0,10,0,0"><Button Content="{loc:Loc DockerCopyCommand}" Click="OnCopyCommand" Style="{StaticResource DockerAction}" /><Button Content="{loc:Loc DockerInsert}" Command="{Binding InsertCommand}" Style="{StaticResource DockerAction}" /></WrapPanel>
    </StackPanel></Expander>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
