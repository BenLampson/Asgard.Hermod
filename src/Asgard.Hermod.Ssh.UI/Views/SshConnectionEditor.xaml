<UserControl x:Class="Asgard.Hermod.Ssh.UI.Views.SshConnectionEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" Focusable="True">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
 <StackPanel>
  <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
   <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Loc SshChangeRoute}" Command="{Binding Wizard.PreviousCommand}" Style="{StaticResource GhostButton}" Height="24" />
    <controls:IconView Kind="route" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
    <TextBlock Text="{Binding RouteSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
   </DockPanel>
  </Border>
  <controls:FormField Label="{loc:Loc InstanceName}" IsRequired="True" Error="{Binding Wizard.NameError}" Margin="0,0,0,14">
   <TextBox x:Name="SshNameInput" Text="{Binding Wizard.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" AutomationProperties.Name="{loc:Loc InstanceName}" />
  </controls:FormField>
  <controls:SegmentedSelector x:Name="ConnectionPaneSelector" ItemsSource="{Binding Panes}" DisplayMemberPath="Name"
                              SelectedValue="{Binding SelectedPane, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id"
                              Visibility="{Binding HasPanes, Converter={StaticResource Visible}}" Margin="0,0,0,14"
                              AutomationProperties.Name="{loc:Loc SshConnectionDetails}" />
  <StackPanel Visibility="{Binding IsHostPane, Converter={StaticResource Visible}}">
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="106" /></Grid.ColumnDefinitions>
    <controls:InstanceConfigurationFieldEditor DataContext="{Binding Host}" Margin="0,0,12,0" />
    <controls:InstanceConfigurationFieldEditor Grid.Column="1" DataContext="{Binding Port}" />
   </Grid>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <controls:InstanceConfigurationFieldEditor DataContext="{Binding User}" Margin="0,0,12,0" />
    <controls:InstanceConfigurationFieldEditor Grid.Column="1" DataContext="{Binding Authentication}" />
   </Grid>
   <controls:InstanceConfigurationFieldEditor DataContext="{Binding Password}" Margin="0,0,0,14" />
   <controls:InstanceConfigurationFieldEditor DataContext="{Binding KeyFile}" Margin="0,0,0,14" />
   <controls:InstanceConfigurationFieldEditor DataContext="{Binding Passphrase}" Margin="0,0,0,14" />
   <TextBlock Text="{loc:Loc SshAgentHint}" Visibility="{Binding UsesAgent, Converter={StaticResource Visible}}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
  </StackPanel>
  <StackPanel Visibility="{Binding IsProxyPane, Converter={StaticResource Visible}}">
   <controls:InstanceConfigurationFieldEditor DataContext="{Binding ProxyType}" Margin="0,0,0,14" />
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="106" /></Grid.ColumnDefinitions>
    <controls:InstanceConfigurationFieldEditor DataContext="{Binding ProxyHost}" Margin="0,0,12,0" />
    <controls:InstanceConfigurationFieldEditor Grid.Column="1" DataContext="{Binding ProxyPort}" />
   </Grid>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <controls:InstanceConfigurationFieldEditor DataContext="{Binding ProxyUser}" Margin="0,0,12,0" />
    <controls:InstanceConfigurationFieldEditor Grid.Column="1" DataContext="{Binding ProxyPassword}" />
   </Grid>
   <controls:InstanceConfigurationFieldEditor DataContext="{Binding ProxyDns}" Margin="0,0,0,14" />
  </StackPanel>
  <StackPanel Visibility="{Binding IsBastion, Converter={StaticResource Visible}}">
   <controls:InstanceConfigurationFieldEditor DataContext="{Binding BastionSelection}" Margin="0,0,0,14" />
   <TextBlock Text="{loc:Loc SshBastionCapabilities}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />
  </StackPanel>
  <Expander Header="{loc:Loc SshAdvanced}" Margin="0,4,0,14"><StackPanel>
   <controls:InstanceConfigurationFieldEditor DataContext="{Binding Timeout}" Margin="0,10,0,0" />
   <StackPanel Visibility="{Binding IsBastion, Converter={StaticResource Visible}}">
    <controls:InstanceConfigurationFieldEditor DataContext="{Binding BastionMenuPrompt}" Margin="0,10,0,0" />
    <controls:InstanceConfigurationFieldEditor DataContext="{Binding BastionShellPrompt}" Margin="0,10,0,0" />
   </StackPanel>
  </StackPanel></Expander>
  <TextBlock Text="{loc:Loc SshCredentialHint}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
 </StackPanel>
</UserControl>
