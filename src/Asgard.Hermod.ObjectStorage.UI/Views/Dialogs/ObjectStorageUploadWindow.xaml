<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Dialogs.ObjectStorageUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Dialogs"
        Title="{loc:Loc UploadObjects}" Width="600" Height="620" ResizeMode="NoResize"
        AllowDrop="True" PreviewDragOver="OnDragOver" Drop="OnDrop">
    <dialogs:ObjectStorageDialogWindow.Resources><BooleanToVisibilityConverter x:Key="UploadVisibility" /></dialogs:ObjectStorageDialogWindow.Resources>
    <dialogs:ObjectStorageDialogWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Padding="20,0" Background="{DynamicResource SurfaceBrush}" HorizontalContentAlignment="Stretch">
            <Grid>
                <TextBlock Text="{loc:Loc UploadToCurrentBucket}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource StandardButton}" Height="32" Padding="14,0" Margin="0,0,10,0" />
                    <Button x:Name="UploadButton" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconView Kind="upload" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource InverseTextBrush}" />
                            <TextBlock Text="{loc:Loc StartUpload}" Foreground="{DynamicResource InverseTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc UploadTo}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Location}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
            </Grid>
            <Border x:Name="DropArea" Height="142" CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,0,18">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:IconView Kind="upload" Width="26" Height="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock Text="{loc:Loc DropFilesHere}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="SelectFilesButton" Command="{Binding SelectFilesCommand}" Height="32" Padding="14,0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal"><controls:IconView Kind="file-plus" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc SelectFiles}" /></StackPanel>
                        </Button>
                        <Button Command="{Binding SelectFolderCommand}" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal"><controls:IconView Kind="folder-plus" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc SelectFolder}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12" Visibility="{Binding IsAdding, Converter={StaticResource UploadVisibility}}" />
            <Grid Margin="0,0,0,10">
                <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
            </Grid>
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="UploadItems" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                <controls:IconView Kind="{Binding Icon}" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,6,0" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=dialogs:ObjectStorageUploadWindow}}"
                                        CommandParameter="{Binding}" Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="{loc:Loc Remove}" AutomationProperties.Name="{loc:Loc RemoveUploadItem}">
                                    <controls:IconView Kind="x" Width="14" Height="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc WhenAnObjectAlreadyExists}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ComboBox x:Name="OverwriteSelector" ItemsSource="{Binding OverwriteChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding OverwritePolicy, Mode=TwoWay}" Width="160" Height="32" IsEnabled="{Binding CanAddPaths}" AutomationProperties.Name="{loc:Loc ExistingObjectPolicy}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</dialogs:ObjectStorageDialogWindow>
