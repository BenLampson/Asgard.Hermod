<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Dialogs.ObjectStorageForcePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Dialogs"
        Title="{loc:Loc ForcePreview}" Width="548" Height="536" ResizeMode="NoResize">
    <dialogs:ObjectStorageDialogWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Height="32" Padding="14,0" Margin="0,0,10,0" />
                <Button Content="{loc:Loc ForcePreviewConfirm}" Command="{Binding ConfirmCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" />
            </StackPanel>
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Loc ForcePreviewQuestion}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{Binding Size, StringFormat={loc:Loc ForcePreviewObjectSize}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,16" />
            <TextBlock Text="{Binding TypeMessage}" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <TextBlock Text="{loc:Loc ForcePreviewType}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid>
                <ComboBox x:Name="PreviewTypeSelector" ItemsSource="{Binding Options}" DisplayMemberPath="Name" SelectedValuePath="Type"
                          SelectedValue="{Binding SelectedType, Mode=TwoWay}" Height="36" AutomationProperties.Name="{loc:Loc ForcePreviewType}" />
                <TextBlock Text="{loc:Loc ForcePreviewSelectType}" Margin="12,0,32,0" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedType}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Text="{loc:Loc ForcePreviewImageOnly}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,16" />
            <Border Background="{DynamicResource WarningWeakBrush}" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <controls:IconView Kind="triangle-alert" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc ForcePreviewTrafficCharges}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding TrafficWarning}" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{loc:Loc ForcePreviewReadOnly}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</dialogs:ObjectStorageDialogWindow>
