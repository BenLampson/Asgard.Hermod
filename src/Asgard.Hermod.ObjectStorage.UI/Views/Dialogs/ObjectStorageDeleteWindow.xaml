<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Dialogs.ObjectStorageDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Dialogs"
        Title="{loc:Loc DeleteObjects2}" Width="620" Height="420" MinWidth="460" MinHeight="340"
        FocusManager.FocusedElement="{Binding ElementName=DismissButton}">
    <dialogs:ObjectStorageDialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </dialogs:ObjectStorageDialogWindow.Resources>
    <dialogs:ObjectStorageDialogWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding DismissCommand}" />
    </dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DismissButton" Content="{Binding DismissLabel}" Command="{Binding DismissCommand}" Height="32" Padding="14,0" />
                <!-- 删除只能通过主动确认开始，Enter 不默认触发。 -->
                <Button x:Name="ConfirmButton" Content="{loc:Loc Delete}" Command="{Binding ConfirmCommand}" Height="32" Padding="14,0" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Background="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}"
                        Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" />
            </StackPanel>
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:IconView Kind="triangle-alert" Width="20" Height="20" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"
                                   Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" />
                <TextBlock Grid.Column="1" Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}" TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource MonoFont}"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />
            <TextBlock Text="{Binding Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" />
        </StackPanel>
        <ItemsControl x:Name="SelectedKeys" Grid.Row="1" ItemsSource="{Binding Keys}" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                      Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" Focusable="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="{loc:Loc ObjectStorageDeleteSelection}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,8" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfirming}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <ProgressBar x:Name="DeleteProgress" Height="8" Minimum="0" Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineSoftBrush}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}"
                             AutomationProperties.Name="{Binding Heading}" />
                <TextBlock Text="{Binding ProgressText}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Outcome}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</dialogs:ObjectStorageDialogWindow>
