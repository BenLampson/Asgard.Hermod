<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Dialogs.ObjectStorageFolderPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Dialogs"
        Title="{loc:Loc FolderProperties}" Width="560" Height="500" MinWidth="460" MinHeight="420">
    <dialogs:ObjectStorageDialogWindow.Resources><BooleanToVisibilityConverter x:Key="Visible" /></dialogs:ObjectStorageDialogWindow.Resources>
    <dialogs:ObjectStorageDialogWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Close}" Command="{Binding CancelCommand}" Height="32" Margin="0,0,10,0" />
                <Button Content="{loc:Loc Cancel}" Command="{Binding StopCommand}" Height="32" Margin="0,0,10,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                <Button x:Name="StartButton" Content="{loc:Loc StartFolderStatistics}" Command="{Binding StartCommand}" Height="32" IsDefault="True">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsComplete}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel>
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><controls:IconView Kind="folder" Width="28" Height="28" Margin="0,0,12,0" /><TextBlock Text="{loc:Loc FolderProperties}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Location}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="ScanProgress" IsIndeterminate="{Binding IsRunning}" Height="6" Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" AutomationProperties.Name="{loc:Loc FolderStatisticsScanning}" />
            <Grid x:Name="PropertiesPanel" Margin="0,22,0,0" Visibility="{Binding IsComplete, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc FileTypeColumn}" Margin="0,0,24,16" /><TextBlock Grid.Column="1" Text="{loc:Loc FileTypeFolder}" />
                <TextBlock Grid.Row="1" Text="{loc:Loc Size}" Margin="0,0,24,16" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Size}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="{loc:Loc FolderStatisticsContents}" Margin="0,0,24,16" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Contains}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="{loc:Loc DirectoryLatestModified}" Margin="0,0,24,0" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Modified}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</dialogs:ObjectStorageDialogWindow>
