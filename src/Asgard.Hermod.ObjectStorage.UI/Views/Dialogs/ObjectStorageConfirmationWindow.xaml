<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Dialogs.ObjectStorageConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Dialogs"
        Title="{Binding Title}" Width="620" Height="420" ResizeMode="NoResize">
    <dialogs:ObjectStorageDialogWindow.Resources><BooleanToVisibilityConverter x:Key="ConfirmationVisibility" /></dialogs:ObjectStorageDialogWindow.Resources>
    <dialogs:ObjectStorageDialogWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消" Command="{Binding CancelCommand}" Height="32" Padding="14,0" Margin="0,0,10,0"
                        Visibility="{Binding RequiresConfirmation, Converter={StaticResource ConfirmationVisibility}}" />
                <!-- 不设置默认确认，危险操作必须主动点击。 -->
                <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Height="32" Padding="14,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <controls:IconView Kind="triangle-alert" Width="20" Height="20" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"
                                   Visibility="{Binding IsDestructive, Converter={StaticResource ConfirmationVisibility}}" />
                <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Location}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ObjectKeys" ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" Margin="0,0,0,8" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</dialogs:ObjectStorageDialogWindow>
