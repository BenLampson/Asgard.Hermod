<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Dialogs.ObjectStorageFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Dialogs"
        Title="新建文件夹" Width="520" Height="340" ResizeMode="NoResize">
    <dialogs:ObjectStorageDialogWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="取消" Command="{Binding CancelCommand}" Height="32" Padding="14,0" Margin="0,0,10,0" />
                <Button x:Name="CreateButton" Content="创建" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" IsDefault="True" />
            </StackPanel>
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="新建文件夹" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Text="{Binding Location}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <controls:FormField Label="名称" IsRequired="True" Error="{Binding Error}" Hint="名称不可包含 / 或 \；当前目录下重名时提示更换名称。">
                <TextBox x:Name="NameInput" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" AutomationProperties.Name="文件夹名称" />
            </controls:FormField>
        </StackPanel>
    </ScrollViewer>
</dialogs:ObjectStorageDialogWindow>
