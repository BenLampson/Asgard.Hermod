<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Dialogs.ObjectStorageFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Dialogs"
        Title="{loc:Loc NewFolder}" Width="520" Height="340" ResizeMode="NoResize">
    <dialogs:ObjectStorageDialogWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Height="32" Padding="14,0" Margin="0,0,10,0" />
                <Button x:Name="CreateButton" Content="{loc:Loc Create}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" IsDefault="True" />
            </StackPanel>
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Loc NewFolder}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Text="{Binding Location}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <controls:FormField Label="{loc:Loc Name}" IsRequired="True" Error="{Binding Error}" Hint="{loc:Loc NamesCannotContainOrChooseADifferentNameIfItAlreadyExistsInThisDirectory}">
                <TextBox x:Name="NameInput" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36" AutomationProperties.Name="{loc:Loc FolderName}" />
            </controls:FormField>
        </StackPanel>
    </ScrollViewer>
</dialogs:ObjectStorageDialogWindow>
