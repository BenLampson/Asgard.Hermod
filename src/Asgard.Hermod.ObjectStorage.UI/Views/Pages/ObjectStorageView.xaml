<UserControl x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Pages.ObjectStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
             xmlns:pages="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Pages"
             Background="{DynamicResource SurfaceBrush}" FontFamily="{DynamicResource UiFont}">
    <Grid>
        <Grid.Resources><BooleanToVisibilityConverter x:Key="DetailsVisible" /></Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <!-- 页头只使用安全摘要；在线状态由实际读取结果决定。 -->
        <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="24,22,24,18" MinHeight="86">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <controls:IconView Kind="{Binding Instance.TypeIcon}" Width="22" Height="22" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <controls:InstanceNameButton Instance="{Binding Instance}" FontSize="20" HorizontalAlignment="Left" MaxWidth="340" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ItemsControl Grid.Column="3" ItemsSource="{Binding Tags}" VerticalAlignment="Center" MaxWidth="240">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border CornerRadius="5" Background="{DynamicResource SuccessWeakBrush}" Padding="8,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:StatusBadge Grid.Column="4" Text="{Binding Status}" Tone="{Binding StatusTone}" IsInline="True" VerticalAlignment="Center" Margin="10,0,14,0" />
                <Button Grid.Column="5" x:Name="EditConnectionButton" Command="{Binding EditConnectionCommand}" Width="32" Height="32" Padding="7"
                        ToolTip="{Binding EditConnectionHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc EditObjectStorageConnection}">
                    <controls:IconView Kind="settings-2" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="BrowserPanels">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*" /><ColumnDefinition x:Name="SplitterColumn" Width="6" /><ColumnDefinition x:Name="DetailsColumn" Width="278" /></Grid.ColumnDefinitions>
            <pages:ObjectStorageListView />
            <GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Background="{DynamicResource LineSoftBrush}"
                          KeyboardIncrement="16" DragIncrement="1" ToolTip="{loc:Loc ResizeObjectDetails}" AutomationProperties.Name="{loc:Loc ResizeObjectDetails}"
                          Visibility="{Binding IsDetailsOpen, Converter={StaticResource DetailsVisible}}">
                <GridSplitter.Template><ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border Width="1" HorizontalAlignment="Center" Background="{TemplateBinding Background}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" Margin="0,2" />
                            <Rectangle Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" Margin="0,2" />
                            <Rectangle Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" Margin="0,2" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate></GridSplitter.Template>
            </GridSplitter>
            <pages:ObjectStorageDetailsView Grid.Column="2" Visibility="{Binding IsDetailsOpen, Converter={StaticResource DetailsVisible}}" />
        </Grid>
    </Grid>
</UserControl>
