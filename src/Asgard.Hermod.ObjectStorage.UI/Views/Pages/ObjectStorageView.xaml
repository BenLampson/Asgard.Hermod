<UserControl x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Pages.ObjectStorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
             xmlns:pages="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Pages"
             Background="{DynamicResource SurfaceBrush}" FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="DetailsVisible" /></UserControl.Resources>
    <Grid>
    <Grid x:Name="BrowserSurface" IsEnabled="{Binding IsConnectionInteractionEnabled}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <!-- 页头只使用安全摘要；在线状态由实际读取结果决定。 -->
        <controls:WorkspaceHeader State="{Binding Connection}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}">
            <controls:WorkspaceHeader.IdentityContent><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <controls:IconView Kind="{Binding Instance.TypeIcon}" Width="28" Height="28" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><controls:InstanceNameButton Instance="{Binding Instance}" FontSize="14" HorizontalAlignment="Stretch" /><TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Grid></controls:WorkspaceHeader.IdentityContent>
            <controls:WorkspaceHeader.StatusContent><StackPanel Orientation="Horizontal"><controls:StatusBadge Style="{DynamicResource WorkspaceHeaderSecondaryStatus}" Text="{Binding Instance.EnvironmentLabel}" Tone="{Binding Instance.EnvironmentTone}" ShowIndicator="False" Margin="0,0,10,0" /><controls:StatusBadge Text="{Binding Status}" Tone="{Binding StatusTone}" ShowIndicator="False" /></StackPanel></controls:WorkspaceHeader.StatusContent>
            <controls:WorkspaceHeader.ActionsContent><Button x:Name="EditConnectionButton" Command="{Binding EditConnectionCommand}" Width="32" Height="32" Padding="7" ToolTip="{Binding EditConnectionHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc EditObjectStorageConnection}"><controls:IconView Kind="settings-2" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" /></Button></controls:WorkspaceHeader.ActionsContent>
        </controls:WorkspaceHeader>
        <Grid Grid.Row="1" x:Name="BrowserPanels">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="*" /><ColumnDefinition x:Name="SplitterColumn" Width="6" /><ColumnDefinition x:Name="DetailsColumn" Width="278" /></Grid.ColumnDefinitions>
            <pages:ObjectStorageListView />
            <GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Background="{DynamicResource LineSoftBrush}"
                          KeyboardIncrement="16" DragIncrement="1" ToolTip="{loc:Loc ResizeObjectDetails}" AutomationProperties.Name="{loc:Loc ResizeObjectDetails}"
                          Visibility="{Binding IsDetailsOpen, Converter={StaticResource DetailsVisible}}">
                <GridSplitter.Template><ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border Width="1" HorizontalAlignment="Center" Background="{TemplateBinding Background}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" Margin="0,2" />
                            <Rectangle Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" Margin="0,2" />
                            <Rectangle Width="2" Height="2" Fill="{DynamicResource TextMutedBrush}" Margin="0,2" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate></GridSplitter.Template>
            </GridSplitter>
            <pages:ObjectStorageDetailsView Grid.Column="2" Visibility="{Binding IsDetailsOpen, Converter={StaticResource DetailsVisible}}" />
        </Grid>
    </Grid>
    <controls:WorkspaceConnectionOverlay CloseWorkspaceCommand="{Binding CloseWindowCommand}" State="{Binding Connection}" TargetName="{Binding Name}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}" Visibility="{Binding Connection.IsOpen, Converter={StaticResource DetailsVisible}}" Panel.ZIndex="100" />
    </Grid>
</UserControl>
