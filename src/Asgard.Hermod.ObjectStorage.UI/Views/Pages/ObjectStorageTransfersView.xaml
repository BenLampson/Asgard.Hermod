<UserControl x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Pages.ObjectStorageTransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="OssTransferVisible" />
        <!-- 只替换折叠外观，保留标准 ToggleButton 的键盘和展开行为。 -->
        <Style TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="5,5,0,0">
                    <StackPanel>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Height="38" Content="{TemplateBinding Header}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="10,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="13" /></Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                                    <controls:IconView Grid.Column="1" Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}">
                                        <controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Kind" Value="chevron-down" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Kind" Value="chevron-up" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style>
                                    </controls:IconView>
                                </Grid>
                            </Border></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="TaskContent" Content="{TemplateBinding Content}" Margin="10,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="TaskContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Expander IsExpanded="{Binding IsTransferExpanded, Mode=TwoWay}" Background="{DynamicResource AppBackgroundBrush}" Padding="10" BorderThickness="0">
        <Expander.Header><DockPanel Height="28" LastChildFill="False">
            <controls:IconView Kind="arrow-up-down" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" />
            <TextBlock Text="{loc:Loc TransferTasks}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="{Binding TransferSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
        </DockPanel></Expander.Header>
        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Transfers}" Margin="0,12,0,8">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,0,0,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="15" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <controls:IconView Kind="{Binding Icon}" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" /><TextBlock Text="{Binding Error}" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock></StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{loc:Loc Retry}" Command="{Binding RetryCommand}" Height="32" Margin="10,0,0,0" Visibility="{Binding CanRetry, Converter={StaticResource OssTransferVisible}}" />
                            <Button Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" Width="22" Height="22" Margin="8,0,0,0" ToolTip="{loc:Loc CancelCurrentTask}" Visibility="{Binding IsRunning, Converter={StaticResource OssTransferVisible}}"><controls:IconView Kind="x" Width="13" Height="13" /></Button>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="5" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineSoftBrush}" BorderThickness="0" Visibility="{Binding IsRunning, Converter={StaticResource OssTransferVisible}}" />
                    </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Expander>
</UserControl>
