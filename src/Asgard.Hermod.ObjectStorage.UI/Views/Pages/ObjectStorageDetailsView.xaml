<UserControl x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Pages.ObjectStorageDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="OssDetailVisible" />
        <Style x:Key="OssMetadataLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="Margin" Value="0,0,8,12" /></Style>
        <Style x:Key="OssMetadataValue" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceBrush}" Padding="20,22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Command="{Binding CloseDetailsCommand}" Style="{StaticResource IconButton}" Width="20" Height="20" Padding="3" ToolTip="关闭对象详情" Visibility="{Binding HasDetailSelection, Converter={StaticResource OssDetailVisible}}"><controls:IconView Kind="x" Width="15" Height="15" /></Button>
                <TextBlock Text="对象详情" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,20" Visibility="{Binding HasDetailSelection, Converter={StaticResource OssDetailVisible}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:IconView Kind="{Binding DetailIcon}" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding DetailName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailName}" VerticalAlignment="Center" />
                    </Grid>
                    <Border CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" Padding="14" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding HasTextPreview, Converter={StaticResource OssDetailVisible}}">
                                <Button DockPanel.Dock="Right" Command="{Binding CopyPreviewCommand}" Style="{StaticResource IconButton}" Width="19" Height="19" Padding="3" ToolTip="复制文本预览"><controls:IconView Kind="copy" Width="13" Height="13" /></Button>
                                <TextBlock Text="{Binding PreviewFormat}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- 内容仅为只读文本，保留选择和复制，不创建浏览器或富文本执行器。 -->
                            <TextBox Grid.Row="1" x:Name="PreviewTextBox" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextBodyBrush}" Visibility="{Binding HasTextPreview, Converter={StaticResource OssDetailVisible}}"
                                     AutomationProperties.Name="对象只读文本预览" />
                            <TextBlock Grid.Row="2" Text="{Binding PreviewMessage}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasTextPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Visibility="{Binding HasFileSelection, Converter={StaticResource OssDetailVisible}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="大小" Style="{StaticResource OssMetadataLabel}" /><TextBlock Grid.Column="1" Text="{Binding DetailSize}" Style="{StaticResource OssMetadataValue}" />
                        <TextBlock Grid.Row="1" Text="更新于" Style="{StaticResource OssMetadataLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailModified}" Style="{StaticResource OssMetadataValue}" />
                        <TextBlock Grid.Row="2" Text="存储类型" Style="{StaticResource OssMetadataLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailStorageClass}" Style="{StaticResource OssMetadataValue}" />
                        <TextBlock Grid.Row="3" Text="访问权限" Style="{StaticResource OssMetadataLabel}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailAccess}" Style="{StaticResource OssMetadataValue}" />
                        <TextBlock Grid.Row="4" Text="Content-Type" Style="{StaticResource OssMetadataLabel}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailContentType}" Style="{StaticResource OssMetadataValue}" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Visibility="{Binding HasDetailSelection, Converter={StaticResource OssDetailVisible}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Command="{Binding CopyKeyCommand}" Style="{StaticResource IconButton}" Width="19" Height="19" Padding="3" ToolTip="复制 Object Key"><controls:IconView Kind="copy" Width="13" Height="13" /></Button><TextBlock Text="Object Key" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></DockPanel>
                            <TextBlock Text="{Binding SelectedEntry.Key}" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextBodyBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,20,0,0" Visibility="{Binding HasFileSelection, Converter={StaticResource OssDetailVisible}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <Button Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" AutomationProperties.Name="下载当前对象">
                    <StackPanel Orientation="Horizontal"><controls:IconView Kind="download" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="下载" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" /></StackPanel>
                </Button>
                <Button Grid.Column="2" Click="OnMoreClick" Width="32" Height="32" Padding="7" ToolTip="当前对象更多操作" AutomationProperties.Name="当前对象更多操作"><controls:IconView Kind="ellipsis" Width="16" Height="16" /></Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
