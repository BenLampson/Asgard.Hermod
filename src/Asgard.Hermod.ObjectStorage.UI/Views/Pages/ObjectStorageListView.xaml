<UserControl x:Class="Asgard.Hermod.ObjectStorage.UI.Views.Pages.ObjectStorageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI"
             xmlns:pages="clr-namespace:Asgard.Hermod.ObjectStorage.UI.Views.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="OssVisible" />
        <Style x:Key="OssError" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}" /><Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12" /><Setter Property="Visibility" Value="Visible" />
            <Style.Triggers><DataTrigger Binding="{Binding DisplayActionError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OssRow" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowKeyboardFocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Stretch" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AppBackgroundBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,22,22,0">
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="18" /><RowDefinition Height="32" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="46" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="8" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
            <controls:SearchableSelect x:Name="BucketSelector" ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket, Mode=OneWay}"
                                      DisplayMemberPath="Name" Icon="box" Height="32" SelectionCommitted="OnBucketSelected" AutomationProperties.Name="{loc:Loc SwitchBucket}" />
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <ItemsControl ItemsSource="{Binding DirectoryBreadcrumbs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                        <controls:IconView Kind="chevron-right" Width="12" Height="12" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Content="{Binding Name}" Command="{Binding NavigateCommand}" Width="Auto" Height="32" Padding="0" FontSize="12" Margin="0,0,8,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" /><Setter Property="FontWeight" Value="Normal" /><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Grid.Column="3" Command="{Binding RefreshCommand}" Width="32" Height="32" Padding="7" ToolTip="{loc:Loc RefreshObjectList}" AutomationProperties.Name="{loc:Loc RefreshObjectList}">
                <controls:IconView Kind="refresh-cw" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" />
            </Button>
            <Button Grid.Column="5" Command="{Binding ToggleDetailsCommand}" Width="32" Height="32" Padding="7" ToolTip="{Binding DetailsToggleLabel}" AutomationProperties.Name="{Binding DetailsToggleLabel}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDetailsOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                <controls:IconView Kind="panel-left" Width="16" Height="16" RenderTransformOrigin="0.5,0.5"><controls:IconView.RenderTransform><ScaleTransform ScaleX="-1" /></controls:IconView.RenderTransform></controls:IconView>
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" MinWidth="80" MaxWidth="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" AutomationProperties.Name="{loc:Loc UploadObjects}">
                <StackPanel Orientation="Horizontal"><controls:IconView Kind="upload" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc Upload}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold" /></StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{Binding NewFolderCommand}" Height="32" Padding="14,0" AutomationProperties.Name="{loc:Loc NewObjectFolder}">
                <StackPanel Orientation="Horizontal"><controls:IconView Kind="folder-plus" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc NewFolder}" FontWeight="SemiBold" /></StackPanel>
            </Button>
            <Grid Grid.Column="4">
                <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="32" MinHeight="32" Padding="30,0,25,0" FontSize="11"
                         Background="{DynamicResource AppBackgroundBrush}" ToolTip="{loc:Loc SearchNamesInTheCurrentDirectory}" AutomationProperties.Name="{loc:Loc SearchNamesInTheCurrentDirectory}" />
                <controls:IconView Kind="search" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
                <TextBlock Text="{loc:Loc SearchNames}" Margin="30,0,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SearchText}" Value="" /><Condition Binding="{Binding ShowSearchDecorations, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <Button Command="{Binding ClearSearchCommand}" Width="24" Height="24" HorizontalAlignment="Right" Padding="5" ToolTip="{loc:Loc ClearSearch}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowSearchDecorations, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    <controls:IconView Kind="x" Width="12" Height="12" />
                </Button>
            </Grid>
            <Button x:Name="SearchHelpButton" Grid.Column="5" Style="{StaticResource IconButton}" Width="24" Height="24" Padding="5" Margin="6,0,0,0"
                    AutomationProperties.Name="{loc:Loc ObjectSearchHelp}" AutomationProperties.HelpText="{loc:Loc ObjectSearchSyntax}"
                    Click="OnSearchHelp" GotKeyboardFocus="OnSearchHelp" LostKeyboardFocus="OnSearchHelpLostFocus">
                <Button.ToolTip><ToolTip><TextBlock Text="{loc:Loc ObjectSearchSyntax}" MaxWidth="340" TextWrapping="Wrap" /></ToolTip></Button.ToolTip>
                <controls:IconView Kind="info" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
            </Button>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Grid MinHeight="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="ScanDirectoryButton" Command="{Binding ScanDirectoryCommand}" Height="32" Padding="14,0" ToolTip="{loc:Loc DirectoryScanScope}" AutomationProperties.Name="{loc:Loc GetModificationTimesAndSort}">
                    <StackPanel Orientation="Horizontal"><controls:IconView Kind="arrow-down-wide-narrow" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{loc:Loc GetModificationTimesAndSort}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{loc:Loc DirectoryScanScope}" ToolTip="{loc:Loc DirectoryScanScope}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid x:Name="DirectoryScanStatusBar" MinHeight="32" Margin="0,8,0,0" Visibility="{Binding HasScanStatus, Converter={StaticResource OssVisible}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="23" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style x:Key="ScanText" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanSuccessful}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsScanPaused}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <controls:IconView Width="15" Height="15" VerticalAlignment="Center">
                    <controls:IconView.Style><Style TargetType="controls:IconView">
                        <Setter Property="Kind" Value="info" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanSuccessful}" Value="True"><Setter Property="Kind" Value="circle-check" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsScanning}" Value="True"><Setter Property="Kind" Value="loader-circle" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsScanPaused}" Value="True"><Setter Property="Kind" Value="triangle-alert" /><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style></controls:IconView.Style>
                </controls:IconView>
                <TextBlock Grid.Column="1" Text="{Binding ScanStatus}" Style="{StaticResource ScanText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,8,4" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Cancel}" Command="{Binding CancelDirectoryScanCommand}" Height="28" MinHeight="28" Padding="14,0" Visibility="{Binding IsScanning, Converter={StaticResource OssVisible}}" />
                    <Button Content="{loc:Loc Continue}" Command="{Binding ContinueDirectoryScanCommand}" Style="{StaticResource PrimaryButton}" Height="28" MinHeight="28" Padding="14,0" Margin="8,0,0,0" Visibility="{Binding IsScanPaused, Converter={StaticResource OssVisible}}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <Border Grid.Row="4" Style="{StaticResource OssError}" Margin="0,12,0,0">
            <DockPanel><Button DockPanel.Dock="Right" Command="{Binding ClearErrorCommand}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc DismissNotification}"><controls:IconView Kind="x" Width="12" Height="12" /></Button>
                <TextBlock Text="{Binding DisplayActionError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></DockPanel>
        </Border>
        <Border Grid.Row="5" Background="{DynamicResource AccentWeakBrush}" Padding="10,8" CornerRadius="5" Margin="0,12,0,0" Visibility="{Binding HasCheckedEntries, Converter={StaticResource OssVisible}}">
            <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Loc Download}" Command="{Binding BatchDownloadCommand}" Height="32" Margin="0,0,8,0" />
                <Button Content="{loc:Loc Delete}" Command="{Binding DeleteCommand}" Height="32" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" />
                <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource IconButton}" ToolTip="{loc:Loc ClearObjectSelection}"><controls:IconView Kind="x" Width="14" Height="14" /></Button>
            </StackPanel><TextBlock Text="{Binding CheckedCount, StringFormat={loc:Loc ObjectsSelected}}" VerticalAlignment="Center" /></DockPanel>
        </Border>
        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="5" Padding="10,0" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding FileTypeColumnWidth, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" /><ColumnDefinition Width="84" /><ColumnDefinition Width="{Binding StorageColumnWidth, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" /><ColumnDefinition Width="{Binding ModifiedColumnWidth, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                    <controls:SelectionCheckBox IsChecked="{Binding IsAllChecked, Mode=TwoWay}" IsThreeState="True" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc SelectAllObjectsOnThisPage}" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc Name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc FileTypeColumn}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Visibility="{Binding FileTypeColumnVisibility, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" />
                    <TextBlock Grid.Column="3" Text="{loc:Loc Size}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{loc:Loc StorageClass}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Visibility="{Binding StorageColumnVisibility, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" />
                    <TextBlock Grid.Column="5" Text="{Binding ModifiedHeading}" ToolTip="{loc:Loc DirectoryModifiedMeaning}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Visibility="{Binding ModifiedColumnVisibility, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" />
                </Grid>
            </Border>
            <ListBox Grid.Row="1" x:Name="ObjectRows" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource OssRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="OnObjectDoubleClick" PreviewMouseRightButtonDown="OnRowRightClick" PreviewKeyDown="OnRowKeyDown" AutomationProperties.Name="{loc:Loc ObjectList}">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding FileTypeColumnWidth, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" /><ColumnDefinition Width="84" /><ColumnDefinition Width="{Binding StorageColumnWidth, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" /><ColumnDefinition Width="{Binding ModifiedColumnWidth, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat={loc:Loc SelectObject}}" />
                        <Grid Grid.Column="1" Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:IconView Kind="{Binding Icon}" Width="18" Height="18" ForegroundResourceKey="{Binding IconBrushKey}" ToolTip="{Binding TypeName}" />
                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Key}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontWeight" Value="Normal" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding TypeName}" ToolTip="{Binding TypeName}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" Visibility="{Binding FileTypeColumnVisibility, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" />
                        <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding StorageClass}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding StorageColumnVisibility, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" />
                        <TextBlock Grid.Column="5" Text="{Binding Modified}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Visibility="{Binding ModifiedColumnVisibility, RelativeSource={RelativeSource AncestorType=pages:ObjectStorageListView}}" />
                        <!-- 保留 16px 图标列对齐，同时为 28px 按钮释放完整命中和焦点描边空间。 -->
                        <Button Grid.Column="6" Click="OnMoreClick" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="-6,0" HorizontalAlignment="Center" ToolTip="{loc:Loc MoreObjectActions}" AutomationProperties.Name="{Binding Name, StringFormat={loc:Loc MoreActionsForObject}}"><controls:IconView Kind="ellipsis" Width="16" Height="16" /></Button>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" Visibility="{Binding ShowState, Converter={StaticResource OssVisible}}">
                <controls:IconView Kind="folder-open" Width="28" Height="28" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,14" />
                <TextBlock Text="{Binding StateTitle}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="{Binding StateDescription}" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="350" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="{Binding ShowEmptyActions, Converter={StaticResource OssVisible}}">
                    <Button Content="{loc:Loc UploadFiles}" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,8,0" /><Button Content="{loc:Loc NewFolder}" Command="{Binding NewFolderCommand}" Height="32" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="{Binding ShowRecovery, Converter={StaticResource OssVisible}}">
                    <Button Content="{loc:Loc Retry}" Command="{Binding RefreshCommand}" Height="32" Margin="0,0,8,0" /><Button Content="{loc:Loc EditConnection}" Command="{Binding EditConnectionCommand}" Height="32" />
                </StackPanel>
                <Button Content="{loc:Loc ClearSearch}" Command="{Binding ClearSearchCommand}" Height="32" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="{Binding DisplayReadError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowState}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding DisplayReadError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <Border Grid.Row="7" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0">
            <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc 100ItemsPerBatch}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <Button Content="{loc:Loc NextBatch}" Command="{Binding LoadMoreCommand}" Height="32" Padding="14,0" />
            </StackPanel><TextBlock Text="{Binding ListSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></DockPanel>
        </Border>
        <pages:ObjectStorageTransfersView Grid.Row="8" />
    </Grid>
</UserControl>
