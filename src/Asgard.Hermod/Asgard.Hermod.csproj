<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Asgard.Hermod</RootNamespace>
    <AssemblyName>Asgard.Hermod</AssemblyName>
    <ApplicationIcon>..\Asgard.Hermod.UI\Assets\Brand\hermod.ico</ApplicationIcon>
    <Product>Asgard Hermod</Product>
    <Description>Open-source Windows management terminal for the Asgard ecosystem.</Description>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AlibabaCloud.OSS.V2" Version="0.2.0" />
    <PackageReference Include="Asgard.Core" Version="6.0.3" />
    <PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="app.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 选区在文字底层绘制，使实色背景和 SelectionTextBrush 同时生效。 -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Asgard.Hermod.UI\Asgard.Hermod.UI.csproj" />
    <ProjectReference Include="..\Asgard.Hermod.WinTerminal\Asgard.Hermod.WinTerminal.csproj" />
  </ItemGroup>
</Project>
