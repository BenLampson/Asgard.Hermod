<Application x:Class="Asgard.Hermod.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Asgard.Hermod.UI;component/Resources/Theme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Asgard.Hermod.UI;component/Resources/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Asgard.Hermod.UI;component/Resources/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Asgard.Hermod.ObjectStorage.UI;component/Resources/WorkspacePages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
