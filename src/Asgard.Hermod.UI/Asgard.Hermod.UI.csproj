<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Asgard.Hermod.UI</RootNamespace>
    <AssemblyName>Asgard.Hermod.UI</AssemblyName>
    <Description>WPF presentation components for Asgard Hermod.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Asgard.Hermod.WinTerminal\Asgard.Hermod.WinTerminal.csproj" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Brand\hermod.ico" />
    <Resource Include="Assets\Brand\hermod.png" />
    <None Update="Assets\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
