<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseScopeEditor" x:Name="Root" Width="540"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 FontFamily="{DynamicResource UiFont}" FontSize="12" UseLayoutRounding="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="ScopeChoice" TargetType="CheckBox"><Setter Property="Height" Value="38" /><Setter Property="Margin" Value="0,0,0,16" /><Setter Property="FocusVisualStyle" Value="{StaticResource TabKeyboardFocusVisual}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17" /><ColumnDefinition Width="10" /><ColumnDefinition Width="14" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <controls:IconView x:Name="Selection" Kind="square" Width="17" Height="17" Foreground="{DynamicResource TextMutedBrush}" /><controls:IconView Grid.Column="2" Kind="database" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
   <TextBlock Grid.Column="4" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center" />
   <TextBlock Grid.Column="6" Text="{Binding State}" FontSize="10" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsPendingAdd}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsPendingRemove}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter TargetName="Selection" Property="Kind" Value="square-check" /><Setter TargetName="Selection" Property="Foreground" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Border x:Name="Panel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="19" KeyboardNavigation.TabNavigation="Cycle">
  <Border.Effect><DropShadowEffect Color="#152540" Opacity="0.13" ShadowDepth="5" BlurRadius="18" Direction="270" /></Border.Effect>
  <StackPanel>
   <Grid Height="24" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc DatabaseScopeTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Command="{Binding CancelCommand}" Style="{StaticResource IconButton}" Width="16" Height="24" Padding="0" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" /></Button></Grid>
   <TextBlock Text="{loc:Loc DatabaseScopeExplanation}" FontSize="12" LineHeight="19.8" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />
   <ScrollViewer x:Name="ChoicesViewport" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="Choices" ItemsSource="{Binding Choices}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ScopeChoice}" AutomationProperties.Name="{Binding Name}"><CheckBox.IsEnabled><Binding Path="DataContext.CanEdit" RelativeSource="{RelativeSource AncestorType=ItemsControl}" /></CheckBox.IsEnabled></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock Text="{loc:Loc DatabaseScopeMinimum}" FontSize="11" LineHeight="18.15" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />
   <DockPanel Height="34"><Button DockPanel.Dock="Right" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Height="30" MinHeight="30" Padding="10,0" FontSize="12" Margin="8,0,0,0" Content="{loc:Loc DatabaseScopeApply}" /><Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Style="{StaticResource DatabaseToolbarButton}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" Padding="10,0" Height="30" Content="{loc:Loc Cancel}" /><TextBlock Text="{Binding SelectionSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
  </StackPanel>
 </Border>
</UserControl>
