<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabasePlanReader" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 PreviewKeyDown="OnReaderKeyDown" FontFamily="{DynamicResource UiFont}" FontSize="12">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="PlanButton" TargetType="Button" BasedOn="{StaticResource DatabaseToolbarButton}"><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="11" /></Style>
  <Style x:Key="PlanMode" TargetType="ListBoxItem"><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="8,0" /><Setter Property="FontSize" Value="11" /><Setter Property="IsEnabled" Value="{Binding IsEnabled}" /><Setter Property="FocusVisualStyle" Value="{StaticResource TabKeyboardFocusVisual}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Mode" CornerRadius="3" Background="Transparent"><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Mode" Property="Background" Value="{DynamicResource SurfaceBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PlanRow" TargetType="ListBoxItem"><Setter Property="Height" Value="68" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="18,0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PlanList" TargetType="ListBox"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="PART_ScrollViewer" Padding="0" BorderThickness="0" Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="PlanDetail"><Grid MinHeight="16" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap" /></Grid></DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}" UseLayoutRounding="True"><Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="14,0"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Command="{Binding ToggleDetailsCommand}" Visibility="{Binding CanShowDetails, Converter={StaticResource Visible}}" ToolTip="{loc:Loc PlanShowDetails}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlanButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDetailsOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="panel-right" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc PlanShowDetails}" /></StackPanel></Button>
    <Button Click="OnCopyRaw" IsEnabled="{Binding HasRawText}" Style="{StaticResource PlanButton}" ToolTip="{loc:Loc PlanCopyRaw}" AutomationProperties.Name="{loc:Loc PlanCopyRaw}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="copy" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc PlanCopyRaw}" /></StackPanel></Button>
    <Button x:Name="MoreButton" Click="OnMore" Style="{StaticResource PlanButton}" ToolTip="{loc:Loc PlanMore}" AutomationProperties.Name="{loc:Loc PlanMore}"><controls:IconView Kind="ellipsis" Width="14" Height="14" /><Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc PlanExpandAll}" Command="{Binding ExpandAllCommand}" /><MenuItem Header="{loc:Loc PlanCollapseAll}" Command="{Binding CollapseAllCommand}" /><Separator /><MenuItem Header="{loc:Loc PlanRawSearch}" Click="OnOpenSearch" /><MenuItem Header="{loc:Loc PlanRawWrap}" IsCheckable="True" IsChecked="{Binding WrapRawText, Mode=TwoWay}" /><MenuItem Header="{loc:Loc PlanExportRaw}" Click="OnExportRaw" /><MenuItem Header="{loc:Loc PlanShowSource}" Click="OnShowSource" /></ContextMenu></Button.ContextMenu></Button>
   </StackPanel>
   <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" MaxWidth="250" ToolTip="{Binding Summary}" />
   <controls:SegmentedSelector DockPanel.Dock="Left" Height="28" MinHeight="28" BorderThickness="0" Padding="2" Background="{DynamicResource AppBackgroundBrush}" ItemsSource="{Binding Modes}" SelectedValuePath="Id" SelectedValue="{Binding ViewMode, Mode=TwoWay}" ItemContainerStyle="{StaticResource PlanMode}"><controls:SegmentedSelector.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:IconView Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{Binding Name}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextBodyBrush}" /></StackPanel></DataTemplate></controls:SegmentedSelector.ItemTemplate><controls:SegmentedSelector.Template><ControlTemplate TargetType="controls:SegmentedSelector"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ItemsPresenter /></Border></ControlTemplate></controls:SegmentedSelector.Template><controls:SegmentedSelector.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></controls:SegmentedSelector.ItemsPanel></controls:SegmentedSelector>
   <TextBlock Text="{Binding Fact}" ToolTip="{Binding Fact}" FontFamily="{DynamicResource UiFont}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Snapshot.IsActual}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </DockPanel></Border>
  <Grid Grid.Row="1" x:Name="ReaderBody" SizeChanged="OnBodySizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailsColumn" Width="296" /></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="GraphViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsTree}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsFieldSummary}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
    <Grid Width="{Binding ActualWidth, ElementName=GraphViewport}" MinWidth="600"><Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid x:Name="MetricHeader" Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="90" /><ColumnDefinition Width="12" /><ColumnDefinition Width="160" /><ColumnDefinition Width="12" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StepHeading}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding RowsHeading}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding MetricHeading}" ToolTip="{Binding MetricNotice}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><TextBlock Grid.Column="6" Text="{Binding LastHeading}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid>
     <ListBox Grid.Row="1" x:Name="NodeRows" Style="{StaticResource PlanList}" BorderThickness="0" Padding="0" Background="Transparent" ItemsSource="{Binding VisibleNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" ItemContainerStyle="{StaticResource PlanRow}" Visibility="{Binding IsTree, Converter={StaticResource Visible}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewKeyDown="OnNodeKeyDown" ScrollViewer.ScrollChanged="OnGraphScrollChanged" AutomationProperties.Name="{loc:Loc PlanTreeView}">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="90" /><ColumnDefinition Width="12" /><ColumnDefinition Width="160" /><ColumnDefinition Width="12" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
       <Grid Margin="{Binding Indent}" ToolTip="{Binding Node.FullOperation}"><Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="9" /><ColumnDefinition Width="28" /><ColumnDefinition Width="9" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Command="{Binding ToggleCommand}" Opacity="1" Width="14" Height="24" Padding="0" BorderThickness="0" Style="{StaticResource IconButton}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"><controls:IconView Kind="{Binding ExpanderIcon}" Width="14" Height="14" /></Button><Border Grid.Column="2" Width="28" Height="28" CornerRadius="5" Background="{DynamicResource AppBackgroundBrush}"><controls:IconView Kind="{Binding Icon}" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" /></Border><StackPanel Grid.Column="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{Binding ServerName}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel><TextBlock Text="{Binding Expression}" ToolTip="{Binding Expression}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /></StackPanel></Grid>
       <TextBlock Grid.Column="2" FontFamily="{DynamicResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding EstimatedRows}" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Snapshot.IsActual, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter Property="Text" Value="{Binding ActualRows}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Grid.Column="4" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Cost}" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Snapshot.IsActual, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter Property="Text" Value="{Binding ActualTime}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Grid.Column="6" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding EstimatedWidth}" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Snapshot.IsActual, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter Property="Text" Value="{Binding Loops}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ListBox Grid.Row="1" x:Name="FieldRows" Style="{StaticResource PlanList}" BorderThickness="0" Padding="0" Background="Transparent" ItemsSource="{Binding FieldRows}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" ItemContainerStyle="{StaticResource PlanRow}" Visibility="{Binding IsFieldSummary, Converter={StaticResource Visible}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="OnGraphScrollChanged" AutomationProperties.Name="{loc:Loc PlanFieldsView}"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="90" /><ColumnDefinition Width="12" /><ColumnDefinition Width="160" /><ColumnDefinition Width="12" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" ToolTip="{Binding Extra}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontFamily="{DynamicResource UiFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{Binding QueryBlock}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel><TextBlock Text="{Binding Extra}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding EstimatedRows}" FontFamily="{DynamicResource UiFont}" FontSize="13" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{Binding Access}" FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalAlignment="Center" /><TextBlock Grid.Column="6" Text="{Binding UsedKey}" FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding UsedKey}" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Border Grid.Row="2" Height="42" VerticalAlignment="Top" Visibility="{Binding HasFlowSummary, Converter={StaticResource Visible}}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0"><controls:IconView Kind="workflow" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding FlowSummary}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
    </Grid>
   </ScrollViewer>
   <DataGrid x:Name="GenericFields" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="32" BorderThickness="0" ItemsSource="{Binding Snapshot.Rows}" Visibility="{Binding IsFieldGrid, Converter={StaticResource Visible}}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBodyBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource LineSoftBrush}" AutomationProperties.Name="{loc:Loc PlanFieldsView}" />
   <Border x:Name="DetailsPanel" Grid.Column="1" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource AppBackgroundBrush}" Padding="17,14,18,14" Visibility="{Binding IsDetailsVisible, Converter={StaticResource Visible}}"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Command="{Binding ToggleDetailsCommand}" Width="14" Height="22" Padding="0" BorderThickness="0" Style="{StaticResource IconButton}" ToolTip="{loc:Loc PlanCloseDetails}" AutomationProperties.Name="{loc:Loc PlanCloseDetails}"><controls:IconView Kind="x" Width="14" Height="14" /></Button><TextBlock Text="{loc:Loc PlanNodeDetails}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></DockPanel>
    <TextBlock Text="{Binding SelectedTitle}" Height="23" ToolTip="{Binding SelectedTitle}" FontFamily="{DynamicResource UiFont}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SelectedOperator}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,12" />
    <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource PlanDetail}" />
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:IconView Kind="info" Width="12" Height="12" VerticalAlignment="Top" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" /><TextBlock Grid.Column="1" Text="{Binding MetricNotice}" FontFamily="{DynamicResource UiFont}" FontSize="10" LineHeight="16.5" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="6,0,0,0" /></Grid>
    <Expander Header="{loc:Loc PlanRawFields}" FontFamily="{DynamicResource UiFont}" FontSize="11" Visibility="{Binding HasAdditionalFields, Converter={StaticResource Visible}}"><ItemsControl ItemsSource="{Binding AdditionalFields}" ItemTemplate="{StaticResource PlanDetail}" Margin="0,12,0,0" /></Expander>
   </StackPanel></ScrollViewer>
   <Button Grid.Row="1" Command="{Binding LocateRawCommand}" Style="{StaticResource PlanButton}" HorizontalAlignment="Left" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="code" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc PlanLocateRaw}" /></StackPanel></Button>
   </Grid></Border>
   <Grid Grid.ColumnSpan="2" Visibility="{Binding IsRaw, Converter={StaticResource Visible}}" Background="{DynamicResource DatabaseEditorBrush}">
    <TextBox x:Name="RawEditor" Text="{Binding RawText, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextBlock.LineHeight="22.8" TextBlock.LineStackingStrategy="BlockLineHeight" TextOptions.TextFormattingMode="Ideal" Background="Transparent" Foreground="{DynamicResource TextBodyBrush}" BorderThickness="0" Padding="18" Margin="-2,0,0,0" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc PlanRawView}"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template><TextBox.Style><Style TargetType="TextBox"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" /><Style.Triggers><DataTrigger Binding="{Binding WrapRawText}" Value="True"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
    <Border x:Name="SearchPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" Margin="18" Padding="6" Width="400"><DockPanel><Button DockPanel.Dock="Right" Click="OnCloseSearch" Width="24" Height="28" Padding="0" Style="{StaticResource PlanButton}" ToolTip="{loc:Loc PlanCloseSearch}" AutomationProperties.Name="{loc:Loc PlanCloseSearch}"><controls:IconView Kind="x" Width="14" Height="14" /></Button><Button DockPanel.Dock="Right" Click="OnNextMatch" Width="24" Height="28" Padding="0" Style="{StaticResource PlanButton}" ToolTip="{loc:Loc PlanSearchNext}" AutomationProperties.Name="{loc:Loc PlanSearchNext}"><controls:IconView Kind="chevron-down" Width="14" Height="14" /></Button><Button DockPanel.Dock="Right" Click="OnPreviousMatch" Width="24" Height="28" Padding="0" Style="{StaticResource PlanButton}" ToolTip="{loc:Loc PlanSearchPrevious}" AutomationProperties.Name="{loc:Loc PlanSearchPrevious}"><controls:IconView Kind="chevron-up" Width="14" Height="14" /></Button><TextBox x:Name="SearchInput" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="28" MinHeight="28" Padding="6,0" MaxLength="256" AutomationProperties.Name="{loc:Loc PlanRawSearch}" PreviewKeyDown="OnSearchKeyDown" /></DockPanel></Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
