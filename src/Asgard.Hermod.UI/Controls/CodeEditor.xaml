<UserControl x:Class="Asgard.Hermod.UI.Controls.CodeEditor" x:Name="EditorRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" ClipToBounds="True">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border ClipToBounds="True" Padding="0,16,12,0"><TextBlock x:Name="LineNumbers" FontFamily="{DynamicResource MonoFont}" FontSize="13" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Top" TextOptions.TextFormattingMode="Ideal" /></Border>
   <TextBox Grid.Column="1" x:Name="Input" Text="{Binding Text, ElementName=EditorRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    IsReadOnly="{Binding IsReadOnly, ElementName=EditorRoot}" MaxLength="{Binding MaxLength, ElementName=EditorRoot}" AcceptsReturn="True" AcceptsTab="True"
    FontFamily="{DynamicResource MonoFont}" FontSize="13" TextOptions.TextFormattingMode="Ideal" Padding="0,16,16,16" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Top"
    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged" ScrollViewer.ScrollChanged="OnScrollChanged" SizeChanged="OnInputSizeChanged">
    <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template>
   </TextBox>
  </Grid>
 </Border>
</UserControl>
