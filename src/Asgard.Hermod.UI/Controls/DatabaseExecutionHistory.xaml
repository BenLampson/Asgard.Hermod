<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseExecutionHistory"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <CollectionViewSource x:Key="Traces" Source="{Binding ExecutionTraces}" Filter="OnFilter" />
  <Style x:Key="DetailMode" TargetType="RadioButton">
   <Setter Property="FontFamily" Value="{DynamicResource UiFont}" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,22,0" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Mode" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="Mode" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Mode" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}"><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <DockPanel Margin="18,0">
   <ComboBox x:Name="KindFilter" DockPanel.Dock="Right" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="OnKindChanged" Height="30" MinHeight="30" MinWidth="120" VerticalAlignment="Center" FontSize="12" AutomationProperties.Name="{loc:Loc DatabaseTraceFilter}">
    <ComboBoxItem Tag="all" Content="{loc:Loc DatabaseTraceAllTypes}" /><ComboBoxItem Tag="query" Content="{loc:Loc DatabaseTraceQueries}" /><ComboBoxItem Tag="plan" Content="{loc:Loc DatabaseOutputPlan}" />
   </ComboBox>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{loc:Loc DatabaseTraceCurrentSession}" FontSize="12" FontWeight="Medium" /><TextBlock Text="{Binding ExecutionTraces.Count, StringFormat={loc:Loc DatabaseTraceRetention}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <ListBox x:Name="TraceList" ItemsSource="{Binding Source={StaticResource Traces}}" SelectedItem="{Binding SelectedTrace, Mode=TwoWay}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Loc DatabaseOutputHistory}">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Height" Value="62" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,10"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel Height="18"><TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><controls:IconView Kind="{Binding StatusIcon}" Width="13" Height="13" Margin="0,0,8,0"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Succeeded}" Value="False"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView><TextBlock Text="{Binding KindLabel}" FontSize="12" VerticalAlignment="Center" /></DockPanel><TextBlock Text="{Binding Metrics}" ToolTip="{Binding Metrics}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel>
     <Button DockPanel.Dock="Right" Content="{loc:Loc DatabaseRestoreSql}" Command="{Binding RestoreTraceCommand}" Style="{StaticResource DatabaseToolbarButton}" VerticalAlignment="Center" ToolTip="{loc:Loc DatabaseTraceRestoreHint}" />
     <TextBlock DockPanel.Dock="Right" Text="{loc:Loc DatabaseTraceSnapshot}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0" />
     <RadioButton x:Name="SqlMode" Content="{loc:Loc DatabaseTraceSql}" Style="{StaticResource DetailMode}" IsChecked="True" Checked="OnDetailChanged" />
     <RadioButton Content="{loc:Loc DatabaseTraceReturnedDetails}" Style="{StaticResource DetailMode}" Checked="OnDetailChanged" HorizontalAlignment="Left" />
    </DockPanel></Border>
    <TextBox x:Name="SqlSnapshot" Grid.Row="1" Text="{Binding SelectedTrace.Sql, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" Padding="18" Background="{DynamicResource DatabaseEditorBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc DatabaseTraceSql}" />
    <TextBox x:Name="ReturnedDetails" Grid.Row="1" Visibility="Collapsed" Text="{Binding SelectedTrace.Detail, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" Padding="18" Background="{DynamicResource DatabaseEditorBrush}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc DatabaseTraceReturnedDetails}" />
   </Grid>
  </Grid>
 </Grid>
</UserControl>
