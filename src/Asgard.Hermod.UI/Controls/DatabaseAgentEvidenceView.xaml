<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseAgentEvidenceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="EvidenceVisible" /><Style x:Key="EvidenceButton" TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="9.5,0" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /></Style></UserControl.Resources>
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="2,0,0,0" Padding="14,4,0,4"><StackPanel>
  <TextBlock Text="{Binding Heading}" FontSize="13" TextWrapping="Wrap" LineHeight="21.45" />
  <TextBlock Text="{Binding Target}" FontSize="11" LineHeight="18.15" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,12" />
  <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="12"><StackPanel>
   <TextBlock Text="{loc:Loc ChatToolSqlSource}" Height="20" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
   <TextBox x:Name="SqlEvidence" Text="{Binding Sql, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MinHeight="20" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight" BorderThickness="0" Padding="0" Background="Transparent" Foreground="{DynamicResource TextBodyBrush}" AutomationProperties.Name="{loc:Loc ChatToolSqlSource}" />
  </StackPanel></Border>
  <StackPanel Margin="0,12,0,12"><TextBlock Text="{Binding Summary}" FontSize="11" LineHeight="18.15" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc ChatToolFrozenPreviewHint}" FontSize="11" LineHeight="18.15" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" /></StackPanel>
  <StackPanel Orientation="Horizontal" Height="30"><Button x:Name="ViewResult" Click="OnViewResult" IsEnabled="{Binding HasOutput}" Style="{StaticResource EvidenceButton}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="table-2" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc ChatToolViewResult}" /></StackPanel></Button>
   <Button x:Name="CopySql" Click="OnCopySql" Style="{StaticResource EvidenceButton}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="copy" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc ChatToolCopySql}" /></StackPanel></Button>
   <TextBlock x:Name="CopyFeedback" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
  <StackPanel x:Name="ResultEvidence" Visibility="{Binding IsResultExpanded, Converter={StaticResource EvidenceVisible}}" Margin="0,12,0,0"><TextBlock Text="{loc:Loc ChatToolBoundedResult}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" /><TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" FontFamily="{DynamicResource MonoFont}" FontSize="12" Background="{DynamicResource AppBackgroundBrush}" Padding="12" AutomationProperties.Name="{loc:Loc ChatToolBoundedResult}" /></StackPanel>
 </StackPanel></Border>
</UserControl>
