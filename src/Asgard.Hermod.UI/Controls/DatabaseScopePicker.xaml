<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseScopePicker" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <Grid>
  <ToggleButton x:Name="Trigger" Height="28" Padding="9,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ToolTip="{loc:Loc DatabaseSessionScope}" AutomationProperties.Name="{loc:Loc DatabaseSessionScope}">
   <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></ToggleButton.Template>
   <StackPanel Orientation="Horizontal"><controls:IconView Kind="database" Width="14" Height="14" /><TextBlock Text="{loc:Loc DatabaseSessionScope}" FontSize="12" Margin="6,0" /><controls:IconView Kind="chevron-down" Width="12" Height="12" /></StackPanel>
  </ToggleButton>
  <Popup IsOpen="{Binding IsChecked, ElementName=Trigger, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Trigger}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
   <Border Width="340" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" DataContext="{Binding DataContext, ElementName=Root}">
    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
     <TextBlock Text="{loc:Loc DatabaseSessionScope}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
     <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ActiveSession.Scope.Databases}"><ItemsControl.ItemTemplate><DataTemplate>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{loc:Loc DatabaseSessionRemoveTitle}" Command="{Binding DataContext.RemoveSessionDatabaseCommand, ElementName=Root}" CommandParameter="{Binding}" Height="28" ToolTip="{loc:Loc DatabaseSessionRequiresDatabase}" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0" /></DockPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <Button Content="{loc:Loc DatabaseSessionAdd}" Command="{Binding AddSessionDatabaseCommand}" Height="28" HorizontalAlignment="Left" Margin="0,8,0,0" />
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
