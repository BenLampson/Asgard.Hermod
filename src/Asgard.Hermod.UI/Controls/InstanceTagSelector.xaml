<UserControl x:Class="Asgard.Hermod.UI.Controls.InstanceTagSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             x:Name="SelectorRoot" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibilityChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="TagVisibility" />
    </UserControl.Resources>
    <StackPanel DataContext="{Binding Model, ElementName=SelectorRoot}">
        <Grid Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc InstanceTagsOptional}" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectionSummary}" FontSize="11" HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
        <Grid Height="36">
            <Button x:Name="TagTrigger" Style="{DynamicResource StandardButton}" Click="OnOpenClick"
                    IsEnabled="{Binding IsEditable}" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{loc:Loc InstanceTagsSelect}" ToolTip="{loc:Loc InstanceTagsSelect}">
                <Grid>
                    <TextBlock Text="{loc:Loc InstanceTagsSelectPlaceholder}" Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <controls:IconView Kind="chevron-down" Width="16" Height="16" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="8,0,28,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding VisibleTags}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource StandardButton}" Height="24" Padding="6,0" Margin="0,0,6,0"
                                    Background="{DynamicResource AccentWeakBrush}" BorderThickness="0" ToolTip="{Binding DisplayPath}"
                                    Command="{Binding Model.RemoveCommand, ElementName=SelectorRoot}" CommandParameter="{Binding Tag.Id}"
                                    AutomationProperties.Name="{Binding DisplayPath, StringFormat={loc:Loc RemoveTag}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayPath}" FontSize="11" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                    <controls:IconView Kind="x" Width="12" Height="12" Margin="6,0,0,0" Foreground="{DynamicResource AccentTextBrush}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding OverflowLabel}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{loc:Loc InstanceTagsOptionalHint}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <Popup x:Name="TagPopup" PlacementTarget="{Binding ElementName=TagTrigger}" Placement="Top" VerticalOffset="-6"
               AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border x:Name="PopupPanel" DataContext="{x:Null}" Width="420" Height="420" Margin="8" Padding="16" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnPopupKeyDown">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.14" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{loc:Loc InstanceTagsSelect}" FontSize="14" FontWeight="SemiBold" />
                        <Button Style="{DynamicResource IconButton}" HorizontalAlignment="Right" Width="20" Height="20"
                                Command="{Binding CancelCommand}" AutomationProperties.Name="{loc:Loc Cancel}" ToolTip="{loc:Loc Close}">
                            <controls:IconView Kind="x" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <TextBox x:Name="TagSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Loc SearchTagsOrPaths}" Padding="10,0" Height="34" />
                        <TextBlock Text="{loc:Loc SearchTagsOrPaths2}" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="{Binding RowPadding}" MinHeight="32">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Button Style="{DynamicResource IconButton}" Width="16" Height="20" Focusable="False"
                                                        Command="{Binding ToggleExpansionCommand}" Visibility="{Binding HasChildren, Converter={StaticResource TagVisibility}}"
                                                        AutomationProperties.Name="{Binding DisplayPath, StringFormat={loc:Loc ExpandOrCollapseTag}}">
                                                    <controls:IconView Kind="{Binding ExpansionIcon}" Width="12" Height="12" />
                                                </Button>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding DisplayName}"
                                                          ToolTip="{Binding DisplayPath}" AutomationProperties.Name="{Binding DisplayPath}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding EmptyMessage}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{Binding SelectionSummary}" FontSize="11" Margin="0,12"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Grid Grid.Row="4">
                        <Button Content="{loc:Loc ClearAll}" Command="{Binding ClearCommand}" Style="{DynamicResource StandardButton}" HorizontalAlignment="Left" Height="32" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Style="{DynamicResource StandardButton}" Margin="0,0,8,0" Height="32" />
                            <Button Content="{loc:Loc InstanceTagsConfirmSelection}" Command="{Binding ApplyCommand}" Style="{DynamicResource PrimaryButton}" Height="32" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
