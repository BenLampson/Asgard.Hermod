<UserControl x:Class="Asgard.Hermod.UI.Controls.InstanceNameButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" x:Name="Root">
    <Button x:Name="RenameButton" CommandParameter="{Binding Instance, ElementName=Root}"
            ToolTip="{loc:Loc RenameInstance}" AutomationProperties.Name="{loc:Loc RenameInstance}"
            HorizontalContentAlignment="Stretch" Padding="3,2" Background="Transparent" BorderThickness="0">
        <Button.Template><ControlTemplate TargetType="Button">
            <Border x:Name="Hover" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Instance.Name, ElementName=Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <controls:IconView Grid.Column="1" Kind="pencil" Width="13" Height="13" Margin="8,0,2,0" Foreground="{DynamicResource TextMutedBrush}" />
        </Grid>
    </Button>
</UserControl>
