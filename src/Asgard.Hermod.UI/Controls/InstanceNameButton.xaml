<UserControl x:Class="Asgard.Hermod.UI.Controls.InstanceNameButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" x:Name="Root">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Instance.Name, ElementName=Root}" ToolTip="{Binding Instance.Name, ElementName=Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    <Button x:Name="RenameButton" Grid.Column="1" Width="22" Height="22" Margin="6,0,0,0" CommandParameter="{Binding Instance, ElementName=Root}"
            chrome:WindowChrome.IsHitTestVisibleInChrome="True"
            Command="{Binding (controls:InstanceMetadataScope.RenameCommand), RelativeSource={RelativeSource Self}}"
            ToolTip="{loc:Loc EditInstanceDetails}" AutomationProperties.Name="{loc:Loc EditInstanceDetails}"
            HorizontalContentAlignment="Stretch" Padding="3,2" Background="Transparent" BorderThickness="0">
        <Button.Template><ControlTemplate TargetType="Button">
            <Border x:Name="Hover" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
        <controls:IconView Kind="pencil" Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" />
    </Button>
    </Grid>
</UserControl>
