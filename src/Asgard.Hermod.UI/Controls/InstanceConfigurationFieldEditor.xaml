<UserControl x:Class="Asgard.Hermod.UI.Controls.InstanceConfigurationFieldEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             Focusable="False">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceFieldTemplate">
            <ListBox ItemsSource="{Binding Choices}" SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     SelectedValuePath="Id" Height="36" BorderThickness="0" Padding="3"
                     Background="{DynamicResource AppBackgroundBrush}" AutomationProperties.Name="{Binding Label}">
                <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ItemsPresenter /></Border></ControlTemplate></ListBox.Template>
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="OptionBorder" CornerRadius="4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>
        <DataTemplate x:Key="FileFieldTemplate">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc Browse}" Click="OnBrowseFile" Margin="8,0,0,0"
                        Height="36" ToolTip="{loc:Loc ChooseFile}" AutomationProperties.Name="{loc:Loc ChooseFile}" />
                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="36"
                         MaxLength="{Binding MaxLength}" FontFamily="{DynamicResource MonoFont}" AutomationProperties.Name="{Binding Label}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="TextFieldTemplate">
            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" MaxLength="{Binding MaxLength}" FontFamily="{DynamicResource MonoFont}"
                     AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="SecretFieldTemplate">
            <controls:SecretInput Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Height="36" MaxLength="{Binding MaxLength}"
                                  AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
    </UserControl.Resources>
    <!-- 新类型复用同一字段编辑器，文字和密钥均由连接器声明决定。 -->
    <controls:FormField Label="{Binding Label}" Hint="{Binding Hint}" Error="{Binding Error}" IsRequired="{Binding IsRequired}">
        <ContentControl Content="{Binding}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSecret}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource SecretFieldTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ChoiceFieldTemplate}" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsFile}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource FileFieldTemplate}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </controls:FormField>
    <UserControl.Style><Style TargetType="UserControl"><Style.Triggers>
        <DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
    </Style.Triggers></Style></UserControl.Style>
</UserControl>
