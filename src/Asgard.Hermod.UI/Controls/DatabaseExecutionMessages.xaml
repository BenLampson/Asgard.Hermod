<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseExecutionMessages"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="MessageCell" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="12,0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Message}" /></Style>
  <Style x:Key="MessageHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceResultGridHeader}"><Setter Property="Height" Value="36" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Padding" Value="12,0" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
 </ResourceDictionary></UserControl.Resources>
 <DataGrid x:Name="MessageGrid" Style="{StaticResource WorkspaceResultGrid}" ItemsSource="{Binding OutputMessages}" SelectedIndex="0" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="40" ColumnHeaderHeight="36" ColumnHeaderStyle="{StaticResource MessageHeader}" GridLinesVisibility="Horizontal" BorderThickness="0" SelectionUnit="FullRow" CanUserResizeRows="False" AutomationProperties.Name="{loc:Loc DatabaseOutputMessages}">
  <DataGrid.Columns>
   <DataGridTextColumn Header="{loc:Loc DatabaseMessageTime}" Binding="{Binding TimeLabel}" Width="120" MinWidth="100" ElementStyle="{StaticResource MessageCell}" />
   <DataGridTextColumn Header="{loc:Loc DatabaseMessageStatus}" Binding="{Binding StatusLabel}" Width="100" MinWidth="80" ElementStyle="{StaticResource MessageCell}" />
   <DataGridTemplateColumn Header="{loc:Loc DatabaseMessagePosition}" Width="100" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding PositionLabel}" ToolTip="{Binding PositionHint}" Command="{Binding DataContext.LocateMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource DatabaseToolbarButton}" HorizontalAlignment="Left" Padding="12,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTextColumn Header="{loc:Loc DatabaseMessageText}" Binding="{Binding Message}" Width="*" MinWidth="240" ElementStyle="{StaticResource MessageCell}" />
  </DataGrid.Columns>
 </DataGrid>
</UserControl>
