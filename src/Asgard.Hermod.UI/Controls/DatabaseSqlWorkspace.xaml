<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseSqlWorkspace" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /></ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition x:Name="SqlRow" Height="268" MinHeight="120" /><RowDefinition Height="6" /><RowDefinition Height="40" /><RowDefinition Height="*" MinHeight="120" /><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsOutputFooterVisible}" Value="True"><Setter Property="Height" Value="32" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="18,0">
   <DockPanel LastChildFill="True">
    <Button DockPanel.Dock="Right" Command="{Binding SaveDocumentCommand}" Style="{StaticResource DatabaseToolbarButton}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><controls:IconView Kind="save" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseSaveSql}" /></StackPanel></Button>
    <Button DockPanel.Dock="Right" Content="{loc:Loc DatabaseCancelExecution}" Command="{Binding CancelCommand}" Style="{StaticResource DatabaseToolbarButton}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" VerticalAlignment="Center" />
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <controls:IconView Kind="database" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,7,0" />
     <Grid><ComboBox x:Name="TargetSelector" ItemsSource="{Binding Databases}" SelectedItem="{Binding Database, Mode=OneWay}" Height="30" MinHeight="30" Width="220" Visibility="{Binding HasMultipleDatabases, Converter={StaticResource Visible}}" SelectionChanged="OnTargetChanged" AutomationProperties.Name="{loc:Loc DatabaseExecutionTarget}" />
      <TextBlock Text="{Binding Database}" FontFamily="{DynamicResource UiFont}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Visibility="{Binding HasSingleDatabase, Converter={StaticResource Visible}}" />
     </Grid>
     <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="10,0" />
     <Button Style="{StaticResource DatabasePrimaryButton}" x:Name="RunButton" Click="OnRun" IsEnabled="{Binding CanRun}" Height="30" Padding="10,0" FontFamily="{DynamicResource UiFont}" FontWeight="Normal" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0">
      <StackPanel Orientation="Horizontal"><controls:IconView Kind="play" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseRun}" /><controls:IconView Kind="chevron-down" Width="12" Height="12" Margin="6,0,0,0" IsHitTestVisible="True" MouseDown="OnRunMenu" /></StackPanel>
      <Button.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc DatabaseRunSelection}" Click="OnRun" /><MenuItem Header="{loc:Loc DatabaseRunAll}" Click="OnRunAll" /></ContextMenu></Button.ContextMenu>
     </Button>
     <TextBlock Text="{loc:Loc DatabaseRunShortcut}" FontFamily="{DynamicResource UiFont}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0" VerticalAlignment="Center" />
     <Button x:Name="AnalyzeButton" Click="OnAnalysisMenu" Style="{StaticResource DatabaseToolbarButton}" IsEnabled="{Binding CanRun}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="scan-search" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseAnalyze}" /><controls:IconView Kind="chevron-down" Width="12" Height="12" Margin="6,0,0,0" /></StackPanel>
      <Button.ContextMenu><ContextMenu Opened="OnAnalysisOpened"><MenuItem Header="{loc:Loc DatabaseExplain}" Click="OnExplain" /><MenuItem Header="{loc:Loc DatabaseAnalyzeActual}" Click="OnAnalyze"  /></ContextMenu></Button.ContextMenu>
     </Button>
    </StackPanel>
   </DockPanel>
  </Border>
  <controls:CodeEditor Grid.Row="1" x:Name="SqlEditor" IsSqlWorkspace="True" Text="{Binding Sql, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CompletionProvider="{Binding}" IsReadOnly="False" MaxLength="10485760" AutomationProperties.Name="{loc:Loc DatabaseSqlEditor}" />
  <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="{DynamicResource SurfaceBrush}" AutomationProperties.Name="{loc:Loc WorkspacePaneResize}"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><Border Width="36" Height="2" Background="{DynamicResource LineBrush}" CornerRadius="1" /></Border></ControlTemplate></GridSplitter.Template></GridSplitter>
  <Border Grid.Row="3" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" ><controls:IconView Kind="circle-check" Width="12" Height="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasResult}" Value="True" /><Condition Binding="{Binding IsResultsOutput}" Value="True" /><Condition Binding="{Binding HasError}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView><TextBlock Text="{Binding OutputRequestSummary}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
   <controls:SectionSelector Height="40" ItemsSource="{Binding OutputViews}" SelectedValuePath="Id" SelectedValue="{Binding OutputView, Mode=TwoWay}" BorderThickness="0" ItemContainerStyle="{StaticResource DatabaseOutputTab}"><controls:SectionSelector.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:IconView Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /><TextBlock Text="{Binding Name}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></DataTemplate></controls:SectionSelector.ItemTemplate></controls:SectionSelector>
  </DockPanel></Border>
  <Grid Grid.Row="4">
   <Grid Visibility="{Binding IsResultsOutput, Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <ComboBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" DisplayMemberPath="Label" Height="30" MinHeight="30" Margin="18,4" HorizontalAlignment="Left" MinWidth="160"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Results.Count}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
    <ContentControl Grid.Row="1" Content="{Binding ResultContent, ElementName=Root}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
   </Grid>
   <ScrollViewer Visibility="{Binding IsMessagesOutput, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto" Padding="18,16"><StackPanel><TextBlock Text="{Binding Error}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /><TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" AcceptsReturn="True" /></StackPanel></ScrollViewer>
   <Grid Visibility="{Binding IsPlanOutput, Converter={StaticResource Visible}}"><controls:DatabasePlanReader x:Name="PlanReader" DataContext="{Binding Plan}"><controls:DatabasePlanReader.Style><Style TargetType="controls:DatabasePlanReader"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.HasPlan, RelativeSource={RelativeSource AncestorType=controls:DatabaseSqlWorkspace}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></controls:DatabasePlanReader.Style></controls:DatabasePlanReader><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasPlan}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{loc:Loc PlanNoPlan}" FontFamily="{DynamicResource UiFont}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="{loc:Loc PlanNoPlanHint}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Grid>
   <controls:DatabaseExecutionHistory x:Name="HistoryReader" Visibility="{Binding IsHistoryOutput, Converter={StaticResource Visible}}" />
  </Grid>
  <Border Grid.Row="5" Visibility="{Binding IsOutputFooterVisible, Converter={StaticResource Visible}}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="18,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsResultsOutput, Converter={StaticResource Visible}}"><Button Click="OnCopy" Style="{StaticResource DatabaseToolbarButton}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="copy" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseCopyResult}" /></StackPanel></Button><Button Click="OnExport" Style="{StaticResource DatabaseToolbarButton}"><StackPanel Orientation="Horizontal"><controls:IconView Kind="download" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseExportResult}" /></StackPanel></Button></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding OutputFooterText}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /><controls:IconView Kind="info" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" IsHitTestVisible="True" ToolTip="{Binding OutputFooterHint}" AutomationProperties.Name="{Binding OutputFooterHint}" /></StackPanel></DockPanel></Border>
 </Grid>
</UserControl>
