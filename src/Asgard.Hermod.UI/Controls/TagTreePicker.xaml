<UserControl x:Class="Asgard.Hermod.UI.Controls.TagTreePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="PickerRoot" Width="380" MaxHeight="650"
             SnapsToDevicePixels="True" UseLayoutRounding="True"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- 默认 ScrollViewer 模板以系统键设置本地宽度，因此在本组件作用域覆盖该键。 -->
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">8</sys:Double>
        <controls:TagPathDisplayConverter x:Key="TagPathDisplay" />
        <!-- 细滚动条仅作用于标签面板；原生 Track 继续处理拖动和分页命令。 -->
        <ControlTemplate x:Key="TagScrollPage" TargetType="RepeatButton">
            <Border Background="Transparent" />
        </ControlTemplate>
        <Style x:Key="TagScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome" Background="{DynamicResource TextFaintBrush}"
                                Opacity="0.45" CornerRadius="3" Margin="1,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Template="{StaticResource TagScrollPage}" Focusable="False"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource TagScrollThumb}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Template="{StaticResource TagScrollPage}" Focusable="False"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 三态外观使用原生 CheckBox 的键盘与自动化能力，点击语义由节点命令统一处理。 -->
        <Style x:Key="TagCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckChrome" Width="14" Height="14" CornerRadius="3"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <Grid>
                                    <controls:IconView x:Name="CheckMark" Kind="check" Width="10" Height="10"
                                                       Foreground="{DynamicResource InverseTextBrush}" Visibility="Collapsed" />
                                    <Border x:Name="MixedMark" Width="6" Height="2" CornerRadius="1"
                                            Background="{DynamicResource InverseTextBrush}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="MixedMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TagPathChip" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#0B1220" Opacity="0.14" BlurRadius="24" ShadowDepth="8" Direction="270" />
        </Border.Effect>
        <!-- 边线向内绘制，不从设计的三百八十像素内容区域再扣除两像素。 -->
        <Grid Margin="-1" DataContext="{Binding Model, ElementName=PickerRoot}">
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="*" />
                <RowDefinition Height="29" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="16">
                <Grid Height="18">
                    <TextBlock Text="{loc:Loc FilterByTags}" FontSize="14" FontWeight="SemiBold" />
                    <Button Style="{DynamicResource IconButton}" Width="15" Height="15" Padding="0"
                            HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                            AutomationProperties.Name="{loc:Loc CancelTagFilters}" ToolTip="{loc:Loc Close}">
                        <controls:IconView Kind="x" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                </Grid>
                <Border Height="34" Margin="0,11,0,0" Padding="10,0" CornerRadius="6"
                        Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchInput}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:IconView Kind="search" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBox x:Name="SearchInput" Grid.Column="2" Style="{DynamicResource SearchTextBox}"
                                 FontSize="12" Foreground="{DynamicResource TextBodyBrush}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Loc SearchTagsOrPaths}" />
                        <TextBlock Grid.Column="2" Text="{loc:Loc SearchTagsOrPaths2}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Grid Height="13" Margin="0,12,0,0">
                    <ComboBox x:Name="MatchModeSelect" Width="132" Height="13" MinHeight="13"
                              Padding="0" BorderThickness="0" Background="Transparent" FontSize="11"
                              HorizontalAlignment="Left" SelectedValuePath="Tag"
                              SelectedValue="{Binding MatchMode, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Loc TagMatchingMode}">
                        <ComboBoxItem Content="{loc:Loc MatchAnySelected}" Tag="{x:Static models:TagFilterMatchMode.Any}" />
                        <ComboBoxItem Content="{loc:Loc MatchAllSelected}" Tag="{x:Static models:TagFilterMatchMode.All}" />
                    </ComboBox>
                    <TextBlock Text="{Binding TotalTagCount, StringFormat={loc:Loc Tags}}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,1" Padding="8,5">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}" AlternationCount="2147483647"
                                      KeyboardNavigation.DirectionalNavigation="Contained">
                            <!-- 两像素间隔只出现在行间，末行不额外占用滚动空间。 -->
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,2,0,0" />
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                            <Setter Property="Margin" Value="0" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="29" Padding="{Binding RowPadding}" CornerRadius="5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource LineSoftBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Width="12" Height="20" Padding="0" BorderThickness="0"
                                                    Background="Transparent" Command="{Binding ToggleExpansionCommand}"
                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat={loc:Loc ExpandTag}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <controls:IconView Kind="{Binding ExpansionIcon}" Width="12" Height="12"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                            </Button>
                                            <controls:TagTreeCheckBox Grid.Column="2" Style="{StaticResource TagCheckBox}" IsThreeState="False"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding Path}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Color}" Margin="0,0,7,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </controls:TagTreeCheckBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{loc:Loc NoMatchingTags}" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="10,8" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="16,0">
                <TextBlock Text="{Binding GroupSummary}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <controls:IconView Kind="list-tree" Width="13" Height="13" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
            <StackPanel Grid.Row="3" Margin="16,8,16,12">
                <TextBlock Text="{Binding SelectionSummary}" FontSize="11" Height="13" LineHeight="13"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="{Binding MaximumChipHeight, ElementName=PickerRoot}">
                    <ItemsControl ItemsSource="{Binding SelectedPaths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TagPathChip}" Margin="0,8,6,0" ToolTip="{Binding}"
                                        Command="{Binding Model.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=controls:TagTreePicker}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding StringFormat={loc:Loc RemoveTag}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Converter={StaticResource TagPathDisplay}}" FontSize="10" MaxWidth="280" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <controls:IconView Kind="x" Width="11" Height="11" Foreground="{DynamicResource AccentTextBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <Border Grid.Row="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,11">
                <Grid>
                    <Button Style="{DynamicResource IconButton}" Width="Auto" Height="32" Padding="0"
                            HorizontalAlignment="Left" Command="{Binding ClearCommand}">
                        <TextBlock Text="{loc:Loc ClearAll}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                    <Button Style="{DynamicResource PrimaryButton}" Height="32" Padding="14,0" FontWeight="SemiBold"
                            HorizontalAlignment="Right" Command="{Binding ApplyCommand}">
                        <TextBlock Text="{Binding ApplyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InverseTextBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
