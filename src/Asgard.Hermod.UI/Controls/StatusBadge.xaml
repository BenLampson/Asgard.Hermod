<UserControl x:Class="Asgard.Hermod.UI.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:models="clr-namespace:Asgard.Hermod.UI.Models"
             FontFamily="{DynamicResource UiFont}"
             FontSize="11.5"
             FontWeight="SemiBold">
    <Border Padding="9,3" CornerRadius="5">
        <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TitleBarBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="{x:Static models:StatusTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="{x:Static models:StatusTone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="{x:Static models:StatusTone.Danger}">
                    <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                     Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
            <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}"
                       FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
        </StackPanel>
    </Border>
</UserControl>
