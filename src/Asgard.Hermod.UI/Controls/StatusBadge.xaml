<UserControl x:Class="Asgard.Hermod.UI.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
             FontFamily="{DynamicResource UiFont}"
             FontSize="12"
             FontWeight="SemiBold">
    <Border CornerRadius="5">
        <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="{DynamicResource TitleBarBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCaption, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="True">
                    <Setter Property="Height" Value="18" /><Setter Property="Padding" Value="5,0" /><Setter Property="CornerRadius" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="{x:Static models:StatusTone.Accent}">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="{x:Static models:StatusTone.Success}">
                    <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="{x:Static models:StatusTone.Warning}">
                    <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="{x:Static models:StatusTone.Danger}">
                    <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInline, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="True">
                    <Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Ellipse VerticalAlignment="Center" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}">
                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Width" Value="7" /><Setter Property="Height" Value="7" /><Setter Property="Margin" Value="0,0,5,0" /><Style.Triggers><DataTrigger Binding="{Binding IsInline, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="True"><Setter Property="Width" Value="6" /><Setter Property="Height" Value="6" /><Setter Property="Margin" Value="0,0,6,0" /></DataTrigger><DataTrigger Binding="{Binding ShowIndicator, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
            </Ellipse>
            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Text="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" /><Style.Triggers><DataTrigger Binding="{Binding IsCaption, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="True"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}" /></DataTrigger><DataTrigger Binding="{Binding IsInline, RelativeSource={RelativeSource AncestorType={x:Type local:StatusBadge}}}" Value="True"><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
