<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentModelSelector" x:Name="SelectorRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <Grid>
  <Button x:Name="SelectorButton" Click="OnOpen" Style="{StaticResource GhostButton}" Height="30" MinHeight="30" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Padding="0" ToolTip="{Binding Label, ElementName=SelectorRoot}" AutomationProperties.Name="{loc:Loc AgentModelSwitchTitle}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions><controls:IconView Kind="cpu" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding ProfileName, ElementName=SelectorRoot}" FontSize="12" FontWeight="Medium" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Model, ElementName=SelectorRoot}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="140" TextTrimming="CharacterEllipsis" /><controls:IconView Grid.Column="3" Kind="chevron-down" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
  </Button>
  <Popup x:Name="ChoicesPopup" PlacementTarget="{Binding ElementName=SelectorButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><controls:AgentModelChoices DataContext="{Binding ElementName=SelectorRoot}" /></Popup>
 </Grid>
</UserControl>
