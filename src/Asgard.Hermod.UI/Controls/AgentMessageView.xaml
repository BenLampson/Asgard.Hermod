<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentMessageView" x:Name="MessageRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
    <Border x:Name="MessageBubble" CornerRadius="6" Margin="0,0,0,16">
        <Border.Style><Style TargetType="Border">
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser, ElementName=MessageRoot}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Padding" Value="12" /></DataTrigger>
                <DataTrigger Binding="{Binding IsTool, ElementName=MessageRoot}" Value="True"><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12" /></DataTrigger>
            </Style.Triggers>
        </Style></Border.Style>
        <StackPanel>
            <TextBlock Text="{Binding Role, ElementName=MessageRoot}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8" />
            <controls:MarkdownView Source="{Binding Body, ElementName=MessageRoot}">
                <controls:MarkdownView.Style><Style TargetType="controls:MarkdownView">
                    <Setter Property="IsMarkdownEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUser, ElementName=MessageRoot}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsTool, ElementName=MessageRoot}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /></DataTrigger>
                    </Style.Triggers>
                </Style></controls:MarkdownView.Style>
            </controls:MarkdownView>
            <TextBlock Text="{Binding Status, ElementName=MessageRoot}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Status, ElementName=MessageRoot}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ContentControl Content="{Binding ActionsContent, ElementName=MessageRoot}" />
        </StackPanel>
    </Border>
</UserControl>
