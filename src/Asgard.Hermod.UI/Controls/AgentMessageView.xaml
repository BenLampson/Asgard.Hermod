<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentMessageView" x:Name="MessageRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" xmlns:vm="clr-namespace:Asgard.Hermod.UI.ViewModels">
 <UserControl.Resources>
  <DataTemplate DataType="{x:Type vm:AgentApprovalRequest}"><controls:AgentApprovalCard /></DataTemplate>
  <Style x:Key="ReplyAction" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Width" Value="14" /><Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,16,0" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
 </UserControl.Resources>
 <StackPanel Margin="0,0,0,18"><Border x:Name="MessageBubble" CornerRadius="12">
  <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
   <Style.Triggers>
    <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsUser, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /><Setter Property="Padding" Value="16,13" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Width" Value="460" /><Setter Property="MaxWidth" Value="{Binding (controls:AgentMessageScope.Owner).ActualWidth, RelativeSource={RelativeSource Self}}" /></DataTrigger>
    <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsTool, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="0" /></DataTrigger>
    <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsError, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerWeakBrush}" /><Setter Property="Padding" Value="16" /></DataTrigger>
   </Style.Triggers>
  </Style></Border.Style>
  <Expander IsExpanded="{Binding (controls:AgentMessageScope.Owner).IsExpanded, RelativeSource={RelativeSource Self}, Mode=TwoWay}" ExpandDirection="Down">
   <Expander.Style><Style TargetType="Expander">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
     <ToggleButton x:Name="ToolToggle" AutomationProperties.Name="{Binding (controls:AgentMessageScope.Owner).ActivityTitle, RelativeSource={RelativeSource Self}}" ToolTip="{Binding (controls:AgentMessageScope.Owner).Status, RelativeSource={RelativeSource Self}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" MinHeight="32" Height="32" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><DockPanel>
       <controls:IconView x:Name="Chevron" DockPanel.Dock="Right" Kind="chevron-right" Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" RenderTransformOrigin="0.5,0.5"><controls:IconView.Style><Style TargetType="controls:IconView"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView>
       <TextBlock DockPanel.Dock="Right" Text="{Binding (controls:AgentMessageScope.Owner).Elapsed, RelativeSource={RelativeSource Self}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="9,0" VerticalAlignment="Center" />
       <controls:IconView Kind="{Binding (controls:AgentMessageScope.Owner).ActivityIcon, RelativeSource={RelativeSource Self}}" Width="15" Height="15" Margin="0,0,9,0"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).ActivityTone, RelativeSource={RelativeSource Self}}" Value="success"><Setter Property="Foreground" Value="{DynamicResource AgentSuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).ActivityTone, RelativeSource={RelativeSource Self}}" Value="running"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).ActivityTone, RelativeSource={RelativeSource Self}}" Value="warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView>
       <TextBlock Text="{Binding (controls:AgentMessageScope.Owner).ActivityTitle, RelativeSource={RelativeSource Self}}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
      </DockPanel></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter x:Name="ToolBody" ContentSource="Content" Margin="0,8,0,12" />
    </StackPanel><ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ToolBody" Property="Visibility" Value="Collapsed" /></Trigger>
     <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsAwaitingApproval, RelativeSource={RelativeSource Self}}" Value="True"><Setter TargetName="ToolToggle" Property="Visibility" Value="Collapsed" /><Setter TargetName="ToolBody" Property="Margin" Value="0" /></DataTrigger>
     <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsTool, RelativeSource={RelativeSource Self}}" Value="False"><Setter TargetName="ToolToggle" Property="Visibility" Value="Collapsed" /><Setter TargetName="ToolBody" Property="Visibility" Value="Visible" /><Setter TargetName="ToolBody" Property="Margin" Value="0" /></DataTrigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></Expander.Style>
   <StackPanel>
    <ContentControl Content="{Binding (controls:AgentMessageScope.Owner).Approval, RelativeSource={RelativeSource Self}}" HorizontalContentAlignment="Stretch" />
    <DockPanel Margin="0,0,0,8"><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsUser, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsTool, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DockPanel.Style><TextBlock DockPanel.Dock="Right" Text="{Binding (controls:AgentMessageScope.Owner).ModelIdentity, RelativeSource={RelativeSource Self}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /><controls:IconView Kind="sparkles" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{loc:Loc ChatAssistantName}" FontSize="13" FontWeight="SemiBold" /></DockPanel>
    <controls:MarkdownView Source="{Binding (controls:AgentMessageScope.Owner).Body, RelativeSource={RelativeSource Self}}">
     <controls:MarkdownView.Style><Style TargetType="controls:MarkdownView"><Setter Property="IsMarkdownEnabled" Value="True" /><Setter Property="FontSize" Value="16" /><Style.Triggers>
      <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsUser, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /><Setter Property="FontSize" Value="15" /></DataTrigger>
      <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsTool, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /><Setter Property="FontSize" Value="12" /><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /></DataTrigger>
      <DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsError, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /></DataTrigger>
      <DataTrigger Binding="{Binding Approval.IsPending, ElementName=MessageRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
     </Style.Triggers></Style></controls:MarkdownView.Style>
    </controls:MarkdownView>
    <StackPanel x:Name="AnswerActions" Orientation="Horizontal" Height="28" Margin="0,8,0,0">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding (controls:AgentMessageScope.Owner).IsUser, RelativeSource={RelativeSource Self}}" Value="False" /><Condition Binding="{Binding (controls:AgentMessageScope.Owner).IsTool, RelativeSource={RelativeSource Self}}" Value="False" /><Condition Binding="{Binding (controls:AgentMessageScope.Owner).IsError, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding (controls:AgentMessageScope.Owner).Body, RelativeSource={RelativeSource Self}}" Value="" /><Condition Binding="{Binding (controls:AgentMessageScope.Owner).CopyText, RelativeSource={RelativeSource Self}}" Value="" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Button x:Name="CopyAnswer" Click="OnCopyAnswer" Style="{StaticResource ReplyAction}" ToolTip="{loc:Loc ChatCopyAnswer}" AutomationProperties.Name="{loc:Loc ChatCopyAnswer}"><controls:IconView Kind="copy" Width="14" Height="14" /></Button>
     <Button x:Name="RestoreQuestion" Command="{Binding (controls:AgentMessageScope.Owner).RestoreDraftCommand, RelativeSource={RelativeSource Self}}" CommandParameter="{Binding (controls:AgentMessageScope.Owner).Question, RelativeSource={RelativeSource Self}}" ToolTip="{loc:Loc ChatRestoreAnswerQuestion}" AutomationProperties.Name="{loc:Loc ChatRestoreAnswerQuestion}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ReplyAction}"><Style.Triggers><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).Question, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style><controls:IconView Kind="rotate-ccw" Width="14" Height="14" /></Button>
     <Button x:Name="Helpful" Click="OnHelpful" ToolTip="{loc:Loc ChatHelpfulLocal}" AutomationProperties.Name="{loc:Loc ChatHelpfulLocal}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ReplyAction}"><Style.Triggers><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).Feedback, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:AgentMessageFeedback.Helpful}"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style><controls:IconView Kind="thumbs-up" Width="14" Height="14" /></Button>
     <Button x:Name="Unhelpful" Click="OnUnhelpful" ToolTip="{loc:Loc ChatUnhelpfulLocal}" AutomationProperties.Name="{loc:Loc ChatUnhelpfulLocal}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ReplyAction}"><Style.Triggers><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).Feedback, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:AgentMessageFeedback.Unhelpful}"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style><controls:IconView Kind="thumbs-down" Width="14" Height="14" /></Button>
     <TextBlock x:Name="CopyStatus" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <ContentControl Content="{Binding (controls:AgentMessageScope.Owner).ActionsContent, RelativeSource={RelativeSource Self}}" />
    <Button Content="{loc:Loc ChatRestoreDraft}" Command="{Binding (controls:AgentMessageScope.Owner).RestoreDraftCommand, RelativeSource={RelativeSource Self}}" CommandParameter="{Binding (controls:AgentMessageScope.Owner).RecoveryPrompt, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Left" Margin="0,10,0,0">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).RecoveryPrompt, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
   </StackPanel>
  </Expander>
 </Border>
 <TextBlock Text="{Binding (controls:AgentMessageScope.Owner).TimestampLabel, RelativeSource={RelativeSource Self}}" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding (controls:AgentMessageScope.Owner).IsUser, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel>
</UserControl>
