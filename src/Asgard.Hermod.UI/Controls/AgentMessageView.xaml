<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentMessageView" x:Name="MessageRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" xmlns:vm="clr-namespace:Asgard.Hermod.UI.ViewModels">
 <UserControl.Resources><DataTemplate DataType="{x:Type vm:AgentApprovalRequest}"><controls:AgentApprovalCard /></DataTemplate></UserControl.Resources>
 <StackPanel Margin="0,0,0,18"><Border x:Name="MessageBubble" CornerRadius="12">
  <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" />
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsUser, ElementName=MessageRoot}" Value="True"><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /><Setter Property="Padding" Value="16,13" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Width" Value="460" /><Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=MessageRoot}" /></DataTrigger>
    <DataTrigger Binding="{Binding IsTool, ElementName=MessageRoot}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="0" /></DataTrigger>
    <DataTrigger Binding="{Binding IsError, ElementName=MessageRoot}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerWeakBrush}" /><Setter Property="Padding" Value="16" /></DataTrigger>
   </Style.Triggers>
  </Style></Border.Style>
  <Expander IsExpanded="{Binding IsExpanded, ElementName=MessageRoot, Mode=TwoWay}" ExpandDirection="Down">
   <Expander.Style><Style TargetType="Expander">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
     <ToggleButton x:Name="ToolToggle" AutomationProperties.Name="{Binding Role, ElementName=MessageRoot}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" MinHeight="32" Height="32" Background="Transparent" BorderThickness="0" Padding="12,0" HorizontalContentAlignment="Stretch">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><DockPanel>
       <controls:IconView DockPanel.Dock="Right" Kind="chevron-down" Width="12" Height="12" />
       <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed, ElementName=MessageRoot}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0" VerticalAlignment="Center" />
       <controls:IconView Kind="terminal" Width="13" Height="13" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
       <TextBlock Text="{Binding Role, ElementName=MessageRoot}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" /><TextBlock DockPanel.Dock="Right" Text="{Binding Status, ElementName=MessageRoot}" FontSize="10" Margin="8,0" VerticalAlignment="Center" />
      </DockPanel></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter x:Name="ToolBody" ContentSource="Content" Margin="0,8,0,12" />
    </StackPanel><ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ToolBody" Property="Visibility" Value="Collapsed" /></Trigger>
     <DataTrigger Binding="{Binding IsAwaitingApproval, ElementName=MessageRoot}" Value="True"><Setter TargetName="ToolToggle" Property="Visibility" Value="Collapsed" /><Setter TargetName="ToolBody" Property="Margin" Value="0" /></DataTrigger>
     <DataTrigger Binding="{Binding IsTool, ElementName=MessageRoot}" Value="False"><Setter TargetName="ToolToggle" Property="Visibility" Value="Collapsed" /><Setter TargetName="ToolBody" Property="Visibility" Value="Visible" /><Setter TargetName="ToolBody" Property="Margin" Value="0" /></DataTrigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></Expander.Style>
   <StackPanel>
    <ContentControl Content="{Binding Approval, ElementName=MessageRoot}" HorizontalContentAlignment="Stretch" />
    <DockPanel Margin="0,0,0,8"><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding IsUser, ElementName=MessageRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsTool, ElementName=MessageRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DockPanel.Style><TextBlock DockPanel.Dock="Right" Text="{Binding ModelIdentity, ElementName=MessageRoot}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{loc:Loc ChatAssistantName}" FontSize="13" FontWeight="SemiBold" /></DockPanel>
    <controls:MarkdownView Source="{Binding Body, ElementName=MessageRoot}">
     <controls:MarkdownView.Style><Style TargetType="controls:MarkdownView"><Setter Property="IsMarkdownEnabled" Value="True" /><Setter Property="FontSize" Value="16" /><Style.Triggers>
      <DataTrigger Binding="{Binding IsUser, ElementName=MessageRoot}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /><Setter Property="FontSize" Value="15" /></DataTrigger>
      <DataTrigger Binding="{Binding IsTool, ElementName=MessageRoot}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /><Setter Property="FontSize" Value="12" /><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /></DataTrigger>
      <DataTrigger Binding="{Binding IsError, ElementName=MessageRoot}" Value="True"><Setter Property="IsMarkdownEnabled" Value="False" /></DataTrigger>
      <DataTrigger Binding="{Binding Approval.IsPending, ElementName=MessageRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
     </Style.Triggers></Style></controls:MarkdownView.Style>
    </controls:MarkdownView>
    <ContentControl Content="{Binding ActionsContent, ElementName=MessageRoot}" />
    <Button Content="{loc:Loc ChatRestoreDraft}" Command="{Binding RestoreDraftCommand, ElementName=MessageRoot}" CommandParameter="{Binding RecoveryPrompt, ElementName=MessageRoot}" HorizontalAlignment="Left" Margin="0,10,0,0">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding RecoveryPrompt, ElementName=MessageRoot}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
   </StackPanel>
  </Expander>
 </Border>
 <TextBlock Text="{Binding TimestampLabel, ElementName=MessageRoot}" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsUser, ElementName=MessageRoot}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel>
</UserControl>
