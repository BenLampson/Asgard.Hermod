<UserControl x:Class="Asgard.Hermod.UI.Controls.WindowControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:windowing="clr-namespace:Asgard.Hermod.UI.Windowing"
             xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <StackPanel Orientation="Horizontal">
        <Button x:Name="MinimizeButton"
                Click="OnMinimize"
                ToolTip="{loc:Loc Minimize}" AutomationProperties.Name="{loc:Loc MinimizeWindow}"
                chrome:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="40" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorkspace, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="Width" Value="14" />
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Owner.ResizeMode, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="NoResize">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <controls:IconView Kind="minus"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /><Style.Triggers><DataTrigger Binding="{Binding IsWorkspace, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView>
        </Button>
        <Button x:Name="MaximizeButton" Click="OnMaximize"
                chrome:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="ToolTip" Value="{loc:Loc Maximize}" />
                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc MaximizeWindow}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorkspace, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="Width" Value="14" />
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Owner.WindowState, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="Maximized">
                            <Setter Property="ToolTip" Value="{loc:Loc Restore}" />
                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc RestoreWindow}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Owner.ResizeMode, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="NoResize">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Owner.ResizeMode, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="CanMinimize">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <controls:IconView>
                <controls:IconView.Style>
                    <Style TargetType="controls:IconView">
                        <Setter Property="Kind" Value="square" /><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspace, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                                <Setter Property="Width" Value="13" /><Setter Property="Height" Value="13" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Owner.WindowState, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="Maximized">
                                <Setter Property="Kind" Value="copy" />
                                </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:IconView.Style>
            </controls:IconView>
        </Button>
        <Button x:Name="CloseButton"
                Click="OnClose"
                chrome:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                    <Setter Property="ToolTip" Value="{loc:Loc Close}" />
                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc CloseWindow}" />
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="40" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorkspace, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="44" /><Setter Property="Margin" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Owner.(windowing:WindowCloseBehavior.HideToTray), RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="ToolTip" Value="{loc:Loc HideMainWindowToTray}" />
                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc HideMainWindowToTray}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Owner.(windowing:WindowCloseBehavior.IsMainWindow), RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="ToolTip" Value="{Binding Owner.(windowing:WindowCloseBehavior.CloseActionLabel), RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Owner.(windowing:WindowCloseBehavior.CloseActionLabel), RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True">
                            <Setter Property="Width" Value="14" />
                            <Setter Property="Height" Value="26" />
                            <Setter Property="Padding" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <controls:IconView Kind="x"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" /><Style.Triggers><DataTrigger Binding="{Binding IsWorkspace, RelativeSource={RelativeSource AncestorType=controls:WindowControls}}" Value="True"><Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView>
        </Button>
    </StackPanel>
</UserControl>
