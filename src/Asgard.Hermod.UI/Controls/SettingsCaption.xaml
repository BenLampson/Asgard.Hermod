<UserControl x:Class="Asgard.Hermod.UI.Controls.SettingsCaption" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Height="60">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/AgentDesign.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
  <DockPanel LastChildFill="True">
   <Button DockPanel.Dock="Right" Click="OnClose" Style="{StaticResource GhostButton}" Width="24" Height="30" MinHeight="30" Padding="0" VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:Loc Close}" AutomationProperties.Name="{loc:Loc Close}"><controls:IconView Kind="x" Width="16" Height="16" /></Button>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <controls:IconView Kind="settings" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsEditor, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView>
    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UiFont}" Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Style.Triggers><DataTrigger Binding="{Binding IsEditor, ElementName=Root}" Value="True"><Setter Property="FontSize" Value="18" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
  </DockPanel>
 </Border>
</UserControl>
