<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentApprovalCard" x:Name="ApprovalRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
 <Border Padding="14" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}">
  <StackPanel>
   <DockPanel Height="24"><controls:IconView Kind="shield-alert" Width="17" Height="17" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
   <TextBlock Text="{Binding Target}" FontSize="12" LineHeight="19.8" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,12" />
   <TextBox x:Name="OperationCode" Visibility="{Binding ShowCode, ElementName=ApprovalRoot, Converter={StaticResource Visible}}" Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="240" MinHeight="40" Padding="12" BorderThickness="0" Background="{DynamicResource AppBackgroundBrush}" AutomationProperties.Name="{loc:Loc ChatApprovalCode}" />
   <TextBlock Text="{loc:Loc ChatApprovalNotice}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,12" />
   <WrapPanel MinHeight="32">
    <Button AutomationProperties.Name="{loc:Loc ChatApprove}" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" Height="30" MinHeight="30" FontSize="12" FontWeight="Normal" Padding="10,0" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="shield-check" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc ChatApprove}" /></StackPanel></Button>
    <Button Content="{loc:Loc ChatReject}" Command="{Binding RejectCommand}" Style="{StaticResource StandardButton}" Height="30" MinHeight="30" FontSize="12" FontWeight="Normal" Padding="10,0" Margin="0,0,8,0" />
    <Button Content="{loc:Loc ChatInsertOnly}" Command="{Binding InsertCommand}" Visibility="{Binding CanInsert, Converter={StaticResource Visible}}" Style="{StaticResource StandardButton}" Height="30" MinHeight="30" FontSize="12" FontWeight="Normal" Padding="10,0" />
   </WrapPanel>
   <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel>
 </Border>
</UserControl>
