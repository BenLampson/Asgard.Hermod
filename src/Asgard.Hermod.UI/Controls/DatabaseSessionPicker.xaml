<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseSessionPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="PickerSurface" UseLayoutRounding="True" Margin="64,40" Background="{DynamicResource SurfaceBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="66" /><RowDefinition Height="24" /><RowDefinition Height="36" /><RowDefinition Height="24" /><RowDefinition Height="*" /><RowDefinition Height="24" /><RowDefinition Height="42" /></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{loc:Loc DatabasePickTitle}" FontFamily="{DynamicResource UiFont}" Height="35" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" /><TextBlock Text="{loc:Loc DatabasePickIntroduction}" FontFamily="{DynamicResource UiFont}" MinHeight="21" FontSize="13" LineHeight="21.45" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel>
  <DockPanel x:Name="PickerSearch" Grid.Row="2"><TextBlock DockPanel.Dock="Right" Text="{Binding DatabaseChoices.Count, StringFormat={loc:Loc DatabaseAvailableCount}}" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="24,0,0,0" /><CheckBox DockPanel.Dock="Right" Content="{loc:Loc DatabaseSessionSelectAll}" Command="{Binding ToggleAllDatabasesCommand}" IsChecked="{Binding IsAllDatabasesSelected, Mode=OneWay}" Style="{StaticResource DatabaseCheckBox}" Margin="24,0,0,0" VerticalAlignment="Center" /><Grid><TextBox Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" Height="34" MinHeight="34" Padding="34,0,12,0" FontFamily="{DynamicResource UiFont}" FontSize="12" AutomationProperties.Name="{loc:Loc DatabaseSessionSearch}" /><controls:IconView Kind="search" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" Margin="12,0,0,0" /><TextBlock Text="{loc:Loc DatabaseSessionSearch}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="34,0,12,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CatalogSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <Border x:Name="PickerList" Grid.Row="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc DatabaseListName}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11" VerticalAlignment="Center" Margin="30,0,0,0" /><TextBlock Grid.Column="1" Text="{loc:Loc DatabaseListState}" HorizontalAlignment="Right" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CatalogItems}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Height="52" Padding="16,0" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><CheckBox Style="{StaticResource DatabaseCheckBox}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><controls:IconView Kind="database" Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" /><TextBlock Text="{Binding Name}" FontFamily="{DynamicResource UiFont}" FontSize="13" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Text="{loc:Loc DatabaseAvailable}" HorizontalAlignment="Right" FontFamily="{DynamicResource UiFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid></Border>
  <DockPanel x:Name="PickerActions" Grid.Row="6"><Button DockPanel.Dock="Right" Command="{Binding OpenSessionCommand}" Style="{StaticResource DatabasePrimaryButton}" Height="30" Padding="10,0" FontFamily="{DynamicResource UiFont}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="arrow-right" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseCreateSession}" /></StackPanel></Button><Button DockPanel.Dock="Right" Content="{loc:Loc Cancel}" Command="{Binding CancelDatabasePickerCommand}" Style="{StaticResource DatabaseToolbarButton}" VerticalAlignment="Center" Visibility="{Binding CanCancelDatabasePicker, Converter={StaticResource Visible}}" /><TextBlock Text="{Binding CatalogSelectionSummary}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></DockPanel>
 </Grid>
</UserControl>
