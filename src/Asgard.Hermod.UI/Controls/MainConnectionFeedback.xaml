<UserControl x:Class="Asgard.Hermod.UI.Controls.MainConnectionFeedback"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" PreviewKeyDown="OnKeyDown" IsVisibleChanged="OnVisibilityChanged">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="FeedbackButton" TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="15,0" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /></Style>
 </UserControl.Resources>
 <Grid Background="#240D182E">
  <Border x:Name="ConnectionCard" MaxWidth="520" Margin="24" Padding="26" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="8">
   <StackPanel>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <controls:IconView Kind="loader-circle" Width="24" Height="24" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsConnecting, Converter={StaticResource Visible}}" RenderTransformOrigin="0.5,0.5"><controls:IconView.RenderTransform><RotateTransform /></controls:IconView.RenderTransform><controls:IconView.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></EventTrigger></controls:IconView.Triggers></controls:IconView>
     <controls:IconView Kind="circle-alert" Width="24" Height="24" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
     <TextBlock x:Name="FeedbackTitle" Grid.Column="1" Text="{Binding Title}" FontSize="18" FontWeight="Normal" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
    <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}" Margin="0,0,0,18" />
    <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></ScrollViewer>
    <Expander Header="{loc:Loc MainConnectionViewDiagnostics}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,18,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
     <Expander.Template><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Height="20" MinHeight="20" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="{loc:Loc MainConnectionViewDiagnostics}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><StackPanel Orientation="Horizontal"><TextBlock Text="{loc:Loc MainConnectionViewDiagnostics}" FontSize="12" VerticalAlignment="Center" /><controls:IconView x:Name="Arrow" Kind="chevron-right" Width="12" Height="12" Margin="6,0,0,0" RenderTransformOrigin="0.5,0.5" /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="DetailBody" ContentSource="Content" Visibility="Collapsed" /></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DetailBody" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" /></Expander>
    <Grid Margin="0,18,0,0">
     <Button x:Name="CancelConnection" Content="{loc:Loc MainConnectionCancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsConnecting, Converter={StaticResource Visible}}" HorizontalAlignment="Right" Style="{StaticResource FeedbackButton}" />
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
      <Button Content="{loc:Loc MainConnectionBack}" Command="{Binding DismissCommand}" Style="{StaticResource FeedbackButton}" Margin="0,0,8,0" />
      <Button x:Name="RetryConnection" Content="{loc:Loc MainConnectionRetry}" Command="{Binding RetryCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FeedbackButton}"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Style></Button.Style></Button>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
