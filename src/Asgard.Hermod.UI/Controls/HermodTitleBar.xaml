<UserControl x:Class="Asgard.Hermod.UI.Controls.HermodTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="{Binding CaptionHeight, RelativeSource={RelativeSource AncestorType=controls:HermodWindow}}">
    <!-- 普通区域由 WindowChrome 处理拖动和双击，窗口按钮仍参与正常命中测试。 -->
    <Border Background="{DynamicResource TitleBarBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:IconView Kind="app-window" Width="14" Height="14"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{DynamicResource UiFont}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="8,0,8,0" />
            </Grid>
            <controls:WindowControls Grid.Column="1" IsCompact="True" VerticalAlignment="Center"
                                     chrome:WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
    </Border>
</UserControl>
