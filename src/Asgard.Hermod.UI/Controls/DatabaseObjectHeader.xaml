<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseObjectHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Height="58" Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
  <controls:IconView Kind="{Binding Icon}" Width="20" Height="20" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
  <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock DockPanel.Dock="Left" x:Name="ObjectName" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="18" FontWeight="SemiBold" MaxWidth="480" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DatabaseContext}" ToolTip="{Binding DatabaseContext}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" /></DockPanel>
  <Border Grid.Column="2" Height="24" CornerRadius="4" Background="{DynamicResource AppBackgroundBrush}" Padding="8,0" Margin="0,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding ObjectTypeName}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></Border>
  <Button x:Name="ReturnToScript" Grid.Column="3" Command="{Binding (controls:DatabaseObjectScope.ReturnToScriptCommand), RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" ToolTip="{loc:Loc DatabaseObjectReturnScript}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DatabaseObjectButton}"><Style.Triggers><Trigger Property="Command" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><controls:IconView Kind="arrow-left" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="{loc:Loc DatabaseObjectReturnScript}" /></StackPanel></Button>
 </Grid>
</UserControl>
