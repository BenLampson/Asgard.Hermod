<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentThinkingView" x:Name="ThinkingRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:Asgard.Hermod.UI.Controls">
 <UserControl.Style><Style TargetType="UserControl"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding State.HasContent, ElementName=ThinkingRoot}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></UserControl.Style>
 <StackPanel DataContext="{Binding State, ElementName=ThinkingRoot}" Margin="0,0,0,8">
  <ToggleButton x:Name="ThinkingToggle" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Height="32" MinHeight="32" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
   AutomationProperties.Name="{Binding ToggleLabel}" ToolTip="{Binding ToggleLabel}" PreviewKeyDown="OnToggleKeyDown">
   <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HitArea" Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,0,8,0"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitArea" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="HitArea" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <c:IconView Kind="chevron-right" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}" RenderTransformOrigin="0.5,0.5"><c:IconView.Style><Style TargetType="c:IconView"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></c:IconView.Style></c:IconView>
    <TextBlock x:Name="ThinkingLabel" Text="{Binding Header}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
    <TextBlock Text="{Binding ElapsedLabel}" FontSize="11" Margin="9,0,0,0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
   </StackPanel>
  </ToggleButton>
  <Border x:Name="ThinkingBody" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0" Margin="6,6,0,4">
   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
   <TextBox x:Name="ReasoningText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.Name="{Binding Header}" />
  </Border>
 </StackPanel>
</UserControl>
