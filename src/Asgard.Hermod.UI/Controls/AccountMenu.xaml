<UserControl x:Class="Asgard.Hermod.UI.Controls.AccountMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="AccountButton" Click="OnAccountClick"
            Style="{DynamicResource IconButton}" Width="Auto" Height="28" Padding="4,0"
            ToolTip="Account">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="11"
                    Background="{DynamicResource AccentBrush}">
                <TextBlock Text="{Binding AccountInitials}" FontSize="9.5" FontWeight="Bold"
                           Foreground="{DynamicResource InverseTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding AccountName}" FontSize="12"
                       Foreground="{DynamicResource TextBodyBrush}"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{Binding AccountName}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="登录服务尚未接入" IsEnabled="False"
                          ToolTip="账号与同步能力会在后续身份接入时启用。" />
                <MenuItem Header="Local terminal" Command="{Binding OpenLocalTerminalCommand}" />
            </ContextMenu>
        </Button.ContextMenu>
    </Button>
</UserControl>
