<UserControl x:Class="Asgard.Hermod.UI.Controls.AccountMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <!-- Pencil 账户菜单：独立身份头部、34px 信息行和 42px 退出行。 -->
        <Style x:Key="AccountMenuRow" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="AccountIdentityHeader" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="MenuItem">
                    <ContentPresenter ContentSource="Header" Margin="12" />
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Button x:Name="AccountButton" Click="OnAccountClick" ContextMenuOpening="OnContextMenuOpening"
            Style="{DynamicResource IconButton}" Width="Auto" Height="28" Padding="4,0"
            FocusVisualStyle="{DynamicResource RowKeyboardFocusVisual}"
            ToolTip="{loc:Loc AccountAndSync}" AutomationProperties.Name="{Binding AccountName}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="22" Height="22" CornerRadius="11">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource LineSoftBrush}" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <Grid>
                    <controls:IconView x:Name="LocalDeviceIcon" Kind="laptop" Width="13" Height="13"
                                       Foreground="{DynamicResource TextMutedBrush}">
                        <controls:IconView.Style><Style TargetType="controls:IconView">
                            <Style.Triggers><DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger></Style.Triggers>
                        </Style></controls:IconView.Style>
                    </controls:IconView>
                    <TextBlock x:Name="AvatarInitials" Text="{Binding AccountInitials}" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource InverseTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <TextBlock Text="{Binding AccountName}" FontSize="12" MaxWidth="140"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountName}"
                       Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:AccountMenu}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <StackPanel x:Name="LocalSignIn" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:AccountMenu}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                <Border Width="1" Height="12" Background="{DynamicResource LineBrush}" Margin="8,0" />
                <TextBlock Text="{loc:Loc SignIn}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="4,0" />
            </StackPanel>
            <controls:IconView x:Name="AccountChevron" Kind="chevron-down" Width="12" Height="12" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                <controls:IconView.Style><Style TargetType="controls:IconView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger></Style.Triggers>
                </Style></controls:IconView.Style>
            </controls:IconView>
        </StackPanel>
        <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Width="312" Placement="Custom" Padding="0">
                <ContextMenu.Style><Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                        <!-- 阴影留在透明弹层内，280px 面板与账户按钮右边缘对齐。 -->
                        <Grid Margin="16">
                            <Border x:Name="MenuChrome" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                                <Border.Effect><DropShadowEffect Color="#0B1220" Opacity="0.12" BlurRadius="20" ShadowDepth="6" Direction="270" /></Border.Effect>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                            </Border>
                        </Grid>
                    </ControlTemplate></Setter.Value></Setter>
                </Style></ContextMenu.Style>
                <MenuItem Style="{StaticResource AccountIdentityHeader}">
                    <MenuItem.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding AccountName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="254" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Height="24" CornerRadius="5" Padding="8,0" Background="{DynamicResource SuccessWeakBrush}">
                                    <TextBlock Text="{Binding AccountStatus}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                                <Border x:Name="AccountSyncBadge" Height="24" CornerRadius="5" Padding="8,0" Margin="8,0,0,0"
                                        ToolTip="{Binding SyncStatusText}" AutomationProperties.Name="{Binding SyncStatusText}">
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="{DynamicResource LineSoftBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSyncStatus}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Synced}">
                                                <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Pending}">
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Synchronizing}">
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.PasswordRequired}">
                                                <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Conflict}">
                                                <Setter Property="Background" Value="{DynamicResource WarningWeakBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Failed}">
                                                <Setter Property="Background" Value="{DynamicResource DangerWeakBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style></Border.Style>
                                    <TextBlock Text="{Binding SyncStatusLabel}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding AccountMessage}" TextWrapping="Wrap" MaxWidth="254"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Style.Triggers><DataTrigger Binding="{Binding AccountMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Loc AccountInformation}" Command="{Binding OpenAccountCommand}" Style="{StaticResource AccountMenuRow}">
                    <MenuItem.Icon><controls:IconView Kind="user-round" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{loc:Loc SignOut}" Command="{Binding SignOutAccountCommand}" Height="42" Margin="4,0" Padding="10,0">
                    <MenuItem.Icon><controls:IconView Kind="log-out" Width="16" Height="16" /></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Button.ContextMenu>
    </Button>
</UserControl>
