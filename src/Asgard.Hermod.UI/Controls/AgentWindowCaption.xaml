<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentWindowCaption"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/AgentDesign.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Height="44" Background="{DynamicResource AppBackgroundBrush}" Padding="18,0">
  <DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}" Style="{StaticResource IconButton}" Width="36" Height="32" ToolTip="{loc:Loc Minimize}" AutomationProperties.Name="{loc:Loc Minimize}"><controls:IconView Kind="minus" Width="12" Height="12" /></Button>
    <Button Click="OnMaximize" Style="{StaticResource IconButton}" Width="36" Height="32" ToolTip="{loc:Loc Maximize}" AutomationProperties.Name="{loc:Loc Maximize}"><controls:IconView Kind="square" Width="12" Height="12" /></Button>
    <Button Command="{x:Static SystemCommands.CloseWindowCommand}" Style="{StaticResource IconButton}" Width="36" Height="32" ToolTip="{loc:Loc AgentHide}" AutomationProperties.Name="{loc:Loc AgentHide}"><controls:IconView Kind="x" Width="14" Height="14" /></Button>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:IconView Kind="sparkles" Foreground="{DynamicResource AccentBrush}" Width="16" Height="16" Margin="0,0,9,0" /><TextBlock Text="{loc:Loc ChatWindowTitle}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" /></StackPanel>
  </DockPanel>
 </Border>
</UserControl>
