<UserControl x:Class="Asgard.Hermod.UI.Controls.SearchableSelect"
             x:Name="SelectRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:local="clr-namespace:Asgard.Hermod.UI.Controls"
             FontFamily="{DynamicResource UiFont}" FontSize="12" Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SelectVisible" />
        <Style x:Key="SelectTrigger" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="FocusRing" CornerRadius="5" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SelectOptionContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Grid>
                    <Border x:Name="OptionChrome" Background="Transparent" CornerRadius="5"><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" /></Border>
                    <Border x:Name="OptionFocus" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionChrome" Property="Background" Value="{DynamicResource AppBackgroundBrush}" /></Trigger>
                    <DataTrigger Binding="{Binding IsCommitted}" Value="True"><Setter TargetName="OptionChrome" Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="OptionFocus" Property="Visibility" Value="Visible" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="TriggerButton" Style="{StaticResource SelectTrigger}" Click="OnTriggerClick" PreviewKeyDown="OnTriggerKeyDown"
                AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=SelectRoot}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="13" /></Grid.ColumnDefinitions>
                <local:IconView Kind="{Binding Icon, ElementName=SelectRoot}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}">
                    <local:IconView.Style><Style TargetType="local:IconView"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Icon, ElementName=SelectRoot}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></local:IconView.Style>
                </local:IconView>
                <TextBlock Grid.Column="1" Text="{Binding SelectedLabel, ElementName=SelectRoot}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />
                <local:IconView Grid.Column="2" Kind="chevron-down" Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </Button>
        <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=TriggerButton}" Placement="Bottom" VerticalOffset="4"
               AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsDropDownOpen, ElementName=SelectRoot, Mode=TwoWay}" Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Grid KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnPopupKeyDown">
                <Border x:Name="OptionsChrome" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Width="280">
                    <StackPanel>
                        <Grid Height="28" Margin="0,0,0,4">
                            <TextBox x:Name="FilterInput" Text="{Binding SearchText, ElementName=SelectRoot, UpdateSourceTrigger=PropertyChanged}" Height="28" MinHeight="28" Padding="28,0,25,0" FontSize="11" PreviewKeyDown="OnFilterKeyDown" AutomationProperties.Name="{loc:Loc FilterOptions}" />
                            <local:IconView Kind="search" Width="14" Height="14" Margin="8,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" />
                            <TextBlock Text="{loc:Loc SearchOptions}" Margin="28,0,28,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText, ElementName=SelectRoot}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Button Click="OnClearFilter" Style="{StaticResource IconButton}" Width="24" Height="24" Padding="5" HorizontalAlignment="Right" ToolTip="{loc:Loc ClearFilters}" AutomationProperties.Name="{loc:Loc ClearOptionFilter}">
                                <local:IconView Kind="x" Width="12" Height="12" />
                            </Button>
                        </Grid>
                        <ListBox x:Name="OptionsList" ItemsSource="{Binding Options, ElementName=SelectRoot}" MaxHeight="224" BorderThickness="0" Background="Transparent" Padding="0"
                                 ItemContainerStyle="{StaticResource SelectOptionContainer}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonUp="OnOptionClick" PreviewKeyDown="OnOptionsKeyDown" AutomationProperties.Name="{loc:Loc AvailableOptions}">
                            <ListBox.ItemTemplate><DataTemplate><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontFamily="{DynamicResource UiFont}" FontSize="12" FontWeight="Normal" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" TextTrimming="CharacterEllipsis" />
                                <local:IconView Grid.Column="1" Kind="check" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsCommitted, Converter={StaticResource SelectVisible}}" />
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyOptions" Margin="8,10">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasOptions, ElementName=SelectRoot}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="{loc:Loc NoMatchingOptions}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <Button Content="{loc:Loc ClearFilters}" Click="OnClearFilter" Style="{StaticResource GhostButton}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding OptionCountText, ElementName=SelectRoot}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,6,8,2" />
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
