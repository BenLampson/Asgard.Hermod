<UserControl x:Class="Asgard.Hermod.UI.Controls.DatabaseColumnReader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" SizeChanged="OnSizeChanged" ClipToBounds="True">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="ColumnText" TargetType="TextBlock"><Setter Property="Margin" Value="12,0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="ColumnLabel" TargetType="TextBlock" BasedOn="{StaticResource ColumnText}"><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /></Style>
  <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource WorkspaceResultGridHeader}"><Setter Property="Height" Value="36" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Padding" Value="12,0" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <DataGrid x:Name="ColumnGrid" Style="{StaticResource WorkspaceResultGrid}" ColumnHeaderStyle="{StaticResource ColumnHeader}" CellStyle="{StaticResource DatabaseResultCell}" BorderThickness="0" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="44" ColumnHeaderHeight="36" GridLinesVisibility="Horizontal" CanUserResizeRows="False" SelectionUnit="FullRow" MaxHeight="420" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{loc:Loc DatabaseColumnFields}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="{loc:Loc DatabaseColumnName}" Binding="{Binding Name}" Width="210" MinWidth="160" ElementStyle="{StaticResource ColumnText}" />
    <DataGridTextColumn Header="{loc:Loc DatabaseColumnType}" Binding="{Binding DataType}" Width="210" MinWidth="160" ElementStyle="{StaticResource ColumnText}" />
    <DataGridTextColumn Header="{loc:Loc DatabaseColumnNullable}" Binding="{Binding NullableLabel}" Width="110" MinWidth="100" ElementStyle="{StaticResource ColumnLabel}" />
    <DataGridTextColumn Header="{loc:Loc DatabaseColumnDefault}" Binding="{Binding DefaultLabel}" Width="250" MinWidth="180" ElementStyle="{StaticResource ColumnText}" />
    <DataGridTextColumn Header="{loc:Loc DatabaseColumnConstraints}" Binding="{Binding ConstraintLabel}" Width="*" MinWidth="140" ElementStyle="{StaticResource ColumnLabel}" />
   </DataGrid.Columns>
  </DataGrid>
  <Border x:Name="SelectionCard" Grid.Row="1" Background="{DynamicResource DatabaseMetadataBackgroundBrush}" CornerRadius="5" SizeChanged="OnSelectionSizeChanged" Padding="16" Margin="0,16,0,0" MinHeight="100">
   <StackPanel><TextBlock x:Name="SelectedName" FontFamily="{DynamicResource MonoFont}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SelectedComment" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="40" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,8,0,0" /><TextBox x:Name="SelectedDefinition" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource DatabaseMetadataCodeBrush}" MinHeight="0" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="100" AutomationProperties.Name="{loc:Loc DatabaseColumnServerDefinition}" /></StackPanel>
  </Border>
 </Grid>
</UserControl>
