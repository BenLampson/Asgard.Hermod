<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentPanel" x:Name="AgentRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 PreviewKeyDown="OnPromptKeyDown" SizeChanged="OnViewportChanged">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/AgentDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /><DataTemplate x:Key="ActivityGroupTemplate"><controls:AgentMessageView IsTool="True" ActivityTitle="{Binding Title}" Status="{Binding Title}" ActivityTone="{Binding Tone}" ActivityIcon="{Binding Icon}" Elapsed="{Binding Elapsed}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"><controls:AgentMessageView.ActionsContent><ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{Binding (controls:AgentConversationScope.MessageTemplate), RelativeSource={RelativeSource Self}}" /></controls:AgentMessageView.ActionsContent></controls:AgentMessageView></DataTemplate></ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <DockPanel x:Name="ToolbarColumn" MaxWidth="1120" Margin="80,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Click="OnConfigureModel" Width="26" Height="30" MinHeight="30" Style="{StaticResource GhostButton}" Padding="0" ToolTip="{loc:Loc AgentModelManage}" AutomationProperties.Name="{loc:Loc AgentModelManage}"><controls:IconView Kind="settings-2" Width="16" Height="16" /></Button><Border Width="1" Height="16" Background="{DynamicResource LineBrush}" Margin="8,0" />
     <Button x:Name="HistoryPicker" Click="OnHistory" IsEnabled="{Binding Archive.CanSwitch, ElementName=AgentRoot}" Height="30" MinHeight="30" FontSize="11" FontWeight="Normal" Padding="7,0" Style="{StaticResource GhostButton}" ToolTip="{loc:Loc ChatHistory}" AutomationProperties.Name="{loc:Loc ChatHistory}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:IconView Kind="history" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc ChatHistory}" /></StackPanel></Button>
     <Button Command="{Binding Archive.NewCommand, ElementName=AgentRoot}" AutomationProperties.Name="{loc:Loc AgentNewConversation}" Style="{StaticResource GhostButton}" Height="30" MinHeight="30" Padding="7,0" FontSize="11" FontWeight="Normal"><StackPanel Orientation="Horizontal"><controls:IconView Kind="plus" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc AgentNewConversation}" /></StackPanel></Button>
    </StackPanel>
    <controls:AgentModelSelector x:Name="ModelSelector" Session="{Binding ModelSession, ElementName=AgentRoot}" IsBusy="{Binding IsBusy, ElementName=AgentRoot}" CancelTask="{Binding CancelCommand, ElementName=AgentRoot}" ManageRequested="OnModelManageRequested" VerticalAlignment="Center" />
   </DockPanel>
  </Border>
  <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer"><Grid>
    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" ClipToBounds="True" />
    <ScrollBar x:Name="PART_VerticalScrollBar" Width="8" Orientation="Vertical" HorizontalAlignment="Right" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
   </Grid></ControlTemplate></ScrollViewer.Template>
   <StackPanel x:Name="MessageColumn" MaxWidth="1120" Margin="80,28">
    <Grid x:Name="Welcome" MinHeight="500">
     <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ConversationItems}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
     <StackPanel VerticalAlignment="Center" Margin="80,0">
      <controls:IconView Kind="sparkles" Width="32" Height="32" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,22" HorizontalAlignment="Center" />
      <TextBlock Text="{loc:Loc ChatWelcome}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22" />
      <TextBlock Text="{Binding WelcomeDescription, ElementName=AgentRoot}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" LineHeight="23.1" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,22" />
      <ItemsControl ItemsSource="{Binding QuickPrompts, ElementName=AgentRoot}"><ItemsControl.ItemTemplate><DataTemplate>
       <Button Click="OnQuickPrompt" AutomationProperties.Name="{Binding}" Style="{StaticResource GhostButton}" Height="44" MinHeight="44" FontSize="13" FontWeight="Normal" HorizontalContentAlignment="Stretch" Padding="0">
        <Button.Template><ControlTemplate TargetType="Button"><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="Transparent"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
        <StackPanel Orientation="Horizontal"><controls:IconView Kind="arrow-up-left" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,9,0" /><TextBlock Text="{Binding}" /></StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Grid>
    <ItemsControl x:Name="ConversationItems" ItemsSource="{Binding PresentationMessages, ElementName=AgentRoot}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><DockPanel Tag="AgentToolTurnHeader" Height="24" Margin="0,0,0,18" Visibility="{Binding ShowToolTurnHeader, Converter={StaticResource Visible}}"><TextBlock DockPanel.Dock="Right" Text="{Binding ModelIdentity}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><controls:IconView Kind="sparkles" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc ChatAssistantName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel><ContentControl Content="{Binding Message}" controls:AgentConversationScope.HideAssistantIdentity="{Binding HideMessageIdentity}" HorizontalContentAlignment="Stretch"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{Binding (controls:AgentConversationScope.MessageTemplate), RelativeSource={RelativeSource Self}}" /><Style.Triggers><DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ActivityGroupTemplate}" /></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{loc:Loc ChatSourceClosed}" Visibility="{Binding IsSourceClosed, ElementName=AgentRoot, Converter={StaticResource Visible}}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,12" />
    <StackPanel Margin="0,8,0,18"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBusy, ElementName=AgentRoot}" Value="True" /><Condition Binding="{Binding IsAwaitingApproval, ElementName=AgentRoot}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{loc:Loc ChatAssistantName}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
     <TextBlock Text="{Binding Status, ElementName=AgentRoot}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,18,0,0" Visibility="{Binding NeedsConfirmation, ElementName=ModelSelector, Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="{loc:Loc AgentModelSwitchConfirmTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" /><TextBlock Text="{Binding SwitchPrompt, ElementName=ModelSelector}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" LineHeight="21.45" TextWrapping="Wrap" Margin="0,0,0,14" /><StackPanel Orientation="Horizontal" Height="32"><Button Content="{loc:Loc AgentModelStopAndSwitch}" Command="{Binding ConfirmSwitchCommand, ElementName=ModelSelector}" Style="{StaticResource PrimaryButton}" Height="30" MinHeight="30" FontSize="12" Padding="10,0" /><Button Content="{loc:Loc Cancel}" Command="{Binding CancelSwitchCommand, ElementName=ModelSelector}" Height="30" MinHeight="30" FontSize="12" Padding="10,0" Margin="8,0,0,0" /></StackPanel></StackPanel></Border>
    <TextBlock Text="{Binding Error, ElementName=ModelSelector}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
    <Button Click="OnConfigureModel" Content="{loc:Loc AgentConfigurationRequired}" HorizontalAlignment="Left" FontSize="12" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsConfigured, ElementName=ModelSelector}" Value="False" /><Condition Binding="{Binding IsSourceClosed, ElementName=AgentRoot}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
    <TextBlock Text="{Binding Error, ElementName=AgentRoot}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ConversationItems}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
  </ScrollViewer>
  <StackPanel x:Name="ComposerColumn" Grid.Row="2" MaxWidth="1120" Margin="80,12,80,14" MinHeight="156">
   <Border x:Name="Composer" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14" MinHeight="128">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <Grid MinHeight="58">
      <TextBox x:Name="PromptEditor" IsReadOnly="{Binding IsSourceClosed, ElementName=AgentRoot}" Style="{StaticResource AgentTextBox}" Text="{Binding Prompt, ElementName=AgentRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" MinHeight="58" MaxHeight="240" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="{Binding MaxPromptLength, ElementName=AgentRoot}" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="{Binding Placeholder, ElementName=AgentRoot}" />
      <TextBlock x:Name="PromptPlaceholder" Text="{Binding Placeholder, ElementName=AgentRoot}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PromptEditor}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <DockPanel Grid.Row="1" Margin="0,10,0,0" MinHeight="30">
      <Button x:Name="SendAction" IsEnabled="{Binding IsConfigured, ElementName=ModelSelector}" DockPanel.Dock="Right" Command="{Binding SendCommand, ElementName=AgentRoot}" Style="{StaticResource PrimaryButton}" Width="30" Height="30" MinHeight="30" Padding="0" ToolTip="{loc:Loc AgentSend}" AutomationProperties.Name="{loc:Loc AgentSend}"><controls:IconView Kind="arrow-up" Width="14" Height="14" /></Button>
      <Button DockPanel.Dock="Right" Content="{loc:Loc AgentStop}" Command="{Binding CancelCommand, ElementName=AgentRoot}" Margin="0,0,8,0" Height="30" MinHeight="30" Visibility="{Binding IsBusy, ElementName=AgentRoot, Converter={StaticResource Visible}}" />
      <StackPanel Orientation="Horizontal">
       <ToggleButton x:Name="ContextToggle" Height="30" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="{loc:Loc ChatContextOptions}" AutomationProperties.Name="{loc:Loc ChatContextOptions}">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><ContentPresenter VerticalAlignment="Center" /></Border></ControlTemplate></ToggleButton.Template>
        <StackPanel Orientation="Horizontal"><controls:IconView Kind="plus" Width="17" Height="17" Margin="0,0,12,0" Foreground="{DynamicResource TextMutedBrush}" /><controls:IconView Kind="paperclip" Width="16" Height="16" Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{loc:Loc ChatContext}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></StackPanel>
       </ToggleButton>
       <ContentControl Content="{Binding ComposerOptions, ElementName=AgentRoot}" Margin="12,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
     </DockPanel>
     <StackPanel Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=ContextToggle, Converter={StaticResource Visible}}"><ContentControl Content="{Binding ContextContent, ElementName=AgentRoot}" /><TextBlock Text="{loc:Loc ChatSharingHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
    </Grid>
   </Border>
   <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Loc AgentSendHint}" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy, ElementName=AgentRoot}" Value="True"><Setter Property="Text" Value="{loc:Loc ChatBusyComposerHint}" /></DataTrigger><DataTrigger Binding="{Binding IsAwaitingApproval, ElementName=AgentRoot}" Value="True"><Setter Property="Text" Value="{loc:Loc ChatApprovalComposerHint}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </StackPanel>
 </Grid>
</UserControl>
