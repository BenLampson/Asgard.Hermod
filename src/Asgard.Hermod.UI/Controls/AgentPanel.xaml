<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentPanel" x:Name="AgentRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" PreviewKeyDown="OnPromptKeyDown">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
    <Border Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                <DockPanel x:Name="AgentHeader">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ClearCommand, ElementName=AgentRoot}" Style="{StaticResource StandardButton}" Width="32" Height="32" Padding="0" ToolTip="{loc:Loc AgentNewConversation}" AutomationProperties.Name="{loc:Loc AgentNewConversation}" Margin="0,0,8,0"><controls:IconView Kind="plus" Width="15" Height="15" /></Button>
                        <Button x:Name="HideAgentButton" Command="{Binding HideCommand, ElementName=AgentRoot}" Click="OnClose" Style="{StaticResource StandardButton}" Width="32" Height="32" Padding="0" ToolTip="{loc:Loc AgentHide}" AutomationProperties.Name="{loc:Loc AgentHide}"><controls:IconView Kind="x" Width="15" Height="15" /></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:IconView Kind="sparkles" Foreground="{DynamicResource AccentBrush}" Width="17" Height="17" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc AgentPanelTitle}" FontSize="14" FontWeight="SemiBold" /></StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                <ContentControl Content="{Binding ContextContent, ElementName=AgentRoot}" />
            </Border>
            <ScrollViewer x:Name="ConversationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,0">
                <ItemsControl ItemsSource="{Binding Messages, ElementName=AgentRoot}" ItemTemplate="{Binding MessageTemplate, ElementName=AgentRoot}" />
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="18,8,18,8">
                <TextBlock Text="{Binding Error, ElementName=AgentRoot}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Status, ElementName=AgentRoot}" Visibility="{Binding IsBusy, ElementName=AgentRoot, Converter={StaticResource Visible}}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="14,0,14,14">
                <Border x:Name="Composer" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptEditor}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid MinHeight="48">
                            <TextBox x:Name="PromptEditor" Style="{StaticResource AgentTextBox}" Text="{Binding Prompt, ElementName=AgentRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="{Binding MaxPromptLength, ElementName=AgentRoot}" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="{Binding Placeholder, ElementName=AgentRoot}" />
                            <TextBlock x:Name="PromptPlaceholder" Text="{Binding Placeholder, ElementName=AgentRoot}" IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}" FontSize="{Binding FontSize, ElementName=PromptEditor}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PromptEditor}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button x:Name="SendAction" DockPanel.Dock="Right" Command="{Binding SendCommand, ElementName=AgentRoot}" Style="{StaticResource PrimaryButton}" ToolTip="{loc:Loc AgentSend}" AutomationProperties.Name="{loc:Loc AgentSend}" Width="34" Height="32" Padding="0"><controls:IconView Kind="arrow-right" Width="15" Height="15" RenderTransformOrigin="0.5,0.5"><controls:IconView.RenderTransform><RotateTransform Angle="-90" /></controls:IconView.RenderTransform></controls:IconView></Button>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc AgentStop}" Command="{Binding CancelCommand, ElementName=AgentRoot}" Margin="0,0,8,0" Visibility="{Binding IsBusy, ElementName=AgentRoot, Converter={StaticResource Visible}}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:IconView Kind="sparkles" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{loc:Loc AgentPanelTitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{loc:Loc AgentSendHint}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
