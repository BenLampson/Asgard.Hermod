<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentCodeSuggestion" x:Name="SuggestionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
    <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <ToggleButton x:Name="SuggestionToggle" IsChecked="{Binding IsExpanded, ElementName=SuggestionRoot, Mode=TwoWay}" MinHeight="32" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0" PreviewKeyDown="OnToggleKeyDown">
                <ToggleButton.Style><Style TargetType="ToggleButton">
                    <Setter Property="ToolTip" Value="{loc:Loc ChatSuggestionExpand}" /><Setter Property="AutomationProperties.Name" Value="{loc:Loc ChatSuggestionExpand}" />
                    <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="{loc:Loc ChatSuggestionCollapse}" /><Setter Property="AutomationProperties.Name" Value="{loc:Loc ChatSuggestionCollapse}" /></Trigger><DataTrigger Binding="{Binding Execution.IsAwaitingApproval, ElementName=SuggestionRoot}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                </Style></ToggleButton.Style>
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HitArea" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HitArea" Property="Background" Value="{DynamicResource SurfaceBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitArea" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></ToggleButton.Template>
                <DockPanel>
                    <controls:IconView DockPanel.Dock="Right" Kind="chevron-right" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5"><controls:IconView.Style><Style TargetType="controls:IconView"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SuggestionRoot}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></controls:IconView.Style></controls:IconView>
                    <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Loc ChatSuggestionExpand}" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SuggestionRoot}" Value="True"><Setter Property="Text" Value="{loc:Loc ChatSuggestionCollapse}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Execution.Status, ElementName=SuggestionRoot}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SuggestionRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock Text="{Binding Caption, ElementName=SuggestionRoot}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </ToggleButton>
            <StackPanel x:Name="SuggestionBody" Margin="0,10,0,0" Visibility="{Binding IsExpanded, ElementName=SuggestionRoot, Converter={StaticResource Visible}}">
            <TextBox x:Name="SuggestionCode" Text="{Binding Code, ElementName=SuggestionRoot, Mode=OneWay}" Style="{StaticResource AgentTextBox}" FontFamily="{DynamicResource MonoFont}" FontSize="12" IsReadOnly="True" MinHeight="0" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent" Padding="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Caption, ElementName=SuggestionRoot}" />
            <WrapPanel Margin="0,12,0,0">
                <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding Execution.IsActive, ElementName=SuggestionRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <Button Content="{Binding InsertText, ElementName=SuggestionRoot}" Command="{Binding InsertCommand, ElementName=SuggestionRoot}" CommandParameter="{Binding CommandParameter, ElementName=SuggestionRoot}" Margin="0,0,8,4" />
                <Button x:Name="ExecuteAction" Command="{Binding ExecuteCommand, ElementName=SuggestionRoot}" CommandParameter="{Binding CommandParameter, ElementName=SuggestionRoot}" Margin="0,0,0,4">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Content" Value="{Binding ExecuteText, ElementName=SuggestionRoot}" /><Style.Triggers><DataTrigger Binding="{Binding Execution.HasExecuted, ElementName=SuggestionRoot}" Value="True"><Setter Property="Content" Value="{loc:Loc ChatSqlRunAgain}" /></DataTrigger><DataTrigger Binding="{Binding Execution.CanExecute, ElementName=SuggestionRoot}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </WrapPanel>
            <controls:AgentApprovalCard x:Name="InlineApproval" ShowCode="False" DataContext="{Binding Execution.Approval, ElementName=SuggestionRoot}" Visibility="{Binding Execution.IsAwaitingApproval, ElementName=SuggestionRoot, Converter={StaticResource Visible}, FallbackValue=Collapsed}" Margin="0,12,0,0" />
            <StackPanel Margin="0,10,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Execution.Status, ElementName=SuggestionRoot, TargetNullValue='', FallbackValue=''}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Execution.IsAwaitingApproval, ElementName=SuggestionRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Execution.Elapsed, ElementName=SuggestionRoot}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0" /><TextBlock x:Name="ExecutionStatus" Text="{Binding Execution.Status, ElementName=SuggestionRoot}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></DockPanel>
                <TextBlock Text="{Binding Execution.Approval.Target, ElementName=SuggestionRoot}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBox x:Name="ExecutionResult" Text="{Binding Execution.Result, ElementName=SuggestionRoot, Mode=OneWay}" Visibility="{Binding Execution.HasResult, ElementName=SuggestionRoot, Converter={StaticResource Visible}, FallbackValue=Collapsed}" Style="{StaticResource AgentTextBox}" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,0" AutomationProperties.Name="{loc:Loc ChatSqlExecutionResultLabel}" />
                <StackPanel Visibility="{Binding Execution.HasOutput, ElementName=SuggestionRoot, Converter={StaticResource Visible}, FallbackValue=Collapsed}" Margin="0,10,0,0">
                    <TextBlock Text="{loc:Loc ChatSqlResultPreview}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="ResultPreview" Text="{Binding Execution.Output, ElementName=SuggestionRoot, Mode=OneWay}" Style="{StaticResource AgentTextBox}" FontFamily="{DynamicResource MonoFont}" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="{loc:Loc ChatSqlResultPreview}" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="CollapseSuggestion" Content="{loc:Loc ChatSuggestionCollapse}" AutomationProperties.Name="{loc:Loc ChatSuggestionCollapse}" Click="OnCollapse" HorizontalAlignment="Left" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Style.Triggers><DataTrigger Binding="{Binding Execution.IsAwaitingApproval, ElementName=SuggestionRoot}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
