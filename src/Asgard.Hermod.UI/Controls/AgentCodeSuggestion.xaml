<UserControl x:Class="Asgard.Hermod.UI.Controls.AgentCodeSuggestion" x:Name="SuggestionRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <TextBlock Text="{Binding Caption, ElementName=SuggestionRoot}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />
            <TextBox Text="{Binding Code, ElementName=SuggestionRoot, Mode=OneWay}" Style="{StaticResource AgentTextBox}" FontFamily="{DynamicResource MonoFont}" FontSize="12" IsReadOnly="True" MinHeight="0" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MaxHeight="180" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Caption, ElementName=SuggestionRoot}" />
            <WrapPanel Margin="0,12,0,0">
                <Button Content="{Binding InsertText, ElementName=SuggestionRoot}" Command="{Binding InsertCommand, ElementName=SuggestionRoot}" CommandParameter="{Binding CommandParameter, ElementName=SuggestionRoot}" Margin="0,0,8,4" />
                <Button Content="{Binding ExecuteText, ElementName=SuggestionRoot}" Command="{Binding ExecuteCommand, ElementName=SuggestionRoot}" CommandParameter="{Binding CommandParameter, ElementName=SuggestionRoot}" Margin="0,0,0,4" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
