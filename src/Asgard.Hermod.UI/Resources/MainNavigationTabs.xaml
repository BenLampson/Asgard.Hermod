<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
 <Style x:Key="MainNavigationTabItem" TargetType="ListBoxItem">
  <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
  <Setter Property="Height" Value="36" /><Setter Property="VerticalAlignment" Value="Bottom" />
  <Setter Property="Padding" Value="14,0" /><Setter Property="Margin" Value="0,0,4,0" />
  <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="FontWeight" Value="Normal" />
  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Grid Background="Transparent" ClipToBounds="False">
    <controls:MainNavigationTabChrome x:Name="Chrome" IsHitTestVisible="False" IsSelected="{TemplateBinding IsSelected}"
       BodyBrush="{DynamicResource AppBackgroundBrush}" HoverBrush="{DynamicResource SurfaceBrush}" />
    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="IsHighlighted" Value="True" /></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="IsHighlighted" Value="True" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Panel.ZIndex" Value="10" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="controls:MainNavigationTabs">
  <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
  <Setter Property="ItemContainerStyle" Value="{StaticResource MainNavigationTabItem}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:MainNavigationTabs"><ItemsPresenter ClipToBounds="False" /></ControlTemplate></Setter.Value></Setter>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" ClipToBounds="False" /></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
   <StackPanel Orientation="Horizontal"><controls:IconView Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    <Grid>
     <!-- Hidden 保留实际字体的测量空间；普通与加粗共同确定尺寸，选中切换不改变后续页签的位置。 -->
     <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Normal" Visibility="Hidden" IsHitTestVisible="False" />
     <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Visibility="Hidden" IsHitTestVisible="False" />
     <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextBodyBrush}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    </Grid>
   </StackPanel>
  </DataTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
