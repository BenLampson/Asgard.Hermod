<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ButtonStyles.xaml" /></ResourceDictionary.MergedDictionaries>
 <Style TargetType="controls:WorkspaceHeader">
  <Style.Resources><BooleanToVisibilityConverter x:Key="Visible" />
   <Style x:Key="WorkspaceHeaderSecondaryStatus" TargetType="controls:StatusBadge"><Style.Triggers>
    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=controls:WorkspaceHeader}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
   </Style.Triggers></Style>
  </Style.Resources>
  <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}" />
  <Setter Property="Height" Value="44" /><Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:WorkspaceHeader">
<Border Background="{DynamicResource WorkspaceCaptionBrush}" BorderBrush="{DynamicResource WorkspaceLineBrush}" BorderThickness="0,0,0,1" Padding="12,0,8,0">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="IdentityColumn" Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <ContentPresenter Content="{Binding IdentityContent, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Margin="0,0,10,0" />
   <ContentPresenter x:Name="StatusSlot" Grid.Column="1" Content="{Binding StatusContent, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Margin="0,0,12,0" />
   <Grid Grid.Column="3" VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True">
    <ContentPresenter Content="{Binding ActionsContent, RelativeSource={RelativeSource TemplatedParent}}">
     <ContentPresenter.Style><Style TargetType="ContentPresenter"><Style.Triggers>
      <DataTrigger Binding="{Binding State.HasError, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
      <DataTrigger Binding="{Binding State.IsConnecting, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
     </Style.Triggers></Style></ContentPresenter.Style>
    </ContentPresenter>
    <StackPanel Orientation="Horizontal">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding State.HasError, RelativeSource={RelativeSource TemplatedParent}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Button Content="{Binding EditConnectionLabel, RelativeSource={RelativeSource TemplatedParent}}" AutomationProperties.Name="{Binding EditConnectionLabel, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Style.Triggers><DataTrigger Binding="{Binding EditCommand, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="{Binding ReconnectLabel, RelativeSource={RelativeSource TemplatedParent}}" Command="{Binding RetryCommand, RelativeSource={RelativeSource TemplatedParent}}" Height="28" Padding="9,0" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{Binding ReconnectLabel, RelativeSource={RelativeSource TemplatedParent}}" />
    </StackPanel>
   </Grid>
   <controls:WindowControls IsWorkspace="True" Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding ShowWindowControls, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}" />
  </Grid>
 </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
