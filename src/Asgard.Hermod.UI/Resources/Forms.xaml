<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
    <!-- 共享操作栏作为自定义 ContentControl，不额外创建业务按钮的名称作用域。 -->
    <Style TargetType="controls:DialogActionBar">
        <Setter Property="Height" Value="60" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DialogActionBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Content" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 表单容器只处理名称、帮助与错误，业务通过 Content 提供自己的输入控件。 -->
    <Style TargetType="controls:FormField">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FormField">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Label Content="{TemplateBinding Label}" Padding="0"
                                   FontSize="12" FontFamily="{DynamicResource UiFont}"
                                   Foreground="{DynamicResource TextBodyBrush}"
                                   Target="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock x:Name="RequiredMark" Text=" *" Visibility="Collapsed"
                                       Foreground="{DynamicResource DangerBrush}" />
                        </StackPanel>
                        <ContentPresenter x:Name="Input" ContentSource="Content"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <TextBlock x:Name="Help" Text="{TemplateBinding Hint}" FontSize="11"
                                   Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="ErrorText" Text="{TemplateBinding Error}" FontSize="11"
                                   Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsRequired" Value="True">
                            <Setter TargetName="RequiredMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasHint" Value="True">
                            <Setter TargetName="Help" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Help" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="controls:SecretInput">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SecretInput">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PART_Editor" Background="Transparent" BorderThickness="0"
                                             FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                             Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center" PasswordChar="●"
                                             MaxLength="{TemplateBinding MaxLength}"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             SelectionBrush="{DynamicResource AccentWeakBrush}"
                                             AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
                                <controls:IconView x:Name="ErrorIcon" Grid.Column="1" Kind="circle-alert"
                                                   Width="16" Height="16" Margin="0,0,10,0" Visibility="Collapsed"
                                                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="6" BorderThickness="2"
                                BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed"
                                IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="controls:FormField.HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SidebarBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="controls:SelectionCard">
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SelectionCard">
                    <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <controls:IconView Kind="{TemplateBinding Icon}" Width="22" Height="22"
                                               Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{TemplateBinding Heading}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Description}" FontSize="11" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:IconView x:Name="SelectedMark" Grid.Column="2" Kind="circle-check" Width="16" Height="16"
                                               Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
