<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
    <!-- 公共壳提供页签和侧栏；本控件仅承载 Content slot 内的布局。 -->
    <Style TargetType="controls:WorkspacePageLayout">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="StatusBarBackground" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="controls:WorkspacePageLayout">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="PART_Toolbar" MinHeight="{TemplateBinding ToolbarMinHeight}">
                        <ContentPresenter Content="{TemplateBinding Toolbar}" />
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{TemplateBinding Notification}" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailsColumn" Width="0" /></Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="PART_Body" ContentSource="Content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <ContentPresenter x:Name="PART_Details" Grid.Column="1" Content="{TemplateBinding Details}" Width="{TemplateBinding DetailsWidth}"
                                          Visibility="Collapsed" HorizontalAlignment="Right" />
                    </Grid>
                    <Border x:Name="PART_StatusBar" Grid.Row="3" Height="28" Background="{TemplateBinding StatusBarBackground}" Padding="16,0" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0">
                        <ContentPresenter Content="{TemplateBinding StatusContent}" VerticalAlignment="Center" />
                    </Border>
                    <ContentPresenter x:Name="PART_Overlay" Grid.RowSpan="4" Panel.ZIndex="100" Content="{TemplateBinding Overlay}" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsOverlayOpen" Value="True"><Setter TargetName="PART_Overlay" Property="Visibility" Value="Visible" /><Setter TargetName="PART_Toolbar" Property="IsEnabled" Value="False" /><Setter TargetName="PART_Body" Property="IsEnabled" Value="False" /><Setter TargetName="PART_Details" Property="IsEnabled" Value="False" /></Trigger>
                    <Trigger Property="Toolbar" Value="{x:Null}"><Setter TargetName="PART_Toolbar" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="StatusContent" Value="{x:Null}"><Setter TargetName="PART_StatusBar" Property="Visibility" Value="Collapsed" /></Trigger>
                    <Trigger Property="IsDetailsOpen" Value="True"><Setter TargetName="PART_Details" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsCompact" Value="True">
                        <Setter TargetName="PART_Details" Property="Grid.Column" Value="0" />
                        <Setter TargetName="PART_Details" Property="Grid.ColumnSpan" Value="2" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsDetailsOpen" Value="True" /><Condition Property="IsCompact" Value="False" /></MultiTrigger.Conditions>
                        <Setter TargetName="DetailsColumn" Property="Width" Value="{Binding DetailsWidth, RelativeSource={RelativeSource TemplatedParent}}" />
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
