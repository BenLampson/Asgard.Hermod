<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 对应 Pencil 明亮主题；所有组件通过动态资源引用同一组语义颜色。 -->
    <!-- 透明底深色标志同时用于标题栏与原生窗口图标。 -->
    <BitmapImage x:Key="HermodLogo" CacheOption="OnLoad"
                 UriSource="pack://application:,,,/Asgard.Hermod.UI;component/Assets/Brand/hermod.png" />
    <BitmapImage x:Key="HermodWindowIcon" CacheOption="OnLoad"
                 UriSource="pack://application:,,,/Asgard.Hermod.UI;component/Assets/Brand/hermod.ico" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#EDEFF4" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#E4E8F0" />
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#DCE1EA" />
    <SolidColorBrush x:Key="LineBrush" Color="#CFD5E0" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="ThemeTrackBrush" Color="#E5E9F0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#171C24" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#36404F" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6577" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#8791A2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6BE0" />
    <SolidColorBrush x:Key="ActionFillBrush" Color="#2F6BE0" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="#2459C2" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B53A6" />
    <SolidColorBrush x:Key="AccentWeakBrush" Color="#E4EDFE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16834E" />
    <SolidColorBrush x:Key="SuccessWeakBrush" Color="#DFF6E9" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B54708" />
    <SolidColorBrush x:Key="WarningWeakBrush" Color="#FFF3DB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D92D20" />
    <SolidColorBrush x:Key="DangerWeakBrush" Color="#FCEAEA" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#9AA5B8" />
    <SolidColorBrush x:Key="OnAccentSoftBrush" Color="#D9E5FF" />
    <!-- Shell 的 ANSI 浅色字符需要深色底，以保持两种外壳主题下的可读性。 -->
    <SolidColorBrush x:Key="TerminalSurfaceBrush" Color="#20252C" />
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#EAEEF5" />
</ResourceDictionary>
