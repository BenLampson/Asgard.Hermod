<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 拉丁文字首先使用包内设计字体；Inter 与 Mono 没有中文字形，中文明确回退到微软雅黑 UI。 -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Asgard.Hermod.UI;component/Assets/Fonts/#Inter, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Asgard.Hermod.UI;component/Assets/Fonts/#JetBrains Mono, Microsoft YaHei UI, Segoe UI</FontFamily>
</ResourceDictionary>
