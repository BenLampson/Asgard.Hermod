<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 静态 TTF 随应用打包，保证未安装设计字体的机器也能显示一致。 -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Asgard.Hermod.UI;component/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Asgard.Hermod.UI;component/Assets/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>
