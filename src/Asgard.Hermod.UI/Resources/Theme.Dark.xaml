<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 与明亮主题共享资源键，换肤只替换字典，不重建视图和会话。 -->
    <!-- 透明底浅色标志随主题字典更新，现有窗口无需重建。 -->
    <BitmapImage x:Key="HermodLogo" CacheOption="OnLoad"
                 UriSource="pack://application:,,,/Asgard.Hermod.UI;component/Assets/Brand/hermod-dark.png" />
    <!-- ImageSource 转换器保留 ICO 的全部帧，原生窗口可选择合适的大、小图标。 -->
    <ImageSource x:Key="HermodWindowIcon">pack://application:,,,/Asgard.Hermod.UI;component/Assets/Brand/hermod-dark.ico</ImageSource>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#303C4D" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#252F3D" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#202C3B" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#111820" />
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#111820" />
    <SolidColorBrush x:Key="LineBrush" Color="#7B8EA8" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#52647D" />
    <SolidColorBrush x:Key="ThemeTrackBrush" Color="#252B34" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F8FD" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#DBE4F1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#C2CEE0" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#A8B8CE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#80B2FF" />
    <SolidColorBrush x:Key="ActionFillBrush" Color="#3468CD" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="#2C5DBA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#C4DCFF" />
    <SolidColorBrush x:Key="AccentWeakBrush" Color="#3A567F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#38C98E" />
    <SolidColorBrush x:Key="SuccessWeakBrush" Color="#103324" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC58F" />
    <SolidColorBrush x:Key="CodeObjectBrush" Color="#B99CF6" />
    <SolidColorBrush x:Key="WarningWeakBrush" Color="#493625" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF938D" />
    <SolidColorBrush x:Key="DangerWeakBrush" Color="#542B2D" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#6F83A0" />
    <SolidColorBrush x:Key="OnAccentSoftBrush" Color="#C2D4FF" />
    <SolidColorBrush x:Key="TerminalSurfaceBrush" Color="#20252C" />
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#EAEEF5" />
    <!-- 文件类别保留辨识色，深色主题提高对比度。 -->
    <SolidColorBrush x:Key="FileVideoBrush" Color="#B59AF5" />
    <SolidColorBrush x:Key="FileAudioBrush" Color="#E792CC" />
    <SolidColorBrush x:Key="FileDesignBrush" Color="#D9AA5F" />
    <SolidColorBrush x:Key="FilePresentationBrush" Color="#EBA06A" />
    <SolidColorBrush x:Key="FileCodeBrush" Color="#71C2DE" />
    <SolidColorBrush x:Key="FileDataBrush" Color="#A5A9EF" />
</ResourceDictionary>
