<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 与明亮主题共享资源键，换肤只替换字典，不重建视图和会话。 -->
    <!-- 透明底浅色标志随主题字典更新，现有窗口无需重建。 -->
    <BitmapImage x:Key="HermodLogo" CacheOption="OnLoad"
                 UriSource="pack://application:,,,/Asgard.Hermod.UI;component/Assets/Brand/hermod-dark.png" />
    <!-- ImageSource 转换器保留 ICO 的全部帧，原生窗口可选择合适的大、小图标。 -->
    <ImageSource x:Key="HermodWindowIcon">pack://application:,,,/Asgard.Hermod.UI;component/Assets/Brand/hermod-dark.ico</ImageSource>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#20252C" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#15181D" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1A1E25" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#101318" />
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#181C23" />
    <SolidColorBrush x:Key="LineBrush" Color="#2E3540" />
    <SolidColorBrush x:Key="LineSoftBrush" Color="#252B34" />
    <SolidColorBrush x:Key="ThemeTrackBrush" Color="#252B34" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAEEF5" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#BFC7D4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C96A7" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#606A7B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5189F8" />
    <SolidColorBrush x:Key="ActionFillBrush" Color="#3468CD" />
    <SolidColorBrush x:Key="ActionHoverBrush" Color="#2C5DBA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A8C6FF" />
    <SolidColorBrush x:Key="AccentWeakBrush" Color="#1E2C47" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#38C98E" />
    <SolidColorBrush x:Key="SuccessWeakBrush" Color="#103324" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2994A" />
    <SolidColorBrush x:Key="WarningWeakBrush" Color="#3A2712" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F26057" />
    <SolidColorBrush x:Key="DangerWeakBrush" Color="#3D1B19" />
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3E4756" />
    <SolidColorBrush x:Key="OnAccentSoftBrush" Color="#C2D4FF" />
    <SolidColorBrush x:Key="TerminalSurfaceBrush" Color="#20252C" />
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#EAEEF5" />
    <!-- 文件类别保留辨识色，深色主题提高对比度。 -->
    <SolidColorBrush x:Key="FileVideoBrush" Color="#B59AF5" />
    <SolidColorBrush x:Key="FileAudioBrush" Color="#E792CC" />
    <SolidColorBrush x:Key="FileDesignBrush" Color="#D9AA5F" />
    <SolidColorBrush x:Key="FilePresentationBrush" Color="#EBA06A" />
    <SolidColorBrush x:Key="FileCodeBrush" Color="#71C2DE" />
    <SolidColorBrush x:Key="FileDataBrush" Color="#A5A9EF" />
</ResourceDictionary>
