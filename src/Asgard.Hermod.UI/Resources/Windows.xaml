<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
    <!-- 模板每次单独创建标题栏，不在多个窗口之间共享 UIElement。 -->
    <DataTemplate x:Key="HermodDefaultCaptionTemplate">
        <controls:HermodTitleBar />
    </DataTemplate>

    <Style TargetType="controls:HermodWindow">
        <Setter Property="Icon" Value="{DynamicResource HermodWindowIcon}" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
        <!-- 系统绘制唯一的外轮廓，正文填满 HWND，避免叠加第二条圆角边线。 -->
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HermodWindow">
                    <Border x:Name="PART_WindowFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <!-- 统一承载正文、标题和页脚的键盘焦点层，所有窗体按钮保持相同导航语义。 -->
                        <AdornerDecorator>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding CaptionHeight, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentPresenter x:Name="PART_Caption"
                                                  Content="{TemplateBinding CaptionContent}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <ContentPresenter Grid.Row="1" ContentSource="Content" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <ContentPresenter x:Name="PART_Footer" Grid.Row="2"
                                                  Content="{TemplateBinding FooterContent}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </AdornerDecorator>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CaptionContent" Value="{x:Null}">
                            <Setter TargetName="PART_Caption" Property="Content"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_Caption" Property="ContentTemplate"
                                    Value="{StaticResource HermodDefaultCaptionTemplate}" />
                        </Trigger>
                        <Trigger Property="FooterContent" Value="{x:Null}">
                            <Setter TargetName="PART_Footer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
