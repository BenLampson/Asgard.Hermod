<UserControl x:Class="Asgard.Hermod.UI.Views.Pages.ConfigurationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             FontFamily="{DynamicResource UiFont}">
    <Border Style="{DynamicResource PanelBorder}" Padding="0" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="14,10" CornerRadius="7,7,0,0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Kind="settings-2" Width="14" Height="14" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="Runtime configuration" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBodyBrush}" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Configuration}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,9" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" ToolTip="{Binding Value}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
