<UserControl x:Class="Asgard.Hermod.UI.Views.Pages.TerminalWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:terminal="clr-namespace:Asgard.Hermod.WinTerminal;assembly=Asgard.Hermod.WinTerminal"
             xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
             Background="{DynamicResource AppBackgroundBrush}"
             FontFamily="{DynamicResource UiFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:IconView Kind="terminal" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <controls:StatusBadge Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center">
                <controls:StatusBadge.Style>
                    <Style TargetType="{x:Type controls:StatusBadge}">
                        <Setter Property="Tone" Value="{x:Static models:StatusTone.Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Tone" Value="{x:Static models:StatusTone.Success}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:StatusBadge.Style>
            </controls:StatusBadge>
            <Button Grid.Column="6" Command="{Binding RetryCommand}" Padding="13,6" VerticalAlignment="Center"
                    ToolTip="{loc:Loc StartANewLocalPowerShellSession}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource StandardButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Kind="rotate-cw" Width="13" Height="13" Margin="0,0,6,0" />
                    <TextBlock Text="{loc:Loc Retry}" FontSize="12.5"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="12,9" CornerRadius="6"
                Background="{DynamicResource DangerWeakBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Error}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" />
        </Border>
        <!-- 固定原生字形渲染所需的等宽字体，避免挂载时临时继承界面字体。 -->
        <Border Grid.Row="2" Style="{DynamicResource PanelBorder}" Padding="12" Margin="0,18,0,0" CornerRadius="8"
                Background="{DynamicResource TerminalSurfaceBrush}" TextElement.FontFamily="Consolas">
            <terminal:TerminalControl x:Name="TerminalView" Session="{Binding Session}"
                                      IsReadOnly="{Binding IsReadOnly}"
                                      FontFamily="Consolas" FontSize="14"
                                      Background="{DynamicResource TerminalSurfaceBrush}"
                                      Foreground="{DynamicResource TerminalTextBrush}" />
        </Border>
    </Grid>
</UserControl>
