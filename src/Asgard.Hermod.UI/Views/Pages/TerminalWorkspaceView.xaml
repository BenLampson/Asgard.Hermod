<UserControl x:Class="Asgard.Hermod.UI.Views.Pages.TerminalWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:terminal="clr-namespace:Asgard.Hermod.WinTerminal;assembly=Asgard.Hermod.WinTerminal"
             xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
             Background="{DynamicResource AppBackgroundBrush}"
             FontFamily="{DynamicResource UiFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WorkspaceHeader State="{Binding ConnectionState}" RetryCommand="{Binding RetryCommand}">
            <controls:WorkspaceHeader.IdentityContent><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <controls:IconView Kind="terminal" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Grid></controls:WorkspaceHeader.IdentityContent>
            <controls:WorkspaceHeader.StatusContent><controls:StatusBadge Text="{Binding Status}" ShowIndicator="False"><controls:StatusBadge.Style><Style TargetType="controls:StatusBadge"><Setter Property="Tone" Value="{x:Static models:StatusTone.Muted}" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Tone" Value="{x:Static models:StatusTone.Success}" /></DataTrigger></Style.Triggers></Style></controls:StatusBadge.Style></controls:StatusBadge></controls:WorkspaceHeader.StatusContent>
        </controls:WorkspaceHeader>
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="12,9" CornerRadius="6"
                Background="{DynamicResource DangerWeakBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Error}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" />
        </Border>
        <!-- 固定原生字形渲染所需的等宽字体，避免挂载时临时继承界面字体。 -->
        <Border Grid.Row="2" Style="{DynamicResource PanelBorder}" Padding="12" Margin="0,18,0,0" CornerRadius="8"
                Background="{DynamicResource TerminalSurfaceBrush}" TextElement.FontFamily="Consolas">
            <terminal:TerminalControl x:Name="TerminalView" Session="{Binding Session}"
                                      IsReadOnly="{Binding IsReadOnly}"
                                      FontFamily="Consolas" FontSize="14"
                                      Background="{DynamicResource TerminalSurfaceBrush}"
                                      Foreground="{DynamicResource TerminalTextBrush}" />
        </Border>
    </Grid>
</UserControl>
