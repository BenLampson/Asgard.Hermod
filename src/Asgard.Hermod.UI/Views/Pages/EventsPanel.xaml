<UserControl x:Class="Asgard.Hermod.UI.Views.Pages.EventsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <Style x:Key="EventIcon" TargetType="{x:Type controls:IconView}">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:StatusTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:StatusTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:StatusTone.Danger}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{DynamicResource PanelBorder}" Padding="0" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Padding="14,10" CornerRadius="7,7,0,0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Kind="list-checks" Width="14" Height="14" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{loc:Loc RecentEvents}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBodyBrush}" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,10" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:IconView Kind="{Binding Icon}" Width="15" Height="15"
                                                       Style="{StaticResource EventIcon}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" ToolTip="{Binding Message}"
                                               FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBodyBrush}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFaintBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
