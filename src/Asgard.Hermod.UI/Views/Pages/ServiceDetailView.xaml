<UserControl x:Class="Asgard.Hermod.UI.Views.Pages.ServiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:pages="clr-namespace:Asgard.Hermod.UI.Views.Pages"
             Background="{DynamicResource AppBackgroundBrush}"
             FontFamily="{DynamicResource UiFont}">
    <UserControl.Resources>
        <Style x:Key="DetailsVisible" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreview}" Value="True">
                    <Setter Property="ToolTip" Value="Sample data · service is not connected." />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDetails}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:IconView Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <controls:StatusBadge Grid.Column="4" Text="{Binding Status}" Tone="{Binding StatusTone}" VerticalAlignment="Center">
                <controls:StatusBadge.Style>
                    <Style TargetType="{x:Type controls:StatusBadge}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                <Setter Property="ToolTip" Value="Sample data · service is not connected." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:StatusBadge.Style>
            </controls:StatusBadge>
            <Button Grid.Column="6" Style="{DynamicResource StandardButton}" Command="{Binding RestartCommand}"
                    Padding="13,6" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Connector not configured. Restart will be available after a service connection is added.">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Kind="rotate-cw" Width="13" Height="13" Margin="0,0,6,0" />
                    <TextBlock Text="Restart" FontSize="12.5"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="8" Style="{DynamicResource PrimaryButton}" Command="{Binding DeployCommand}"
                    Padding="14,6" VerticalAlignment="Center" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Connector not configured. Deploy will be available after a service connection is added.">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Kind="play" Width="13" Height="13" Margin="0,0,6,0" />
                    <TextBlock Text="Deploy" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>
        </Grid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="-6,18,-6,0"
                      Style="{StaticResource DetailsVisible}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="6,0" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource PanelBorder}" Padding="14" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconView Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,7,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Value}" Margin="0,8,0,0" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource DetailsVisible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <pages:ConfigurationPanel />
            <pages:EventsPanel Grid.Column="2" />
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDetails}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <controls:IconView Kind="{Binding Icon}" Width="28" Height="28" Margin="0,0,0,14"
                               Foreground="{DynamicResource TextFaintBrush}" />
            <TextBlock Text="No connector configured" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBodyBrush}" />
            <TextBlock Text="Add a service connection to view configuration, metrics and events."
                       Margin="0,6,0,0" FontSize="12.5" TextAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
