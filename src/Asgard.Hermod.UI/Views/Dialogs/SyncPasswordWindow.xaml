<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.SyncPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{Binding Title}" Width="560" Height="520" MinWidth="480" MinHeight="480" ResizeMode="CanResize">
    <controls:HermodDialog.Resources>
        <BooleanToVisibilityConverter x:Key="DownloadVisibility" />
    </controls:HermodDialog.Resources>
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Height="32" Padding="14,0" Margin="0,0,10,0" />
                <Button x:Name="ConfirmButton" Content="{Binding Title}" Command="{Binding ConfirmCommand}" Height="32" Padding="14,0" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <controls:IconView Kind="info" Width="26" Height="26" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left" Margin="0,0,0,14" />
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14" />
            <TextBlock x:Name="PasswordExplanation" Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,18" />
            <TextBlock Text="{loc:Loc SyncPassword}" FontWeight="SemiBold" Margin="0,0,0,8" />
            <controls:SecretInput x:Name="PasswordInput" Value="{Binding Password, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" Height="36"
                AutomationProperties.Name="{loc:Loc SyncPassword}" />
            <TextBlock Text="{Binding PasswordHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,18" />
            <CheckBox x:Name="RestoreConfirmation" IsChecked="{Binding ConfirmRestore}"
                Visibility="{Binding IsDownload, Converter={StaticResource DownloadVisibility}}" AutomationProperties.Name="{loc:Loc ConfirmWorkspaceRestore}">
                <TextBlock Text="{loc:Loc ConfirmWorkspaceRestore}" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
    </ScrollViewer>
</controls:HermodDialog>
