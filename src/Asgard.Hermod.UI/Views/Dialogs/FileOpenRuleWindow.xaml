<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.FileOpenRuleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{Binding Title}" Width="640" Height="340" MinWidth="500" MinHeight="340">
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" Height="32" />
                <Button Content="{loc:Loc Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Height="32" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Loc FileExtension}" Margin="0,0,0,8" />
            <TextBox x:Name="ExtensionInput" Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc FileExtension}" />
            <TextBlock Text="{loc:Loc FileProgram}" Margin="0,16,0,8" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding ProgramPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc FileProgram}" />
                <Button Grid.Column="1" Content="{loc:Loc Browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{loc:Loc FileExtensionHint}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </ScrollViewer>
</controls:HermodDialog>
