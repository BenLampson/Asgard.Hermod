<Window x:Class="Asgard.Hermod.UI.Views.Dialogs.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        Title="{loc:Loc TrayMenu}" AutomationProperties.Name="{loc:Loc TrayMenu}"
        Width="268" Height="152" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="OnKeyDown" Deactivated="OnDeactivated">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Canvas>
        <Border Canvas.Left="10" Canvas.Top="10" Width="248" Height="123" CornerRadius="7"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" /></Border.Effect>
            <StackPanel Margin="6">
                <TextBlock Text="{loc:Loc AsgardHermod}" Height="30" Padding="10,6" FontSize="12" FontWeight="SemiBold" />
                <Button x:Name="ToggleButton" Height="36" HorizontalContentAlignment="Left" Click="OnToggle">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Kind="app-window" Width="16" Height="16" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="ToggleLabel" FontSize="12" />
                    </StackPanel>
                </Button>
                <Border Height="1" Margin="6,4" Background="{DynamicResource LineBrush}" />
                <Button x:Name="ExitButton" Height="36" HorizontalContentAlignment="Left" Click="OnExit"
                        AutomationProperties.Name="{loc:Loc ExitHermod}">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Kind="log-out" Width="16" Height="16" Margin="0,0,10,0" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{loc:Loc ExitHermod}" Foreground="{DynamicResource DangerBrush}" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <Path x:Name="Arrow" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" />
        <Rectangle x:Name="ArrowJoin" Width="15" Height="2" Fill="{DynamicResource SurfaceBrush}" />
    </Canvas>
</Window>
