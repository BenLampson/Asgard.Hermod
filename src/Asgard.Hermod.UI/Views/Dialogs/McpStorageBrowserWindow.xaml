<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.McpStorageBrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{loc:Loc McpStorageBrowserTitle}" Width="640" Height="560" MinWidth="430" MinHeight="440" ResizeMode="CanResize">
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Cancel}" IsCancel="True" Margin="0,0,8,0" Height="32" />
                <Button x:Name="McpUseStorageLocation" Content="{loc:Loc McpStorageUseLocation}" Click="OnChoose" IsEnabled="{Binding CanChoose}"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Height="32" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Loc McpBucket}" Margin="0,0,0,4" />
            <ComboBox x:Name="McpBucketPicker" ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket}" DisplayMemberPath="Name"
                      IsEnabled="{Binding CanInteract}" AutomationProperties.Name="{loc:Loc McpBucket}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,10,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" MaxHeight="40" VerticalAlignment="Center" />
            <Button x:Name="McpSelectCurrent" Grid.Column="1" Content="{loc:Loc McpStorageSelectCurrentFolder}" Click="OnSelectCurrent" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{loc:Loc McpStorageRootHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ListBox x:Name="McpFolderList" Grid.Row="3" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                 MinHeight="80" IsEnabled="{Binding CanInteract}" MouseDoubleClick="OnOpenFolder" KeyDown="OnFolderKeyDown"
                 Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineSoftBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{loc:Loc McpStorageFolderList}">
            <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Prefix}" /></DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="10,4" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FolderItem" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="FolderItem" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FolderItem" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FolderItem" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="FolderItem" Property="BorderThickness" Value="1" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
            <Button Content="{loc:Loc McpStorageOpenFolder}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,4" />
            <Button Content="{loc:Loc McpStorageParentFolder}" Command="{Binding UpCommand}" Margin="0,0,8,4" />
            <Button Content="{loc:Loc McpStorageLoadMore}" Command="{Binding LoadMoreCommand}" Margin="0,0,8,4" />
            <Button Content="{loc:Loc Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,0,4" />
        </WrapPanel>
        <TextBlock Grid.Row="5" Text="{Binding Message}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</controls:HermodDialog>
