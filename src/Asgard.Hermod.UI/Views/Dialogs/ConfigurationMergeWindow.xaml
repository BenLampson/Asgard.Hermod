<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.ConfigurationMergeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{loc:Loc SyncMerge}" Width="700" Height="620" MinWidth="520" MinHeight="450">
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="16,0" />
                <Button Content="{loc:Loc SyncMergeAndSync}" Command="{Binding ConfirmCommand}" Padding="16,0" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Loc SyncMerge}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{loc:Loc SyncMergeHint}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding EntityName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FieldLabel}" Margin="0,6,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LocalValue}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CloudValue}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <ComboBox SelectedIndex="{Binding SelectedIndex}" AutomationProperties.Name="{Binding FieldLabel}" MinHeight="32">
                                    <ComboBoxItem Content="{loc:Loc SyncKeepLocal}" />
                                    <ComboBoxItem Content="{loc:Loc SyncKeepCloud}" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</controls:HermodDialog>
