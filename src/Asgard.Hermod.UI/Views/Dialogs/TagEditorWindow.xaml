<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        Title="{Binding Title}" Width="520" Height="540" ResizeMode="NoResize">
    <controls:HermodDialog.Resources>
        <BooleanToVisibilityConverter x:Key="TagBooleanVisibility" />
        <!-- 快捷颜色仍是标准按钮，键盘和自动化都可用。 -->
        <Style x:Key="TagColorSwatchButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.7" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:HermodDialog.Resources>
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource StandardButton}"
                        Height="32" Padding="14,0" Margin="0,0,10,0" />
                <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" ToolTip="{Binding SaveHint}"
                        Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0" FontWeight="SemiBold" IsDefault="True" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <controls:FormField Label="名称" IsRequired="True" Hint="名称在同一父级下唯一。" Error="{Binding NameError}" Margin="0,0,0,16">
                <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="36" MaxLength="80"
                         IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Tag 名称" />
            </controls:FormField>
            <controls:FormField Label="父级 Tag" Hint="可选根级或其他自定义 Tag。" Error="{Binding ParentError}" Margin="0,0,0,16">
                <ComboBox ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding SelectedParent}" DisplayMemberPath="DisplayName"
                          Height="36" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="父级 Tag" />
            </controls:FormField>
            <controls:FormField Label="颜色" Hint="支持 #RGB 和 #RRGGBB，例如 #3AF 或 #33AAFF。" Error="{Binding ColorError}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Height="36" Padding="10,0" Click="OnPaletteToggleClick" IsEnabled="{Binding IsEditable}"
                                ToolTip="展开或收起常用颜色" AutomationProperties.Name="常用 Tag 颜色">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="4" Background="{Binding PreviewColor}" Margin="0,0,8,0" />
                                <controls:IconView Kind="chevron-down" Width="12" Height="12" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="HexInput" Grid.Column="2" Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" FontFamily="{DynamicResource MonoFont}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="Tag HEX 颜色" />
                    </Grid>
                    <ItemsControl x:Name="ColorPalette" ItemsSource="{Binding Swatches}" Margin="0,10,0,0" IsEnabled="{Binding IsEditable}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TagColorSwatchButton}" Background="{Binding Color}" ToolTip="{Binding Color}" AutomationProperties.Name="{Binding Color}"
                                        Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Color}">
                                    <controls:IconView Kind="check" Width="12" Height="12" Foreground="White"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource TagBooleanVisibility}}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:FormField>
            <!-- 路径和颜色始终使用最后一次有效 HEX，错误输入不会清空预览。 -->
            <Border CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="预览" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" CornerRadius="5" Background="{DynamicResource AccentWeakBrush}" Padding="8,5" HorizontalAlignment="Left" MaxWidth="280">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding PreviewColor}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding PreviewPath}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" MaxWidth="235" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="3" Text="{Binding PreviewColor}" FontFamily="{DynamicResource MonoFont}"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Border>
            <Border CornerRadius="6" Background="{DynamicResource DangerWeakBrush}" Padding="12" Margin="0,16,0,0">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="重试" Command="{Binding RetryCommand}" Height="28" Margin="12,0,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:HermodDialog>
