<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.StorageSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{loc:Loc Storage}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc StorageDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,24" />
                <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="20">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{loc:Loc Refresh}" Command="{Binding RefreshCommand}" Height="30" />
                            <TextBlock Text="{loc:Loc StorageTemporaryFiles}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel Margin="0,12,0,16">
                            <TextBlock Text="{Binding TotalSize}" FontSize="32" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding FileCountText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding CleanableText}" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,20,4" />
                            <TextBlock Text="{Binding InUseText}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" ToolTip="{loc:Loc StorageSessionProtectionHint}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Loc StorageUsageDetails}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding Usage}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Loc StorageLocation}" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding RootPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{loc:Loc StorageLocation}" ToolTip="{Binding RootPath}" />
                    <Button Grid.Column="1" Content="{loc:Loc StorageOpenFolder}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding PartialWarning}" Foreground="{DynamicResource WarningBrush}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Message}" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,20,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc StorageCleanupTemporaryFiles}" Command="{Binding CleanupCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="16,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{loc:Loc StorageCleanupOnlyUnused}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Loc StorageCleanupSafeHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
