<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        xmlns:models="clr-namespace:Asgard.Hermod.UI.Models"
        Title="{Binding WindowTitle}" Width="820" Height="600">
    <controls:HermodDialog.Resources>
        <BooleanToVisibilityConverter x:Key="WizardVisibility" />
        <!-- 侧栏只显示进度，不提供绕过步骤校验的跳转入口。 -->
        <Style x:Key="WizardStepContainer" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStepBadge" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource LineSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessWeakBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStepNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WizardStepLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 列表负责服务商选中同步，卡片复用全局选项外观。 -->
        <Style x:Key="ProviderListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfirmationRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
        <Style x:Key="ConfirmationLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ConfirmationValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </controls:HermodDialog.Resources>
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56" Padding="24,0" Background="{DynamicResource SurfaceBrush}"
                                  HorizontalContentAlignment="Stretch">
            <Grid>
                <TextBlock Text="{Binding StepCountText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource StandardButton}"
                            Height="32" Padding="14,0" Margin="0,0,10,0" />
                    <Button Content="上一步" Command="{Binding PreviousCommand}" Style="{StaticResource StandardButton}"
                            Visibility="{Binding HasPreviousStep, Converter={StaticResource WizardVisibility}}"
                            Height="32" Padding="14,0" Margin="0,0,10,0" />
                    <Button x:Name="ContinueButton" Command="{Binding ContinueCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconView Width="14" Height="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource InverseTextBrush}">
                                <controls:IconView.Style>
                                    <Style TargetType="controls:IconView">
                                        <Setter Property="Kind" Value="chevron-right" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfirmationStep}" Value="True">
                                                <Setter Property="Kind" Value="check" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:IconView.Style>
                            </controls:IconView>
                            <TextBlock Text="{Binding ContinueLabel}" Foreground="{DynamicResource InverseTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,0,1,0" Padding="16,28">
            <StackPanel>
                <TextBlock Text="{Binding WizardHeading}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProviderName}" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" Margin="0,12,0,24" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WizardStepContainer}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WizardStepBadge}">
                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource WizardStepNumber}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0"
                                               Style="{StaticResource WizardStepLabel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28" IsEnabled="{Binding IsInformationEditable}">
                <TextBlock Text="{Binding StepTitle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StepDescription}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,24" />
                <StackPanel Visibility="{Binding IsTypeStep, Converter={StaticResource WizardVisibility}}">
                    <TextBlock Text="实例类型" Margin="0,0,0,8" />
                    <ListBox x:Name="TypeList" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                             IsEnabled="{Binding IsTypeSelectionEditable}"
                             BorderThickness="0" Padding="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ProviderListItem}" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="实例类型">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:SelectionCard Heading="{Binding Name}" Description="{Binding Description}"
                                                        Icon="{Binding Icon}" Height="74" GroupName="InstanceType"
                                                        Checked="OnTypeChecked" AutomationProperties.Name="{Binding Name}"
                                                        IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Visibility="{Binding HasTypeSelection, Converter={StaticResource WizardVisibility}}">
                    <TextBlock Text="服务商" Margin="0,16,0,8" />
                    <ListBox x:Name="ProviderList" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                             IsEnabled="{Binding IsTypeSelectionEditable}"
                             BorderThickness="0" Padding="0"
                             Background="Transparent" ItemContainerStyle="{StaticResource ProviderListItem}"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="实例服务商">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:SelectionCard Heading="{Binding Name}" Description="{Binding ProductName}"
                                                        Icon="{Binding Icon}" Height="74" GroupName="InstanceProvider"
                                                        Checked="OnProviderChecked" AutomationProperties.Name="{Binding Name}"
                                                        IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="选择服务商后，下一步填写连接信息。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,28,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding IsInformationStep, Converter={StaticResource WizardVisibility}}">
                    <controls:FormField Label="实例名称" IsRequired="True" Error="{Binding NameError}" Margin="0,0,0,20">
                        <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="36" MaxLength="128"
                                 AutomationProperties.Name="实例名称" />
                    </controls:FormField>
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:InstanceConfigurationFieldEditor Margin="0,0,0,20" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Visibility="{Binding IsTestStep, Converter={StaticResource WizardVisibility}}">
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:IconView Width="40" Height="40" VerticalAlignment="Top">
                            <controls:IconView.Style>
                                <Style TargetType="controls:IconView">
                                    <Setter Property="Kind" Value="circle-dashed" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestState}" Value="{x:Static models:InstanceConnectionTestState.Succeeded}">
                                            <Setter Property="Kind" Value="circle-check" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TestState}" Value="{x:Static models:InstanceConnectionTestState.Failed}">
                                            <Setter Property="Kind" Value="circle-x" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:IconView.Style>
                        </controls:IconView>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding TestHeading}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TestMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,20"
                                 Visibility="{Binding IsTesting, Converter={StaticResource WizardVisibility}}" />
                    <TextBlock Text="{Binding TestErrorCode}" FontFamily="{DynamicResource MonoFont}" Margin="0,0,0,16"
                               Foreground="{DynamicResource DangerBrush}" Visibility="{Binding HasTestErrorCode, Converter={StaticResource WizardVisibility}}" />
                    <ItemsControl ItemsSource="{Binding TestChecks}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未通过" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSuccessful}" Value="True">
                                                            <Setter Property="Text" Value="通过" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="检查连接信息是否正确，并确认当前身份拥有所需访问权限。"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Visibility="{Binding HasTestFailure, Converter={StaticResource WizardVisibility}}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="修改信息" Command="{Binding ModifyInformationCommand}" Height="32" Padding="14,0" Margin="0,0,10,0"
                                Visibility="{Binding HasTestFailure, Converter={StaticResource WizardVisibility}}" />
                        <Button x:Name="StartTestButton" Content="{Binding TestActionLabel}" Command="{Binding TestConnectionCommand}"
                                Height="32" Padding="14,0" Margin="0,0,10,0" />
                        <Button Content="取消测试" Command="{Binding CancelTestCommand}" Height="32" Padding="14,0"
                                Visibility="{Binding IsTesting, Converter={StaticResource WizardVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="修改连接信息后需重新测试。" Foreground="{DynamicResource TextMutedBrush}" Margin="0,24,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsSaveLocationStep, Converter={StaticResource WizardVisibility}}">
                    <controls:SelectionCard x:Name="LocalSaveChoice" Heading="本地" Description="保存在这台设备上"
                                            Icon="laptop" IsChecked="{Binding IsLocalSave}" GroupName="SaveLocation" Height="88" />
                    <controls:SelectionCard Heading="账户" Description="登录后可选择" Icon="lock-keyhole"
                                            IsEnabled="{Binding CanSaveToAccount}" GroupName="SaveLocation" Height="88" Margin="0,12,0,0" />
                    <TextBlock Text="登录后仍可选择本地，也会保留本地信息。" Margin="0,24,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsConfirmationStep, Converter={StaticResource WizardVisibility}}">
                    <Border Style="{StaticResource ConfirmationRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="136" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="实例名称" Style="{StaticResource ConfirmationLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource ConfirmationValue}" />
                    </Grid></Border>
                    <Border Style="{StaticResource ConfirmationRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="136" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="类型 / 服务商" Style="{StaticResource ConfirmationLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding ProviderSummary}" Style="{StaticResource ConfirmationValue}" />
                    </Grid></Border>
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ConfirmationRow}"><Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="136" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Style="{StaticResource ConfirmationLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ConfirmationValue}" Style="{StaticResource ConfirmationValue}" />
                                </Grid></Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource ConfirmationRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="136" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="连接测试" Style="{StaticResource ConfirmationLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding TestSummary}" Style="{StaticResource ConfirmationValue}" />
                    </Grid></Border>
                    <Border Style="{StaticResource ConfirmationRow}"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="136" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="保存位置" Style="{StaticResource ConfirmationLabel}" />
                        <TextBlock Grid.Column="1" Text="本地" Style="{StaticResource ConfirmationValue}" />
                    </Grid></Border>
                    <TextBlock Text="{Binding ConfirmationHint}" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,24,0,0" />
                    <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource DangerBrush}" Margin="0,16,0,0"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</controls:HermodDialog>
