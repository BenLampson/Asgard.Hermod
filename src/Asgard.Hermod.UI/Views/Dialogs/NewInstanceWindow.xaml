<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        Title="New instance" Width="620" SizeToContent="Height">
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar>
            <StackPanel Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource StandardButton}"
                        Height="32" FontSize="12" Padding="14,0" Margin="0,0,8,0" />
                <Button Content="Create instance" Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButton}" Height="32" FontSize="12" FontWeight="SemiBold"
                        Padding="14,0" IsDefault="True" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="New instance" FontSize="19" FontWeight="Bold" />
            <TextBlock Text="Available in this workspace for the current session."
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0" FontSize="11.5" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Name" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="34"
                     AutomationProperties.Name="Instance name" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Connection type" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding ConnectionType}"
                      Height="34" AutomationProperties.Name="Connection type" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="Endpoint" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsRemote}"
                     Height="34" AutomationProperties.Name="Instance endpoint" />
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Tag" Foreground="{DynamicResource TextBodyBrush}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Height="34"
                     AutomationProperties.Name="Instance tag" />
        </StackPanel>
    </Grid>
</controls:HermodDialog>
