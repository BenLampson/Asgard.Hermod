<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
        Title="{Binding WindowTitle}" Width="820" Height="600">
    <controls:HermodDialog.Resources>
        <BooleanToVisibilityConverter x:Key="WizardVisibility" />
    </controls:HermodDialog.Resources>
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56" Padding="24,0" Background="{DynamicResource SurfaceBrush}"
                                  HorizontalContentAlignment="Stretch">
            <Grid>
                <TextBlock Text="{Binding StepCountText}" Visibility="{Binding HasTypeSelection, Converter={StaticResource WizardVisibility}}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource StandardButton}"
                            Height="32" Padding="14,0" Margin="0,0,10,0" />
                    <Button Content="{loc:Loc Back}" Command="{Binding PreviousCommand}" Style="{StaticResource StandardButton}"
                            Visibility="{Binding HasPreviousStep, Converter={StaticResource WizardVisibility}}"
                            Height="32" Padding="14,0" Margin="0,0,10,0" />
                    <Button x:Name="ContinueButton" Visibility="{Binding HasTypeSelection, Converter={StaticResource WizardVisibility}}" Command="{Binding ContinueCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconView Width="14" Height="14" Margin="0,0,8,0"
                                               Foreground="{DynamicResource InverseTextBrush}">
                                <controls:IconView.Style>
                                    <Style TargetType="controls:IconView">
                                        <Setter Property="Kind" Value="chevron-right" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfirmationStep}" Value="True">
                                                <Setter Property="Kind" Value="check" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:IconView.Style>
                            </controls:IconView>
                            <TextBlock Text="{Binding ContinueLabel}" Foreground="{DynamicResource InverseTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <controls:InstanceWizard x:Name="WizardLayout" Heading="{Binding SelectedType.Name}" Description="{Binding SelectedType.Description}"
                             Steps="{Binding Steps}" ShowProgress="{Binding HasTypeSelection}">
        <Grid IsEnabled="{Binding IsInformationEditable}">
            <StackPanel Margin="28" Visibility="{Binding IsChoosingType, Converter={StaticResource WizardVisibility}}">
                <TextBlock Text="{loc:Loc ChooseInstanceType}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc ChooseInstanceTypeDescription}" Margin="0,16,0,24" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <controls:InstanceTypePicker x:Name="TypeList" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                                             IsEnabled="{Binding IsTypeSelectionEditable}"
                                             AutomationProperties.Name="{loc:Loc InstanceType}" />
            </StackPanel>
            <controls:InstanceConnectionWizardContent x:Name="ConnectionContent"
                                                     Visibility="{Binding HasTypeSelection, Converter={StaticResource WizardVisibility}}" />
        </Grid>
    </controls:InstanceWizard>
</controls:HermodDialog>
