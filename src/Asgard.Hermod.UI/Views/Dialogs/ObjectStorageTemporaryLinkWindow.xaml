<dialogs:ObjectStorageDialogWindow x:Class="Asgard.Hermod.UI.Views.Dialogs.ObjectStorageTemporaryLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.UI.Views.Dialogs"
        Title="生成临时链接" Width="670" Height="380" ResizeMode="NoResize">
    <dialogs:ObjectStorageDialogWindow.Resources><BooleanToVisibilityConverter x:Key="LinkVisibility" /></dialogs:ObjectStorageDialogWindow.Resources>
    <dialogs:ObjectStorageDialogWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></dialogs:ObjectStorageDialogWindow.InputBindings>
    <dialogs:ObjectStorageDialogWindow.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <Button Content="关闭" Command="{Binding CancelCommand}" Height="32" Padding="14,0" />
        </controls:DialogActionBar>
    </dialogs:ObjectStorageDialogWindow.FooterContent>
    <ScrollViewer x:Name="DialogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="生成临时链接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="有效期" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="LifetimeSelector" Grid.Column="1" ItemsSource="{Binding Lifetimes}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedLifetime, Mode=TwoWay}" Height="32" IsEnabled="{Binding CanSelectLifetime}" AutomationProperties.Name="临时链接有效期" />
                <Button x:Name="GenerateButton" Grid.Column="3" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="14,0">
                    <StackPanel Orientation="Horizontal"><controls:IconView Kind="link" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource InverseTextBrush}" /><TextBlock Text="{Binding GenerateLabel}" Foreground="{DynamicResource InverseTextBrush}" /></StackPanel>
                </Button>
            </Grid>
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,12" Visibility="{Binding IsGenerating, Converter={StaticResource LinkVisibility}}" />
            <Grid Height="36" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="LinkPreview" Text="{Binding Link, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12" Padding="10,0"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="临时链接" />
                <Button x:Name="CopyButton" Grid.Column="1" Command="{Binding CopyCommand}" Height="36" Margin="8,0,0,0"
                        ToolTip="复制完整链接" AutomationProperties.Name="复制临时链接">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Kind="copy" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="复制链接" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="获得链接的人可在有效期内访问此对象，请谨慎分享。" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CopyStatus}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</dialogs:ObjectStorageDialogWindow>
