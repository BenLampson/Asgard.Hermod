<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.McpApprovalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{loc:Loc McpApprovalTitle}" Width="680" Height="520" MinWidth="430" MinHeight="380" ResizeMode="CanResize">
    <controls:HermodDialog.Resources><BooleanToVisibilityConverter x:Key="Visible" /></controls:HermodDialog.Resources>
    <controls:HermodDialog.InputBindings><KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}" /></controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc McpApprovalDeny}" Click="OnDeny" Height="32" Margin="0,0,8,0" />
                <Button x:Name="McpApprove" Content="{loc:Loc McpApprovalAllow}" Click="OnApprove" IsEnabled="{Binding CanApprove}"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Height="32" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Loc McpApprovalHeading}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,18" />
            <TextBlock Text="{loc:Loc McpApprovalInstance}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Request.InstanceName}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="15" />
            <TextBlock Text="{Binding Request.InstanceType}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,14" />
            <TextBlock Text="{loc:Loc McpApprovalAction}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Request.Operation}" TextWrapping="Wrap" Margin="0,4,0,14" />
            <ItemsControl ItemsSource="{Binding Request.Fields}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{Binding ShowDownloadFolder, Converter={StaticResource Visible}}">
                <TextBlock Text="{loc:Loc McpApprovalDownloadFolder}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc McpApprovalDownloadFolderHint}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                <Button x:Name="McpApprovalChooseFolder" Content="{loc:Loc McpStorageSelectTransferFolder}" Click="OnChooseFolder"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,0" />
                <TextBlock Text="{Binding DownloadFolder}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding DownloadFileLabel}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</controls:HermodDialog>
