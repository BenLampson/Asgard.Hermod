<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.TagManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
    <UserControl.Resources>
        <loc:BuiltInTagNameConverter x:Key="BuiltInTagName" />
        <BooleanToVisibilityConverter x:Key="TagBooleanVisibility" />
        <Style x:Key="TagRowAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Padding" Value="5" />
        </Style>
        <Style x:Key="TagNameButton" TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,30,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="52" />
            <RowDefinition Height="26" />
            <RowDefinition Height="36" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{loc:Loc TagManagement}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc UseColorsAndHierarchyToKeepInstancesOrganized}" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                    Height="32" Padding="14,0" Command="{Binding NewTagCommand}" AutomationProperties.Name="{loc:Loc NewTag}">
                <StackPanel Orientation="Horizontal">
                    <controls:IconView Kind="plus" Width="16" Height="16" Foreground="{DynamicResource InverseTextBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc NewTag}" Foreground="{DynamicResource InverseTextBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>
        <!-- 固定环境单独展示，没有编辑、子级或删除入口，也不参与搜索。 -->
        <Border Grid.Row="2" CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" Padding="14,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{loc:Loc SystemFixed}" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{loc:Loc Environment}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                    <controls:IconView Kind="lock-keyhole" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding BuiltInTags}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0" ToolTip="{loc:Loc BuiltInEnvironmentTag}">
                                <Ellipse Width="5" Height="5" Fill="{Binding Color}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Converter={StaticResource BuiltInTagName}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Custom}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CustomTagCount}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <Border Width="220" Height="32" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <controls:IconView Kind="search" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox x:Name="TagSearchInput" Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBox}" AutomationProperties.Name="{loc:Loc SearchTags}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc SearchTags2}" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="228" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Name}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc Instance}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="12,0" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                        <Grid Margin="{Binding Indent}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource TagRowAction}" Width="20" Height="24" Command="{Binding ToggleExpandedCommand}"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource TagBooleanVisibility}}" AutomationProperties.Name="{loc:Loc ExpandOrCollapseTag}">
                                                <controls:IconView Kind="{Binding ExpansionIcon}" Width="12" Height="12" />
                                            </Button>
                                            <controls:IconView Kind="corner-down-right" Width="12" Height="12" Foreground="{DynamicResource TextFaintBrush}">
                                                <controls:IconView.Style>
                                                    <Style TargetType="controls:IconView">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions><Condition Binding="{Binding HasChildren}" Value="False" /><Condition Binding="{Binding Depth}" Value="0" /></MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding HasChildren}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Depth}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:IconView.Style>
                                            </controls:IconView>
                                            <Button Grid.Column="1" Style="{StaticResource TagNameButton}" Command="{Binding SelectCommand}"
                                                    ToolTip="{Binding Tag.Path}" AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Color}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding InstanceCount}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Style="{StaticResource TagRowAction}" Click="OnTagMenuButtonClick" AutomationProperties.Name="{loc:Loc ManageTags}">
                                            <controls:IconView Kind="ellipsis" Width="16" Height="16" />
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{loc:Loc Rename}" Command="{Binding RenameCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="{loc:Loc Edit}" Command="{Binding EditCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="{loc:Loc AddChild}" Command="{Binding AddChildCommand}" CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:Loc DeleteTag}" Command="{Binding DeleteCommand}" CommandParameter="{Binding}" Foreground="{DynamicResource DangerBrush}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource TagBooleanVisibility}}">
                    <controls:IconView Kind="tags" Width="30" Height="30" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,16" />
                    <TextBlock Text="{loc:Loc NoCustomTagsYet}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Loc OrganizeYourInstancesWithCustomTags}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,20" />
                    <Button Content="{loc:Loc NewTag}" Command="{Binding NewTagCommand}" Style="{StaticResource PrimaryButton}" Height="32" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoMatches, Converter={StaticResource TagBooleanVisibility}}">
                    <TextBlock Text="{loc:Loc NoMatchingTags2}" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" />
                    <Button Content="{loc:Loc ClearSearch}" Command="{Binding ClearSearchCommand}" Height="32" Margin="0,14,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{loc:Loc SelectATagToViewDetailsOrManageItUsing}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,0" />
            </Grid>
            <Border Grid.Column="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1,0,0,0" Padding="24,4,0,0">
                <Grid>
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource TagBooleanVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc TAGDETAILS}" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,20" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding SelectedTag.Color}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SelectedTag.Name}" FontSize="18" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPath}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,14,0,18" />
                            <Border Height="1" Background="{DynamicResource LineSoftBrush}" />
                            <TextBlock Text="{loc:Loc Color}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,18,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="4" Background="{Binding SelectedTag.Color}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SelectedTag.Color}" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc LinkedInstances}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,22,0,12" />
                            <TextBlock Text="{Binding SelectedInstanceLabel}" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Button Content="{loc:Loc Rename}" Command="{Binding RenameCommand}" Height="32" Padding="12,0" Margin="0,0,8,0" />
                                <Button Command="{Binding EditCommand}" Height="32" Padding="12,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><controls:IconView Kind="pencil" Width="14" Height="14" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc Edit}" /></StackPanel>
                                </Button>
                                <Button Command="{Binding AddChildCommand}" Height="32" Padding="12,0">
                                    <StackPanel Orientation="Horizontal"><controls:IconView Kind="plus" Width="14" Height="14" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc AddChild}" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Row="1" Command="{Binding DeleteCommand}" Style="{StaticResource IconButton}"
                                Width="Auto" Height="28" Padding="0" HorizontalAlignment="Left" Foreground="{DynamicResource DangerBrush}">
                            <StackPanel Orientation="Horizontal"><controls:IconView Kind="trash-2" Width="14" Height="14" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc DeleteTag}" Foreground="{DynamicResource DangerBrush}" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{loc:Loc SelectATagToViewDetails}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <TextBlock Text="{loc:Loc ReadingTags}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource TagBooleanVisibility}}" />
        </Grid>
        <Border Grid.Row="7" CornerRadius="6" Background="{DynamicResource DangerWeakBrush}" Padding="12" Margin="0,16,0,0">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc Retry}" Command="{Binding RetryCommand}" Height="28" Margin="12,0,0,0" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
