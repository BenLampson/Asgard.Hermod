<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.TextPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{Binding Name, StringFormat={loc:Loc FilePreviewTitle}}" Width="960" Height="680" MinWidth="520" MinHeight="360" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Close}" Click="OnCloseClick" />
            <TextBlock Text="{loc:Loc FilePreviewReadOnly}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </DockPanel>
        <TextBox Grid.Row="1" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
            FontFamily="{DynamicResource MonoFont}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
            AutomationProperties.Name="{loc:Loc FileTextPreview}" />
    </Grid>
</controls:HermodDialog>
