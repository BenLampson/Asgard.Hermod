<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.AgentSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="32" MaxWidth="680" HorizontalAlignment="Left">
   <TextBlock Text="{loc:Loc AgentSettingsTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
   <Border Background="{DynamicResource AccentWeakBrush}" Padding="16" CornerRadius="8" Margin="0,0,0,20"><TextBlock Text="{loc:Loc AgentSettingsPrivacy}" TextWrapping="Wrap" /></Border>
   <TextBlock Text="{loc:Loc AgentEndpoint}" Margin="0,0,0,8" />
   <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" AutomationProperties.Name="{loc:Loc AgentEndpoint}" />
   <TextBlock Text="{loc:Loc AgentEndpointHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,16" />
   <TextBlock Text="{loc:Loc AgentModel}" Margin="0,0,0,8" />
   <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="{loc:Loc AgentModel}" />
   <TextBlock Text="{loc:Loc AgentApiKey}" Margin="0,16,0,8" />
   <controls:SecretInput Value="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" AutomationProperties.Name="{loc:Loc AgentApiKey}" />
   <TextBlock Text="{Binding KeyStatus}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,4" />
   <TextBlock Text="{loc:Loc AgentKeyHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
   <WrapPanel Margin="0,20,0,12"><Button Content="{loc:Loc AgentApplySettings}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" /><Button Content="{loc:Loc AgentClearKey}" Command="{Binding ClearKeyCommand}" Margin="0,0,0,8" /></WrapPanel>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
