<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.AgentSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource UiFont}" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/AgentDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible" /></ResourceDictionary></UserControl.Resources>
 <ScrollViewer Background="{DynamicResource SurfaceBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28">
   <DockPanel Height="42" Margin="0,0,0,20"><Button DockPanel.Dock="Right" Command="{Binding AddCommand}" AutomationProperties.Name="{loc:Loc AgentModelAdd}" Style="{StaticResource PrimaryButton}" Height="30" MinHeight="30" FontSize="12" Padding="10,0" VerticalAlignment="Center" FontWeight="Normal"><StackPanel Orientation="Horizontal"><controls:IconView Kind="plus" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc AgentModelAdd}" /></StackPanel></Button><TextBlock Text="{loc:Loc AgentModelSettingsHeading}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
   <TextBlock Text="{loc:Loc AgentModelsIntroduction}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" LineHeight="21.45" TextWrapping="Wrap" Margin="0,0,0,20" />
   <TextBlock Text="{loc:Loc AgentModelsEmpty}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,20" />
   <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,20" /></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate>
    <Border Height="100" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <controls:IconView Kind="cpu" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><StackPanel Orientation="Horizontal" Height="22"><TextBlock Text="{Binding Name}" MaxWidth="400" ToolTip="{Binding Name}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Border Background="{DynamicResource AccentWeakBrush}" CornerRadius="4" Padding="7,0" Height="21" Margin="9,0,0,0" Visibility="{Binding IsDefault, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Loc AgentModelDefaultBadge}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" /></Border></StackPanel><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0" LineHeight="19.8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" /></StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="32">
      <Button FontWeight="Normal" Content="{Binding DefaultLabel}" Command="{Binding DataContext.DefaultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" FontSize="11" Padding="0" Height="30" MinHeight="30" Margin="0,0,14,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="16" Height="30" MinHeight="30" Padding="0" Margin="0,0,14,0" ToolTip="{loc:Loc AgentModelEdit}" AutomationProperties.Name="{loc:Loc AgentModelEdit}"><controls:IconView Kind="pencil" Width="15" Height="15" /></Button>
      <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="16" Height="30" MinHeight="30" Padding="0" ToolTip="{loc:Loc AgentModelDelete}" AutomationProperties.Name="{loc:Loc AgentModelDelete}"><controls:IconView Kind="trash-2" Width="15" Height="15" /></Button>
     </StackPanel>
    </Grid></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,16,0,0" Visibility="{Binding HasPendingDelete, Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap" FontSize="12" /><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="{loc:Loc AgentModelDelete}" Command="{Binding ConfirmDeleteCommand}" Height="30" MinHeight="30" FontSize="12" /><Button Content="{loc:Loc Cancel}" Command="{Binding CancelDeleteCommand}" Height="30" MinHeight="30" FontSize="12" Margin="10,0,0,0" /></StackPanel></StackPanel></Border>
   <StackPanel Margin="0,16,0,16"><StackPanel Orientation="Horizontal" Height="24"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsSynced}" Value="True"><Setter Property="TextElement.Foreground" Value="{DynamicResource AgentSuccessBrush}" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><controls:IconView Kind="shield-check" Width="17" Height="17" Margin="0,0,8,0" /><TextBlock Text="{Binding SyncLabel}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsSynced}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AgentSuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Text="{loc:Loc AgentModelsSyncExplanation}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19.8" Margin="0,10,0,0" /><TextBlock Text="{loc:Loc AgentModelsDefaultExplanation}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19.8" Margin="0,10,0,0" /></StackPanel>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
