<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.MetadataEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
 Title="{Binding Title}" Width="600" Height="320" MinWidth="400" MinHeight="280" ResizeMode="CanResize"
 KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OnPreviewKeyDown">
 <controls:HermodDialog.Resources><BooleanToVisibilityConverter x:Key="Visible" /></controls:HermodDialog.Resources>
 <controls:HermodDialog.FooterContent><controls:DialogActionBar Height="56"><StackPanel Orientation="Horizontal">
  <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
  <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" />
 </StackPanel></controls:DialogActionBar></controls:HermodDialog.FooterContent>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel Margin="24">
   <TextBlock Text="{loc:Loc MetadataEditHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18" />
   <controls:FormField Label="{Binding NameLabel}" Error="{Binding NameError}" IsRequired="True" Visibility="{Binding IsNameEditing, Converter={StaticResource Visible}}">
    <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxLength}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{Binding NameLabel}" />
   </controls:FormField>
   <controls:InstanceHostingProviderSelector x:Name="HostingProviderSelector" ProviderId="{Binding HostingProviderId}"
    IsEnabled="{Binding IsEditable}" Visibility="{Binding IsHostingProviderEditing, Converter={StaticResource Visible}}" Margin="0,12,0,12" />
   <controls:InstanceTagSelector x:Name="TagSelector" Model="{Binding Tags}" Visibility="{Binding IsTagEditing, Converter={StaticResource Visible}}" />
   <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
 </ScrollViewer>
</controls:HermodDialog>
