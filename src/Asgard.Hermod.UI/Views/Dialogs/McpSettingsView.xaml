<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.McpSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="McpVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28" MaxWidth="650" HorizontalAlignment="Stretch">
            <TextBlock Text="{loc:Loc McpSettingsTitle}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc McpSettingsDescription}" Margin="0,8,0,20" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Margin="0,8,0,8">
                        <Button x:Name="McpToggle" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Margin="0,0,8,4" Padding="12,0" />
                        <Button Content="{loc:Loc McpCopyConfiguration}" Command="{Binding CopyCommand}" Margin="0,0,8,4" Padding="12,0" />
                        <Button Content="{loc:Loc Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,0,4" Padding="12,0" />
                    </WrapPanel>
                    <TextBlock Text="{loc:Loc McpClientHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{loc:Loc McpDefaultAccessTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8" />
            <TextBlock Text="{loc:Loc McpDefaultAccessHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Loc McpNoInstances}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                       Visibility="{Binding NoInstances, Converter={StaticResource McpVisibility}}" />
            <ItemsControl x:Name="McpInstanceAccessList" ItemsSource="{Binding InstanceAccess}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay}" Margin="0,6,0,0"
                              IsEnabled="{Binding DataContext.CanEditExclusions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              AutomationProperties.Name="{Binding Label}">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    </CheckBox>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:Loc McpExcludedScopesTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,8" />
            <TextBlock Text="{loc:Loc McpExcludedScopesHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Loc McpNoExcludedScopes}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                       Visibility="{Binding NoExcludedScopes, Converter={StaticResource McpVisibility}}" />
            <ItemsControl ItemsSource="{Binding ExcludedScopes}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Instance}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Loc McpRemoveExclusion}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Padding="10,0" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="McpOpenExclusion" Content="{loc:Loc McpAddExclusion}" Click="OnOpenExclusion" IsEnabled="{Binding CanEditExclusions}"
                    HorizontalAlignment="Left" Padding="16,0" Margin="0,12,0,0" />
            <TextBlock Text="{loc:Loc McpStarterPromptTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="{loc:Loc McpStarterPromptHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc McpStarterPrompt}" TextWrapping="Wrap" />
                    <Button x:Name="McpCopyPromptButton" Content="{loc:Loc McpCopyPrompt}" Command="{Binding CopyPromptCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
