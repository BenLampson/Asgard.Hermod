<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.McpSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="McpVisibility" />
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="PolicyButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
      <Setter Property="Height" Value="31" /><Setter Property="MinHeight" Value="29" /><Setter Property="Padding" Value="9,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Policy}" Value="{x:Static models:McpInstancePolicy.AlwaysAllow}">
          <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /><Setter Property="Background" Value="{DynamicResource WarningWeakBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Policy}" Value="{x:Static models:McpInstancePolicy.Blocked}">
          <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="Background" Value="{DynamicResource DangerWeakBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Width="45" Height="45" Background="{DynamicResource AccentWeakBrush}" CornerRadius="10" VerticalAlignment="Center" Margin="0,0,12,0">
          <controls:IconView Kind="workflow" Width="23" Height="23" Foreground="{DynamicResource AccentTextBrush}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
          <TextBlock Text="{loc:Loc McpAccessControl}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{loc:Loc McpAccessSubtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button x:Name="McpToggle" Command="{Binding ToggleCommand}" ToolTip="{Binding ToggleLabel}" AutomationProperties.Name="{Binding ToggleLabel}"
                  AutomationProperties.HelpText="{Binding StateText}" Style="{StaticResource GhostButton}" Padding="4,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border CornerRadius="10" Width="34" Height="19" Padding="3" VerticalAlignment="Center">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource LineBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Ellipse Width="13" Height="13" Fill="{DynamicResource InverseTextBrush}"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="HorizontalAlignment" Value="Left" /><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="HorizontalAlignment" Value="Right" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="McpOpenGuide" Content="{loc:Loc McpClientGuide}" Click="OnOpenGuide" Style="{StaticResource GhostButton}"
                  HorizontalAlignment="Right" Height="27" MinHeight="27" Padding="5,0" Foreground="{DynamicResource AccentTextBrush}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24,13,24,6">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{loc:Loc McpDefaultAccessTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Border Background="{DynamicResource AppBackgroundBrush}" Padding="6,1" CornerRadius="4" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding InstanceAccess.Count}" FontSize="12" /></Border>
      </StackPanel>
      <Grid Grid.Column="1" Width="180">
        <TextBox x:Name="McpSearch" Padding="28,0,6,0" VerticalContentAlignment="Center" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc McpSearchInstances}" />
        <controls:IconView Kind="search" Width="14" Height="14" Margin="9,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}" />
        <TextBlock Text="{loc:Loc McpSearchInstances}" VerticalAlignment="Center" Margin="28,0,5,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=McpSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
      <Button Grid.Column="2" Margin="6,0,0,0" Width="32" Padding="0" Command="{Binding RefreshCommand}" ToolTip="{loc:Loc Refresh}" AutomationProperties.Name="{loc:Loc Refresh}"><controls:IconView Kind="refresh-cw" Width="15" Height="15" /></Button>
    </Grid>
    <controls:SegmentedSelector x:Name="McpFilters" Grid.Row="2" Margin="24,0,24,8" HorizontalAlignment="Left" ItemsSource="{Binding Filters}"
        SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc McpFilterPolicy}" Background="Transparent">
      <controls:SegmentedSelector.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding Count}" Margin="6,0,0,0" Foreground="{DynamicResource TextMutedBrush}">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Policy}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </StackPanel></DataTemplate></controls:SegmentedSelector.ItemTemplate>
    </controls:SegmentedSelector>
    <Border Grid.Row="3" Margin="24,0" CornerRadius="7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,7,23,7" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6,6,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc InstanceName}" Style="{StaticResource Muted}" /><TextBlock Grid.Column="1" Text="{loc:Loc McpTypeColumn}" Style="{StaticResource Muted}" /><TextBlock Grid.Column="2" Text="{loc:Loc McpAccessPolicy}" Style="{StaticResource Muted}" />
          </Grid>
        </Border>
        <Grid>
          <ListBox x:Name="McpInstanceAccessList" ItemsSource="{Binding VisibleInstances}" IsEnabled="{Binding CanEditExclusions}" BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.VirtualizationMode="Recycling"
                   KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="{loc:Loc McpDefaultAccessTitle}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <Border Padding="12,6" MinHeight="45" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="134" /></Grid.ColumnDefinitions>
                  <DockPanel LastChildFill="True" Margin="0,0,8,0">
                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AppBackgroundBrush}" VerticalAlignment="Center" Margin="0,0,9,0">
                      <controls:IconView Kind="{Binding Icon}" Width="16" Height="16"><controls:IconView.Style><Style TargetType="controls:IconView"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Style.Triggers>
                        <DataTrigger Binding="{Binding Target.Target.TypeId}" Value="storage"><Setter Property="Foreground" Value="{DynamicResource FileVideoBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Target.Target.TypeId}" Value="ssh"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Target.Target.TypeId}" Value="redis"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Target.Target.TypeId}" Value="rabbitmq"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
                      </Style.Triggers></Style></controls:IconView.Style></controls:IconView>
                    </Border>
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Target.Label}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Grid.Column="1" Text="{Binding TypeName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{Binding TypeName}" />
                  <Button Grid.Column="2" Style="{StaticResource PolicyButton}" Click="OnOpenPolicy" AutomationProperties.Name="{Binding AccessibleLabel}" ToolTip="{Binding AccessibleLabel}">
                    <DockPanel><controls:IconView DockPanel.Dock="Left" Kind="{Binding PolicyIcon}" Width="14" Height="14" Margin="0,0,5,0" />
                      <controls:IconView DockPanel.Dock="Right" Kind="chevron-down" Width="12" Height="12" /><TextBlock Text="{Binding PolicyLabel}" VerticalAlignment="Center" /></DockPanel>
                    <Button.ContextMenu>
                      <ContextMenu Placement="Bottom" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock Text="{Binding Name, StringFormat={loc:Loc McpPolicyMenuTitle}}" TextWrapping="Wrap" MaxWidth="280" /></MenuItem.Header></MenuItem>
                  <MenuItem Command="{Binding SetPolicyCommand}" CommandParameter="{x:Static models:McpInstancePolicy.Confirm}"
                            AutomationProperties.Name="{loc:Loc McpConfirmFirst}" AutomationProperties.HelpText="{loc:Loc McpConfirmDescription}">
                    <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Style.Triggers><DataTrigger Binding="{Binding Policy}" Value="{x:Static models:McpInstancePolicy.Confirm}"><Setter Property="IsChecked" Value="True" /></DataTrigger></Style.Triggers>
                    </Style></MenuItem.Style>
                    <MenuItem.Icon><controls:IconView Kind="message-square" Width="15" Height="15" Foreground="{DynamicResource AccentTextBrush}" /></MenuItem.Icon>
                    <MenuItem.Header><StackPanel Width="265" Margin="0,6">
                      <TextBlock Text="{loc:Loc McpConfirmFirst}" FontWeight="SemiBold" />
                      <TextBlock Text="{loc:Loc McpConfirmDescription}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Command="{Binding SetPolicyCommand}" CommandParameter="{x:Static models:McpInstancePolicy.AlwaysAllow}"
                            AutomationProperties.Name="{loc:Loc McpAlwaysAllowInstance}" AutomationProperties.HelpText="{loc:Loc McpAllowDescription}">
                    <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Style.Triggers><DataTrigger Binding="{Binding Policy}" Value="{x:Static models:McpInstancePolicy.AlwaysAllow}"><Setter Property="IsChecked" Value="True" /></DataTrigger></Style.Triggers>
                    </Style></MenuItem.Style>
                    <MenuItem.Icon><controls:IconView Kind="shield-check" Width="15" Height="15" Foreground="{DynamicResource WarningBrush}" /></MenuItem.Icon>
                    <MenuItem.Header><StackPanel Width="265" Margin="0,6">
                      <TextBlock Text="{loc:Loc McpAlwaysAllowInstance}" FontWeight="SemiBold" />
                      <TextBlock Text="{loc:Loc McpAllowDescription}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem Command="{Binding SetPolicyCommand}" CommandParameter="{x:Static models:McpInstancePolicy.Blocked}"
                            AutomationProperties.Name="{loc:Loc McpBlockAccess}" AutomationProperties.HelpText="{loc:Loc McpBlockDescription}">
                    <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Style.Triggers><DataTrigger Binding="{Binding Policy}" Value="{x:Static models:McpInstancePolicy.Blocked}"><Setter Property="IsChecked" Value="True" /></DataTrigger></Style.Triggers>
                    </Style></MenuItem.Style>
                    <MenuItem.Icon><controls:IconView Kind="circle-x" Width="15" Height="15" Foreground="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                    <MenuItem.Header><StackPanel Width="265" Margin="0,6">
                      <TextBlock Text="{loc:Loc McpBlockAccess}" FontWeight="SemiBold" />
                      <TextBlock Text="{loc:Loc McpBlockDescription}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel></MenuItem.Header>
                  </MenuItem>
                        <Separator /><MenuItem Header="{loc:Loc McpBlockedPriority}" IsEnabled="False" />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{loc:Loc McpNoInstances}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" Visibility="{Binding NoInstances, Converter={StaticResource McpVisibility}}" />
          <TextBlock Text="{loc:Loc McpNoMatch}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" Visibility="{Binding NoMatches, Converter={StaticResource McpVisibility}}" />
        </Grid>
      </DockPanel>
    </Border>
    <Border Grid.Row="4" Margin="24,10,24,8" Padding="12,9" CornerRadius="7" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <StackPanel>
        <DockPanel>
          <Button x:Name="McpOpenExclusion" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnOpenExclusion" IsEnabled="{Binding CanEditExclusions}" Padding="10,0" AutomationProperties.Name="{loc:Loc McpAddLocation}">
            <StackPanel Orientation="Horizontal"><controls:IconView Kind="plus" Width="14" Height="14" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc McpAddLocation}" /></StackPanel>
          </Button>
          <controls:IconView DockPanel.Dock="Left" Kind="lock-keyhole" Width="20" Height="20" Margin="3,0,12,0" Foreground="{DynamicResource TextMutedBrush}" />
          <StackPanel Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{loc:Loc McpLocationsShort}" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding ExcludedScopes.Count}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
            <TextBlock Text="{loc:Loc McpBlockedPriority}" Style="{StaticResource Muted}" />
          </StackPanel>
        </DockPanel>
        <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding ExcludedScopes}"><ItemsControl.ItemTemplate><DataTemplate>
            <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="{loc:Loc McpRemoveExclusion}" Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                  CommandParameter="{Binding}" Padding="8,0" VerticalAlignment="Center" />
              <StackPanel Margin="4,0,7,0"><TextBlock Text="{Binding Instance}" FontWeight="Medium" TextWrapping="Wrap" /><TextBlock Text="{Binding Scope}" Style="{StaticResource Muted}" /></StackPanel>
            </DockPanel>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
    <Border Grid.Row="5" Padding="24,7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><DockPanel>
      <controls:IconView Kind="info" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource TextMutedBrush}" />
      <TextBlock AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="Text" Value="{Binding Message}" /><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Text" Value="{loc:Loc McpAutoSaveHint}" /></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style></TextBlock>
    </DockPanel></Border>
  </Grid>
</UserControl>
