<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:dialogs="clr-namespace:Asgard.Hermod.UI.Views.Dialogs">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/AgentDesign.xaml" /></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="SettingsBooleanVisibility" /></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource AppBackgroundBrush}" Padding="16,24">
            <ItemsControl ItemsSource="{Binding PrimaryCategories}"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding Name}" IsEnabled="{Binding IsAvailable}" Height="38" Margin="0,0,0,8" FontSize="13" FontWeight="Normal" HorizontalContentAlignment="Left" Padding="12,0"
                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="agent" /><Condition Binding="{Binding DataContext.IsAgentSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="general" /><Condition Binding="{Binding DataContext.IsGeneralNavigationSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="account" /><Condition Binding="{Binding DataContext.IsAccountSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></MultiDataTrigger>
                    </Style.Triggers></Style></Button.Style>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsGeneralSelected, Converter={StaticResource SettingsBooleanVisibility}}">
            <StackPanel Margin="32" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Loc General}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,28" />
                <TextBlock Text="{loc:Loc Language}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{loc:Loc FollowWindowsDisplayLanguageAutomaticallyOrChooseALanguageBelow}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="NativeName"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Width="280" MinHeight="36"
                          HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Language}" />
                <TextBlock Text="{Binding CurrentLanguage}" Margin="0,16,0,8" />
                <TextBlock Text="{loc:Loc LanguageChangesTakeEffectAfterRestartingHermodYourChoiceIsSavedOnThisDevice}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding LanguageMessage}" Margin="0,16,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel DataContext="{Binding CloseSettings}" Margin="0,28,0,0">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{loc:Loc MainCloseSettingsHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <CheckBox Content="{loc:Loc MainCloseAskSetting}" IsChecked="{Binding AskBeforeClosing, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc MainCloseAskSetting}" />
                    <TextBlock Text="{loc:Loc MainCloseDefaultAction}" Margin="0,16,0,8" />
                    <ComboBox ItemsSource="{Binding Actions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedAction, Mode=TwoWay}" Width="280" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc MainCloseDefaultAction}" />
                    <TextBlock Text="{loc:Loc MainCloseSettingsHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Text="{loc:Loc AdditionalSettings}" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,12" />
                <ItemsControl ItemsSource="{Binding AdditionalCategories}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" IsEnabled="{Binding IsAvailable}" HorizontalAlignment="Left" Height="32" Margin="0,0,0,8" Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAccountSelected, Converter={StaticResource SettingsBooleanVisibility}}">
            <StackPanel Margin="32" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Loc Account}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,28" />
                <TextBlock Text="{Binding AccountName}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="SettingsAccountStatus" Text="{Binding AccountStatus}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ManageAccountButton" Content="{loc:Loc AccountAndSync}" Command="{Binding OpenAccountCommand}" HorizontalAlignment="Left" Padding="16,0" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="1" Visibility="{Binding IsTagsSelected, Converter={StaticResource SettingsBooleanVisibility}}">
            <dialogs:TagManagementView DataContext="{Binding Tags}" />
        </Grid>
        <dialogs:FileOpeningSettingsView Grid.Column="1" DataContext="{Binding FileOpening}"
            Visibility="{Binding DataContext.IsFileOpeningSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}, Converter={StaticResource SettingsBooleanVisibility}}" />
        <dialogs:StorageSettingsView Grid.Column="1" DataContext="{Binding Storage}"
            Visibility="{Binding DataContext.IsStorageSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}, Converter={StaticResource SettingsBooleanVisibility}}" />
        <dialogs:AgentSettingsView Grid.Column="1" DataContext="{Binding AgentModels}"
            Visibility="{Binding DataContext.IsAgentSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}, Converter={StaticResource SettingsBooleanVisibility}}" />
        <dialogs:AboutSettingsView x:Name="AboutContent" Grid.Column="1" DataContext="{Binding About}" Visibility="{Binding DataContext.IsAboutSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}, Converter={StaticResource SettingsBooleanVisibility}}" />
        <dialogs:UpdateSettingsView x:Name="UpdatesContent" Grid.Column="1" DataContext="{Binding Updates}" Visibility="{Binding DataContext.IsUpdatesSelected, RelativeSource={RelativeSource AncestorType=dialogs:SettingsView}, Converter={StaticResource SettingsBooleanVisibility}}" />
    </Grid>
</UserControl>
