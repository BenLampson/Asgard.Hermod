<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.FilePreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{Binding Name, StringFormat={loc:Loc FilePreviewTitle}}" Width="960" Height="680" MinWidth="520" MinHeight="360" ResizeMode="CanResize">
    <controls:HermodDialog.Resources><BooleanToVisibilityConverter x:Key="FilePreviewVisibility" /></controls:HermodDialog.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Close}" Click="OnCloseClick" />
            <TextBlock Text="{loc:Loc FilePreviewReadOnly}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </DockPanel>
        <TextBox Grid.Row="1" x:Name="TextContent" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
            FontFamily="{DynamicResource MonoFont}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
            Visibility="{Binding IsText, Converter={StaticResource FilePreviewVisibility}}" AutomationProperties.Name="{loc:Loc FileTextPreview}" />
        <Grid Grid.Row="1" Visibility="{Binding IsImage, Converter={StaticResource FilePreviewVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{loc:Loc ImageZoom}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="4" Value="1" Width="180" VerticalAlignment="Center" ValueChanged="OnZoomChanged" AutomationProperties.Name="{loc:Loc ImageZoom}" />
                <TextBlock Text="{Binding Value, ElementName=ZoomSlider, StringFormat={loc:Loc ImageZoomPercent}}" Margin="12,0" VerticalAlignment="Center" />
                <Button Content="{loc:Loc ImageFit}" Click="OnFitClick" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" x:Name="ImageViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="OnImageSizeChanged" Background="{DynamicResource AppBackgroundBrush}">
                <Image x:Name="ImageContent" Source="{Binding Image}" Stretch="Uniform" AutomationProperties.Name="{loc:Loc FileImagePreview}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</controls:HermodDialog>
