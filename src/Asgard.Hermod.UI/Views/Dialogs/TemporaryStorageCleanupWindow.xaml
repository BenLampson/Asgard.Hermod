<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.TemporaryStorageCleanupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{loc:Loc StorageConfirmCleanupTitle}" Width="520" Height="280">
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Cancel}" Height="32" Margin="0,0,8,0" IsCancel="True" Click="OnCancelClick" />
                <Button Content="{loc:Loc StorageCleanup}" Height="32" Style="{StaticResource PrimaryButton}" Click="OnCleanupClick" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Loc StorageConfirmCleanupTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16" />
            <TextBlock x:Name="EstimateText" TextWrapping="Wrap" FontSize="13" />
            <TextBlock Text="{loc:Loc StorageCleanupSafeHint}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</controls:HermodDialog>
