<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.AccountRegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{loc:Loc RegistrationTitle}" Width="560" Height="660" MinWidth="480" MinHeight="520" ResizeMode="CanResize">
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </controls:HermodDialog.InputBindings>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CloseButton" Content="{loc:Loc Close}" Command="{Binding CloseCommand}" Height="32" Padding="14,0" Margin="0,0,10,0" />
                <Button x:Name="RegisterButton" Content="{loc:Loc RegistrationTitle}" Command="{Binding RegisterCommand}" Height="32" Padding="14,0" Margin="0,0,10,0" />
                <Button x:Name="SignInButton" Content="{loc:Loc SignInToYourAccount}" Command="{Binding SignInCommand}" Height="32" Padding="14,0" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <TextBlock Text="{loc:Loc RegistrationTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="{loc:Loc RegistrationExplanation}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" />
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="{loc:Loc RegistrationUsername}" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" Height="36"
                        AutomationProperties.Name="{loc:Loc RegistrationUsername}" Margin="0,0,0,14" />
                    <TextBlock Text="{loc:Loc RegistrationEmail}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="255" Height="36"
                        AutomationProperties.Name="{loc:Loc RegistrationEmail}" Margin="0,0,0,14" />
                    <TextBlock Text="{loc:Loc RegistrationPassword}" Margin="0,0,0,6" />
                    <controls:SecretInput Value="{Binding Password, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" Height="36"
                        AutomationProperties.Name="{loc:Loc RegistrationPassword}" />
                    <TextBlock Text="{loc:Loc RegistrationPasswordHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,14" />
                    <TextBlock Text="{loc:Loc RegistrationConfirmPassword}" Margin="0,0,0,6" />
                    <controls:SecretInput Value="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" Height="36"
                        AutomationProperties.Name="{loc:Loc RegistrationConfirmPassword}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="OperationMessage" Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="24,8,24,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</controls:HermodDialog>
