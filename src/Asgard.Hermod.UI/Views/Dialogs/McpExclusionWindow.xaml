<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.McpExclusionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
    xmlns:vm="clr-namespace:Asgard.Hermod.UI.ViewModels"
    xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
    Title="{loc:Loc McpAddLocation}" Width="510" Height="515" MinWidth="430" MinHeight="380" ResizeMode="CanResize">
    <controls:HermodDialog.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/McpDialogColors.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </ResourceDictionary></controls:HermodDialog.Resources>
    <controls:HermodDialog.FooterContent>
        <controls:DialogActionBar Height="56">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Cancel}" IsCancel="True" Margin="0,0,8,0" Height="32" />
                <Button x:Name="McpSaveExclusion" Content="{loc:Loc McpSaveScope}" Command="{Binding AddExclusionCommand}"
                        Style="{StaticResource PrimaryButton}" IsDefault="True" Height="32" />
            </StackPanel>
        </controls:DialogActionBar>
    </controls:HermodDialog.FooterContent>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:Loc McpBlockedPriority}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />
            <TextBlock Text="{loc:Loc McpSelectInstance}" Margin="0,0,0,4" />
            <ComboBox x:Name="McpExclusionTarget" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{loc:Loc McpSelectInstance}" />
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowTransfers, Converter={StaticResource Visible}}">
                <TextBlock Text="{loc:Loc McpScopeRange}" Margin="0,0,0,4" />
                <controls:SegmentedSelector SelectedValuePath="Tag" SelectedValue="{Binding StorageRange, Mode=TwoWay}"
                                            AutomationProperties.Name="{loc:Loc McpScopeRange}">
                    <ListBoxItem Tag="{x:Static vm:McpStorageExclusionRange.Prefix}" Content="{loc:Loc McpScopePrefix}" />
                    <ListBoxItem Tag="{x:Static vm:McpStorageExclusionRange.Bucket}" Content="{loc:Loc McpScopeBucket}" />
                    <ListBoxItem Tag="{x:Static vm:McpStorageExclusionRange.Instance}" Content="{loc:Loc McpScopeInstance}" />
                </controls:SegmentedSelector>
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowResource, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding ResourceLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Resource, UpdateSourceTrigger=PropertyChanged}" MaxLength="253" AutomationProperties.Name="{Binding ResourceLabel}" />
                    <Button x:Name="McpExclusionBrowseStorage" Grid.Column="1" Content="{loc:Loc McpBrowseLocation}" Click="OnBrowseStorage" IsEnabled="{Binding CanBrowseStorage}"
                            Visibility="{Binding ShowTransfers, Converter={StaticResource Visible}}" Margin="8,0,0,0" Padding="12,0" />
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowQualifier, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding QualifierLabel}" />
                <TextBox Text="{Binding Qualifier, UpdateSourceTrigger=PropertyChanged}" MaxLength="1024" AutomationProperties.Name="{Binding QualifierLabel}" />
            </StackPanel>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowExclusionTable, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding ExclusionTableLabel}" />
                <TextBox Text="{Binding Table, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" AutomationProperties.Name="{Binding ExclusionTableLabel}" />
            </StackPanel>
            <Border CornerRadius="5" Background="{DynamicResource AppBackgroundBrush}" Padding="10" Margin="0,12,0,0">
                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ScopePreview}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <DockPanel><controls:IconView Kind="lock-keyhole" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ScopePreview}" TextWrapping="Wrap" AutomationProperties.Name="{loc:Loc McpScopeRange}" /></DockPanel>
            </Border>
            <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</controls:HermodDialog>
