<UserControl x:Class="Asgard.Hermod.UI.Views.Dialogs.AboutSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" Focusable="False">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel Margin="32" MaxWidth="680" HorizontalAlignment="Stretch">
   <TextBlock Text="{loc:Loc About}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24" />
   <Border Style="{StaticResource PanelBorder}" Padding="24" CornerRadius="10"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Image Source="{DynamicResource HermodLogo}" Width="72" Height="72" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Hermod}" />
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{loc:Loc HomeProductName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="AboutVersion" Text="{Binding Version}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" /></StackPanel>
    </Grid>
    <TextBlock Text="{loc:Loc HomeTagline}" FontSize="15" Margin="0,24,0,8" TextWrapping="Wrap" />
    <TextBlock Text="{loc:Loc HomeDescription}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="20" />
   </StackPanel></Border>
   <Border Style="{StaticResource PanelBorder}" Padding="24" CornerRadius="10" Margin="0,16,0,0"><StackPanel>
    <TextBlock Text="{loc:Loc HomeOpenSource}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
    <TextBlock Text="{loc:Loc HomeOpenSourceDescription}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="20" />
    <TextBlock Text="{loc:Loc HomeAuthor}" Margin="0,20,0,8" TextWrapping="Wrap" />
    <TextBlock Text="{loc:Loc HomeLicense}" Margin="0,0,0,20" TextWrapping="Wrap" />
    <Button x:Name="OpenRepository" Content="{loc:Loc HomeOpenGitHub}" Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
    <TextBox x:Name="RepositoryAddress" Text="{Binding RepositoryUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" FontSize="12" FontFamily="{DynamicResource MonoFont}" Margin="0,12,0,0" AutomationProperties.Name="{loc:Loc AboutRepositoryAddress}" />
   </StackPanel></Border>
   <TextBlock Text="{Binding Message}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
