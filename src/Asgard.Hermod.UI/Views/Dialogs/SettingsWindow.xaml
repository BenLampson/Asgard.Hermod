<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.UI.Views.Dialogs"
        Title="{loc:Loc SystemSettings}" Width="1100" Height="740">
    <controls:HermodDialog.Resources>
        <BooleanToVisibilityConverter x:Key="SettingsBooleanVisibility" />
    </controls:HermodDialog.Resources>
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </controls:HermodDialog.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 分类由宿主能力决定可用性，账号状态与主窗口共享。 -->
        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0" Padding="14,24,14,20">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Settings}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,28" />
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="0,1,0,0" Padding="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:IconView Kind="{Binding WorkspaceIcon}" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SettingsAccountName" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountName}" />
                            <TextBlock x:Name="SettingsWorkspaceName" Text="{Binding WorkspaceName}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button IsEnabled="{Binding IsAvailable}" Height="38" Margin="0,0,0,6"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
                                        <Setter Property="Padding" Value="12,0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Id}" Value="account" />
                                                    <Condition Binding="{Binding DataContext.IsAccountSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Id}" Value="storage" />
                                                    <Condition Binding="{Binding DataContext.IsStorageSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Id}" Value="file-opening" />
                                                    <Condition Binding="{Binding DataContext.IsFileOpeningSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Id}" Value="general" />
                                                    <Condition Binding="{Binding DataContext.IsGeneralSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Id}" Value="tags" />
                                                    <Condition Binding="{Binding DataContext.IsTagsSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsGeneralSelected, Converter={StaticResource SettingsBooleanVisibility}}">
            <StackPanel Margin="32" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Loc General}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,28" />
                <TextBlock Text="{loc:Loc Language}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{loc:Loc FollowWindowsDisplayLanguageAutomaticallyOrChooseALanguageBelow}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />
                <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="NativeName"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Width="280" MinHeight="36"
                          HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Language}" />
                <TextBlock Text="{Binding CurrentLanguage}" Margin="0,16,0,8" />
                <TextBlock Text="{loc:Loc LanguageChangesTakeEffectAfterRestartingHermodYourChoiceIsSavedOnThisDevice}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding LanguageMessage}" Margin="0,16,0,0" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAccountSelected, Converter={StaticResource SettingsBooleanVisibility}}">
            <StackPanel Margin="32" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Loc Account}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,28" />
                <TextBlock Text="{Binding AccountName}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="SettingsAccountStatus" Text="{Binding AccountStatus}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ManageAccountButton" Content="{loc:Loc AccountAndSync}" Command="{Binding OpenAccountCommand}" HorizontalAlignment="Left" Padding="16,0" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="1" Visibility="{Binding IsTagsSelected, Converter={StaticResource SettingsBooleanVisibility}}">
            <dialogs:TagManagementView DataContext="{Binding Tags}" />
        </Grid>
        <dialogs:FileOpeningSettingsView Grid.Column="1" DataContext="{Binding FileOpening}"
            Visibility="{Binding DataContext.IsFileOpeningSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SettingsBooleanVisibility}}" />
        <dialogs:StorageSettingsView Grid.Column="1" DataContext="{Binding Storage}"
            Visibility="{Binding DataContext.IsStorageSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SettingsBooleanVisibility}}" />
    </Grid>
</controls:HermodDialog>
