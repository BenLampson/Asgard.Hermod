<controls:HermodWindow x:Class="Asgard.Hermod.UI.Views.Dialogs.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:dialogs="clr-namespace:Asgard.Hermod.UI.Views.Dialogs"
 Title="{loc:Loc SystemSettings}" Width="1020" Height="800" MinWidth="800" MinHeight="540" CaptionHeight="60"
 ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Background="{DynamicResource SurfaceBrush}">
 <controls:HermodWindow.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/AgentDesign.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></controls:HermodWindow.Resources>
 <controls:HermodWindow.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}" /></controls:HermodWindow.InputBindings>
 <controls:HermodWindow.CaptionContent><controls:SettingsCaption Title="{loc:Loc Settings}" /></controls:HermodWindow.CaptionContent>
 <dialogs:SettingsView />
</controls:HermodWindow>
