<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
        xmlns:dialogs="clr-namespace:Asgard.Hermod.UI.Views.Dialogs"
        Title="系统设置" Width="1100" Height="740">
    <controls:HermodDialog.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </controls:HermodDialog.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 导航保留未来分类的位置，只有已经设计的 Tag 管理可以进入。 -->
        <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0" Padding="14,24,14,20">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,28" />
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="0,1,0,0" Padding="12,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Kind="laptop" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="本地" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button IsEnabled="{Binding IsAvailable}" Height="38" Margin="0,0,0,6"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
                                        <Setter Property="Padding" Value="12,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <dialogs:TagManagementView Grid.Column="1" DataContext="{Binding Tags}" />
    </Grid>
</controls:HermodDialog>
