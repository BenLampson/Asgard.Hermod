<controls:HermodDialog x:Class="Asgard.Hermod.UI.Views.Dialogs.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls" xmlns:dialogs="clr-namespace:Asgard.Hermod.UI.Views.Dialogs"
 Title="{loc:Loc SystemSettings}" Width="1020" Height="800" CaptionHeight="60">
 <controls:HermodDialog.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/AgentDesign.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></controls:HermodDialog.Resources>
 <controls:HermodDialog.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseCommand}" /></controls:HermodDialog.InputBindings>
 <controls:HermodDialog.CaptionContent><controls:SettingsCaption Title="{loc:Loc Settings}" /></controls:HermodDialog.CaptionContent>
 <dialogs:SettingsView />
</controls:HermodDialog>
