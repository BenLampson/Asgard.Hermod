<UserControl x:Class="Asgard.Hermod.UI.Views.Shell.WorkspaceTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             Height="36">
    <Border Background="{DynamicResource TabInactiveBrush}" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource LineBrush}" Padding="6,0">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom">
            <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 关闭按钮与选择按钮并列，关闭时不会触发切换。 -->
                        <Grid Height="31" Margin="0,0,2,0">
                            <Button Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                        <Setter Property="Padding" Value="12,0" />
                                        <Setter Property="ToolTip" Value="{Binding Header}" />
                                        <Setter Property="BorderThickness" Value="1,1,1,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Header}" Value="">
                                                <Setter Property="Padding" Value="9,0" />
                                                <Setter Property="ToolTip" Value="{loc:Loc Home}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Kind="{Binding Icon}">
                                        <controls:IconView.Style>
                                            <Style TargetType="controls:IconView">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Setter Property="Width" Value="13" />
                                                <Setter Property="Height" Value="13" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Header}" Value="">
                                                        <Setter Property="Width" Value="14" />
                                                        <Setter Property="Height" Value="14" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:IconView.Style>
                                    </controls:IconView>
                                    <TextBlock Text="{Binding Header}" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="7,0,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Header}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" Margin="7,0,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlert}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Border Width="11" Margin="7,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanClose}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Width="15" Height="24" Padding="0" Margin="0,0,10,0" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="{loc:Loc CloseTab}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanClose}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:IconView Kind="x" Width="11" Height="11"
                                                   Foreground="{DynamicResource TextFaintBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
