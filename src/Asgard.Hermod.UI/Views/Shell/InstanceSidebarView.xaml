<UserControl x:Class="Asgard.Hermod.UI.Views.Shell.InstanceSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:shell="clr-namespace:Asgard.Hermod.UI.Views.Shell"
             x:Name="SidebarRoot">
    <Grid>
        <!-- 展开视图与图标栏共用 Instances 集合和打开命令。 -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=SidebarRoot}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="3" Text="{Binding OperationError}" Margin="12,4,12,8"
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OperationError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Margin="12,0">
                <TextBlock Text="Instances" FontSize="12.5" FontWeight="Bold"
                           Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center" />
                <Button Command="{Binding AddInstanceCommand}" Style="{DynamicResource IconButton}"
                        Width="24" Height="24" Padding="0" HorizontalAlignment="Right" ToolTip="Add instance">
                    <controls:IconView Kind="plus" Width="15" Height="15"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
            </Grid>
            <Border Grid.Row="1" Margin="10,2,10,6" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="9,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconView Kind="search" Width="13" Height="13"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                    <TextBox x:Name="InstanceSearch" Grid.Column="2"
                             Style="{DynamicResource SearchTextBox}" FontSize="11.5"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter instances by name" />
                    <TextBlock Grid.Column="2" Text="Filter instances by name…" FontSize="11.5"
                               Foreground="{DynamicResource TextFaintBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InstanceSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,2,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="TagFilterButton" Style="{DynamicResource StandardButton}"
                        Height="19" Margin="10,2,10,8" Padding="8,3" HorizontalAlignment="Left"
                        Click="OnTagFilterClick" ToolTip="Filter instances by tag">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Kind="plus" Width="11" Height="11"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TagFilterLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Button>
                <Popup x:Name="TagFilterPopup" PlacementTarget="{Binding ElementName=TagFilterButton}"
                       Placement="Bottom" HorizontalOffset="-16" VerticalOffset="-2"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                       Opened="OnTagPopupOpened" Closed="OnTagPopupClosed">
                    <!-- 阴影空间不计入设计稿中三百八十像素的选择器主体。 -->
                    <Border Padding="16,8,16,24" Background="Transparent">
                        <controls:TagTreePicker x:Name="TagPicker" Width="380"
                                                KeyboardNavigation.TabNavigation="Cycle" />
                    </Border>
                </Popup>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="30"
                                            Margin="0,0,0,1" Padding="14,0" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconView Kind="{Binding Icon}" Width="15" Height="15"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No matching instances" FontSize="11.5" Margin="14,8"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=SidebarRoot}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0,12" HorizontalAlignment="Center">
                <Button Style="{DynamicResource IconButton}" Width="36" Height="36"
                        Margin="0,0,0,8" Click="OnCollapsedSearchClick" ToolTip="Find instances">
                    <controls:IconView Kind="search" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
                <ItemsControl ItemsSource="{Binding Instances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="36" Height="36" Margin="0,0,0,8"
                                    ToolTip="{Binding Name}"
                                    Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <controls:IconView Kind="{Binding Icon}" Width="18" Height="18" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{DynamicResource IconButton}" Width="36" Height="36"
                        Command="{Binding AddInstanceCommand}" ToolTip="Add instance">
                    <controls:IconView Kind="plus" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
