<UserControl x:Class="Asgard.Hermod.UI.Views.Shell.InstanceSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls"
             xmlns:models="clr-namespace:Asgard.Hermod.Abstractions.Models;assembly=Asgard.Hermod.Abstractions"
             x:Name="SidebarRoot">
    <UserControl.Resources>
        <!-- 所有存储提供商共用琥珀色类型图标，实例列表不展示 Bucket 展开箭头。 -->
        <Style x:Key="InstanceIcon" TargetType="controls:IconView">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStorage}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="InstanceVisibility" />
        <Style x:Key="InstanceSyncIcon" TargetType="controls:IconView">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Synced}">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Synchronizing}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Conflict}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static models:ConfigurationSyncStatus.Failed}">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- 展开视图与图标栏共用 Instances 集合和打开命令。 -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=SidebarRoot}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="3" Text="{Binding OperationError}" Margin="12,4,12,8"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OperationError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Margin="12,0">
                <TextBlock Text="{loc:Loc Instance}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBodyBrush}" VerticalAlignment="Center" />
                <Button Command="{Binding AddInstanceCommand}" Style="{DynamicResource IconButton}"
                        Width="24" Height="24" Padding="0" HorizontalAlignment="Right" ToolTip="{loc:Loc AddInstance}">
                    <controls:IconView Kind="plus" Width="15" Height="15"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
            </Grid>
            <Border Grid.Row="1" Margin="10,2,10,6" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="9,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="13" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconView Kind="search" Width="13" Height="13"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                    <TextBox x:Name="InstanceSearch" Grid.Column="2"
                             Style="{DynamicResource SearchTextBox}" FontSize="12"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Loc FilterInstancesByName}" />
                    <TextBlock Grid.Column="2" Text="{loc:Loc FilterInstanceList}" FontSize="12"
                               Foreground="{DynamicResource TextFaintBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InstanceSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,2,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="TagFilterButton" Style="{DynamicResource GhostButton}"
                        Height="35" Margin="8,0" Padding="12,8,12,14" HorizontalContentAlignment="Left"
                        Click="OnTagFilterClick" ToolTip="{loc:Loc FilterInstancesByTags}">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconView Kind="tags" Width="13" Height="13"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock FontSize="12" FontWeight="Normal"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="7,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding TagFilterLabel}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTagPaths.Count}" Value="0">
                                            <Setter Property="Text" Value="{loc:Loc FilterTags}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Popup x:Name="TagFilterPopup" PlacementTarget="{Binding ElementName=TagFilterButton}"
                       Placement="Bottom" HorizontalOffset="-16" VerticalOffset="-2"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                       Opened="OnTagPopupOpened" Closed="OnTagPopupClosed">
                    <!-- 阴影空间不计入设计稿中三百八十像素的选择器主体。 -->
                    <Border Padding="16,8,16,24" Background="Transparent">
                        <controls:TagTreePicker x:Name="TagPicker" Width="380"
                                                KeyboardNavigation.TabNavigation="Cycle" />
                    </Border>
                </Popup>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Instances}" Margin="8,0"
                                      AutomationProperties.Name="{loc:Loc InstanceList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="34"
                                            ToolTip="{Binding AccessibleName}" AutomationProperties.Name="{Binding AccessibleName}"
                                            Margin="0,0,0,2" Padding="12,0" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarItemButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="15" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:IconView x:Name="InstanceTypeIcon" Kind="{Binding TypeIcon}" Width="15" Height="15"
                                                               ToolTip="{Binding TypeHint}" IsHitTestVisible="True"
                                                               Style="{StaticResource InstanceIcon}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                                                       FontFamily="{DynamicResource UiFont}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <controls:IconView x:Name="InstanceProviderIcon" Grid.Column="3" Kind="{Binding Icon}"
                                                               Width="16" Height="16" Margin="8,0,0,0"
                                                               ToolTip="{Binding ProviderHint}" IsHitTestVisible="True"
                                                               Visibility="{Binding HasProviderIcon, Converter={StaticResource InstanceVisibility}}" />
                                            <controls:IconView x:Name="InstanceCloudStatus" Grid.Column="4" Kind="{Binding SyncIcon}"
                                                               Width="14" Height="14" Margin="8,0,0,0" Style="{StaticResource InstanceSyncIcon}"
                                                               ToolTip="{Binding SyncHint}" AutomationProperties.Name="{Binding SyncHint}" IsHitTestVisible="True"
                                                               Visibility="{Binding HasSyncStatus, Converter={StaticResource InstanceVisibility}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Loc NoMatchingInstances}" FontSize="12" Margin="14,8"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=SidebarRoot}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="0,12" HorizontalAlignment="Center">
                <Button Style="{DynamicResource IconButton}" Width="36" Height="36"
                        Margin="0,0,0,8" Click="OnCollapsedSearchClick" ToolTip="{loc:Loc FindInstances}">
                    <controls:IconView Kind="search" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
                <ItemsControl ItemsSource="{Binding Instances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="36" Height="36" Margin="0,0,0,8"
                                    ToolTip="{Binding AccessibleName}" AutomationProperties.Name="{Binding AccessibleName}" Padding="4"
                                    Command="{Binding DataContext.OpenInstanceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="28" Height="28">
                                    <controls:IconView Kind="{Binding TypeIcon}" Width="18" Height="18">
                                        <controls:IconView.Style>
                                            <Style TargetType="controls:IconView" BasedOn="{StaticResource InstanceIcon}">
                                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Style>
                                        </controls:IconView.Style>
                                    </controls:IconView>
                                    <controls:IconView Kind="{Binding Icon}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Visibility="{Binding HasProviderIcon, Converter={StaticResource InstanceVisibility}}" />
                                    <controls:IconView Kind="{Binding SyncIcon}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Style="{StaticResource InstanceSyncIcon}"
                                                       Visibility="{Binding HasSyncStatus, Converter={StaticResource InstanceVisibility}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{DynamicResource IconButton}" Width="36" Height="36"
                        Command="{Binding AddInstanceCommand}" ToolTip="{loc:Loc AddInstance}">
                    <controls:IconView Kind="plus" Width="18" Height="18"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
