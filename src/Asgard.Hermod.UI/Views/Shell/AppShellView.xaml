<UserControl x:Class="Asgard.Hermod.UI.Views.Shell.AppShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Asgard.Hermod.UI.Views.Shell"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- 窗口边框和标题栏由 HermodWindow 承载，这里组合导航与工作区。 -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <shell:InstanceSidebarView x:Name="SidebarView"
                    DataContext="{Binding Sidebar}"
                    IsExpanded="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ExpandSearchRequested="OnExpandSearchRequested" />
                <shell:SidebarFooterView Grid.Row="1" />
            </Grid>
        </Border>
        <shell:WorkspaceView x:Name="Workspace" Grid.Column="1"
                             DataContext="{Binding Workspace}" />
    </Grid>
</UserControl>
