<UserControl x:Class="Asgard.Hermod.UI.Views.Shell.SidebarFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization"
             xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="ThemeSegmentButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Segment" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Segment" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FooterRoundButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="{TemplateBinding Background}"
                                CornerRadius="17" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentWeakBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="12,12,12,9" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                        <Setter Property="Padding" Value="12,12,12,11" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid>
                    <Border Background="{DynamicResource ThemeTrackBrush}" CornerRadius="8"
                            Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetLightThemeCommand}" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeSegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Kind="sun" Width="14" Height="14" />
                                    <TextBlock Text="{loc:Loc Light}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBodyBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetDarkThemeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemeSegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:IconView Kind="moon" Width="14" Height="14" />
                                    <TextBlock Text="{loc:Loc Dark}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBodyBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource FooterRoundButton}" HorizontalAlignment="Right"
                            Command="{Binding ToggleSidebarCommand}" ToolTip="{loc:Loc CollapseSidebar}">
                        <controls:IconView Kind="panel-left" Width="16" Height="16" />
                    </Button>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="{loc:Loc Hermod}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding Version}" FontFamily="{DynamicResource MonoFont}" FontSize="10"
                               HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Command="{Binding ToggleThemeCommand}" Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FooterRoundButton}">
                            <Setter Property="ToolTip" Value="{loc:Loc SwitchToDarkMode}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                    <Setter Property="ToolTip" Value="{loc:Loc SwitchToLightMode}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <controls:IconView Width="16" Height="16">
                        <controls:IconView.Style>
                            <Style TargetType="controls:IconView">
                                <Setter Property="Kind" Value="moon" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                        <Setter Property="Kind" Value="sun" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:IconView.Style>
                    </controls:IconView>
                </Button>
                <Button Style="{StaticResource FooterRoundButton}" Command="{Binding ToggleSidebarCommand}"
                        ToolTip="{loc:Loc ExpandSidebar}">
                    <controls:IconView Kind="panel-left" Width="16" Height="16" />
                </Button>
                <TextBlock Text="{Binding CompactVersion}" FontFamily="{DynamicResource MonoFont}" FontSize="8"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
