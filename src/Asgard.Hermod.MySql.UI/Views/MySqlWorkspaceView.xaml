<UserControl x:Class="Asgard.Hermod.MySql.UI.Views.MySqlWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:vm="clr-namespace:Asgard.Hermod.MySql.UI.ViewModels" PreviewKeyDown="OnKeyDown" controls:WorkspaceConnectionScope.State="{Binding Connection}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /></Style>
  <Style x:Key="ObjectTreeItem" TargetType="TreeViewItem">
   <Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="ToolTip" Value="{Binding Label}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><StackPanel>
    <Border x:Name="Row" MinHeight="32" Padding="6,0" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Margin="0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Width="20" Height="22" BorderThickness="0" Background="Transparent"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><controls:IconView x:Name="Arrow" Kind="chevron-right" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Kind" Value="chevron-down" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
     <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
    </Grid></Border><ItemsPresenter x:Name="Children" Visibility="Collapsed" Margin="18,0,0,0" />
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Children" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsKeyboardFocusWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type vm:MySqlTreeNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource ObjectTreeItem}">
   <StackPanel><Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <controls:IconView Kind="{Binding Icon}" ForegroundResourceKey="{Binding ColorResource}" Width="15" Height="15" /><TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}" />
   </Grid><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />
    <Button Content="{loc:Loc MySqlLoadMore}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Left" Margin="0,3,0,6"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsExpanded}" Value="True" /><Condition Binding="{Binding HasMore}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
   </StackPanel>
  </HierarchicalDataTemplate>
 </UserControl.Resources>
 <controls:WorkspacePageLayout x:Name="WorkspaceLayout" IsOverlayOpen="{Binding Connection.IsOpen}">
  <controls:WorkspacePageLayout.Overlay><controls:WorkspaceConnectionOverlay CloseWorkspaceCommand="{Binding CloseWindowCommand}" State="{Binding Connection}" TargetName="{Binding Name}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}" /></controls:WorkspacePageLayout.Overlay>
  <controls:WorkspacePageLayout.Toolbar><controls:WorkspaceHeader State="{Binding Connection}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}">
   <controls:WorkspaceHeader.IdentityContent><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition x:Name="IdentityColumn" Width="*" /></Grid.ColumnDefinitions>
    <controls:IconView x:Name="ToolbarTypeIcon" Kind="database" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><controls:InstanceNameButton Instance="{Binding Instance}" FontSize="14" HorizontalAlignment="Stretch" /><TextBlock Text="{Binding Endpoint}" ToolTip="{Binding Endpoint}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
   </Grid></controls:WorkspaceHeader.IdentityContent>
   <controls:WorkspaceHeader.StatusContent><StackPanel Orientation="Horizontal"><controls:StatusBadge Style="{DynamicResource WorkspaceHeaderSecondaryStatus}" Text="{Binding Instance.EnvironmentLabel}" Tone="{Binding Instance.EnvironmentTone}" ShowIndicator="False" Margin="0,0,10,0" /><controls:StatusBadge x:Name="Badge" Text="{Binding Status}" Tone="{Binding ConnectionTone}" ShowIndicator="False" /></StackPanel></controls:WorkspaceHeader.StatusContent>
   <controls:WorkspaceHeader.ActionsContent><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{loc:Loc MySqlNewQuery}" Command="{Binding NewQueryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" /><Button Content="{loc:Loc MySqlEditConnection}" Command="{Binding EditConnectionCommand}" Margin="0,0,10,0" /><controls:WorkspaceTools Items="{Binding Tools}" /></StackPanel></controls:WorkspaceHeader.ActionsContent>
  </controls:WorkspaceHeader></controls:WorkspacePageLayout.Toolbar>
  <controls:WorkspacePageLayout.Notification><Border Background="{DynamicResource DangerWeakBrush}" Padding="20,10" Visibility="{Binding HasError, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /></Border></controls:WorkspacePageLayout.Notification>
  <controls:WorkspacePageLayout.StatusContent><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ActiveTab.Status}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveTab.IsQuery}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ActiveTab.Section}" Value="structure"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ActiveTab.IsMetadataOnly}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ActiveTab.StateLabel}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></DockPanel></controls:WorkspacePageLayout.StatusContent>
  <Grid x:Name="Body" SizeChanged="OnBodySizeChanged"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="200" /><ColumnDefinition x:Name="SplitterColumn" Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border x:Name="TreePanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,1,0" Padding="12,18,12,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RefreshTreeCommand}" ToolTip="{loc:Loc MySqlRefreshBranch}" AutomationProperties.Name="{loc:Loc MySqlRefreshBranch}"><controls:IconView Kind="refresh-cw" Width="14" Height="14" /></Button><TextBlock Text="{loc:Loc MySqlDatabaseObjects}" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
     <Grid Grid.Row="1" Margin="0,0,0,10"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" ToolTip="{loc:Loc MySqlSearchLoaded}" AutomationProperties.Name="{loc:Loc MySqlSearchLoaded}" /><TextBlock Text="{loc:Loc MySqlSearchLoaded}" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <controls:WorkspaceTreeView Grid.Row="2" x:Name="ObjectTree" IsEnabled="{Binding IsConnected}" ItemsSource="{Binding Tree.Root.Children}" ItemContainerStyle="{StaticResource ObjectTreeItem}" Background="Transparent" BorderThickness="0" SelectedItemChanged="OnSelectedObject" AutomationProperties.Name="{loc:Loc MySqlDatabaseObjects}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"></controls:WorkspaceTreeView>
     <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding Tree.Root.Status}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12" /><Button Content="{loc:Loc MySqlLoadMore}" Command="{Binding Tree.Root.LoadMoreCommand}" Visibility="{Binding Tree.Root.HasMore, Converter={StaticResource Visible}}" HorizontalAlignment="Left" /><TextBlock Text="{loc:Loc MySqlSearchLoadedHint}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" x:Name="Splitter" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="{DynamicResource LineSoftBrush}" ShowsPreview="True" />
   <Grid Grid.Column="2" Margin="22,18,22,14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel><Button x:Name="DrawerButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="OnDrawer" Visibility="Collapsed" ToolTip="{loc:Loc MySqlDatabaseObjects}" AutomationProperties.Name="{loc:Loc MySqlDatabaseObjects}" Margin="0,0,8,0"><controls:IconView Kind="database" Width="16" Height="16" /></Button>
     <controls:WorkspaceTabStrip x:Name="ObjectTabs" CloseCommand="{Binding CloseTabCommand}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}" ToolTipMemberPath="Header" SelectionChanged="OnTabChanged" Visibility="{Binding HasTabs, Converter={StaticResource Visible}}">
      <controls:WorkspaceTabStrip.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:IconView Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" /><TextBlock Text="●" FontSize="8" Foreground="{DynamicResource WarningBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource Visible}}" /><Button Style="{StaticResource IconButton}" Width="24" Height="24" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc MySqlCloseTab}" AutomationProperties.Name="{loc:Loc MySqlCloseTab}" Margin="6,0,0,0"><controls:IconView Kind="x" Width="12" Height="12" /></Button></StackPanel></DataTemplate></controls:WorkspaceTabStrip.ItemTemplate>
     </controls:WorkspaceTabStrip>
    </DockPanel>
    <ContentControl Grid.Row="1" x:Name="TabHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    <StackPanel Grid.Row="1" x:Name="EmptyTabs" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasTabs}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <controls:IconView Kind="table-2" Width="38" Height="38" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18" />
     <TextBlock Text="{loc:Loc MySqlNoOpenTabs}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
     <TextBlock Text="{loc:Loc MySqlNoOpenTabsHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,20" />
     <Button Content="{loc:Loc MySqlNewQuery}" Command="{Binding NewQueryCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
    </StackPanel>
   </Grid>
  </Grid>
 </controls:WorkspacePageLayout>
</UserControl>
