<UserControl x:Class="Asgard.Hermod.MySql.UI.Views.MySqlWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:vm="clr-namespace:Asgard.Hermod.MySql.UI.ViewModels" xmlns:views="clr-namespace:Asgard.Hermod.MySql.UI.Views" PreviewKeyDown="OnKeyDown" controls:WorkspaceConnectionScope.State="{Binding Connection}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /></Style>
  <Style x:Key="ObjectTreeItem" TargetType="TreeViewItem">
   <Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="ToolTip" Value="{Binding Label}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><StackPanel>
    <Border x:Name="Row" MinHeight="32" Padding="6,0" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Margin="0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Width="20" Height="22" BorderThickness="0" Background="Transparent"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><controls:IconView x:Name="Arrow" Kind="chevron-right" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Kind" Value="chevron-down" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
     <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
    </Grid></Border><ItemsPresenter x:Name="Children" Visibility="Collapsed" Margin="18,0,0,0" />
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Children" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsKeyboardFocusWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type vm:MySqlTreeNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource ObjectTreeItem}">
   <StackPanel><Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <controls:IconView Kind="{Binding Icon}" ForegroundResourceKey="{Binding ColorResource}" Width="15" Height="15" /><TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}" />
   </Grid><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />
    <Button Content="{loc:Loc MySqlLoadMore}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Left" Margin="0,3,0,6"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsExpanded}" Value="True" /><Condition Binding="{Binding HasMore}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
   </StackPanel>
  </HierarchicalDataTemplate>
 </UserControl.Resources>
 <controls:WorkspacePageLayout x:Name="WorkspaceLayout" IsOverlayOpen="{Binding Connection.IsOpen}" CompactBreakpoint="1040">
  <controls:WorkspacePageLayout.Overlay><controls:WorkspaceConnectionOverlay CloseWorkspaceCommand="{Binding CloseWindowCommand}" State="{Binding Connection}" TargetName="{Binding Name}" RetryCommand="{Binding ReconnectCommand}" /></controls:WorkspacePageLayout.Overlay>
  <controls:WorkspacePageLayout.Toolbar><controls:WorkspaceHeader State="{Binding Connection}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}">
   <controls:WorkspaceHeader.IdentityContent><controls:WorkspaceIdentity Instance="{Binding Instance}" Endpoint="{Binding Endpoint}" Icon="brand-mysql" /></controls:WorkspaceHeader.IdentityContent>
   <controls:WorkspaceHeader.StatusContent><controls:StatusBadge Style="{DynamicResource WorkspaceHeaderSecondaryStatus}" Text="{Binding Instance.EnvironmentLabel}" Tone="{Binding Instance.EnvironmentTone}" ShowIndicator="False" IsCaption="True" /></controls:WorkspaceHeader.StatusContent>
   <controls:WorkspaceHeader.ActionsContent><StackPanel x:Name="CaptionActions" Orientation="Horizontal" VerticalAlignment="Center">
    <controls:WorkspaceTools x:Name="CaptionTools" Items="{Binding Tools}" VerticalAlignment="Center" Margin="0,0,8,0" />
    <Button x:Name="AgentAction" Command="{Binding ToggleAssistantCommand}" Height="28" FontSize="12" Padding="9,0" ToolTip="{loc:Loc DatabaseSessionAgentHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc DatabaseSessionAgent}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAssistantOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
     <StackPanel Orientation="Horizontal"><controls:IconView Kind="sparkles" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="{loc:Loc DatabaseSessionAgent}" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel>
    </Button>
   </StackPanel></controls:WorkspaceHeader.ActionsContent>
  </controls:WorkspaceHeader></controls:WorkspacePageLayout.Toolbar>
  <controls:WorkspacePageLayout.Notification><Border Background="{DynamicResource DangerWeakBrush}" Padding="20,10" Visibility="{Binding HasError, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /></Border></controls:WorkspacePageLayout.Notification>
  <controls:WorkspacePageLayout.StatusContent><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ActiveTab.Status}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveTab.IsQuery}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ActiveTab.Section}" Value="structure"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ActiveTab.IsMetadataOnly}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ActiveTab.StateLabel}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" /></DockPanel></controls:WorkspacePageLayout.StatusContent>
  <controls:WorkspaceSplitView x:Name="AgentSplit" IsPaneOpen="{Binding IsAssistantOpen}" PaneWidth="{Binding AssistantWidth, Mode=TwoWay}">
   <controls:WorkspaceSplitView.MainContent>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <StackPanel Visibility="{Binding IsDatabaseFocused, Converter={StaticResource Visible}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="{loc:Loc DatabaseSessionNew}" Command="{Binding NewQueryCommand}" Margin="8,4,12,4" />
    <controls:WorkspaceTabStrip ItemsSource="{Binding Sessions}" SelectedItem="{Binding ActiveSession, Mode=TwoWay}" CloseCommand="{Binding CloseTabCommand}" ToolTipMemberPath="Header"><controls:WorkspaceTabStrip.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:IconView Kind="file-code" Width="14" Height="14" Margin="0,0,8,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /><Button Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource IconButton}" Content="×" Width="24" Height="24" Margin="8,0,0,0" ToolTip="{loc:Loc DatabaseSessionClose}" AutomationProperties.Name="{loc:Loc DatabaseSessionClose}" /></StackPanel></DataTemplate></controls:WorkspaceTabStrip.ItemTemplate></controls:WorkspaceTabStrip>
    </DockPanel>
    <Border BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="12,8"><WrapPanel>
     <Button Content="{loc:Loc DatabaseSessionCatalog}" Command="{Binding BrowseDatabasesCommand}" Margin="0,0,10,4" />
     <TextBlock Text="{loc:Loc DatabaseSessionScope}" VerticalAlignment="Center" Margin="0,0,10,4" />
     <ItemsControl ItemsSource="{Binding ActiveSession.Scope.Databases}" Margin="0,0,10,4"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource AccentWeakBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
       <Button Content="×" Width="24" Height="24" Command="{Binding DataContext.RemoveSessionDatabaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc DatabaseSessionRemoveTitle}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="ToolTip" Value="{loc:Loc DatabaseSessionRemoveTitle}" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.ActiveSession.Scope.CanRemoveDatabase, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="ToolTip" Value="{loc:Loc DatabaseSessionRequiresDatabase}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Content="{loc:Loc DatabaseSessionAdd}" Command="{Binding AddSessionDatabaseCommand}" Margin="0,0,10,4" />
     <Button Content="{loc:Loc DatabaseSessionReturnScript}" Command="{Binding ReturnToScriptCommand}" Margin="0,0,10,4" />
     <Button Content="{loc:Loc DatabaseSessionHistory}" Command="{Binding ShowSessionHistoryCommand}" Margin="0,0,0,4" />
    </WrapPanel></Border>
   </StackPanel>
   <Grid Grid.Row="1" x:Name="Body" SizeChanged="OnBodySizeChanged" Visibility="{Binding IsDatabaseFocused, Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="200" /><ColumnDefinition x:Name="SplitterColumn" Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border x:Name="TreePanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,1,0" Padding="12,18,12,12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button x:Name="CollapseTreeButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnDrawer" ToolTip="{loc:Loc DatabaseSessionHideTree}" AutomationProperties.Name="{loc:Loc DatabaseSessionHideTree}"><controls:IconView Kind="panel-left-close" Width="16" Height="16" /></Button><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding RefreshTreeCommand}" ToolTip="{loc:Loc MySqlRefreshBranch}" AutomationProperties.Name="{loc:Loc MySqlRefreshBranch}"><controls:IconView Kind="refresh-cw" Width="14" Height="14" /></Button><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding BrowseDatabasesCommand}" Visibility="{Binding IsDatabaseFocused, Converter={StaticResource Visible}}" ToolTip="{loc:Loc MySqlBrowseDatabases}" AutomationProperties.Name="{loc:Loc MySqlBrowseDatabases}"><controls:IconView Kind="database" Width="14" Height="14" /></Button><TextBlock Text="{loc:Loc DatabaseSessionDatabases}" ToolTip="{Binding NavigationTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
     <Grid Grid.Row="1" Margin="0,0,0,10"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" ToolTip="{loc:Loc MySqlSearchLoaded}" AutomationProperties.Name="{loc:Loc MySqlSearchLoaded}" /><TextBlock Text="{loc:Loc MySqlSearchLoaded}" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <controls:WorkspaceTreeView Grid.Row="2" x:Name="ObjectTree" IsEnabled="{Binding IsConnected}" ItemsSource="{Binding SessionTreeItems}" ItemContainerStyle="{StaticResource ObjectTreeItem}" Background="Transparent" BorderThickness="0" SelectedItemChanged="OnSelectedObject" PreviewMouseLeftButtonUp="OnObjectClick" AutomationProperties.Name="{loc:Loc MySqlDatabaseObjects}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"></controls:WorkspaceTreeView>
     <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding NavigationRoot.Status}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12" /><Button Content="{loc:Loc MySqlLoadMore}" Command="{Binding NavigationRoot.LoadMoreCommand}" Visibility="{Binding NavigationRoot.HasMore, Converter={StaticResource Visible}}" HorizontalAlignment="Left" /><TextBlock Text="{loc:Loc MySqlSearchLoadedHint}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" x:Name="Splitter" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="{DynamicResource LineSoftBrush}" ShowsPreview="True" />
   <Grid Grid.Column="2" Margin="12,10,12,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel><Button x:Name="DrawerButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="OnDrawer" Visibility="Collapsed" ToolTip="{loc:Loc DatabaseSessionShowTree}" AutomationProperties.Name="{loc:Loc DatabaseSessionShowTree}" Margin="0,0,8,0"><controls:IconView Kind="panel-left-open" Width="16" Height="16" /></Button>
     <controls:WorkspaceTabStrip x:Name="ObjectTabs" CloseCommand="{Binding CloseTabCommand}" ItemsSource="{Binding ActiveDocuments}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}" ToolTipMemberPath="Header" SelectionChanged="OnTabChanged" Visibility="{Binding HasTabs, Converter={StaticResource Visible}}">
      <controls:WorkspaceTabStrip.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:IconView Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}" /><TextBlock Text="{Binding DocumentTitle}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" /><TextBlock Text="●" FontSize="8" Foreground="{DynamicResource WarningBrush}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource Visible}}" /><Button Style="{StaticResource IconButton}" Width="24" Height="24" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc MySqlCloseTab}" AutomationProperties.Name="{loc:Loc MySqlCloseTab}" Margin="6,0,0,0"><controls:IconView Kind="x" Width="12" Height="12" /></Button></StackPanel></DataTemplate></controls:WorkspaceTabStrip.ItemTemplate>
     </controls:WorkspaceTabStrip>
    </DockPanel>
    <ContentControl Grid.Row="1" x:Name="TabHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    <StackPanel Grid.Row="1" x:Name="EmptyTabs" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasTabs}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <controls:IconView Kind="table-2" Width="38" Height="38" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18" />
     <TextBlock Text="{loc:Loc MySqlNoOpenTabs}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
     <TextBlock Text="{loc:Loc MySqlNoOpenTabsHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,20" />
     <Button Content="{loc:Loc DatabaseSessionNew}" Command="{Binding NewQueryCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
    </StackPanel>
   </Grid>
  </Grid>
   <Grid Grid.Row="1" Margin="32" Visibility="{Binding IsCatalog, Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,24"><TextBlock Text="{loc:Loc DatabaseSessionCatalog}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc DatabaseSessionCatalogHint}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" /></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,24,16"><Button DockPanel.Dock="Right" Content="{loc:Loc DatabaseSessionSelectAll}" Command="{Binding SelectAllDatabasesCommand}" Visibility="{Binding HasMultipleCatalogDatabases, Converter={StaticResource Visible}}" Margin="12,0,0,0" /><Grid><TextBox Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc DatabaseSessionSearch}" AutomationProperties.Name="{loc:Loc DatabaseSessionSearch}" /><TextBlock Text="{loc:Loc DatabaseSessionSearch}" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CatalogSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
    <Border Grid.Row="2" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,24,0" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding CatalogItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,6" Background="{DynamicResource SurfaceBrush}"><StackPanel Orientation="Horizontal">
     <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Name}" Visibility="{Binding DataContext.HasMultipleCatalogDatabases, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
     <controls:IconView Kind="database" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" />
    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Padding="24" Background="{DynamicResource AccentWeakBrush}" CornerRadius="6"><StackPanel><TextBlock Text="{loc:Loc DatabaseSessionOpen}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding Instance.Name}" FontWeight="SemiBold" Margin="0,20,0,8" /><TextBlock Text="{Binding Endpoint}" /><TextBlock Text="{Binding CatalogSelectionSummary}" FontWeight="SemiBold" Margin="0,20,0,6" /><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding CatalogSelectionNames}" TextWrapping="Wrap" /></ScrollViewer><TextBlock Text="{loc:Loc DatabaseSessionRulesHint}" TextWrapping="Wrap" Margin="0,24,0,24" /><Button Content="{loc:Loc DatabaseSessionOpen}" Command="{Binding OpenSessionCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel></Border>
    <TextBlock Grid.Row="3" Text="{Binding Tree.Root.Status}" Foreground="{DynamicResource TextMutedBrush}" Margin="120,20,12,0" TextWrapping="Wrap" />
    <Button Grid.Row="3" Grid.Column="1" Content="{loc:Loc MySqlLoadMore}" Command="{Binding Tree.Root.LoadMoreCommand}" Visibility="{Binding Tree.Root.HasMore, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,16,0,0" />
    <Button Grid.Row="3" Content="{loc:Loc DatabaseSessionRefreshCatalog}" Command="{Binding RefreshTreeCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
   </Grid>
  </Grid>
   </controls:WorkspaceSplitView.MainContent>
   <controls:WorkspaceSplitView.PaneContent><views:MySqlAssistantView x:Name="AssistantPanel" /></controls:WorkspaceSplitView.PaneContent>
  </controls:WorkspaceSplitView>
 </controls:WorkspacePageLayout>
</UserControl>
