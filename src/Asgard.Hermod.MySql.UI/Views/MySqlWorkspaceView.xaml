<UserControl x:Class="Asgard.Hermod.MySql.UI.Views.MySqlWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:vm="clr-namespace:Asgard.Hermod.MySql.UI.ViewModels" xmlns:views="clr-namespace:Asgard.Hermod.MySql.UI.Views" PreviewKeyDown="OnKeyDown" controls:WorkspaceConnectionScope.State="{Binding Connection}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextOptions.TextFormattingMode" Value="Ideal" /><Setter Property="FontFamily" Value="{DynamicResource UiFont}" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" /></Style>
  <Style x:Key="ObjectTreeItem" TargetType="TreeViewItem">
   <Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="ToolTip" Value="{Binding Label}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><StackPanel>
    <Border x:Name="Row" MinHeight="29" Padding="6,0" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="{Binding RowOutset}"><Grid Margin="{Binding RowInset}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ExpanderColumn" Width="19" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Width="12" Height="22" HorizontalAlignment="Left" BorderThickness="0" Background="Transparent"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><controls:IconView x:Name="Arrow" Kind="chevron-right" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Kind" Value="chevron-down" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
     <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
    </Grid></Border><ItemsPresenter x:Name="Children" Visibility="Collapsed" Margin="{Binding ChildrenIndent}" />
   </StackPanel><ControlTemplate.Triggers><DataTrigger Binding="{Binding IsObjectEntry}" Value="True"><Setter TargetName="ExpanderColumn" Property="Width" Value="0" /><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></DataTrigger><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Children" Property="Visibility" Value="Visible" /></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentWeakBrush}" /></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsKeyboardFocusWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type vm:MySqlTreeNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource ObjectTreeItem}">
   <StackPanel><Grid Height="29"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <controls:IconView Kind="{Binding Icon}" Foreground="{DynamicResource TextMutedBrush}" Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="0,0,7,0" /><TextBlock Grid.Column="1" FontSize="11" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Detail}" />
   </Grid><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />
    <Button Content="{loc:Loc MySqlLoadMore}" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Left" Margin="0,3,0,6"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsExpanded}" Value="True" /><Condition Binding="{Binding HasMore}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
   </StackPanel>
  </HierarchicalDataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <controls:WorkspacePageLayout x:Name="WorkspaceLayout" IsOverlayOpen="{Binding Connection.IsOpen}" CompactBreakpoint="1040">
  <controls:WorkspacePageLayout.Overlay><controls:WorkspaceConnectionOverlay CloseWorkspaceCommand="{Binding CloseWindowCommand}" State="{Binding Connection}" TargetName="{Binding Name}" RetryCommand="{Binding ReconnectCommand}" /></controls:WorkspacePageLayout.Overlay>
  <controls:WorkspacePageLayout.Toolbar><controls:WorkspaceHeader State="{Binding Connection}" RetryCommand="{Binding ReconnectCommand}" EditCommand="{Binding EditConnectionCommand}">
   <controls:WorkspaceHeader.IdentityContent><controls:WorkspaceIdentity ToolTip="{Binding EngineDescription}" Instance="{Binding Instance}" Endpoint="{Binding Endpoint}" Icon="brand-mysql" /></controls:WorkspaceHeader.IdentityContent>
   <controls:WorkspaceHeader.StatusContent><controls:StatusBadge Style="{DynamicResource WorkspaceHeaderSecondaryStatus}" Text="{Binding Instance.EnvironmentLabel}" Tone="{Binding Instance.EnvironmentTone}" ShowIndicator="False" IsCaption="True" /></controls:WorkspaceHeader.StatusContent>
   <controls:WorkspaceHeader.ActionsContent><StackPanel x:Name="CaptionActions" Orientation="Horizontal" VerticalAlignment="Center">
    <controls:WorkspaceTools x:Name="CaptionTools" Items="{Binding Tools}" VerticalAlignment="Center" Margin="0,0,8,0" />
    <Button x:Name="AgentAction" Click="OnOpenAgent" Height="28" FontWeight="Normal" FontSize="12" Padding="9,0" ToolTip="{loc:Loc DatabaseSessionAgentHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Loc DatabaseSessionAgent}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource StandardButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAssistantOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentWeakBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
     <StackPanel Orientation="Horizontal"><controls:IconView Kind="sparkles" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="{loc:Loc DatabaseSessionAgent}" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel>
    </Button>
   </StackPanel></controls:WorkspaceHeader.ActionsContent>
  </controls:WorkspaceHeader></controls:WorkspacePageLayout.Toolbar>
  <controls:WorkspacePageLayout.Notification><Border Background="{DynamicResource DangerWeakBrush}" Padding="20,10" Visibility="{Binding HasError, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /></Border></controls:WorkspacePageLayout.Notification>
  <controls:WorkspacePageLayout.StatusContent><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ActiveTab.StateLabel}" FontFamily="{DynamicResource UiFont}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal"><controls:IconView Kind="shield-check" Width="12" Height="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" /><TextBlock Text="{Binding ConnectionSummary}" FontFamily="{DynamicResource UiFont}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" /></StackPanel></DockPanel></controls:WorkspacePageLayout.StatusContent>
  <controls:WorkspaceSplitView x:Name="AgentSplit" IsPaneOpen="False" PaneWidth="{Binding AssistantWidth, Mode=TwoWay}">
   <controls:WorkspaceSplitView.MainContent>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <StackPanel>
    <DockPanel Height="36" Background="{DynamicResource AppBackgroundBrush}"><Button DockPanel.Dock="Right" Command="{Binding NewQueryCommand}" Visibility="{Binding IsDatabaseFocused, Converter={StaticResource Visible}}" Style="{StaticResource DatabaseToolbarButton}" Margin="0,3,12,3"><Button.Content><StackPanel Orientation="Horizontal"><controls:IconView Kind="plus" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" /><TextBlock Text="{loc:Loc DatabaseSessionNew}" /></StackPanel></Button.Content></Button><controls:DatabaseScopePicker DockPanel.Dock="Right" Margin="0,3,3,3" Visibility="{Binding IsDatabaseFocused, Converter={StaticResource Visible}}" />
<Border DockPanel.Dock="Left" Width="176" Margin="12,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,2,0,0" Visibility="{Binding IsCatalog, Converter={StaticResource Visible}}"><StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><controls:IconView Kind="plus" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" /><TextBlock Text="{loc:Loc DatabasePickTab}" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></StackPanel></Border><controls:WorkspaceTabStrip Height="36" MinHeight="36" Background="{DynamicResource AppBackgroundBrush}" ItemContainerStyle="{StaticResource DatabaseSessionTab}" Padding="12,0" Visibility="{Binding IsDatabaseFocused, Converter={StaticResource Visible}}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding ActiveSession, Mode=TwoWay}" CloseCommand="{Binding CloseTabCommand}" ToolTipMemberPath="Header"><controls:WorkspaceTabStrip.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
 <controls:IconView Kind="file-code" Width="14" Height="14" Style="{StaticResource DatabaseTabIcon}" />
 <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="6,0,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Margin" Value="9,0,9,0" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 <Button Grid.Column="2" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DatabaseCloseButton}" ToolTip="{loc:Loc DatabaseSessionClose}" AutomationProperties.Name="{loc:Loc DatabaseSessionClose}"><controls:IconView Kind="x" Width="12" Height="12" /></Button>
 </Grid></DataTemplate></controls:WorkspaceTabStrip.ItemTemplate></controls:WorkspaceTabStrip>
    </DockPanel>

   </StackPanel>
   <Grid Grid.Row="1" x:Name="Body" SizeChanged="OnBodySizeChanged" Visibility="{Binding IsDatabaseFocused, Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="232" MinWidth="200" /><ColumnDefinition x:Name="SplitterColumn" Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border x:Name="TreePanel" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0" Padding="12,16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <DockPanel Height="24" Margin="0,0,0,12"><Button x:Name="CollapseTreeButton" DockPanel.Dock="Right" Width="15" Height="24" Padding="0" BorderThickness="0" Style="{StaticResource IconButton}" Click="OnDrawer" ToolTip="{loc:Loc DatabaseSessionHideTree}" AutomationProperties.Name="{loc:Loc DatabaseSessionHideTree}"><controls:IconView Kind="panel-left-close" Width="15" Height="15" /></Button><Button DockPanel.Dock="Right" Width="14" Height="24" Padding="0" BorderThickness="0" Margin="0,0,7,0" Style="{StaticResource IconButton}" Command="{Binding RefreshTreeCommand}" ToolTip="{loc:Loc MySqlRefreshBranch}" AutomationProperties.Name="{loc:Loc MySqlRefreshBranch}"><controls:IconView Kind="refresh-cw" Width="14" Height="14" /></Button><TextBlock FontSize="13" Text="{loc:Loc DatabaseObjects}" ToolTip="{Binding NavigationTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
     <Grid Grid.Row="1" Margin="0,0,0,12"><controls:IconView Kind="search" Width="12" Height="12" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" Panel.ZIndex="1" /><TextBox Padding="28,0,10,0" Height="30" MinHeight="30" FontSize="11" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" ToolTip="{loc:Loc MySqlSearchLoaded}" AutomationProperties.Name="{loc:Loc MySqlSearchLoaded}" /><TextBlock Text="{loc:Loc MySqlSearchLoaded}" IsHitTestVisible="False" Margin="29,0,10,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <DockPanel Grid.Row="2" LastChildFill="False"><controls:WorkspaceTreeView DockPanel.Dock="Top" VerticalAlignment="Top" x:Name="ObjectTree" IsEnabled="{Binding IsConnected}" ItemsSource="{Binding SessionTreeItems}" ItemContainerStyle="{StaticResource ObjectTreeItem}" Background="Transparent" BorderThickness="0" Padding="0" SelectedItemChanged="OnSelectedObject" PreviewMouseLeftButtonUp="OnObjectClick" AutomationProperties.Name="{loc:Loc MySqlDatabaseObjects}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"></controls:WorkspaceTreeView><TextBlock DockPanel.Dock="Top" Text="{Binding NavigationLoadedSummary}" Margin="0,24,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" /></DockPanel>
     <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding NavigationRoot.Status}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12" /><Button Content="{loc:Loc MySqlLoadMore}" Command="{Binding NavigationRoot.LoadMoreCommand}" Visibility="{Binding NavigationRoot.HasMore, Converter={StaticResource Visible}}" HorizontalAlignment="Left" /></StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" x:Name="Splitter" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="{DynamicResource LineSoftBrush}" ShowsPreview="True" />
   <Grid Grid.Column="2" Margin="0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <DockPanel Height="36" Background="{DynamicResource AppBackgroundBrush}"><Button x:Name="DrawerButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Click="OnDrawer" Visibility="Collapsed" ToolTip="{loc:Loc DatabaseSessionShowTree}" AutomationProperties.Name="{loc:Loc DatabaseSessionShowTree}" Margin="0,0,8,0"><controls:IconView Kind="panel-left-open" Width="16" Height="16" /></Button>
     <controls:WorkspaceTabStrip x:Name="ObjectTabs" Height="36" MinHeight="36" Background="{DynamicResource AppBackgroundBrush}" ItemContainerStyle="{StaticResource DatabaseDocumentTab}" Padding="12,0" CloseCommand="{Binding CloseTabCommand}" ItemsSource="{Binding ActiveDocuments}" SelectedItem="{Binding ActiveTab, Mode=TwoWay}" ToolTipMemberPath="Header" SelectionChanged="OnTabChanged" Visibility="{Binding HasTabs, Converter={StaticResource Visible}}">
      <controls:WorkspaceTabStrip.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><controls:IconView Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,7,0" Style="{StaticResource DatabaseTabIcon}" /><TextBlock Text="{Binding DocumentTitle}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" /><Ellipse Width="5" Height="5" Fill="{DynamicResource WarningBrush}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource Visible}}" /><Button Style="{StaticResource DatabaseCloseButton}" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc MySqlCloseTab}" AutomationProperties.Name="{loc:Loc MySqlCloseTab}" Margin="6,0,0,0"><controls:IconView Kind="x" Width="12" Height="12" /></Button></StackPanel></DataTemplate></controls:WorkspaceTabStrip.ItemTemplate>
     </controls:WorkspaceTabStrip>
    </DockPanel>
    <ContentControl Grid.Row="1" x:Name="TabHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    <StackPanel Grid.Row="1" x:Name="EmptyTabs" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasTabs}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <controls:IconView Kind="table-2" Width="38" Height="38" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18" />
     <TextBlock Text="{loc:Loc MySqlNoOpenTabs}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
     <TextBlock Text="{loc:Loc MySqlNoOpenTabsHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,20" />
     <Button Content="{loc:Loc DatabaseSessionNew}" Command="{Binding NewQueryCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
    </StackPanel>
   </Grid>
  </Grid>
   <controls:DatabaseSessionPicker Grid.Row="1" Visibility="{Binding IsCatalog, Converter={StaticResource Visible}}" />
  </Grid>
   </controls:WorkspaceSplitView.MainContent>
  </controls:WorkspaceSplitView>
 </controls:WorkspacePageLayout>
</UserControl>
