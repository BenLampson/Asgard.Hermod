<UserControl x:Class="Asgard.Hermod.MySql.UI.Views.MySqlCategoryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI" xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Asgard.Hermod.UI;component/Resources/DatabaseDesign.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Background="{DynamicResource SurfaceBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <DockPanel Margin="20,12"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="{loc:Loc DatabaseOverviewRefresh}" AutomationProperties.Name="{loc:Loc DatabaseOverviewRefresh}"><controls:IconView Kind="refresh-cw" Width="16" Height="16" /></Button><TextBlock Text="{Binding OverviewCategory.DisplayLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
  <TextBlock Grid.Row="1" Text="{Binding OverviewCategory.Status}" Margin="20,0,20,8" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
  <TextBlock Grid.Row="2" Text="{loc:Loc DatabaseOverviewChooseGroup}" Margin="20" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding OverviewCategory}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <DataGrid x:Name="ItemsGrid" Grid.Row="2" Margin="20,0" ItemsSource="{Binding OverviewCategory.Children}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="36" GridLinesVisibility="Horizontal" CanUserResizeRows="False" SelectionUnit="FullRow" PreviewKeyDown="OnKeyDown" AutomationProperties.Name="{Binding OverviewCategory.Label}">
   <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource WorkspaceResultGrid}"><Style.Triggers><DataTrigger Binding="{Binding OverviewCategory}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DataGrid.Style>
   <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource WorkspaceGridRow}"><EventSetter Event="MouseDoubleClick" Handler="OnOpen" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="{loc:Loc MySqlObjectName}" Binding="{Binding Object.Name}" Width="220" MinWidth="130" />
    <DataGridTextColumn x:Name="AutoIncrementColumn" Header="{loc:Loc MySqlCatalogAutoIncrement}" Binding="{Binding Object.AutoIncrement}" Width="130" />
    <DataGridTextColumn x:Name="UpdatedColumn" Header="{loc:Loc MySqlCatalogUpdated}" Binding="{Binding Object.UpdatedAt}" Width="160" />
    <DataGridTextColumn x:Name="LengthColumn" Header="{loc:Loc MySqlCatalogDataLength}" Binding="{Binding Object.DataLength}" Width="120" />
    <DataGridTextColumn x:Name="EngineColumn" Header="{loc:Loc MySqlCatalogEngine}" Binding="{Binding Object.Engine}" Width="100" />
    <DataGridTextColumn x:Name="RowsColumn" Header="{loc:Loc MySqlCatalogRows}" Binding="{Binding Object.RowCount}" Width="100" />
    <DataGridTextColumn x:Name="CommentColumn" Header="{loc:Loc MySqlCatalogComment}" Binding="{Binding Object.Comment}" Width="*" MinWidth="180" />
    <DataGridTextColumn x:Name="DetailColumn" Header="{loc:Loc MySqlObjectDetails}" Binding="{Binding Object.Detail}" Width="*" MinWidth="180" />
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
