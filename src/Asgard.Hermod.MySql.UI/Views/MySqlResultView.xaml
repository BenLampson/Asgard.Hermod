<UserControl x:Class="Asgard.Hermod.MySql.UI.Views.MySqlResultView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:Asgard.Hermod.UI.Controls;assembly=Asgard.Hermod.UI" xmlns:loc="clr-namespace:Asgard.Hermod.UI.Localization;assembly=Asgard.Hermod.UI">
 <UserControl.Resources>
  <DataTemplate x:Key="ColumnHeader"><StackPanel ToolTip="{Binding Name}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBodyBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TypeName}" FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate>
  <DataTemplate x:Key="CellDisplay">
   <Border x:Name="CellBackground" Padding="10,0,4,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="ValueText" FontFamily="{DynamicResource UiFont}" FontSize="12" Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" VerticalAlignment="Center" />
    <Button x:Name="Expand" Grid.Column="1" Style="{StaticResource IconButton}" Width="20" Height="24" Click="OnExpand" Visibility="Hidden" ToolTip="{loc:Loc MySqlOpenField}" AutomationProperties.Name="{loc:Loc MySqlOpenField}"><controls:IconView Kind="maximize-2" Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}" /></Button>
   </Grid></Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsNull}" Value="True"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource TextFaintBrush}" /><Setter TargetName="ValueText" Property="FontStyle" Value="Italic" /></DataTrigger>
    <DataTrigger Binding="{Binding IsNumeric}" Value="True"><Setter TargetName="ValueText" Property="TextAlignment" Value="Right" /></DataTrigger>
    <DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter TargetName="CellBackground" Property="Background" Value="{DynamicResource WarningWeakBrush}" /></DataTrigger>
    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter TargetName="Expand" Property="Visibility" Value="Visible" /></DataTrigger>
    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"><Setter TargetName="Expand" Property="Visibility" Value="Visible" /></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="CellInput"><TextBox Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource UiFont}" FontSize="12" MaxLength="2048" BorderThickness="0" Padding="8,0" VerticalContentAlignment="Center" Loaded="OnInputLoaded" AutomationProperties.Name="{loc:Loc MySqlFieldValue}" /></DataTemplate>
 </UserControl.Resources>
 <Grid><DataGrid x:Name="ResultGrid" FontFamily="{DynamicResource UiFont}" FontSize="12" Style="{StaticResource WorkspaceResultGrid}" ItemsSource="{Binding Rows}" LoadingRow="OnLoadingRow" BeginningEdit="OnBeginningEdit" CellEditEnding="OnCellEditEnding" PreviewKeyDown="OnKeyDown" AutomationProperties.Name="{loc:Loc MySqlQueryResults}">
  <DataGrid.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc MySqlOpenField}" Click="OnOpenCurrent" /><MenuItem Header="{loc:Loc MySqlRevertCell}" Click="OnRevertCell" /></ContextMenu></DataGrid.ContextMenu>
 </DataGrid><TextBlock x:Name="EmptyResult" Text="{loc:Loc MySqlNoRows}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRows}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
</UserControl>
